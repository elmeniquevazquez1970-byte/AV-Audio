    gbg_r=0.88; gbg_g=0.87; gbg_b=0.84; grid_r=0.72; grid_g=0.71; grid_b=0.68;
    txt_r=0.14; txt_g=0.14; txt_b=0.14; tsub_r=0.24; tsub_g=0.24; tsub_b=0.24;
    knob_r=0.22; knob_g=0.22; knob_b=0.24; wt_r=1.0; wt_g=1.0; wt_b=1.0;
    acc_r=0.28; acc_g=0.52; acc_b=0.82; org_r=0.90; org_g=0.50; org_b=0.20;
    purp_r=0.60; purp_g=0.38; purp_b=0.85; yel_r=0.90; yel_g=0.72; yel_b=0.20;
    grn_r=0.30; grn_g=0.65; grn_b=0.40; red_r=0.85; red_g=0.30; red_b=0.30;
    punch_r=0.92; punch_g=0.45; punch_b=0.55; grain_amt=0.04;
) : (
