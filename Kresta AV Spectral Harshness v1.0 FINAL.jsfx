    txt_r=0.14; txt_g=0.17; txt_b=0.22; tsub_r=0.18; tsub_g=0.22; tsub_b=0.30;
    knob_r=0.20; knob_g=0.22; knob_b=0.26; wt_r=0.98; wt_g=0.98; wt_b=0.98;
    acc_r=0.25; acc_g=0.50; acc_b=0.80; org_r=0.92; org_g=0.55; org_b=0.28;
    purp_r=0.60; purp_g=0.38; purp_b=0.82; yel_r=0.95; yel_g=0.78; yel_b=0.25;
    grn_r=0.32; grn_g=0.70; grn_b=0.42; red_r=0.88; red_g=0.32; red_b=0.32;
    punch_r=0.92; punch_g=0.42; punch_b=0.55; grain_amt=0.08;
);
gfx_clear = (floor(bg_r*255) * 65536) + (floor(bg_g*255) * 256) + floor(bg_b*255);

// === LAYOUT ===
header_h = 42;
left_w = 180;
mid_w = 160;
right_x = left_w + mid_w;
graph_x = right_x + 12;
graph_y = header_h + 16;
graph_w = gfx_w - graph_x - 22;
graph_h = gfx_h - graph_y - 20;

g_x_int = graph_x; g_y_int = graph_y; g_w_int = graph_w; g_h_int = graph_h;
log_min_int = log(20);
scale_x_int = g_w_int / (log(srate * 0.5) - log_min_int);
max_db_display = 60.0;
x_min_handle = g_x_int + (log(slider1) - log_min_int) * scale_x_int;
x_max_handle = g_x_int + (log(slider2) - log_min_int) * scale_x_int;
y_thresh_handle = g_y_int + (-slider3 / max_db_display) * g_h_int;

big_cx = left_w / 2; big_cy = 82; big_r = 48;
foc_cx = 50; foc_cy = 195; small_r = 26;
rel_cx = 128; rel_cy = 195;
tilt_x = 12; tilt_y = 265; tilt_w = 22; tilt_h = 95;

mb_x = 12;
mb_w = left_w - 24;
mb_hdr_y = 380;
mb_tog_y = 394; mb_tog_h = 20;
mb_c1_y = 418; mb_c2_y = 440; mb_c3_y = 462;
mb_bar_h = 20;
mb_zn_tog_y = 486; mb_zn_tog_h = 20;
mb_tog_w = (mb_w - 6) / 4;
mb_z1_y = 510; mb_z2_y = 530; mb_z3_y = 550; mb_z4_y = 570;
mb_z_h = 18;

pun_x = left_w + 12; pun_w = mid_w - 24;

pun_y = 58; pun_h = 20;
unm_y = 80; unm_h = 20;
att_y = 102; att_h = 20;
mix_y = 124; mix_h = 20;

fft_hdr_y = 152;
fft_y = 166; fft_h = 20;
fft_btn_w = (mid_w - 24 - 6) / 4;
fft_info_y = 192;

nod_hdr_y = 216;
nod_tog_y = 230; nod_tog_h = 20;
nod_q_y = 252; nod_q_h = 20;

sc_hdr_y = 278;
sc_y = 292; sc_h = 20;
scl_y = 314; scl_h = 20;

aut_hdr_y = 340;
aut_y = 354; aut_h = 20;

out_hdr_y = 380;
out_gain_y = 394; out_gain_h = 20;
am_y = 416; am_h = 20;

resp_hdr_y = 446;
knee_y = 460; knee_h = 20;
slope_y = 482; slope_h = 20;
rsm_y = 504; rsm_h = 20;
mred_y = 526; mred_h = 20;

big_btn_y = 564; big_btn_h = 26;
solo_x = left_w + 12; solo_w = 40;
del_x = solo_x + solo_w + 4; del_w = 40;
byp_x = del_x + del_w + 4;
byp_w = mid_w - 24 - solo_w - del_w - 8;

theme_w = 100; theme_h = 22;
theme_x = gfx_w - 160 - theme_w - 24; theme_y = 10;
mode_w = 150; mode_h = 22;
mode_x = gfx_w - mode_w - 12; mode_y = 10;
mode_btn_w = mode_w / 3;

gr_m_w = 10; gr_m_x = gfx_w - 18; gr_m_y = graph_y; gr_m_h = graph_h;

// === FUNCTIONS ===
function section_header(ui_txt, ui_hx, ui_hy) (
    gfx_set(tsub_r, tsub_g, tsub_b, 1);
    gfx_setfont(1, "Arial", ui_f10, 'b');
    gfx_x = ui_hx; gfx_y = ui_hy; gfx_drawstr(ui_txt);
);

function hash01(ui_n) (
    ui_ht = sin(ui_n * 12.9898 + 78.233) * 43758.5453;
    ui_ht - floor(ui_ht);
);

function draw_knob(ui_kx, ui_ky, ui_kr, ui_kval, ui_kstr, ui_ksz, ui_klbl, ui_kid) (
    (hover_node == ui_kid || drag_mode == ui_kid) ? (
        gfx_set(acc_r, acc_g, acc_b, 0.28); gfx_circle(ui_kx, ui_ky, ui_kr + 5, 1);
    );
    gfx_set(knob_r, knob_g, knob_b, 1); gfx_circle(ui_kx, ui_ky, ui_kr, 1);
    gfx_set(0.30, 0.30, 0.32, 1); gfx_circle(ui_kx, ui_ky, ui_kr, 0);
    ui_sa = -2.356; ui_ea = 2.356;
    ui_ca = ui_sa + (ui_ea - ui_sa) * ui_kval;
    ui_nseg = 52; ui_kk = 0;
    loop(ui_nseg,
        ui_a = ui_sa + (ui_ea - ui_sa) * ui_kk / ui_nseg;
        ui_a <= ui_ca ? (
            ui_x1 = ui_kx + cos(ui_a) * (ui_kr - 3); ui_y1 = ui_ky + sin(ui_a) * (ui_kr - 3);
            ui_x2 = ui_kx + cos(ui_a) * (ui_kr + 2); ui_y2 = ui_ky + sin(ui_a) * (ui_kr + 2);
            gfx_set(wt_r, wt_g, wt_b, 1); gfx_line(ui_x1, ui_y1, ui_x2, ui_y2);
        );
        ui_kk += 1;
    );
    ui_ix = ui_kx + cos(ui_ca) * (ui_kr * 0.72);
    ui_iy = ui_ky + sin(ui_ca) * (ui_kr * 0.72);
    gfx_set(wt_r, wt_g, wt_b, 1); gfx_circle(ui_ix, ui_iy, 2.5, 1);
    gfx_set(wt_r, wt_g, wt_b, 1); gfx_setfont(1, "Arial", ui_ksz, 'b');
    gfx_measurestr(ui_kstr, ui_tw, ui_th);
    gfx_x = ui_kx - ui_tw/2; gfx_y = ui_ky - ui_th/2;
    gfx_drawstr(ui_kstr);
    gfx_set(tsub_r, tsub_g, tsub_b, 1); gfx_setfont(1, "Arial", ui_f10, 'b');
    gfx_measurestr(ui_klbl, ui_lw, ui_lh);
    gfx_x = ui_kx - ui_lw/2; gfx_y = ui_ky + ui_kr + 8;
    gfx_drawstr(ui_klbl);
);

function draw_hbar(ui_bx, ui_by, ui_bw, ui_bh, ui_bval, ui_blbl, ui_bstr, ui_bid, ui_br, ui_bg, ui_bb) (
    gfx_set(0.94, 0.94, 0.94, 0.85); gfx_rect(ui_bx, ui_by, ui_bw, ui_bh);
    gfx_set(ui_br, ui_bg, ui_bb, 0.85); gfx_rect(ui_bx, ui_by, ui_bw * ui_bval, ui_bh);
    (hover_node == ui_bid || drag_mode == ui_bid) ? (
        gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(ui_bx - 1, ui_by - 1, ui_bw + 2, ui_bh + 2, 0);
    ) : (
        gfx_set(0.70, 0.70, 0.72, 0.6); gfx_rect(ui_bx, ui_by, ui_bw, ui_bh, 0);
    );
    gfx_set(lbl_r, lbl_g, lbl_b, 1); gfx_setfont(1, "Arial", ui_f10, 'b');
    gfx_measurestr(ui_blbl, ui_lw, ui_lh);
    gfx_x = ui_bx + 6; gfx_y = ui_by + (ui_bh - ui_lh) / 2;
    gfx_drawstr(ui_blbl);
    gfx_measurestr(ui_bstr, ui_vw, ui_vh);
    gfx_x = ui_bx + ui_bw - ui_vw - 6; gfx_y = ui_by + (ui_bh - ui_vh) / 2;
    gfx_drawstr(ui_bstr);
);

function draw_toggle_btn(ui_tx, ui_ty, ui_tw, ui_th, ui_ttitle, ui_tstate, ui_tid, ui_tr, ui_tg, ui_tb) (
    hover_node == ui_tid ? gfx_set(0.88, 0.88, 0.90, 1) : gfx_set(0.93, 0.93, 0.95, 1);
    gfx_rect(ui_tx, ui_ty, ui_tw, ui_th);
    ui_tstate ? ( gfx_set(ui_tr, ui_tg, ui_tb, 0.80); gfx_rect(ui_tx, ui_ty, ui_tw, ui_th); );
    gfx_set(0.65, 0.65, 0.68, 1); gfx_rect(ui_tx, ui_ty, ui_tw, ui_th, 0);
    gfx_set(lbl_r, lbl_g, lbl_b, ui_tstate ? 1 : 0.85);
    gfx_setfont(1, "Arial", ui_f10, 'b');
    gfx_measurestr(ui_ttitle, ui_ttw, ui_tth);
    gfx_x = ui_tx + (ui_tw - ui_ttw)/2; gfx_y = ui_ty + (ui_th - ui_tth)/2;
    gfx_drawstr(ui_ttitle);
);

function draw_radio_btn(ui_rx, ui_ry, ui_rw, ui_rh, ui_rtitle, ui_rsel, ui_rid, ui_rr, ui_rg, ui_rb) (
    ui_rsel ? ( gfx_set(ui_rr, ui_rg, ui_rb, 0.85); gfx_rect(ui_rx, ui_ry, ui_rw, ui_rh); ) : (
        hover_node == ui_rid ? gfx_set(0.88, 0.88, 0.90, 1) : gfx_set(0.93, 0.93, 0.95, 1);
        gfx_rect(ui_rx, ui_ry, ui_rw, ui_rh);
    );
    gfx_set(0.65, 0.65, 0.68, 1); gfx_rect(ui_rx, ui_ry, ui_rw, ui_rh, 0);
    gfx_set(lbl_r, lbl_g, lbl_b, ui_rsel ? 1 : 0.85);
    gfx_setfont(1, "Arial", ui_f10, 'b');
    gfx_measurestr(ui_rtitle, ui_rtw, ui_rth);
    gfx_x = ui_rx + (ui_rw - ui_rtw)/2; gfx_y = ui_ry + (ui_rh - ui_rth)/2;
    gfx_drawstr(ui_rtitle);
);

function draw_tooltip2(ui_l1, ui_l2, ui_mx, ui_my) (
    gfx_setfont(1, "Arial", ui_f12, 'b');
    gfx_measurestr(ui_l1, ui_l1w, ui_l1h);
    gfx_setfont(1, "Arial", ui_f9, 'n');
    gfx_measurestr(ui_l2, ui_l2w, ui_l2h);
    ui_box_w = max(ui_l1w, ui_l2w);
    ui_box_h = ui_l1h + ui_l2h + 4;

    ui_tx = ui_mx + 16; ui_ty = ui_my + 16;
    ui_tx + ui_box_w + 12 > gfx_w ? ui_tx = gfx_w - ui_box_w - 14;
    ui_ty + ui_box_h + 8 > gfx_h ? ui_ty = ui_my - ui_box_h - 20;

    gfx_set(0, 0, 0, 0.92); gfx_rect(ui_tx - 6, ui_ty - 4, ui_box_w + 12, ui_box_h + 8);
    gfx_set(acc_r, acc_g, acc_b, 0.9); gfx_rect(ui_tx - 6, ui_ty - 4, 2, ui_box_h + 8);

    gfx_set(1, 1, 1, 1); gfx_setfont(1, "Arial", ui_f12, 'b');
    gfx_x = ui_tx; gfx_y = ui_ty;
    gfx_drawstr(ui_l1);

    gfx_set(0.85, 0.85, 0.85, 1); gfx_setfont(1, "Arial", ui_f9, 'n');
    gfx_x = ui_tx; gfx_y = ui_ty + ui_l1h + 2;
    gfx_drawstr(ui_l2);
);

// === MOUSE ===
mouse_down = mouse_cap & 1;
mouse_r_down = mouse_cap & 2;
mouse_shift = mouse_cap & 8;
mouse_ctrl = mouse_cap & 4;
mouse_click = mouse_down && !last_mouse_cap;
mouse_dbl_click = mouse_click && (time_precise() - last_click_time < 0.25);
mouse_click ? last_click_time = time_precise();
hover_node = -1;
mx = mouse_x; my = mouse_y;

wheel_dir = 0;
mouse_wheel > last_mw ? wheel_dir = 1;
mouse_wheel < last_mw ? wheel_dir = -1;
last_mw = mouse_wheel;

hit_node_idx = -1;
drag_mode == 0 && slider17 == 1 ? (
    nod_hit_n = 0;
    loop(max_nodes,
        nod_hit_nf = mem[offset_node_f + nod_hit_n];
        nod_hit_ng = mem[offset_node_g + nod_hit_n];
