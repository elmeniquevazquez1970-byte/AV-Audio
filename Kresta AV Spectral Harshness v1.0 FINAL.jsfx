desc: Kresta AV - Multiband Spectral Harshness Control —- AV Audio - Author Adrian Vazquez
// version: 1.0 (node freq sliders extended to 48k for high sample rates)

// --- Sliders originales ---
slider1:2000<20,15000,10>-Frequency Min (Hz)
slider2:18000<40,22000,10>-Frequency Max (Hz)
slider3:-20<-60,0,0.1>-Threshold (dB)
slider4:100<0,100,1>-Amount (%)
slider5:300<10,1000,1>-Release (ms)
slider6:0<-1,1,0.01>-Tilt (Spectral Slope)
slider7:0<-24,24,0.1>-Output Gain (dB)
slider8:0<0,1,1{Off,On}>-Delta Listen
slider9:0<0,1,1{Off,On}>-Bypass
slider10:2<0,3,1{1024,2048,4096,8192}>-FFT Size
slider11:0<0,100,1>-Focus (%)
slider12:0<0,2,1{Stereo,Mid,Side}>-Processing Mode
slider13:0<0,1,1{Off,On}>-Solo Band
slider14:0<0,5,1{Beige,Black,Red,Green,White,Blue}>-Theme
slider15:0<0,100,1>-Punch (%)
slider16:0<0,100,1>-SC Unmask (%)
slider17:0<0,1,1{Off,On}>-Nodal Curve
slider18:2<0.5,8,0.1>-Node Q
slider19:0<0,100,1>-Auto-Makeup (%)
slider20:20<20,500,5>-SC HPF (Hz)
slider21:0<0,1,1{Off,On}>-Multiband Mode
slider22:250<40,15000,10>-Crossover 1 (Hz)
slider23:1200<100,18000,10>-Crossover 2 (Hz)
slider24:5000<500,22000,10>-Crossover 3 (Hz)
slider25:100<0,100,1>-Amount LOW (%)
slider26:100<0,100,1>-Amount LO-MID (%)
slider27:100<0,100,1>-Amount HI-MID (%)
slider28:100<0,100,1>-Amount HIGH (%)
slider29:1<0,1,1{Off,On}>-Enable LOW
slider30:1<0,1,1{Off,On}>-Enable LO-MID
slider31:1<0,1,1{Off,On}>-Enable HI-MID
slider32:1<0,1,1{Off,On}>-Enable HIGH
slider33:0<0,50,0.5>-Attack (ms)
slider34:100<0,100,1>-Mix Dry/Wet (%)
slider35:0<0,1,1{Off,On}>-SC Listen
slider36:0<0,100,1>-Auto-Threshold (%)
slider37:0<0,12,0.1>-Soft Knee (dB)
slider38:1<0.5,4,0.05>-Slope
slider39:0<0,100,1>-Reduction Smooth (%)
slider40:40<3,60,1>-Max Reduction (dB)
// --- Nodal persistence (hidden sliders) ---
slider41:400<20,48000,1>-Node 1 Freq
slider42:1000<20,48000,1>-Node 2 Freq
slider43:2500<20,48000,1>-Node 3 Freq
slider44:5000<20,48000,1>-Node 4 Freq
slider45:10000<20,48000,1>-Node 5 Freq
slider46:0<-12,0,0.1>-Node 1 Gain
slider47:0<-12,0,0.1>-Node 2 Gain
slider48:0<-12,0,0.1>-Node 3 Gain
slider49:0<-12,0,0.1>-Node 4 Gain
slider50:0<-12,0,0.1>-Node 5 Gain

in_pin:left input
in_pin:right input
in_pin:sidechain L
in_pin:sidechain R
out_pin:left output
out_pin:right output

@init
ext_nodenorm = 1;

idx_in = 0;
buf_len = 65536;
display_gr = 0;

offset_in_l       = 0;
offset_in_r       = buf_len;
offset_out_l      = buf_len * 2;
offset_out_r      = buf_len * 3;
offset_win        = buf_len * 4;
offset_pink       = buf_len * 5;
offset_fft        = buf_len * 6;
offset_gain_mem_l = buf_len * 7;
offset_gain_mem_r = buf_len * 8;
offset_vis_gain   = buf_len * 9;
offset_sc_in      = buf_len * 10;
offset_sc_fft     = buf_len * 11;
offset_sc_mag     = buf_len * 12;
offset_node_f     = buf_len * 13;
offset_node_g     = buf_len * 13 + 8;
offset_sm_gain    = buf_len * 14;
max_nodes = 5;

i = 0;
loop(4096,
    mem[offset_gain_mem_l + i] = 1.0;
    mem[offset_gain_mem_r + i] = 1.0;
    mem[offset_vis_gain + i]   = 1.0;
    mem[offset_sm_gain + i]    = 1.0;
    i += 1;
);

i = 0;
loop(8192,
    mem[offset_sc_in + i]  = 0;
    mem[offset_sc_fft + i] = 0;
    mem[offset_sc_mag + i] = 0;
    i += 1;
);

// Node values are now persisted via sliders 41-50 and synced in @block.
// Initial mem[] is set from sliders on the first @block call.

pk_fast = 0; pk_slow = 0; pk_scale = 0;
sc_hpf_lp = 0;
am_avg_gr = 0; am_gain = 1.0;
lt_rms = 0;
at_offset_db = 0;

function init_window_config() (
    slider10 == 0 ? fft_size = 1024 :
    slider10 == 1 ? fft_size = 2048 :
    slider10 == 2 ? fft_size = 4096 : fft_size = 8192;
    fft_size_halved = fft_size * 0.5;
    overlap = 4;
    hop_size = fft_size / overlap;
    norm_factor = 1.0 / fft_size;
    window_correction = 2.0 / 3.0;
    pdc_delay = fft_size; pdc_bot_ch = 0; pdc_top_ch = 2;
    i = 0; loop(fft_size,
        mem[offset_win + i] = 0.5 * (1 - cos(2 * $pi * i / fft_size));
        i += 1;
    );
    i = 0; loop(fft_size_halved,
        mem[offset_vis_gain + i] = 1.0;
        mem[offset_sm_gain + i]  = 1.0;
        i += 1;
    );
);

function calc_params() (
    bin_hz = srate / fft_size;
    start_bin = floor(slider1 / bin_hz);
    start_bin = max(1, min(start_bin, fft_size_halved - 1));
    end_bin = floor(slider2 / bin_hz);
    end_bin = max(start_bin + 1, min(end_bin, fft_size_halved));

    thresh_lin  = pow(10, (slider3 + at_offset_db) / 20);
    amount      = slider4 / 100.0;
    rel_coeff   = exp(-1.0 / (slider5 * srate * 0.001 / hop_size));
    out_gain    = pow(10, slider7 / 20);

    slider33 > 0.01 ? (
        att_coeff = exp(-1.0 / (slider33 * srate * 0.001 / hop_size));
    ) : ( att_coeff = 0; );

    base_exponent = 0.5;
    tilt_mod = slider6 * 0.2;
    final_exponent = base_exponent - tilt_mod;
    log_min_f = log(slider1);
    log_max_f = log(slider2);
    log_range = log_max_f - log_min_f;
    focus_amt = slider11 / 100.0;
    max_dip_db = 24.0;

    pk_fast_rel = exp(-1.0 / (srate * 0.025));
    pk_slow_att = 1.0 - exp(-1.0 / (srate * 0.150));
    pk_amt      = slider15 / 100.0;

    scm_smooth = exp(-hop_size / (srate * 0.05));
    scm_amt    = slider16 / 100.0;
    nod_q = slider18;

    sc_hpf_coeff = 1.0 - exp(-2.0 * $pi * slider20 / srate);
    am_coeff = 1.0 - exp(-hop_size / (srate * 0.3));

    mx_wet = slider34 / 100.0;
    mx_dry = 1.0 - mx_wet;
    aut_amt = slider36 / 100.0;
    lt_coeff = 1.0 - exp(-hop_size / (srate * 2.0));

    c1_bin = floor(slider22 / bin_hz);
    c1_bin = max(start_bin, min(c1_bin, end_bin - 2));
    c2_bin = floor(slider23 / bin_hz);
    c2_bin = max(c1_bin + 1, min(c2_bin, end_bin - 1));
    c3_bin = floor(slider24 / bin_hz);
    c3_bin = max(c2_bin + 1, min(c3_bin, end_bin));

    z_low_amt   = slider29 == 1 ? slider25 / 100.0 : 0;
    z_lomid_amt = slider30 == 1 ? slider26 / 100.0 : 0;
    z_himid_amt = slider31 == 1 ? slider27 / 100.0 : 0;
    z_high_amt  = slider32 == 1 ? slider28 / 100.0 : 0;

    knee_db_eff = slider37;
    knee_lin_eff = pow(10, slider37 / 20);
    slope_eff = slider38;
    slope_active = abs(slider38 - 1.0) > 0.01;
    slider39 > 0.01 ? (
        sm_smooth = exp(-1.0 / (slider39 * srate * 0.001 / hop_size));
    ) : ( sm_smooth = 0 );
    max_red_lin = pow(10, -slider40 / 20);

    i = 0;
    loop(fft_size_halved,
        val = 0;
        i > 0 ? (
            val = 1.0 / pow(i, final_exponent);
            bin_f = i * bin_hz;
            bin_f >= slider1 && bin_f <= slider2 && log_range > 0 && slider11 > 0 ? (
                p = (log(bin_f) - log_min_f) / log_range;
                dip_shape = sin(p * $pi);
                dip_db = -(focus_amt * max_dip_db) * dip_shape;
                val *= pow(10, dip_db / 20);
            );
        );
        mem[offset_pink + i] = val;
        i += 1;
    );
);

init_window_config();
calc_params();
last_srate = srate;

@slider
target_fft_idx = slider10;
curr_fft_size = (target_fft_idx == 0 ? 1024 : target_fft_idx == 1 ? 2048 : target_fft_idx == 2 ? 4096 : 8192);
curr_fft_size != fft_size ? init_window_config();
calc_params();

@block
srate != last_srate ? (
    last_srate = srate;
    calc_params();
);
update_dsp ? (
    calc_params();
    update_dsp = 0;
);

// Sync node sliders -> mem (persistence across reloads and play)
mem[offset_node_f + 0] = slider41;
mem[offset_node_f + 1] = slider42;
mem[offset_node_f + 2] = slider43;
mem[offset_node_f + 3] = slider44;
mem[offset_node_f + 4] = slider45;
mem[offset_node_g + 0] = slider46;
mem[offset_node_g + 1] = slider47;
mem[offset_node_g + 2] = slider48;
mem[offset_node_g + 3] = slider49;
mem[offset_node_g + 4] = slider50;

@sample
mem[offset_in_l + idx_in] = spl0;
mem[offset_in_r + idx_in] = spl1;

sc_in_raw = (spl2 + spl3) * 0.5;
sc_hpf_lp = sc_hpf_lp + (sc_in_raw - sc_hpf_lp) * sc_hpf_coeff;
mem[offset_sc_in + idx_in] = sc_in_raw - sc_hpf_lp;

pk_inst = spl0*spl0 + spl1*spl1;
pk_fast = pk_inst > pk_fast ? pk_inst : pk_fast * pk_fast_rel;
pk_slow = pk_slow + (pk_inst - pk_slow) * pk_slow_att;

pk_scale = 0;
slider15 > 0 ? (
    pk_slow > 0.0001 ? (
        pk_ratio = pk_fast / pk_slow;
        pk_ratio > 1.0 ? (
            pk_norm = min(4.0, pk_ratio);
            pk_s = ((pk_norm - 1.0) / 3.0) * pk_amt;
            pk_s > 0.85 ? pk_s = 0.85;
            pk_scale = pk_s;
        );
    );
);

(idx_in % hop_size) == 0 ? (
    i = 0;
    loop(fft_size_halved,
        mem[offset_vis_gain + i] = 1.0;
        i += 1;
    );

    read_pos = (idx_in - fft_size + buf_len) % buf_len;

    slider36 > 0 ? (
        dry_inst = mem[offset_in_l + read_pos] * mem[offset_in_l + read_pos]
                 + mem[offset_in_r + read_pos] * mem[offset_in_r + read_pos];
        lt_rms = lt_rms + (dry_inst - lt_rms) * lt_coeff;
        lt_db = lt_rms > 0.0000000001 ? 10 * log10(lt_rms) : -60;
        at_offset_db = (lt_db - (-20)) * aut_amt;
        at_offset_db = max(-40, min(at_offset_db, 20));
    ) : ( at_offset_db = 0; );

    thresh_lin = pow(10, (slider3 + at_offset_db) / 20);

    scm_active = 0;
    slider16 > 0 ? (
        i = 0;
        loop(fft_size,
            idx_circ = (read_pos + i) % buf_len;
            mem[offset_sc_fft + i*2]     = mem[offset_sc_in + idx_circ] * mem[offset_win + i];
            mem[offset_sc_fft + i*2 + 1] = 0;
            i += 1;
        );
        fft(offset_sc_fft, fft_size);
        fft_permute(offset_sc_fft, fft_size);
        scm_max = 0;
        i = 0;
        loop(fft_size_halved,
            scm_r = i*2; scm_c = scm_r+1;
            scm_m = sqrt(sqr(mem[offset_sc_fft + scm_r]) + sqr(mem[offset_sc_fft + scm_c]));
            scm_sm = mem[offset_sc_mag + i] + (scm_m - mem[offset_sc_mag + i]) * scm_smooth;
            mem[offset_sc_mag + i] = scm_sm;
            scm_sm > scm_max ? scm_max = scm_sm;
            i += 1;
        );
        scm_max > 1.0 ? scm_active = 1;
        scm_max < 0.0000000001 ? scm_max = 0.0000000001;
    );

    punch_mult = 1.0 - pk_scale;
    em_amount = amount * punch_mult;
    em_low    = z_low_amt   * punch_mult;
    em_lomid  = z_lomid_amt * punch_mult;
    em_himid  = z_himid_amt * punch_mult;
    em_high   = z_high_amt  * punch_mult;

    // CH 1
    i = 0;
    loop(fft_size,
        idx_circ = (read_pos + i) % buf_len;
        slider12 == 0 ? (
            in_samp = mem[offset_in_l + idx_circ];
        ) : (
            in_samp = (mem[offset_in_l + idx_circ] + mem[offset_in_r + idx_circ]) * 0.5;
        );
        mem[offset_fft + i*2] = in_samp * mem[offset_win + i];
        mem[offset_fft + i*2 + 1] = 0;
        i += 1;
    );
    fft(offset_fft, fft_size);
    fft_permute(offset_fft, fft_size);
    block_min_gain = 1.0;

    slider12 != 2 ? (
        i = start_bin;
        loop_count = end_bin - start_bin;
        loop(loop_count,
            r = i*2; c = r+1;
            mag = sqrt(sqr(mem[offset_fft + r]) + sqr(mem[offset_fft + c]));
            target = mem[offset_pink + i] * thresh_lin * fft_size_halved;

            zone_am = em_amount;
            slider21 == 1 ? (
                i < c1_bin ? zone_am = em_low :
                i < c2_bin ? zone_am = em_lomid :
                i < c3_bin ? zone_am = em_himid : zone_am = em_high;
            );

            knee_f = 1.0;
            slider37 > 0.01 ? (
                excess = mag / max(0.0000001, target);
                excess > knee_lin_eff ? (
                    knee_f = 1.0;
                ) : (
                    knee_f = (excess - 1.0) / max(0.0001, knee_lin_eff - 1.0);
                    knee_f < 0 ? knee_f = 0;
                    knee_f = knee_f * knee_f;
                );
            );

            gain_target = 1.0;
            (mag > target && mag > 0.0000001) ? (
                diff = target / mag;
                red_amt = 1.0 - diff;
                slope_active ? (
                    red_amt = pow(red_amt, slope_eff);
                );
                gain_target = 1.0 - red_amt * zone_am * knee_f;
            );

            scm_active ? (
                scm_norm = mem[offset_sc_mag + i] / scm_max;
                scm_duck = scm_norm * scm_norm * scm_amt * 0.9;
                gain_target *= (1.0 - scm_duck);
            );

            slider17 == 1 ? (
                nod_freq = i * bin_hz;
                nod_db = 0;
                nod_n = 0;
                loop(max_nodes,
                    nod_nf = mem[offset_node_f + nod_n];
                    nod_ng = mem[offset_node_g + nod_n];
                    nod_nf > 0 ? (
                        nod_ld = log(nod_freq / nod_nf) * nod_q;
                        nod_db += nod_ng * exp(-0.5 * nod_ld * nod_ld);
                    );
                    nod_n += 1;
                );
                nod_db < 0 ? ( gain_target *= pow(10, nod_db / 20); );
            );

            last_gain = mem[offset_gain_mem_l + i];
            gain_target < last_gain ? (
                slider33 > 0.01 ? (
                    current_gain = gain_target + (last_gain - gain_target) * att_coeff;
                ) : (
                    current_gain = gain_target;
                );
            ) : (
                current_gain = gain_target + (last_gain - gain_target) * rel_coeff;
            );
            mem[offset_gain_mem_l + i] = current_gain;

            ap_gain = current_gain;
            slider39 > 0.01 ? (
                sm_prev = mem[offset_sm_gain + i];
                sm_new = sm_prev + (current_gain - sm_prev) * sm_smooth;
                mem[offset_sm_gain + i] = sm_new;
                ap_gain = sm_new;
            );
            ap_gain < max_red_lin ? ap_gain = max_red_lin;

            slider12 == 1 || slider12 == 0 ? mem[offset_vis_gain + i] = ap_gain;
            ap_gain < block_min_gain ? block_min_gain = ap_gain;

            mem[offset_fft + r] *= ap_gain;
            mem[offset_fft + c] *= ap_gain;
            neg_r = (fft_size - i) * 2;
            mem[offset_fft + neg_r]     *= ap_gain;
            mem[offset_fft + neg_r + 1] *= ap_gain;
            i += 1;
        );
    ) : (
        i = start_bin; loop_count = end_bin - start_bin;
        loop(loop_count, mem[offset_gain_mem_l + i] = 1.0; i += 1;);
    );

    slider13 == 1 ? (
        i = 1; low_count = max(0, start_bin - 1);
        loop(low_count,
            mem[offset_fft + i*2] = 0; mem[offset_fft + i*2 + 1] = 0;
            neg_r = (fft_size - i) * 2; mem[offset_fft + neg_r] = 0; mem[offset_fft + neg_r + 1] = 0;
            i += 1;
        );
        mem[offset_fft] = 0; mem[offset_fft + 1] = 0;
        i = end_bin + 1; up_count = max(0, fft_size_halved - end_bin - 1);
        loop(up_count,
            mem[offset_fft + i*2] = 0; mem[offset_fft + i*2 + 1] = 0;
            neg_r = (fft_size - i) * 2; mem[offset_fft + neg_r] = 0; mem[offset_fft + neg_r + 1] = 0;
            i += 1;
        );
        mem[offset_fft + fft_size_halved*2] = 0; mem[offset_fft + fft_size_halved*2 + 1] = 0;
    );

    fft_ipermute(offset_fft, fft_size);
    ifft(offset_fft, fft_size);

    i = 0;
    loop(fft_size,
        val_norm = mem[offset_fft + i*2] * norm_factor;
        out_val = val_norm * mem[offset_win + i] * window_correction;
        idx_circ = (read_pos + i) % buf_len;
        mem[offset_out_l + idx_circ] += out_val;
        i += 1;
    );

    // CH 2
    i = 0;
    loop(fft_size,
        idx_circ = (read_pos + i) % buf_len;
        slider12 == 0 ? (
            in_samp = mem[offset_in_r + idx_circ];
        ) : (
            in_samp = (mem[offset_in_l + idx_circ] - mem[offset_in_r + idx_circ]) * 0.5;
        );
        mem[offset_fft + i*2] = in_samp * mem[offset_win + i];
        mem[offset_fft + i*2 + 1] = 0;
        i += 1;
    );
    fft(offset_fft, fft_size);
    fft_permute(offset_fft, fft_size);

    slider12 != 1 ? (
        i = start_bin;
        loop_count = end_bin - start_bin;
        loop(loop_count,
            r = i*2; c = r+1;
            mag = sqrt(sqr(mem[offset_fft + r]) + sqr(mem[offset_fft + c]));
            target = mem[offset_pink + i] * thresh_lin * fft_size_halved;

            zone_am = em_amount;
            slider21 == 1 ? (
                i < c1_bin ? zone_am = em_low :
                i < c2_bin ? zone_am = em_lomid :
                i < c3_bin ? zone_am = em_himid : zone_am = em_high;
            );

            knee_f = 1.0;
            slider37 > 0.01 ? (
                excess = mag / max(0.0000001, target);
                excess > knee_lin_eff ? (
                    knee_f = 1.0;
                ) : (
                    knee_f = (excess - 1.0) / max(0.0001, knee_lin_eff - 1.0);
                    knee_f < 0 ? knee_f = 0;
                    knee_f = knee_f * knee_f;
                );
            );

            gain_target = 1.0;
            (mag > target && mag > 0.0000001) ? (
                diff = target / mag;
                red_amt = 1.0 - diff;
                slope_active ? (
                    red_amt = pow(red_amt, slope_eff);
                );
                gain_target = 1.0 - red_amt * zone_am * knee_f;
            );

            scm_active ? (
                scm_norm = mem[offset_sc_mag + i] / scm_max;
                scm_duck = scm_norm * scm_norm * scm_amt * 0.9;
                gain_target *= (1.0 - scm_duck);
            );

            slider17 == 1 ? (
                nod_freq = i * bin_hz;
                nod_db = 0;
                nod_n = 0;
                loop(max_nodes,
                    nod_nf = mem[offset_node_f + nod_n];
                    nod_ng = mem[offset_node_g + nod_n];
                    nod_nf > 0 ? (
                        nod_ld = log(nod_freq / nod_nf) * nod_q;
                        nod_db += nod_ng * exp(-0.5 * nod_ld * nod_ld);
                    );
                    nod_n += 1;
                );
                nod_db < 0 ? ( gain_target *= pow(10, nod_db / 20); );
            );

            last_gain = mem[offset_gain_mem_r + i];
            gain_target < last_gain ? (
                slider33 > 0.01 ? (
                    current_gain = gain_target + (last_gain - gain_target) * att_coeff;
                ) : (
                    current_gain = gain_target;
                );
            ) : (
                current_gain = gain_target + (last_gain - gain_target) * rel_coeff;
            );
            mem[offset_gain_mem_r + i] = current_gain;

            ap_gain = current_gain;
            slider39 > 0.01 ? (
                sm_prev = mem[offset_sm_gain + i];
                sm_new = sm_prev + (current_gain - sm_prev) * sm_smooth;
                mem[offset_sm_gain + i] = sm_new;
                ap_gain = sm_new;
            );
            ap_gain < max_red_lin ? ap_gain = max_red_lin;

            slider12 == 2 ? mem[offset_vis_gain + i] = ap_gain;
            ap_gain < block_min_gain ? block_min_gain = ap_gain;

            mem[offset_fft + r] *= ap_gain;
            mem[offset_fft + c] *= ap_gain;
            neg_r = (fft_size - i) * 2;
            mem[offset_fft + neg_r]     *= ap_gain;
            mem[offset_fft + neg_r + 1] *= ap_gain;
            i += 1;
        );
    ) : (
        i = start_bin; loop_count = end_bin - start_bin;
        loop(loop_count, mem[offset_gain_mem_r + i] = 1.0; i += 1;);
    );

    slider13 == 1 ? (
        i = 1; low_count = max(0, start_bin - 1);
        loop(low_count,
            mem[offset_fft + i*2] = 0; mem[offset_fft + i*2 + 1] = 0;
            neg_r = (fft_size - i) * 2; mem[offset_fft + neg_r] = 0; mem[offset_fft + neg_r + 1] = 0;
            i += 1;
        );
        mem[offset_fft] = 0; mem[offset_fft + 1] = 0;
        i = end_bin + 1; up_count = max(0, fft_size_halved - end_bin - 1);
        loop(up_count,
            mem[offset_fft + i*2] = 0; mem[offset_fft + i*2 + 1] = 0;
            neg_r = (fft_size - i) * 2; mem[offset_fft + neg_r] = 0; mem[offset_fft + neg_r + 1] = 0;
            i += 1;
        );
        mem[offset_fft + fft_size_halved*2] = 0; mem[offset_fft + fft_size_halved*2 + 1] = 0;
    );

    fft_ipermute(offset_fft, fft_size);
    ifft(offset_fft, fft_size);

    i = 0;
    loop(fft_size,
        val_norm = mem[offset_fft + i*2] * norm_factor;
        out_val = val_norm * mem[offset_win + i] * window_correction;
        idx_circ = (read_pos + i) % buf_len;
        mem[offset_out_r + idx_circ] += out_val;
        i += 1;
    );

    gr_db = block_min_gain < 1.0 ? 20 * log10(block_min_gain) : 0;
    gr_db < display_gr ? ( display_gr = gr_db; ) : ( display_gr = display_gr + (0 - display_gr) * 0.15; );

    slider19 > 0 ? (
        am_avg_gr = am_avg_gr + (display_gr - am_avg_gr) * am_coeff;
        am_gain_db = -am_avg_gr * (slider19 / 100.0);
        am_gain = pow(10, am_gain_db / 20);
    ) : ( am_gain = 1.0; );
);

read_idx_out = (idx_in - fft_size + buf_len) % buf_len;

slider12 == 0 ? (
    out_l = mem[offset_out_l + read_idx_out];
    out_r = mem[offset_out_r + read_idx_out];
) : (
    m = mem[offset_out_l + read_idx_out];
    s = mem[offset_out_r + read_idx_out];
    out_l = m + s; out_r = m - s;
);

dry_l = mem[offset_in_l + read_idx_out];
dry_r = mem[offset_in_r + read_idx_out];
mem[offset_out_l + read_idx_out] = 0;
mem[offset_out_r + read_idx_out] = 0;
idx_in = (idx_in + 1) % buf_len;

slider34 < 99.99 ? (
    out_l = dry_l * mx_dry + out_l * mx_wet;
    out_r = dry_r * mx_dry + out_r * mx_wet;
);

slider8 == 1 ? ( out_l = dry_l - out_l; out_r = dry_r - out_r; );
out_l *= out_gain * am_gain;
out_r *= out_gain * am_gain;
slider9 == 1 ? ( out_l = dry_l; out_r = dry_r; );

slider35 == 1 ? (
    sc_delay_l = mem[offset_sc_in + read_idx_out];
    out_l = sc_delay_l * out_gain;
    out_r = sc_delay_l * out_gain;
);

// === NaN/Inf GUARD ===
out_l = (out_l == out_l && abs(out_l) < 100) ? out_l : 0;
out_r = (out_r == out_r && abs(out_r) < 100) ? out_r : 0;

spl0 = out_l;
spl1 = out_r;

@gfx 900 660

// === FONT SCALE ===
ui_scale = min(gfx_w / 900, gfx_h / 660);
ui_scale < 0.75 ? ui_scale = 0.75;
ui_scale > 1.40 ? ui_scale = 1.40;
ui_scale *= 1.15;

ui_f8  = floor(9  * ui_scale);
ui_f9  = floor(10 * ui_scale);
ui_f10 = floor(12 * ui_scale);
ui_f11 = floor(13 * ui_scale);
ui_f12 = floor(14 * ui_scale);
ui_f13 = floor(15 * ui_scale);
ui_f15 = floor(17 * ui_scale);
ui_f18 = floor(20 * ui_scale);
ui_f20 = floor(22 * ui_scale);

lbl_r = 0.12; lbl_g = 0.12; lbl_b = 0.15;

// === THEMES ===
grain_amt = 0.08;
slider14 == 0 ? (
    bg_r=0.84; bg_g=0.80; bg_b=0.72; panel_r=0.88; panel_g=0.84; panel_b=0.76;
    gbg_r=0.78; gbg_g=0.74; gbg_b=0.66; grid_r=0.62; grid_g=0.58; grid_b=0.50;
    txt_r=0.22; txt_g=0.18; txt_b=0.13; tsub_r=0.30; tsub_g=0.24; tsub_b=0.18;
    knob_r=0.24; knob_g=0.20; knob_b=0.16; wt_r=0.98; wt_g=0.96; wt_b=0.92;
    acc_r=0.60; acc_g=0.35; acc_b=0.20; org_r=0.85; org_g=0.45; org_b=0.15;
    purp_r=0.55; purp_g=0.32; purp_b=0.55; yel_r=0.85; yel_g=0.70; yel_b=0.20;
    grn_r=0.35; grn_g=0.60; grn_b=0.32; red_r=0.75; red_g=0.22; red_b=0.18;
    punch_r=0.80; punch_g=0.35; punch_b=0.40; grain_amt=0.10;
) : slider14 == 1 ? (
    bg_r=0.10; bg_g=0.10; bg_b=0.11; panel_r=0.14; panel_g=0.14; panel_b=0.15;
    gbg_r=0.07; gbg_g=0.07; gbg_b=0.09; grid_r=0.26; grid_g=0.26; grid_b=0.29;
    txt_r=0.90; txt_g=0.88; txt_b=0.85; tsub_r=0.55; tsub_g=0.53; tsub_b=0.50;
    knob_r=0.18; knob_g=0.18; knob_b=0.20; wt_r=0.95; wt_g=0.94; wt_b=0.92;
    acc_r=0.95; acc_g=0.55; acc_b=0.28; org_r=0.95; org_g=0.55; org_b=0.28;
    purp_r=0.70; purp_g=0.42; purp_b=0.85; yel_r=0.95; yel_g=0.80; yel_b=0.30;
    grn_r=0.35; grn_g=0.75; grn_b=0.42; red_r=0.90; red_g=0.30; red_b=0.28;
    punch_r=0.95; punch_g=0.45; punch_b=0.55; grain_amt=0.06;
) : slider14 == 2 ? (
    bg_r=0.42; bg_g=0.17; bg_b=0.16; panel_r=0.48; panel_g=0.21; panel_b=0.20;
    gbg_r=0.34; gbg_g=0.12; gbg_b=0.12; grid_r=0.58; grid_g=0.30; grid_b=0.28;
    txt_r=0.95; txt_g=0.88; txt_b=0.82; tsub_r=0.78; tsub_g=0.60; tsub_b=0.55;
    knob_r=0.18; knob_g=0.07; knob_b=0.07; wt_r=0.98; wt_g=0.94; wt_b=0.88;
    acc_r=0.98; acc_g=0.78; acc_b=0.55; org_r=0.98; org_g=0.70; org_b=0.35;
    purp_r=0.80; purp_g=0.50; purp_b=0.75; yel_r=0.98; yel_g=0.85; yel_b=0.45;
    grn_r=0.55; grn_g=0.80; grn_b=0.50; red_r=0.98; red_g=0.42; red_b=0.35;
    punch_r=0.98; punch_g=0.55; punch_b=0.55; grain_amt=0.12;
) : slider14 == 3 ? (
    bg_r=0.24; bg_g=0.32; bg_b=0.22; panel_r=0.28; panel_g=0.37; panel_b=0.26;
    gbg_r=0.18; gbg_g=0.26; gbg_b=0.17; grid_r=0.40; grid_g=0.52; grid_b=0.38;
    txt_r=0.90; txt_g=0.94; txt_b=0.84; tsub_r=0.62; tsub_g=0.72; tsub_b=0.58;
    knob_r=0.10; knob_g=0.18; knob_b=0.10; wt_r=0.95; wt_g=0.98; wt_b=0.90;
    acc_r=0.75; acc_g=0.90; acc_b=0.55; org_r=0.92; org_g=0.70; org_b=0.35;
    purp_r=0.70; purp_g=0.55; purp_b=0.80; yel_r=0.95; yel_g=0.88; yel_b=0.40;
    grn_r=0.60; grn_g=0.92; grn_b=0.55; red_r=0.85; red_g=0.35; red_b=0.30;
    punch_r=0.90; punch_g=0.55; punch_b=0.55; grain_amt=0.10;
) : slider14 == 4 ? (
