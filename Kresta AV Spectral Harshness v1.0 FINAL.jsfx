grain_count = 220;
grain_i = 0;
loop(grain_count,
    _gx = floor(hash01(grain_i) * gfx_w);
    _gy = floor(hash01(grain_i + 500) * gfx_h);
    _gv = hash01(grain_i + 1000);
    _gv > 0.5 ? ( gfx_set(1, 1, 1, grain_amt * (_gv - 0.5) * 2); ) :
    ( gfx_set(0, 0, 0, grain_amt * (0.5 - _gv) * 2); );
    gfx_rect(_gx, _gy, 1, 1);
    grain_i += 1;
);
