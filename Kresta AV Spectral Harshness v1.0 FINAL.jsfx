    ui_c2x_d > g_x_int && ui_c2x_d < g_x_int + g_w_int ? (
        (hover_node == 115 || drag_mode == 15) ? gfx_set(1.0, 0.9, 0.25, 1) : gfx_set(0.9, 0.75, 0.15, 0.75);
        gfx_rect(ui_c2x_d - 1, g_y_int, 2, g_h_int);
        gfx_set(1.0, 0.9, 0.25, 1); gfx_circle(ui_c2x_d, g_y_int + 10, 6, 1);
        gfx_set(0,0,0,1); gfx_circle(ui_c2x_d, g_y_int + 10, 6, 0);
        gfx_set(1.0, 0.9, 0.25, 1); gfx_circle(ui_c2x_d, g_y_int + 10, 3, 1);
        sprintf(#c2s, "%.0f", slider23);
        gfx_set(1, 1, 1, 0.9); gfx_setfont(2, "Arial", ui_f9, 'b');
        gfx_measurestr(#c2s, tw, th);
        gfx_x = ui_c2x_d - tw/2; gfx_y = g_y_int + 20;
        gfx_drawstr(#c2s);
    );
    ui_c3x_d = g_x_int + (log(slider24) - log_min_int) * scale_x_int;
    ui_c3x_d > g_x_int && ui_c3x_d < g_x_int + g_w_int ? (
        (hover_node == 116 || drag_mode == 16) ? gfx_set(1.0, 0.9, 0.25, 1) : gfx_set(0.9, 0.75, 0.15, 0.75);
        gfx_rect(ui_c3x_d - 1, g_y_int, 2, g_h_int);
        gfx_set(1.0, 0.9, 0.25, 1); gfx_circle(ui_c3x_d, g_y_int + 10, 6, 1);
        gfx_set(0,0,0,1); gfx_circle(ui_c3x_d, g_y_int + 10, 6, 0);
        gfx_set(1.0, 0.9, 0.25, 1); gfx_circle(ui_c3x_d, g_y_int + 10, 3, 1);
        sprintf(#c3s, "%.0f", slider24);
        gfx_set(1, 1, 1, 0.9); gfx_setfont(2, "Arial", ui_f9, 'b');
        gfx_measurestr(#c3s, tw, th);
        gfx_x = ui_c3x_d - tw/2; gfx_y = g_y_int + 20;
        gfx_drawstr(#c3s);
    );
);

x_min_draw = g_x_int + (log(slider1) - log_min_int) * scale_x_int;
gfx_set(acc_r, acc_g, acc_b, (hover_node == 101 || drag_mode == 1) ? 1.0 : 0.6);
gfx_rect(x_min_draw - 1, g_y_int, 2, g_h_int);
x_max_draw = g_x_int + (log(slider2) - log_min_int) * scale_x_int;
gfx_set(acc_r, acc_g, acc_b, (hover_node == 102 || drag_mode == 2) ? 1.0 : 0.6);
gfx_rect(x_max_draw - 1, g_y_int, 2, g_h_int);

y_thresh_base = g_y_int + (-(slider3 + at_offset_db) / max_db_display) * g_h_int;
y_thresh_base < g_y_int ? y_thresh_base = g_y_int;
y_thresh_base > g_y_int + g_h_int ? y_thresh_base = g_y_int + g_h_int;
gfx_set(org_r, org_g, org_b, (hover_node == 103 || drag_mode == 3) ? 0.95 : 0.6);
ix = 0;
log_range_vis = log(slider2) - log(slider1);
loop(g_w_int,
    x_pos = g_x_int + ix;
    freq = exp((ix / scale_x_int) + log_min_int);
    y_pos = y_thresh_base;
    freq >= slider1 && freq <= slider2 && slider11 > 0 && log_range_vis > 0 ? (
        p = (log(freq) - log(slider1)) / log_range_vis;
        dip_shape = sin(p * $pi);
        dip_db = (slider11 / 100.0) * 24.0 * dip_shape;
        y_pos += (dip_db / max_db_display) * g_h_int;
    );
    ix == 0 ? ( gfx_x = x_pos; gfx_y = y_pos; last_y = y_pos; ) : (
        gfx_line(x_pos - 1, last_y, x_pos, y_pos, 0);
        gfx_x = x_pos; gfx_y = y_pos;
        last_y = y_pos;
    );
    ix += 1;
);

gfx_set(0.88, 0.88, 0.90, 1); gfx_rect(gr_m_x, gr_m_y, gr_m_w, gr_m_h);
gfx_set(0.62, 0.62, 0.66, 1); gfx_rect(gr_m_x, gr_m_y, gr_m_w, gr_m_h, 0);
gr_val = 0.0;
slider9 != 1 ? gr_val = min(0.0, max(-max_db_display, display_gr));
gr_bar_h = (-gr_val / max_db_display) * gr_m_h;
gfx_set(acc_r, acc_g, acc_b, 0.9); gfx_rect(gr_m_x, gr_m_y, gr_m_w, gr_bar_h);
pk_disp = 0;
slider15 > 0 ? pk_disp = min(1.0, pk_scale / max(0.0001, pk_amt));
pk_bar_h = pk_disp * gr_m_h;
gfx_set(punch_r, punch_g, punch_b, 0.7);
gfx_rect(gr_m_x + gr_m_w - 4, gr_m_y + gr_m_h - pk_bar_h, 3, pk_bar_h);
gfx_set(txt_r, txt_g, txt_b, 0.85); gfx_setfont(2, "Arial", ui_f9, 'b');
gr_val < -0.1 ? (
    sprintf(#gr_str, "%.0f", gr_val);
    gfx_measurestr(#gr_str, tw, th);
    gfx_x = gr_m_x - tw - 4; gfx_y = gr_m_y + gr_bar_h - th/2;
    gfx_drawstr(#gr_str);
);

hover_node == 104 ? ( sprintf(#tip, "Amount: %d%%", slider4); draw_tooltip2(#tip, "Overall strength of spectral reduction", mx, my); ) :
