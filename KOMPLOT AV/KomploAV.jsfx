@init

ext_gr_meter = 0.0;
ext_in_meter_L = 0.0; ext_in_meter_R = 0.0;
ext_out_meter_L = 0.0; ext_out_meter_R = 0.0;
gr_peak_hold = 0.0; gr_peak_timer = 0;
peak_hold_L = 0.0; peak_hold_R = 0.0;
peak_timer_L = 0; peak_timer_R = 0;
peak_in_L = 0.0; peak_in_R = 0.0;
peak_out_L = 0.0; peak_out_R = 0.0;
hold_max_gr = 1.0;
hold_max_gr_display = 1.0;
ext_sustain = 0.0;
__memory_Index__ = 4096;
blit_c = 262144;

os_use = 0; prev_os_use = 0;
pd_amount = 0.5; am_t = 0.0;
active_knob = 0;
active_fader = 0;
drag_y0 = 0; drag_v0 = 0; drag_min = 0; drag_max = 0; drag_def = 0;
mouse_prev_cap = 0; hover_knob = 0;
ui_pending = 0;

rms_coef = 1.0 - exp(-1.0 / (srate * 0.010));
rms_coef_inv = 1.0 - rms_coef;

peak_gr_db = 0.0;
click_gr_frame = -100;
auto_gr_avg = 1.0;

edit_slider = 0;
edit_val = 0;
edit_dec = 0;
edit_has_dec = 0;
edit_neg = 0;
edit_fresh = 1;
edit_block = 0;

wheel_hover_knob = 0;
prev_wheel = 0;

function allocate(size) local(result)
( result = __memory_Index__; __memory_Index__ += size; result; );

function DB_TO_K(x) ( 10 ^ (x / 20); );
function K_TO_DB(x) ( 20 * log10(max(x, 0.0000001)); );
function my_tanh(x) local(e2x, xc)
( xc = max(-15, min(15, x)); e2x = exp(2 * xc); (e2x - 1) / (e2x + 1); );

function knob_hit(mx, my, cx, cy, r) local(dx, dy)
( dx = mx-cx; dy = my-cy; (dx*dx + dy*dy) <= (r*r); );

function knob_marker(xf, yf, val, vmin, vmax, size)
  local(a, nx, ny, gw_local, gh_local)
(
  gw_local = gfx_w;
  gh_local = gfx_h;
  a = -2.356 + ((val - vmin) / (vmax - vmin)) * 4.712;
  a = max(-2.356, min(2.356, a));
  nx = xf * gw_local + sin(a) * 12;
  ny = yf * gh_local - cos(a) * 12;
  gfx_set(0xff8844, 1);
  gfx_circle(nx, ny, size);
  gfx_set(0xffffff, 0.9);
  gfx_circle(nx, ny, size * 0.4);
);

M_SQRT2 = sqrt(2.0); M_SQRT1_2 = M_SQRT2 / 2.0;

function F2_reset() ( this.x1=0; this.x2=0; this.y1=0; this.y2=0; );
function F2_resetv(val) ( this.x1=val; this.x2=val; this.y1=val; this.y2=val; );
function F2_proc(x0) local(y0)
(
  y0 = x0*this.a0 + this.x1*this.a1 + this.x2*this.a2 + this.y1*this.b1 + this.y2*this.b2;
  this.x2=this.x1; this.x1=x0; this.y2=this.y1; this.y1=y0;
  y0;
);
function F2_LP(fk, Q) local(w0, KK, KK2, a0, a1, a2, b0, b1, b2)
(
  w0 = fk*2.0*$pi; KK = 1.0/tan(w0/2.0); KK2 = KK*KK;
  a0=1.0; a1=2.0; a2=1.0;
  b0 = KK2 + KK/Q + 1.0; b1 = 2.0*(1.0-KK2); b2 = KK2 - KK/Q + 1.0;
  this.a0=a0/b0; this.a1=a1/b0; this.a2=a2/b0;
  this.b1=-b1/b0; this.b2=-b2/b0;
);
function F2_HP(fk, Q) local(omega0, alpha)
(
  omega0 = fk*2.0*$pi; alpha = sin(omega0)/(2.0*Q);
  this.a0 = ((1.0+cos(omega0))/2.0)/(1.0+alpha);
  this.a1 = -(1.0+cos(omega0))/(1.0+alpha);
  this.a2 = ((1.0+cos(omega0))/2.0)/(1.0+alpha);
  this.b1 = -(-2.0*cos(omega0))/(1.0+alpha);
  this.b2 = -(1.0-alpha)/(1.0+alpha);
);
function F2_LS(fk, Q, A) local(alpha, w0, a0, a1, a2, b0, b1, b2)
(
  A = sqrt(A); w0 = fk*2.0*$pi; alpha = sin(w0)/(2.0*Q);
  a0 = A*((A+1.0)-(A-1.0)*cos(w0)+2.0*sqrt(A)*alpha);
  a1 = 2.0*A*((A-1.0)-(A+1.0)*cos(w0));
  a2 = A*((A+1.0)-(A-1.0)*cos(w0)-2.0*sqrt(A)*alpha);
  b0 = (A+1.0)+(A-1.0)*cos(w0)+2.0*sqrt(A)*alpha;
  b1 = -2.0*((A-1.0)+(A+1.0)*cos(w0));
  b2 = (A+1.0)+(A-1.0)*cos(w0)-2.0*sqrt(A)*alpha;
  this.a0=a0/b0; this.a1=a1/b0; this.a2=a2/b0;
  this.b1=-b1/b0; this.b2=-b2/b0;
);
function LSP_getQ(x) local(ff, ff2, Q)
(
  (x < 23.756) ? x = 23.756;
  ff = x/35.15; ff2 = ff*ff;
  Q = 1.0 / sqrt((M_SQRT2-1.0)*ff2 + 2.0 - 1.0/ff2);
  Q;
);
function LSP_setF(freq_hz)
(
  this.flt1.F2_HP(35.15/srate, this.LSP_getQ(freq_hz));
  this.flt2.F2_HP(35.15/srate, this.LSP_getQ(freq_hz));
);
function LSP_proc(x) ( this.flt2.F2_proc(this.flt1.F2_proc(x)); );
function LSP_reset() ( this.flt1.F2_reset(); this.flt2.F2_reset(); );

function ARF_setAR(afk, rfk, sfk, t) local(dxx, df)
(
  df = sfk * pow(max(afk, rfk) / sfk, t);
  this.diode_lpf.F2_LP(df, M_SQRT1_2);
  this.fa = 1.0/(1.0/(afk*2.0*$pi)+1.0);
  this.fr = 1.0/(1.0/(rfk*2.0*$pi)+1.0);
  this.diode_xx = 0.025;
  dxx = this.diode_xx;
  this.d_ax7 = -3432.0/pow(dxx,15.0);
  this.d_ax6 = 25740.0/pow(dxx,14.0);
  this.d_ax5 = -83160.0/pow(dxx,13.0);
  this.d_ax4 = 150150.0/pow(dxx,12.0);
  this.d_ax3 = -163800.0/pow(dxx,11.0);
  this.d_ax2 = 108108.0/pow(dxx,10.0);
  this.d_ax1 = -40040.0/pow(dxx,9.0);
  this.d_ax0 = 6435.0/pow(dxx,8.0);
);
function ARF_diode(x) local(x2, x4, x8, x12, y)
(
  (x < 0.0) ? ( y = 0.0; ) :
  (x > this.diode_xx) ? ( y = x; ) : (
    x2=x*x; x4=x2*x2; x8=x4*x4; x12=x8*x4;
    y = x8*x*this.d_ax0 + x8*x2*this.d_ax1 + x8*x2*x*this.d_ax2 +
        x12*this.d_ax3 + x12*x*this.d_ax4 + x12*x2*this.d_ax5 +
        x12*x2*x*this.d_ax6 + x12*x4*this.d_ax7;
  );
  y;
);
function ARF_proc(x) local(y)
(
  y = (this.s += this.fa * this.ARF_diode(x - this.s) + this.fr * (x - this.s));
  y = this.diode_lpf.F2_proc(y);
  y;
);
function ARF_reset(r1)
( this.diode_lpf.F2_resetv(r1 ? 1.0 : 0.0); this.s = 0; );

function ARE_setAR(afk, rfk, sfk, t)
(
  this.fabs_lpf.F2_LP(sfk, M_SQRT1_2);
  this.filter.ARF_setAR(afk, rfk, sfk, t);
  this.use_pd = 0;
);
function ARE_setAR_pd(afk, rfk, sfk, t)
(
  this.fabs_lpf.F2_LP(sfk, M_SQRT1_2);
  this.filter.ARF_setAR(afk, rfk, sfk, t);
  this.filter2.ARF_setAR(afk, rfk * 0.125, sfk, t);
  this.use_pd = 1;
);
function ARE_s2f(sec) local(freq)
( (sec > 0.0) ? (freq = 1.0/sec;) : (freq = srate/(2.0*$pi)); freq/srate; );
function ARE_procAC(x) local(y1, y2, y3)
(
  y1 = abs(x);
  y2 = this.fabs_lpf.F2_proc(y1);
  y3 = this.filter.ARF_proc(y2);
  y3;
);
function ARE_procDC(x) ( this.filter.ARF_proc(x); );
function ARE_procDC_pd(x, sustain) local(ef, es)
(
  (this.use_pd) ? (
    ef = this.filter.ARF_proc(x);
    es = this.filter2.ARF_proc(x);
    (1 - sustain) * ef + sustain * es;
  ) : (
    this.filter.ARF_proc(x);
  );
);
function ARE_reset(r1)
(
  this.fabs_lpf.F2_reset();
  this.filter.ARF_reset(r1);
  (this.use_pd) ? ( this.filter2.ARF_reset(r1); );
);

function EC_init() local(i, d)
(
  M_SQRT_k = allocate(99);
  i = 0;
  loop(99, M_SQRT_k[i] = allocate(10); i += 1; );
  d = M_SQRT_k;

  d[0][0]=0.008089369; d[0][1]=1.165029822; d[0][2]=-0.319041799; d[0][3]=0.224483703; d[0][4]=-0.103484717; d[0][5]=0.029307465; d[0][6]=-0.004919235; d[0][7]=0.000448306; d[0][8]=-0.000017100; d[0][9]=5.930535366;
  d[10][0]=0.139379586; d[10][1]=1.923317459; d[10][2]=-2.206137250; d[10][3]=1.809506551; d[10][4]=-0.886956369; d[10][5]=0.259695421; d[10][6]=-0.044512910; d[10][7]=0.004115552; d[10][8]=-0.000158349; d[10][9]=5.910212200;
  d[20][0]=0.263467441; d[20][1]=2.013537812; d[20][2]=-2.754759371; d[20][3]=2.361146644; d[20][4]=-1.181311569; d[20][5]=0.350033105; d[20][6]=-0.060468920; d[20][7]=0.005621875; d[20][8]=-0.000217202; d[20][9]=5.909951942;
  d[30][0]=0.357424815; d[30][1]=1.955149828; d[30][2]=-2.891762948; d[30][3]=2.536806038; d[30][4]=-1.283779897; d[30][5]=0.383006294; d[30][6]=-0.066467847; d[30][7]=0.006199825; d[30][8]=-0.000240120; d[30][9]=5.909788640;
  d[40][0]=0.428114747; d[40][1]=1.867425331; d[40][2]=-2.895041623; d[40][3]=2.578812116; d[40][4]=-1.315176564; d[40][5]=0.394221554; d[40][6]=-0.068630910; d[40][7]=0.006416174; d[40][8]=-0.000248926; d[40][9]=5.900476243;
  d[50][0]=0.482493384; d[50][1]=1.780615729; d[50][2]=-2.852688683; d[50][3]=2.569804952; d[50][4]=-1.318180819; d[50][5]=0.396522306; d[50][6]=-0.069196760; d[50][7]=0.006480252; d[50][8]=-0.000251741; d[50][9]=5.900377770;
  d[60][0]=0.525373238; d[60][1]=1.702281020; d[60][2]=-2.796080735; d[60][3]=2.541081847; d[60][4]=-1.309418326; d[60][5]=0.394994503; d[60][6]=-0.069061511; d[60][7]=0.006476494; d[60][8]=-0.000251857; d[60][9]=5.900298598;
  d[70][0]=0.559951513; d[70][1]=1.633526597; d[70][2]=-2.737209117; d[70][3]=2.505506548; d[70][4]=-1.295935399; d[70][5]=0.391831212; d[70][6]=-0.068615900; d[70][7]=0.006442007; d[70][8]=-0.000250731; d[70][9]=5.900233103;
  d[80][0]=0.588379536; d[80][1]=1.573603885; d[80][2]=-2.680719818; d[80][3]=2.468622948; d[80][4]=-1.280891638; d[80][5]=0.388036912; d[80][6]=-0.068041293; d[80][7]=0.006394170; d[80][8]=-0.000249050; d[80][9]=5.900177786;
  d[90][0]=0.612140551; d[90][1]=1.521332787; d[90][2]=-2.628277203; d[90][3]=2.432839243; d[90][4]=-1.265742709; d[90][5]=0.384088123; d[90][6]=-0.067425264; d[90][7]=0.006341479; d[90][8]=-0.000247151; d[90][9]=5.900130315;
  d[98][0]=0.628504776; d[98][1]=1.484238647; d[98][2]=-2.589532909; d[98][3]=2.405696759; d[98][4]=-1.254009316; d[98][5]=0.380975608; d[98][6]=-0.066932332; d[98][7]=0.006298759; d[98][8]=-0.000245593; d[98][9]=5.900096872;

  i = 1;
  loop(98,
    ((i % 10) != 0 && i != 98) ? (
      idx_lo = floor(i / 10) * 10;
      idx_hi = idx_lo + 10;
      (idx_hi > 98) ? idx_hi = 98;
      frac = (i - idx_lo) / (idx_hi - idx_lo);
      j = 0;
      loop(10,
        d[i][j] = d[idx_lo][j] + frac * (d[idx_hi][j] - d[idx_lo][j]);
        j += 1;
      );
    );
    i += 1;
  );
);

function EC_h2(x) local(y, p, x2, x4)
(
  (this.ratio > 0.0) ? (
    (x > M_SQRT_k[this.ratio_index][9]) ? ( x = M_SQRT_k[this.ratio_index][9]; );
    x2 = x*x; x4 = x2*x2;
    p = M_SQRT_k[this.ratio_index][0] +
        x*M_SQRT_k[this.ratio_index][1] + x2*M_SQRT_k[this.ratio_index][2] +
        x2*x*M_SQRT_k[this.ratio_index][3] + x4*M_SQRT_k[this.ratio_index][4] +
        x4*x*M_SQRT_k[this.ratio_index][5] + x4*x2*M_SQRT_k[this.ratio_index][6] +
        x4*x2*x*M_SQRT_k[this.ratio_index][7] + x4*x4*M_SQRT_k[this.ratio_index][8];
    y = p * this.thresh_ratio;
  ) : ( y = this.thresh; );
  y;
);
function EC_dh2(x) local(y)
(
  (this.ratio > 0.0) ? (
    (x > 0.0) ? ( y = this.EC_h2(x) * this.ratio / x; ) : ( y = 0.0; );
  ) : ( y = 0.0; );
  y;
);
function EC_h1(x) local(x2, x3, x4)
( x2=x*x; x3=x2*x; x4=x2*x2; x + x3*this.A3 + x4*this.A4; );
function EC_h(x) local(y)
( y = (x < this.thresh2) ? this.EC_h1(x) : this.EC_h2(x); y; );
function EC_getGR(x) local(y)
( y = (x >= this.hx_min) ? this.EC_h(x) / x : 1.0; y; );

function EC_setT(thresh, knee, ratio) local(delta, x2, y2, dy2)
(
  this.thresh = thresh; this.hx_min = 0.000001;
  (ratio <= 10.9) ? (
    ratio = floor(ratio*10.0)/10.0;
    this.ratio_index = (ratio*10.0 - 11.0);
    this.ratio = 1.0 / ratio;
    (this.ratio_index < 0) ? this.ratio_index = 0;
    (this.ratio_index >= 99) ? this.ratio_index = 98;
    this.thresh_ratio = pow(1.0/this.thresh, this.ratio) * this.thresh;
  ) : ( this.ratio = 0; );

  delta = knee * 2.0 * this.thresh;
  this.thresh2 = this.thresh + delta;
  x2 = this.thresh2;
  y2 = this.EC_h2(x2);
  dy2 = this.EC_dh2(x2);
  this.A3 = -(3.0*x2 - 4.0*y2 + x2*dy2)/(x2*x2*x2);
  this.A4 = 1.0/(x2*x2*x2*x2)*(2.0*x2 - 3.0*y2 + x2*dy2);
);
function EC_proc(x)
( (this.ratio == 1.0) ? 1.0 : this.EC_getGR(x); );

function Sat_clean(x) local(x2, x4, y)
(
  (x < -1.927384823613229) ? x = -1.927384823613229;
  (x > 1.925547073273503) ? x = 1.925547073273503;
  x2=x*x; x4=x2*x2;
  y = 1.043653138515045*x + 0.051012188210767*x2 + -0.048182108389193*x2*x +
      -0.076851680685586*x4 + -0.076851680685586*x4*x + 0.019456557521838*x4*x2 +
      0.011322488095808*x4*x2*x + -0.001614452827801*x4*x4;
  y;
);
function Sat_tape(x) local(y, th)
( th = my_tanh(x*0.85); y = th + 0.15*x*(1-th*th); y; );
function Sat_tube(x) local(y, xa, x2)
(
  xa = abs(x); x2 = x*x;
  (x >= 0) ? ( y = x/(1+0.3*xa) + 0.08*x2/(1+x2); ) : ( y = x/(1+0.5*xa); );
  y;
);
function Sat_trans(x) local(y, s, xc, ex)
(
  s = 1.5; xc = max(-20, min(20, x)); ex = exp(s*xc);
  y = (1.0/s)*log(1+ex) - 0.5;
  y / 0.6343 * 0.95;
);
function Sat_setT(th) ( this.threshold = th; );

function Sat_OS_init() local(i)
(
  this.he = allocate(8);
  this.he[0] = -0.00134; this.he[1] =  0.01010; this.he[2] = -0.04451; this.he[3] = 0.28575;
  this.he[4] =  0.28575; this.he[5] = -0.04451; this.he[6] =  0.01010; this.he[7] = -0.00134;
  this.up1 = allocate(8); this.up2 = allocate(8);
  this.dn1e = allocate(8); this.dn1o = allocate(8);
  this.dn2e = allocate(8); this.dn2o = allocate(8);
  i = 0;
  loop(8,
    this.up1[i] = 0; this.up2[i] = 0;
    this.dn1e[i] = 0; this.dn1o[i] = 0;
    this.dn2e[i] = 0; this.dn2o[i] = 0;
    i += 1;
  );
  this.up1ptr = 0; this.up2ptr = 0;
  this.dn1ptr = 0; this.dn2ptr = 0;
);
function Sat_OS_reset() local(i)
(
  i = 0;
  loop(8,
    this.up1[i] = 0; this.up2[i] = 0;
    this.dn1e[i] = 0; this.dn1o[i] = 0;
    this.dn2e[i] = 0; this.dn2o[i] = 0;
    i += 1;
  );
  this.up1ptr = 0; this.up2ptr = 0;
  this.dn1ptr = 0; this.dn2ptr = 0;
);
function Sat_up1(x) local(i, s, he)
(
  he = this.he;
  this.up1[this.up1ptr] = x;
  s = 0; i = 0;
  loop(8, s += 2.0 * he[i] * this.up1[(this.up1ptr - i + 8) & 7]; i += 1; );
  this.up1_even = s;
  this.up1_odd  = this.up1[(this.up1ptr - 3 + 8) & 7];
  this.up1ptr = (this.up1ptr + 1) & 7;
);
function Sat_up2(x) local(i, s, he)
(
  he = this.he;
  this.up2[this.up2ptr] = x;
  s = 0; i = 0;
  loop(8, s += 2.0 * he[i] * this.up2[(this.up2ptr - i + 8) & 7]; i += 1; );
  this.up2_even = s;
  this.up2_odd  = this.up2[(this.up2ptr - 3 + 8) & 7];
  this.up2ptr = (this.up2ptr + 1) & 7;
);
function Sat_dn1(e, o) local(i, s, he)
(
  he = this.he;
  this.dn1e[this.dn1ptr] = e;
  this.dn1o[this.dn1ptr] = o;
  s = 0; i = 0;
  loop(8, s += he[i] * this.dn1e[(this.dn1ptr - i + 8) & 7]; i += 1; );
  s += 0.5 * this.dn1o[(this.dn1ptr - 4 + 8) & 7];
  this.dn1ptr = (this.dn1ptr + 1) & 7;
  s;
);
function Sat_dn2(e, o) local(i, s, he)
(
  he = this.he;
  this.dn2e[this.dn2ptr] = e;
  this.dn2o[this.dn2ptr] = o;
  s = 0; i = 0;
  loop(8, s += he[i] * this.dn2e[(this.dn2ptr - i + 8) & 7]; i += 1; );
  s += 0.5 * this.dn2o[(this.dn2ptr - 4 + 8) & 7];
  this.dn2ptr = (this.dn2ptr + 1) & 7;
  s;
);
function Sat_raw(x) local(y, t)
(
  t = x / this.threshold;
  (this.sat_type == 0) ? ( y = this.Sat_clean(t); ) :
  (this.sat_type == 1) ? ( y = this.Sat_tape(t); ) :
  (this.sat_type == 2) ? ( y = this.Sat_tube(t); ) :
                          ( y = this.Sat_trans(t); );
  y * this.threshold;
);
function Sat_proc(x) local(y, a0, a1, b00, b01, b10, b11, c0, c1)
(
  (os_use == 0) ? ( y = this.Sat_raw(x); ) :
  (os_use == 1) ? (
    this.Sat_up1(x);
    a0 = this.up1_even; a1 = this.up1_odd;
    b00 = this.Sat_raw(a0); b01 = this.Sat_raw(a1);
    y = this.Sat_dn1(b00, b01);
  ) : (
    this.Sat_up1(x);
    a0 = this.up1_even; a1 = this.up1_odd;
    this.Sat_up2(a0);
    b00 = this.up2_even; b01 = this.up2_odd;
    this.Sat_up2(a1);
    b10 = this.up2_even; b11 = this.up2_odd;
    b00 = this.Sat_raw(b00); b01 = this.Sat_raw(b01);
    b10 = this.Sat_raw(b10); b11 = this.Sat_raw(b11);
    c0 = this.Sat_dn1(b00, b01);
    c1 = this.Sat_dn1(b10, b11);
    y = this.Sat_dn2(c0, c1);
  );
  y;
);

function Lim_init(maxla) local(i)
(
  this.bufL = allocate(maxla); this.bufR = allocate(maxla);
  this.buf_size = maxla; this.idx = 0; this.lookahead = 64;
  this.gain = 1.0; this.ceiling = 0.977;
  this.rel_coeff = 0.9999; this.atk_coeff = 0.5; this.env = 0.0;
  i = 0; loop(maxla, this.bufL[i]=0; this.bufR[i]=0; i += 1; );
);
function Lim_setLA(samples)
( this.lookahead = min(max(samples, 1), this.buf_size - 1); );
function Lim_proc(x, ch) local(y, read_idx, a, target)
(
  a = abs(x);
  read_idx = (this.idx + this.buf_size - this.lookahead) % this.buf_size;
  (ch == 0) ? ( y = this.bufL[read_idx]; this.bufL[this.idx] = x; ) :
              ( y = this.bufR[read_idx]; this.bufR[this.idx] = x; );
  (a > this.env) ? ( this.env += this.atk_coeff*(a - this.env); ) :
                    ( this.env = this.ceiling + (this.env - this.ceiling)*this.rel_coeff; );
  (this.env > this.ceiling) ? (
    target = this.ceiling / this.env;
    (target < this.gain) ? ( this.gain = target; );
  );
  this.gain = this.gain + 0.001*(1.0 - this.gain);
  (ch == 0) ? ( this.idx = (this.idx + 1) % this.buf_size; );
  y * this.gain;
);

function CC_pre(x) local(x_sc, ax, crest, target_sus)
(
  (this.use_sc_flt) ? ( x_sc = this.sc_flt.LSP_proc(x); ) :
                       ( x_sc = this.sc_flt2.F2_proc(x); );
  ax = abs(x_sc);
  (ax > this.peak_env) ? ( this.peak_env = ax; ) : ( this.peak_env *= 0.9997; );
  this.rms_env = this.rms_env * rms_coef_inv + ax * ax * rms_coef;
  crest = this.peak_env / (sqrt(this.rms_env) + 0.0001);
  target_sus = 1.0 - (crest - 1.5) / 2.0;
  target_sus = max(0, min(1, target_sus));
  this.sustain = this.sustain * 0.995 + target_sus * 0.005;
  this.env.ARE_procAC(x_sc * this.in_gain) * this.det_fix;
);
function CC_post(x_dry, env) local(env_gr, env_ar, x_wet, y, sus)
(
  env_gr = this.env_k.EC_proc(env);
  env_gr = max(0.001, min(2.0, env_gr));
  sus = this.sustain * pd_amount;
  sus = sus * sus;
  env_ar = 2.0 - this.env_ar.ARE_procDC_pd(2.0 - env_gr, sus);
  env_ar = max(0.001, min(2.0, env_ar));
  this.gr = env_ar;
  x_wet = x_dry * env_ar * this.in_gain;
  (this.use_sat) ? ( x_wet = this.sat.Sat_proc(x_wet); );
  y = x_wet * this.gain * (1.0 - this.dry_mix_k) + x_dry * this.dry_mix_k;
  y;
);
function CC_proc(x, sc) ( this.CC_post(x, this.CC_pre(sc)); );
function CC_reset()
(
  this.env.ARE_reset(0);
  this.sc_flt.LSP_reset();
  this.sc_flt2.F2_reset();
  this.env_ar.ARE_reset(1);
  this.peak_env = 0;
  this.rms_env = 0.0001;
  this.sustain = 0;
);

SL_MONO=0; SL_2MONO=1; SL_M=2; SL_S=3; SL_MS=4; SL_STEREO=5;

function SC_setEnv(atk, rel, scf, t) local(ea, er, mf)
(
  (t < 0.5) ? (
    (atk <= 0.0095) ? ( ea=0.001; this.c1.det_fix = DB_TO_K(0.547); ) :
    (atk <= 0.0245) ? ( ea=0.010; this.c1.det_fix = DB_TO_K(1.536); ) :
                      ( ea=0.025; this.c1.det_fix = DB_TO_K(2.237); );
    er = rel;
  ) : ( ea=0.00005; er=rel; this.c1.det_fix = DB_TO_K(0.878); );
  this.c2.det_fix = this.c1.det_fix;
  mf = 21500.0;
  this.c1.env.ARE_setAR(ARE_s2f(ea), ARE_s2f(er), mf/srate, 1.0);
  this.c2.env.ARE_setAR(ARE_s2f(ea), ARE_s2f(er), mf/srate, 1.0);
  (scf > 0.0) ? (
    this.c1.sc_flt.LSP_setF(scf); this.c1.use_sc_flt = 1;
    this.c2.sc_flt.LSP_setF(scf); this.c2.use_sc_flt = 1;
  ) : (
    this.c1.sc_flt2.F2_LS(296.0/srate, 0.7, DB_TO_K(-3.02)); this.c1.use_sc_flt = 0;
    this.c2.sc_flt2.F2_LS(296.0/srate, 0.7, DB_TO_K(-3.02)); this.c2.use_sc_flt = 0;
  );
  this.c1.env_ar.ARE_setAR_pd(ARE_s2f(atk), ARE_s2f(er), mf/srate, t);
  this.c2.env_ar.ARE_setAR_pd(ARE_s2f(atk), ARE_s2f(er), mf/srate, t);
);
function SC_setEnvK(th, knee, ratio)
(
  this.c1.env_k.EC_setT(th, knee, ratio);
  this.c2.env_k.EC_setT(th, knee, ratio);
);
function SC_setGain(g, dm, ig)
(
  this.c1.gain = g; this.c1.dry_mix_k = dm; this.c1.in_gain = ig;
  this.c2.gain = g; this.c2.dry_mix_k = dm; this.c2.in_gain = ig;
);
function SC_setSat(th, st)
(
  this.c1.sat.Sat_setT(th); this.c1.sat.sat_type = st;
  this.c2.sat.Sat_setT(th); this.c2.sat.sat_type = st;
);
function SC_setMode(sl)
(
  this.stereo_mode = sl;
  this.c1.use_sat = ((sl != SL_S) && (sl != SL_MS) && this.use_sat);
  this.c2.use_sat = this.c1.use_sat;
);
function SC_setUseSat(u)
( this.use_sat = u; this.SC_setMode(this.stereo_mode); );

function SC_proc(x1, x2, sc1, sc2) local(xm, xs, ym, ys, scm, scs, e1, e2, env)
(
  (this.stereo_mode == SL_MONO) ? (
    this.y1 = this.c1.CC_proc(x1, sc1); this.y2 = this.y1;
    this.gr = this.c1.gr;
  ) : (this.stereo_mode == SL_2MONO) ? (
    this.y1 = this.c1.CC_proc(x1, sc1);
    this.y2 = this.c2.CC_proc(x2, sc2);
    this.gr = min(this.c1.gr, this.c2.gr);
  ) : (this.stereo_mode == SL_M) ? (
    xm = (x1+x2)/2.0; xs = (x1-x2)/2.0; scm = (sc1+sc2)/2.0;
    ym = this.c1.CC_proc(xm, scm); ys = xs;
    this.y1 = ym + ys; this.y2 = ym - ys;
    this.gr = this.c1.gr;
  ) : (this.stereo_mode == SL_S) ? (
    xm = (x1+x2)/2.0; xs = (x1-x2)/2.0; scs = (sc1-sc2)/2.0;
    ym = xm; ys = this.c1.CC_proc(xs, scs);
    (this.use_sat) ? ( ys = this.c1.sat.Sat_proc(ys); );
    this.y1 = ym + ys; this.y2 = ym - ys;
    this.gr = this.c1.gr;
  ) : (this.stereo_mode == SL_STEREO) ? (
    e1 = this.c1.CC_pre(sc1); e2 = this.c2.CC_pre(sc2);
    env = (e1 + e2) / 2.0;
    this.y1 = this.c1.CC_post(x1, env);
    this.y2 = this.c2.CC_post(x2, env);
    this.gr = min(this.c1.gr, this.c2.gr);
  ) : (
    scm = (sc1+sc2)/2.0; scs = (sc1-sc2)/2.0;
    e1 = this.c1.CC_pre(scm); e2 = this.c2.CC_pre(scs);
    env = max(e1, e2);
    xm = (x1+x2)/2.0; xs = (x1-x2)/2.0;
    ym = this.c1.CC_post(xm, env); ys = this.c2.CC_post(xs, env);
    this.y1 = this.c1.sat.Sat_proc(ym + ys);
    this.y2 = this.c2.sat.Sat_proc(ym - ys);
    this.gr = min(this.c1.gr, this.c2.gr);
  );
);
function SC_reset() ( this.c1.CC_reset(); this.c2.CC_reset(); );

function update_params()
(
  param_Input = DB_TO_K(slider1);
  param_SCF = slider2;
  param_SCFOn = slider3;
  param_Thr = DB_TO_K(slider4);
  param_Rat = slider5;
  param_Kne = slider6;
  param_Atk = slider7 / 1000.0;
  param_AMd = slider8;
  param_Rel = slider9 / 1000.0;
  param_SatOn = slider10;
  param_SatDr = slider11;
  param_Mkup = DB_TO_K(slider12);
  param_DMx = slider13 / 100.0;
  param_SM = slider14;
  param_Byp = slider15;
  param_SC = slider16;
  param_SatT = slider17;
  param_Auto = slider18;
  param_Lim = slider19;
  param_LimC = DB_TO_K(slider20);
  param_Delta = slider21;
  pd_amount = slider24 / 100.0;
  am_t = (param_AMd == 0) ? 0.0 : (param_AMd == 1) ? 0.25 : (param_AMd == 2) ? 0.5 : (param_AMd == 3) ? 0.75 : 1.0;
  os_use = slider23;
  (os_use != prev_os_use) ? (
    compressor.c1.sat.Sat_OS_reset();
    compressor.c2.sat.Sat_OS_reset();
    prev_os_use = os_use;
  );
  compressor.SC_setEnv(param_Atk, param_Rel, param_SCFOn ? param_SCF : 0, am_t);
  compressor.SC_setEnvK(param_Thr, param_Kne, param_Rat);
  compressor.SC_setSat(DB_TO_K(12.0 - param_SatDr), param_SatT);
  compressor.SC_setUseSat(param_SatOn);

  (param_Auto == 0) ? (
    compressor.SC_setGain(DB_TO_K(slider12), param_DMx, param_Input);
  );

  compressor.SC_setMode(param_SM);
  limiter.ceiling = param_LimC;
);

(global_init == 0) ? (
  __memory_Index__ = 4096;
  EC_init();
  limiter.Lim_init(256);
  limiter.Lim_setLA(64);
  compressor.c1.sat.Sat_OS_init();
  compressor.c2.sat.Sat_OS_init();

  compressor.gr = 1.0;

  global_init = 1;
);

compressor.SC_reset();

@slider

update_params();

@block

(ui_pending > 0) ? ( ui_pending = 0; update_params(); );

(gr_peak_timer > 0) ? ( gr_peak_timer -= 1; ) : ( gr_peak_hold = max(gr_peak_hold * 0.95, ext_gr_meter); );
(ext_gr_meter < gr_peak_hold) ? ( gr_peak_hold = ext_gr_meter; gr_peak_timer = 20; );
(peak_timer_L > 0) ? ( peak_timer_L -= 1; ) : ( peak_hold_L = max(peak_hold_L - 1, ext_in_meter_L); );
(peak_timer_R > 0) ? ( peak_timer_R -= 1; ) : ( peak_hold_R = max(peak_hold_R - 1, ext_in_meter_R); );
(ext_in_meter_L > peak_hold_L) ? ( peak_hold_L = ext_in_meter_L; peak_timer_L = 20; );
(ext_in_meter_R > peak_hold_R) ? ( peak_hold_R = ext_in_meter_R; peak_timer_R = 20; );

ext_gr_meter = K_TO_DB(hold_max_gr);
hold_max_gr_display = hold_max_gr;
hold_max_gr = 1.0;
ext_sustain = ext_sustain * 0.7 + compressor.c1.sustain * 0.3;
ext_in_meter_L = ext_in_meter_L * 0.7 + K_TO_DB(peak_in_L) * 0.3;
ext_in_meter_R = ext_in_meter_R * 0.7 + K_TO_DB(peak_in_R) * 0.3;
ext_out_meter_L = ext_out_meter_L * 0.7 + K_TO_DB(peak_out_L) * 0.3;
ext_out_meter_R = ext_out_meter_R * 0.7 + K_TO_DB(peak_out_R) * 0.3;
peak_in_L = 0; peak_in_R = 0; peak_out_L = 0; peak_out_R = 0;

(ext_gr_meter < peak_gr_db) ? (
  peak_gr_db = ext_gr_meter;
) : (
  peak_gr_db = peak_gr_db * 0.998 + ext_gr_meter * 0.002;
);

(param_Auto) ? (
  auto_gr_avg = auto_gr_avg * 0.99 + compressor.gr * 0.01;
  (auto_gr_avg < 0.001) ? ( auto_gr_avg = 0.001; );
  auto_mkup_dyn = -20 * log10(auto_gr_avg);
  auto_mkup_dyn = max(0, min(24, auto_mkup_dyn));
  compressor.SC_setGain(DB_TO_K(slider12 + auto_mkup_dyn), param_DMx, param_Input);
) : (
  auto_gr_avg = 1.0;
);

@sample

in_L = spl0; in_R = spl1;
peak_in_L = max(peak_in_L, abs(in_L));
peak_in_R = max(peak_in_R, abs(in_R));

(!param_Byp) ? (
  (!param_SC) ?
    compressor.SC_proc(spl0, spl1, spl0, spl1) :
    compressor.SC_proc(spl0, spl1, spl2, spl3);
  out_L = compressor.y1;
  out_R = compressor.y2;
  (param_Delta) ? ( out_L -= in_L; out_R -= in_R; );
  (param_Lim) ? (
    out_L = limiter.Lim_proc(out_L, 0);
    out_R = limiter.Lim_proc(out_R, 1);
  );
  spl0 = out_L; spl1 = out_R;
  peak_out_L = max(peak_out_L, abs(out_L));
  peak_out_R = max(peak_out_R, abs(out_R));
);
hold_max_gr = min(hold_max_gr, compressor.gr);

@gfx 940 400

// ============================================================
// CONSTANTES
// ============================================================
KW = 1909; KH = 824;
FRSZ = 140; FRAMES = 61; KCOLS = 31;

kx = gfx_w / KW;
ky = gfx_h / KH;
ks = (kx + ky) * 0.5;

ls = min(gfx_w / max(1, 940), gfx_h / max(1, 400));
ls = max(0.40, min(1.10, ls));

skin = slider22|0;
knob_strip = 4 + skin;

ksz_lcd = FRSZ * ks * 0.48;
lcd_w = ksz_lcd * 1.85;
lcd_h = max(11, floor(17*ls));
lcd_yoff = ksz_lcd + 6 + lcd_h * 0.5;

// ============================================================
// PALETA POR SKIN
// ============================================================
skin == 0 ? (
  bdR=0.36; bdG=0.46; bdB=0.58;
  txR=0.93; txG=0.96; txB=0.99;
  dmR=0.75; dmG=0.82; dmB=0.92;
  acR=0.40; acG=0.72; acB=1.00;
  lbR=0.85; lbG=0.90; lbB=0.98;
  lcR=0.02; lcG=0.05; lcB=0.08;
  ltR=0.55; ltG=0.95; ltB=1.00;
  pnR=0.17; pnG=0.24; pnB=0.33;
  phR=0.26; phG=0.35; phB=0.45;
) : skin == 1 ? (
  bdR=0.32; bdG=0.32; bdB=0.35;
  txR=0.96; txG=0.96; txB=0.96;
  dmR=0.75; dmG=0.75; dmB=0.78;
  acR=1.00; acG=0.58; acB=0.15;
  lbR=0.85; lbG=0.85; lbB=0.88;
  lcR=0.02; lcG=0.02; lcB=0.03;
  ltR=1.00; ltG=0.65; ltB=0.20;
  pnR=0.17; pnG=0.17; pnB=0.19;
  phR=0.26; phG=0.26; phB=0.28;
) : skin == 2 ? (
  bdR=0.28; bdG=0.44; bdB=0.32;
  txR=0.91; txG=0.98; txB=0.93;
  dmR=0.70; dmG=0.85; dmB=0.74;
  acR=0.40; acG=0.95; acB=0.50;
  lbR=0.80; lbG=0.92; lbB=0.82;
  lcR=0.02; lcG=0.05; lcB=0.03;
  ltR=0.50; ltG=1.00; ltB=0.60;
  pnR=0.13; pnG=0.22; pnB=0.15;
  phR=0.20; phG=0.32; phB=0.24;
) : (
  bdR=0.42; bdG=0.30; bdB=0.55;
  txR=0.97; txG=0.92; txB=1.00;
  dmR=0.80; dmG=0.70; dmB=0.93;
  acR=0.85; acG=0.52; acB=1.00;
  lbR=0.88; lbG=0.80; lbB=0.98;
  lcR=0.04; lcG=0.02; lcB=0.08;
  ltR=0.90; ltG=0.60; ltB=1.00;
  pnR=0.22; pnG=0.15; pnB=0.30;
  phR=0.31; phG=0.22; phB=0.42;
);

gfx_setfont(1, "Arial", max(5, floor(11*ls)), 'b');
gfx_setfont(2, "Arial", max(4, floor(9*ls)), 'b');
gfx_setfont(3, "Arial", max(6, floor(15*ls)), 'b');
gfx_setfont(4, "Arial", max(5, floor(10*ls)));
gfx_setfont(5, "Arial", max(4, floor(8*ls)), 'b');
gfx_setfont(6, "Arial", max(5, floor(11*ls)), 'b');
gfx_setfont(7, "Arial", max(6, floor(14*ls)), 'b');
gfx_setfont(8, "Arial", max(5, floor(11*ls)), 'b');
gfx_setfont(9, "Arial", max(6, floor(15*ls)), 'b');
gfx_setfont(10, "Arial", max(5, floor(12*ls)), 'b');

// ============================================================
// HELPERS
// ============================================================
function vgrad(x, y, w, h, r1, g1, b1, r2, g2, b2) local(i, t, r, g, b, sh, n, hh)
(
  sh = 4; hh = h; n = ceil(hh / sh); i = 0;
  loop(n,
    t = (i*sh) / max(1, hh-1);
    r = r1 + (r2 - r1) * t;
    g = g1 + (g2 - g1) * t;
    b = b1 + (b2 - b1) * t;
    gfx_set(r, g, b, 1);
    gfx_rect(x, y + i*sh, w, min(sh, hh - i*sh));
    i += 1;
  );
);

function rr(x, y, w, h, rad)
(
  gfx_rect(x + rad, y, w - 2*rad, h);
  gfx_rect(x, y + rad, w, h - 2*rad);
  gfx_circle(x + rad, y + rad, rad, 1);
  gfx_circle(x + w - rad, y + rad, rad, 1);
  gfx_circle(x + rad, y + h - rad, rad, 1);
  gfx_circle(x + w - rad, y + h - rad, rad, 1);
);

function setfid(fid)
(
  (fid==1) ? gfx_setfont(1,"Arial",max(5,floor(11*ls)),'b') :
  (fid==2) ? gfx_setfont(2,"Arial",max(4,floor(9*ls)),'b') :
  (fid==3) ? gfx_setfont(3,"Arial",max(6,floor(15*ls)),'b') :
  (fid==4) ? gfx_setfont(4,"Arial",max(5,floor(10*ls))) :
  (fid==5) ? gfx_setfont(5,"Arial",max(4,floor(8*ls)),'b') :
  (fid==6) ? gfx_setfont(6,"Arial",max(5,floor(11*ls)),'b') :
  (fid==7) ? gfx_setfont(7,"Arial",max(6,floor(14*ls)),'b') :
  (fid==8) ? gfx_setfont(8,"Arial",max(5,floor(11*ls)),'b') :
  (fid==9) ? gfx_setfont(9,"Arial",max(6,floor(15*ls)),'b') :
             gfx_setfont(10,"Arial",max(5,floor(12*ls)),'b');
);

function txt_c(str, cx, cy, fid, r, g, b) local(w, h)
(
  setfid(fid);
  gfx_set(r, g, b, 1);
  gfx_measurestr(str, w, h);
  gfx_x = cx - w*0.5;
  gfx_y = cy - h*0.5;
  gfx_drawstr(str);
);

function txt_l(str, x, cy, fid, r, g, b) local(w, h)
(
  setfid(fid);
  gfx_set(r, g, b, 1);
  gfx_measurestr(str, w, h);
  gfx_x = x;
  gfx_y = cy - h*0.5;
  gfx_drawstr(str);
);

function txt_r(str, xr, cy, fid, r, g, b) local(w, h)
(
  setfid(fid);
  gfx_set(r, g, b, 1);
  gfx_measurestr(str, w, h);
  gfx_x = xr - w;
  gfx_y = cy - h*0.5;
  gfx_drawstr(str);
);

function onoff_str(v)    ( v ? "On" : "Off"; );
function atkmode_str(v)  ( (v<1)?"Alpha":(v<2)?"Epsilon":(v<3)?"Gamma":(v<4)?"Dseta":"Beta"; );
function mode_str(v)     ( (v<1)?"Mono":(v<2)?"Dual Mono":(v<3)?"M":(v<4)?"S":(v<5)?"MS":"Stereo"; );
function sctype_str(v)   ( v ? "Ext SC." : "Int SC."; );
function sattype_str(v)  ( (v<1)?"Clean":(v<2)?"Tape":(v<3)?"Tube":"Transistor"; );
function theme_str(v)    ( (v<1)?"Brian":(v<2)?"Adri":(v<3)?"Mayte":"Vicky"; );
function os_str(v)       ( (v<1)?"Off":(v<2)?"2x":"4x"; );

// ============================================================
// FONDO
// ============================================================
img_w = 0; img_h = 0;
gfx_getimgdim(skin, img_w, img_h);

(img_w > 0) ? (
  blit_c[0] = 0; blit_c[1] = 0;
  blit_c[2] = img_w; blit_c[3] = img_h;
  blit_c[4] = 0; blit_c[5] = 0;
  blit_c[6] = gfx_w; blit_c[7] = gfx_h;
  gfx_blitext(skin, blit_c, 0);
);

// ============================================================
// HEADER
// ============================================================
hdr_sep_y = floor(gfx_h * 0.115);

gfx_setfont(11, "Vladimir Script", max(14, floor(34*ls)));
gfx_set(txR, txG, txB, 1);
gfx_measurestr("Komplot - AV", tw, th);
gfx_x = gfx_w * 0.5 - tw * 0.5;
gfx_y = 0;
gfx_drawstr("Komplot - AV");

txt_r("DSP y diseño Adrian Vazquez", gfx_w - 45, 18, 10, dmR, dmG, dmB);

gfx_set(bdR, bdG, bdB, 0.5);
gfx_rect(12, hdr_sep_y, gfx_w - 24, 1);
gfx_set(0, 0, 0, 0.4);
gfx_rect(12, hdr_sep_y + 1, gfx_w - 24, 1);

// ============================================================
// KNOBS
// ============================================================
function draw_knob_full(cx, cy, val, vmin, vmax, stripid, lbl, fmt, edit_id)
  local(n, fi, col, row, sz, ksz, lw, lh, lx, ly, s, w, h, knw, knh)
(
  sz = FRSZ * ks;
  ksz = sz * 0.48;

  gfx_getimgdim(stripid, knw, knh);
  (knw > 0) ? (
    n = (val - vmin) / (vmax - vmin);
    n = max(0, min(1, n));
    fi = floor(n * (FRAMES - 1) + 0.5);
    col = fi - floor(fi / KCOLS) * KCOLS;
    row = floor(fi / KCOLS);
    blit_c[0] = col * FRSZ; blit_c[1] = row * FRSZ;
    blit_c[2] = FRSZ; blit_c[3] = FRSZ;
    blit_c[4] = cx - sz * 0.5; blit_c[5] = cy - sz * 0.5;
    blit_c[6] = sz; blit_c[7] = sz;
    gfx_blitext(stripid, blit_c, 0);
  );

  txt_c(lbl, cx, cy - ksz - 15*ls, 6, lbR, lbG, lbB);

  lw = ksz * 1.85;
  lh = max(11, floor(17*ls));
  lx = cx - lw * 0.5;
  ly = cy + ksz + 6;

  (edit_id > 0 && edit_slider == edit_id) ? (
    gfx_set(acR, acG, acB, 0.9);
    rr(lx - 2, ly - 2, lw + 4, lh + 4, 4);
  );

  gfx_set(0, 0, 0, 0.75);
  rr(lx + 1, ly + 1, lw, lh, 3);
  gfx_set(lcR, lcG, lcB, 1);
  rr(lx, ly, lw, lh, 3);
  gfx_set(bdR, bdG, bdB, 0.55);
  gfx_rect(lx + 3, ly + 1, lw - 6, 1);
  gfx_set(0, 0, 0, 0.6);
  gfx_rect(lx + 3, ly + lh - 2, lw - 6, 1);

  (edit_id > 0 && edit_slider == edit_id) ? (
    final_int = floor(edit_val / pow(10, edit_dec));
    frac_part = edit_val - final_int * pow(10, edit_dec);
    (edit_has_dec) ? (
      (edit_dec > 0) ? (
        sprintf(#disp_str, "%s%d.%d", edit_neg ? "-" : "", final_int, frac_part);
      ) : (
        sprintf(#disp_str, "%s%d.", edit_neg ? "-" : "", final_int);
      );
    ) : (
      (edit_fresh) ? ( sprintf(#disp_str, "%s", edit_neg ? "-" : "0"); )
                   : ( sprintf(#disp_str, "%s%d", edit_neg ? "-" : "", edit_val); );
    );
    txt_c(#disp_str, cx, ly + lh * 0.5 + 0.5, 1, 0.95, 0.85, 0.55);
  ) : (
    s = sprintf(#, fmt, val);
    txt_c(s, cx, ly + lh * 0.5 + 0.5, 1, ltR, ltG, ltB);
  );
);

gfx_set(1, 1, 1, 1);
draw_knob_full(0.0911*gfx_w, 0.2512*gfx_h, slider1,  -12, 12,  knob_strip, "INPUT",   "%.1f", 1);
draw_knob_full(0.2300*gfx_w, 0.2536*gfx_h, slider2,   40, 260, knob_strip, "SC FREQ", "%.0f", 2);
draw_knob_full(0.6951*gfx_w, 0.2549*gfx_h, slider4,  -40, 0,   knob_strip, "THRESH",  "%.1f", 3);
draw_knob_full(0.8057*gfx_w, 0.2585*gfx_h, slider5,  1.1, 20,  knob_strip, "RATIO",   "%.1f", 4);
draw_knob_full(0.9214*gfx_w, 0.2573*gfx_h, slider6,    0, 1,   knob_strip, "KNEE",    "%.2f", 5);
draw_knob_full(0.0885*gfx_w, 0.5874*gfx_h, slider7,    1, 100, knob_strip, "ATTACK",  "%.1f", 6);
draw_knob_full(0.3651*gfx_w, 0.5850*gfx_h, slider9,   50, 1000,knob_strip, "RELEASE", "%.1f", 7);
draw_knob_full(0.6401*gfx_w, 0.5886*gfx_h, slider11, -12, 12,  knob_strip, "SAT DRV", "%.1f", 8);
draw_knob_full(0.7826*gfx_w, 0.5898*gfx_h, slider12, -12, 12,  knob_strip, "MAKEUP",  "%.1f", 9);
draw_knob_full(0.9183*gfx_w, 0.5886*gfx_h, slider13,   0, 100, knob_strip, "DRY MIX", "%.1f", 10);

// ============================================================
// VU
// ============================================================
gr_db = 20 * log10(max(hold_max_gr_display, 0.0000001));
(gr_db > 0) ? gr_db = 0;
(gr_db < -20) ? gr_db = -20;
t = max(0, min(1, -gr_db / 20.0));

vu_x = 0.380 * gfx_w;
vu_y = 0.115 * gfx_h;
vu_w = 0.270 * gfx_w;

vf_w = 0; vf_h = 0;
gfx_getimgdim(8, vf_w, vf_h);

(vf_w > 0) ? ( vu_h = vu_w * vf_h / vf_w; ) : ( vu_h = 0.22 * gfx_h; );

(vf_w > 0) ? (
  blit_c[0] = 0; blit_c[1] = 0;
  blit_c[2] = vf_w; blit_c[3] = vf_h;
  blit_c[4] = vu_x; blit_c[5] = vu_y;
  blit_c[6] = vu_w; blit_c[7] = vu_h;
  gfx_blitext(8, blit_c, 0);
) : (
  gfx_set(0, 0, 0, 0.55);
  rr(vu_x + 2, vu_y + 2, vu_w, vu_h, 10);
  gfx_set(0.06, 0.06, 0.07, 1);
  rr(vu_x, vu_y, vu_w, vu_h, 10);
  gfx_set(0.30, 0.30, 0.34, 1);
  rr(vu_x + 3, vu_y + 3, vu_w - 6, vu_h - 6, 8);
  gfx_set(0.10, 0.10, 0.12, 1);
  rr(vu_x + 5, vu_y + 5, vu_w - 10, vu_h - 10, 7);
  vgrad(vu_x + 9, vu_y + 9, vu_w - 18, vu_h - 18, 0.92, 0.85, 0.66, 0.72, 0.64, 0.43);
);

pvx = vu_x + vu_w * 0.4987;
pvy = vu_y + vu_h * 0.97;

arc_deg_0  =  15;
arc_deg_20 = -62;

needle_len = vu_h * 0.65;

needle_deg = arc_deg_0 + t * (arc_deg_20 - arc_deg_0);
needle_ang = needle_deg * $pi / 180;

ntx = pvx + sin(needle_ang) * needle_len;
nty = pvy - cos(needle_ang) * needle_len;

gfx_set(0.10, 0.08, 0.05, 0.30);
gfx_line(pvx + 1, pvy + 1, ntx + 1, nty + 1);

gfx_set(0.05, 0.05, 0.05, 1);
gfx_line(pvx, pvy, ntx, nty);
gfx_line(pvx + 1, pvy, ntx + 1, nty);
gfx_line(pvx - 1, pvy, ntx - 1, nty);

gfx_set(0.35, 0.35, 0.35, 0.4);
gfx_line(pvx, pvy, ntx, nty);

gfx_set(0.10, 0.08, 0.05, 1);
gfx_circle(pvx, pvy, 5, 1);
gfx_set(0.22, 0.20, 0.15, 1);
gfx_circle(pvx, pvy, 3.5, 1);
gfx_set(0.45, 0.42, 0.35, 0.7);
gfx_circle(pvx - 1.2, pvy - 1.2, 1.2, 1);

// ============================================================
// GR READOUT
// ============================================================
gr_readout_x = vu_x + vu_w * 0.5;
gr_readout_y = vu_y + vu_h + 22*ls;

gr_box_w = 110 * ls;
gr_box_h = 34 * ls;

gfx_set(0, 0, 0, 0.55);
rr(gr_readout_x - gr_box_w*0.5 + 1, gr_readout_y - gr_box_h*0.5 + 2, gr_box_w, gr_box_h, 4);

gfx_set(lcR, lcG, lcB, 1);
rr(gr_readout_x - gr_box_w*0.5, gr_readout_y - gr_box_h*0.5, gr_box_w, gr_box_h, 4);

gfx_set(bdR, bdG, bdB, 0.7);
gfx_rect(gr_readout_x - gr_box_w*0.5 + 5, gr_readout_y - gr_box_h*0.5, gr_box_w - 10, 1);
gfx_set(0, 0, 0, 0.65);
gfx_rect(gr_readout_x - gr_box_w*0.5 + 5, gr_readout_y + gr_box_h*0.5 - 1, gr_box_w - 10, 1);

gfx_setfont(12, "Arial", max(6, floor(10*ls)), 'b');
gfx_set(dmR, dmG, dmB, 1);
gfx_measurestr("MAX GR", tw2, th2);
gfx_x = gr_readout_x - tw2*0.5;
gfx_y = gr_readout_y - gr_box_h*0.5 + 3;
gfx_drawstr("MAX GR");

gr_pk_abs = -peak_gr_db;
(gr_pk_abs < 0.05) ? ( gr_pk_abs = 0; );

(peak_gr_db > -0.05) ? ( gr_cr = dmR; gr_cg = dmG; gr_cb = dmB; ) :
(peak_gr_db > -3)    ? ( gr_cr = 0.35; gr_cg = 0.95; gr_cb = 0.45; ) :
(peak_gr_db > -8)    ? ( gr_cr = 0.98; gr_cg = 0.85; gr_cb = 0.30; ) :
                       ( gr_cr = 1.00; gr_cg = 0.35; gr_cb = 0.25; );

gr_str2 = sprintf(#, "%.1f dB", gr_pk_abs);

gfx_setfont(13, "Arial", max(9, floor(15*ls)), 'b');
gfx_set(gr_cr, gr_cg, gr_cb, 1);
gfx_measurestr(gr_str2, tw2, th2);
gfx_x = gr_readout_x - tw2*0.5;
gfx_y = gr_readout_y + gr_box_h*0.5 - th2 - 3;
gfx_drawstr(gr_str2);

gr_hit = (abs(mouse_x - gr_readout_x) < gr_box_w*0.5) && (abs(mouse_y - gr_readout_y) < gr_box_h*0.5);

(mouse_click && gr_hit) ? (
  (frame_count - click_gr_frame < 30) ? (
    peak_gr_db = 0;
    click_gr_frame = -100;
  ) : (
    click_gr_frame = frame_count;
  );
);

// ============================================================
// DROPDOWNS
// ============================================================
function draw_dd(cx, cy, w, h, lbl, str)
  local(x, y, ww, hh, lw, lh, ax, ay, ti)
(
  ww = w * gfx_w;
  hh = h * gfx_h;
  x = cx * gfx_w - ww * 0.5;
  y = cy * gfx_h - hh * 0.5;

  setfid(8);
  gfx_set(dmR, dmG, dmB, 1);
  gfx_measurestr(lbl, lw, lh);
  gfx_x = x + 2;
  gfx_y = y - lh - 4;
  gfx_drawstr(lbl);

  gfx_set(0, 0, 0, 0.6);
  rr(x + 1, y + 2, ww, hh, 5);

  gfx_set(0.035, 0.035, 0.045, 1);
  rr(x, y, ww, hh, 5);

  gfx_set(0.42, 0.42, 0.48, 0.85);
  gfx_rect(x + 5, y, ww - 10, 1);
  gfx_rect(x, y + 5, 1, hh - 10);
  gfx_rect(x + ww - 1, y + 5, 1, hh - 10);
  gfx_set(0.22, 0.22, 0.28, 0.7);
  gfx_rect(x + 5, y + hh - 1, ww - 10, 1);

  setfid(7);
  gfx_set(0.96, 0.96, 0.98, 1);
  gfx_measurestr(str, lw, lh);
  gfx_x = x + 10;
  gfx_y = y + (hh - lh) * 0.5 + 1;
  gfx_drawstr(str);

  ax = x + ww - 14;
  ay = y + hh * 0.5 - 3;
  gfx_set(0.96, 0.96, 0.98, 1);
  ti = 0;
  loop(6,
    gfx_rect(ax - 5 + ti, ay + ti, 11 - ti*2, 1);
    ti += 1;
  );
);

draw_dd(0.2285, 0.5978, 0.1013, 0.0720, "ATTACK MODE", atkmode_str(slider8|0));
draw_dd(0.5026, 0.7000, 0.0786, 0.0720, "SAT",         onoff_str(slider10|0));
draw_dd(0.1386, 0.8154, 0.0993, 0.0720, "MODE",        mode_str(slider14|0));
draw_dd(0.2823, 0.8154, 0.1096, 0.0720, "BYPASS",      onoff_str(slider15|0));
draw_dd(0.4312, 0.8154, 0.1303, 0.0720, "SIDECHAIN",   sctype_str(slider16|0));
draw_dd(0.5863, 0.8154, 0.1303, 0.0720, "SAT TYPE",    sattype_str(slider17|0));
draw_dd(0.7415, 0.8154, 0.1303, 0.0720, "AUTO MAKEUP", onoff_str(slider18|0));
draw_dd(0.8992, 0.8154, 0.1303, 0.0720, "LIMITER",     onoff_str(slider19|0));
draw_dd(0.3046, 0.9401, 0.0483, 0.0350, "DELTA",       onoff_str(slider21|0));
draw_dd(0.4157, 0.9401, 0.1200, 0.0720, "THEME",       theme_str(slider22|0));
draw_dd(0.5915, 0.9401, 0.1510, 0.0720, "OVERSAMPLE",  os_str(slider23|0));

// ============================================================
// TOGGLE SC FILTER
// ============================================================
function draw_toggle(cx, cy, on) local(x, y, w, h, r, kx)
(
  w = 44; h = 20;
  x = cx - w * 0.5; y = cy - h * 0.5;
  r = h * 0.5;
  gfx_set(0, 0, 0, 0.55);
  rr(x + 1, y + 1, w, h, r);
  (on) ? gfx_set(acR, acG, acB, 0.92) : gfx_set(lcR, lcG, lcB, 1);
  rr(x, y, w, h, r);
  gfx_set(bdR, bdG, bdB, 0.85);
  gfx_rect(x + r, y, w - h, 1);
  gfx_rect(x + r, y + h - 1, w - h, 1);
  (on) ? ( kx = x + w - r; ) : ( kx = x + r; );
  gfx_set(0, 0, 0, 0.5);
  gfx_circle(kx + 1, cy + 1, r - 2, 1);
  gfx_set(txR, txG, txB, 1);
  gfx_circle(kx, cy, r - 2, 1);
  gfx_set(1, 1, 1, 0.5);
  gfx_circle(kx - 1.2, cy - 1.2, 1.5, 1);
);

txt_c("SC FILTER", 0.3392*gfx_w, 0.40*gfx_h - 18, 8, dmR, dmG, dmB);
draw_toggle(0.3392*gfx_w, 0.40*gfx_h, slider3|0);

// ============================================================
// FADERS
// ============================================================
function draw_fader_code(xn, yn, wn, val, vmin, vmax, lbl, fmt)
  local(fw, fx, fy, tt, hx, hw, hh, s)
(
  fw = wn * gfx_w;
  fx = xn * gfx_w - fw * 0.5;
  fy = yn * gfx_h;

  txt_c(lbl, xn * gfx_w, fy - 14, 6, dmR, dmG, dmB);

  gfx_set(0, 0, 0, 0.5);
  rr(fx + 1, fy - 3 + 1, fw, 6, 3);
  gfx_set(lcR, lcG, lcB, 1);
  rr(fx, fy - 3, fw, 6, 3);
  gfx_set(bdR, bdG, bdB, 0.55);
  gfx_rect(fx + 3, fy - 3, fw - 6, 1);
  gfx_rect(fx + 3, fy + 2, fw - 6, 1);

  tt = max(0, min(1, (val - vmin) / (vmax - vmin)));
  (tt > 0.005) ? (
    gfx_set(acR, acG, acB, 0.55);
    rr(fx + 1, fy - 2, fw * tt - 2, 4, 2);
  );

  hw = 14; hh = 22;
  hx = fx + fw * tt;

  gfx_set(0, 0, 0, 0.6);
  rr(hx - hw*0.5 + 1, fy - hh*0.5 + 1, hw, hh, 3);
  gfx_set(pnR, pnG, pnB, 1);
  rr(hx - hw*0.5, fy - hh*0.5, hw, hh, 3);
  gfx_set(phR, phG, phB, 0.55);
  rr(hx - hw*0.5 + 2, fy - hh*0.5 + 2, hw - 4, 6, 2);
  gfx_set(bdR, bdG, bdB, 0.95);
  gfx_rect(hx - hw*0.5 + 3, fy - hh*0.5, hw - 6, 1);
  gfx_rect(hx - hw*0.5 + 3, fy + hh*0.5 - 1, hw - 6, 1);
  gfx_set(0, 0, 0, 0.6);
  gfx_rect(hx - 1, fy - 5, 2, 10);

  s = sprintf(#, fmt, val);
  txt_c(s, xn * gfx_w, fy + 20, 6, ltR, ltG, ltB);
);

draw_fader_code(0.1283, 0.9187, 0.1519, slider20, -12, 0,   "LIM CEIL", "%.1f");
draw_fader_code(0.8038, 0.9187, 0.1577, slider24, 0,   100, "PD REL",   "%.0f");

// ============================================================
// LEDs
// ============================================================
function draw_led(x, y, on, r, g, b) local(rr)
(
  rr = 4.0 * ks;
  (on > 0) ? (
    gfx_set(r, g, b, 0.15);
    gfx_circle(x, y, rr * 2.3, 1);
    gfx_set(r, g, b, 0.55);
    gfx_circle(x, y, rr * 1.5, 1);
    gfx_set(r, g, b, 1);
    gfx_circle(x, y, rr, 1);
    gfx_set(1, 1, 1, 0.75);
    gfx_circle(x - rr*0.3, y - rr*0.3, rr*0.4, 1);
  ) : (
    gfx_set(0.06, 0.06, 0.06, 1);
    gfx_circle(x, y, rr, 1);
    gfx_set(r*0.22, g*0.22, b*0.22, 0.75);
    gfx_circle(x, y, rr*0.7, 1);
  );
);

draw_led(0.3392*gfx_w - 40, 0.40*gfx_h, slider3, 0.35, 0.95, 0.35);
draw_led(0.4819*gfx_w, 0.6750*gfx_h, slider10, 0.35, 0.95, 0.35);
draw_led(0.3379*gfx_w, 0.7973*gfx_h, slider15, 1.00, 0.40, 0.10);
draw_led(0.4935*gfx_w, 0.7973*gfx_h, slider16, 0.35, 0.95, 0.35);
draw_led(0.7999*gfx_w, 0.7973*gfx_h, slider18, 0.35, 0.95, 0.35);
draw_led(0.9633*gfx_w, 0.7973*gfx_h, slider19, 0.35, 0.95, 0.35);
draw_led(0.2750*gfx_w, 0.9175*gfx_h, slider21, 0.35, 0.95, 0.35);
draw_led(0.7046*gfx_w, 0.9175*gfx_h, slider23 > 0 ? 1 : 0, 0.35, 0.95, 0.35);

// ============================================================
// INTERACCIÓN
// ============================================================
function inrect(mxn, myn, xn, yn, hw, hh) ( (abs(mxn - xn) < hw) && (abs(myn - yn) < hh); );

frame_count += 1;
mouse_click = (mouse_cap & 1) && !(mouse_prev_cap & 1);
mouse_rclick = (mouse_cap & 2) && !(mouse_prev_cap & 2);
mouse_release = !(mouse_cap & 1) && (mouse_prev_cap & 1);
ui_changed = 0;

// === FIX 1: liberar active_knob si el botón no está presionado ===
(!(mouse_cap & 1) && active_knob > 0) ? ( active_knob = 0; );

// === FIX 2: liberar active_fader si el botón no está presionado ===
(!(mouse_cap & 1) && active_fader > 0) ? ( active_fader = 0; );

// === FIX 3: liberar edit_block cuando se suelta el mouse ===
(!(mouse_cap & 1)) ? ( edit_block = 0; );

// === FIX 4: rastrear cambio real del wheel ===
wheel_delta = mouse_wheel - prev_wheel;
prev_wheel = mouse_wheel;

mxn = mouse_x / gfx_w;
myn = mouse_y / gfx_h;

// ============================================================
// LCD HIT-TEST
// ============================================================
hit_lcd = 0;
(abs(mouse_x - 0.0911*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.2512*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 1 :
(abs(mouse_x - 0.2300*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.2536*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 2 :
(abs(mouse_x - 0.6951*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.2549*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 3 :
(abs(mouse_x - 0.8057*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.2585*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 4 :
(abs(mouse_x - 0.9214*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.2573*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 5 :
(abs(mouse_x - 0.0885*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.5874*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 6 :
(abs(mouse_x - 0.3651*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.5850*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 7 :
(abs(mouse_x - 0.6401*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.5886*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 8 :
(abs(mouse_x - 0.7826*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.5898*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 9 :
(abs(mouse_x - 0.9183*gfx_w) < lcd_w*0.5 && abs(mouse_y - (0.5886*gfx_h + lcd_yoff)) < lcd_h*0.5) ? hit_lcd = 10 : 0;

(mouse_click && hit_lcd > 0 && edit_slider == 0 && edit_block == 0) ? (
  edit_slider = hit_lcd;
  edit_val = 0;
  edit_dec = 0;
  edit_has_dec = 0;
  edit_neg = 0;
  edit_fresh = 1;
);

// ============================================================
// PROCESAMIENTO DE TECLADO
// ============================================================
(edit_slider > 0) ? (
  ch = gfx_getchar(0);
  (ch > 0) ? (
    (ch == 27) ? (
      edit_slider = 0;
      edit_block = 1;
    ) : (ch == 13) ? (
      final_v = edit_val / pow(10, edit_dec);
      (edit_neg) ? ( final_v = -final_v; );
      (edit_slider == 1)  ? ( slider1  = max(-12, min(12, final_v)); ) :
      (edit_slider == 2)  ? ( slider2  = max(40,  min(260, final_v)); ) :
      (edit_slider == 3)  ? ( slider4  = max(-40, min(0, final_v)); ) :
      (edit_slider == 4)  ? ( slider5  = max(1.1, min(20, final_v)); ) :
      (edit_slider == 5)  ? ( slider6  = max(0,   min(1, final_v)); ) :
      (edit_slider == 6)  ? ( slider7  = max(1,   min(100, final_v)); ) :
      (edit_slider == 7)  ? ( slider9  = max(50,  min(1000, final_v)); ) :
      (edit_slider == 8)  ? ( slider11 = max(-12, min(12, final_v)); ) :
      (edit_slider == 9)  ? ( slider12 = max(-12, min(12, final_v)); ) :
                            ( slider13 = max(0,   min(100, final_v)); );
      edit_slider = 0;
      edit_block = 1;
      last_click_knob = 0;
      last_click_frame = -1000;
      ui_pending = 1;
      sliderchange(-1);
    ) : (ch == 8) ? (
      (edit_has_dec && edit_dec > 0) ? (
        edit_dec -= 1;
        edit_val = floor(edit_val / 10);
      ) : (edit_has_dec) ? (
        edit_has_dec = 0;
      ) : (
        edit_val = floor(edit_val / 10);
        (edit_val == 0) ? ( edit_fresh = 1; edit_neg = 0; );
      );
    ) : (ch >= 48 && ch <= 57) ? (
      d = ch - 48;
      (edit_fresh) ? ( edit_val = d; edit_fresh = 0; )
      : (edit_has_dec) ? ( edit_val = edit_val * 10 + d; edit_dec += 1; )
                       : ( edit_val = edit_val * 10 + d; );
    ) : (ch == 46 || ch == 44) ? (
      (edit_fresh) ? ( edit_val = 0; edit_fresh = 0; );
      edit_has_dec = 1;
    ) : (ch == 45) ? (
      edit_neg = !edit_neg;
    );
  );
);

// ============================================================
// WHEEL sobre knob — detecta SOLO cambios reales
// ============================================================
wheel_hover_knob = 0;
hit_r = 36 * ks;
(abs(mouse_x - 0.0911*gfx_w) < hit_r && abs(mouse_y - 0.2512*gfx_h) < hit_r) ? wheel_hover_knob = 1 :
(abs(mouse_x - 0.2300*gfx_w) < hit_r && abs(mouse_y - 0.2536*gfx_h) < hit_r) ? wheel_hover_knob = 2 :
(abs(mouse_x - 0.6951*gfx_w) < hit_r && abs(mouse_y - 0.2549*gfx_h) < hit_r) ? wheel_hover_knob = 3 :
(abs(mouse_x - 0.8057*gfx_w) < hit_r && abs(mouse_y - 0.2585*gfx_h) < hit_r) ? wheel_hover_knob = 4 :
(abs(mouse_x - 0.9214*gfx_w) < hit_r && abs(mouse_y - 0.2573*gfx_h) < hit_r) ? wheel_hover_knob = 5 :
(abs(mouse_x - 0.0885*gfx_w) < hit_r && abs(mouse_y - 0.5874*gfx_h) < hit_r) ? wheel_hover_knob = 6 :
(abs(mouse_x - 0.3651*gfx_w) < hit_r && abs(mouse_y - 0.5850*gfx_h) < hit_r) ? wheel_hover_knob = 7 :
(abs(mouse_x - 0.6401*gfx_w) < hit_r && abs(mouse_y - 0.5886*gfx_h) < hit_r) ? wheel_hover_knob = 8 :
(abs(mouse_x - 0.7826*gfx_w) < hit_r && abs(mouse_y - 0.5898*gfx_h) < hit_r) ? wheel_hover_knob = 9 :
(abs(mouse_x - 0.9183*gfx_w) < hit_r && abs(mouse_y - 0.5886*gfx_h) < hit_r) ? wheel_hover_knob = 10 : 0;

(wheel_hover_knob > 0 && wheel_delta != 0 && edit_slider == 0 && edit_block == 0) ? (
  wstep = (wheel_delta > 0) ? 1 : -1;
  (wheel_hover_knob == 1)  ? ( slider1  = max(-12, min(12,   slider1  + wstep * 0.01));  ) :
  (wheel_hover_knob == 2)  ? ( slider2  = max(40,  min(260,  slider2  + wstep * 0.5));   ) :
  (wheel_hover_knob == 3)  ? ( slider4  = max(-40, min(0,    slider4  + wstep * 0.01));  ) :
  (wheel_hover_knob == 4)  ? ( slider5  = max(1.1, min(20,   slider5  + wstep * 0.01));  ) :
  (wheel_hover_knob == 5)  ? ( slider6  = max(0,   min(1,    slider6  + wstep * 0.001)); ) :
  (wheel_hover_knob == 6)  ? ( slider7  = max(1,   min(100,  slider7  + wstep * 0.05));  ) :
  (wheel_hover_knob == 7)  ? ( slider9  = max(50,  min(1000, slider9  + wstep * 0.5));   ) :
  (wheel_hover_knob == 8)  ? ( slider11 = max(-12, min(12,   slider11 + wstep * 0.01));  ) :
  (wheel_hover_knob == 9)  ? ( slider12 = max(-12, min(12,   slider12 + wstep * 0.01));  ) :
                             ( slider13 = max(0,   min(100,  slider13 + wstep * 0.1));   );
  ui_pending = 1;
  sliderchange(-1);
);

// ============================================================
// KNOB DRAG
// ============================================================
hit_knob = 0;
(abs(mouse_x - 0.0927*gfx_w) < hit_r && abs(mouse_y - 0.2561*gfx_h) < hit_r) ? hit_knob = 1 :
(abs(mouse_x - 0.2310*gfx_w) < hit_r && abs(mouse_y - 0.2646*gfx_h) < hit_r) ? hit_knob = 2 :
(abs(mouse_x - 0.6957*gfx_w) < hit_r && abs(mouse_y - 0.2609*gfx_h) < hit_r) ? hit_knob = 3 :
(abs(mouse_x - 0.8062*gfx_w) < hit_r && abs(mouse_y - 0.2633*gfx_h) < hit_r) ? hit_knob = 4 :
(abs(mouse_x - 0.9214*gfx_w) < hit_r && abs(mouse_y - 0.2561*gfx_h) < hit_r) ? hit_knob = 5 :
(abs(mouse_x - 0.0896*gfx_w) < hit_r && abs(mouse_y - 0.5922*gfx_h) < hit_r) ? hit_knob = 6 :
(abs(mouse_x - 0.3656*gfx_w) < hit_r && abs(mouse_y - 0.5862*gfx_h) < hit_r) ? hit_knob = 7 :
(abs(mouse_x - 0.6396*gfx_w) < hit_r && abs(mouse_y - 0.5922*gfx_h) < hit_r) ? hit_knob = 8 :
(abs(mouse_x - 0.7821*gfx_w) < hit_r && abs(mouse_y - 0.5910*gfx_h) < hit_r) ? hit_knob = 9 :
(abs(mouse_x - 0.9183*gfx_w) < hit_r && abs(mouse_y - 0.5910*gfx_h) < hit_r) ? hit_knob = 10 : 0;

(edit_slider > 0 || edit_block > 0) ? ( hit_knob = 0; );

is_double = 0;
(mouse_click && hit_knob > 0 && hit_knob == last_click_knob && frame_count - last_click_frame < 25 && edit_block == 0 && edit_slider == 0) ? is_double = 1;
(mouse_click && hit_knob > 0) ? ( last_click_knob = hit_knob; last_click_frame = frame_count; );

(mouse_click && hit_knob > 0) ? (
  (is_double) ? (
    (hit_knob == 1)  ? ( slider1  = 0;   ) :
    (hit_knob == 2)  ? ( slider2  = 120; ) :
    (hit_knob == 3)  ? ( slider4  = -10; ) :
    (hit_knob == 4)  ? ( slider5  = 4;   ) :
    (hit_knob == 5)  ? ( slider6  = 1;   ) :
    (hit_knob == 6)  ? ( slider7  = 10;  ) :
    (hit_knob == 7)  ? ( slider9  = 110; ) :
    (hit_knob == 8)  ? ( slider11 = 6;   ) :
    (hit_knob == 9)  ? ( slider12 = 0;   ) :
                       ( slider13 = 0;   );
    active_knob = 0;
    ui_changed = 1;
  ) : (
    active_knob = hit_knob;
    drag_y0 = mouse_y;
    (active_knob == 1)  ? (drag_v0 = slider1;  drag_min=-12; drag_max=12;  drag_def=0; ) :
    (active_knob == 2)  ? (drag_v0 = slider2;  drag_min=40;  drag_max=260; drag_def=120; ) :
    (active_knob == 3)  ? (drag_v0 = slider4;  drag_min=-40; drag_max=0;   drag_def=-10; ) :
    (active_knob == 4)  ? (drag_v0 = slider5;  drag_min=1.1; drag_max=20;  drag_def=4; ) :
    (active_knob == 5)  ? (drag_v0 = slider6;  drag_min=0;   drag_max=1;   drag_def=1; ) :
    (active_knob == 6)  ? (drag_v0 = slider7;  drag_min=1;   drag_max=100; drag_def=10; ) :
    (active_knob == 7)  ? (drag_v0 = slider9;  drag_min=50;  drag_max=1000;drag_def=110; ) :
    (active_knob == 8)  ? (drag_v0 = slider11; drag_min=-12; drag_max=12;  drag_def=6; ) :
    (active_knob == 9)  ? (drag_v0 = slider12; drag_min=-12; drag_max=12;  drag_def=0; ) :
                          (drag_v0 = slider13; drag_min=0;   drag_max=100; drag_def=0; );
  );
);

(active_knob > 0) ? (
  dy = drag_y0 - mouse_y;
  nv = drag_v0 + (dy / 200.0) * (drag_max - drag_min);
  nv = max(drag_min, min(drag_max, nv));
  (active_knob == 1)  ? ( slider1 = nv; ) :
  (active_knob == 2)  ? ( slider2 = nv; ) :
  (active_knob == 3)  ? ( slider4 = nv; ) :
  (active_knob == 4)  ? ( slider5 = nv; ) :
  (active_knob == 5)  ? ( slider6 = nv; ) :
  (active_knob == 6)  ? ( slider7 = nv; ) :
  (active_knob == 7)  ? ( slider9 = nv; ) :
  (active_knob == 8)  ? ( slider11 = nv; ) :
  (active_knob == 9)  ? ( slider12 = nv; ) :
                        ( slider13 = nv; );
  ui_changed = 1;
);

hit_dd = 0;
inrect(mxn, myn, 0.2285, 0.5978, 0.055, 0.045) ? hit_dd = 8  :
inrect(mxn, myn, 0.5026, 0.7000, 0.045, 0.045) ? hit_dd = 10 :
inrect(mxn, myn, 0.1386, 0.8154, 0.055, 0.045) ? hit_dd = 14 :
inrect(mxn, myn, 0.2823, 0.8154, 0.060, 0.045) ? hit_dd = 15 :
inrect(mxn, myn, 0.4312, 0.8154, 0.070, 0.045) ? hit_dd = 16 :
inrect(mxn, myn, 0.5863, 0.8154, 0.070, 0.045) ? hit_dd = 17 :
inrect(mxn, myn, 0.7415, 0.8154, 0.070, 0.045) ? hit_dd = 18 :
inrect(mxn, myn, 0.8992, 0.8154, 0.070, 0.045) ? hit_dd = 19 :
inrect(mxn, myn, 0.3046, 0.9401, 0.030, 0.028) ? hit_dd = 21 :
inrect(mxn, myn, 0.4157, 0.9401, 0.065, 0.045) ? hit_dd = 22 :
inrect(mxn, myn, 0.5915, 0.9401, 0.080, 0.045) ? hit_dd = 23 : 0;

((mouse_click || mouse_rclick) && hit_dd > 0 && edit_slider == 0 && edit_block == 0) ? (
  ddir = mouse_rclick ? -1 : 1;
  (hit_dd == 8)  ? ( slider8  = ((slider8|0)  + ddir + 5) % 5;  ) :
  (hit_dd == 10) ? ( slider10 = !(slider10|0); ) :
  (hit_dd == 14) ? ( slider14 = ((slider14|0) + ddir + 6) % 6;  ) :
  (hit_dd == 15) ? ( slider15 = !(slider15|0); ) :
  (hit_dd == 16) ? ( slider16 = !(slider16|0); ) :
  (hit_dd == 17) ? ( slider17 = ((slider17|0) + ddir + 4) % 4;  ) :
  (hit_dd == 18) ? ( slider18 = !(slider18|0); ) :
  (hit_dd == 19) ? ( slider19 = !(slider19|0); ) :
  (hit_dd == 21) ? ( slider21 = !(slider21|0); ) :
  (hit_dd == 22) ? ( slider22 = ((slider22|0) + ddir + 4) % 4;  ) :
                   ( slider23 = ((slider23|0) + ddir + 3) % 3;  );
  ui_changed = 1;
);

hit_scf = inrect(mxn, myn, 0.3392, 0.40, 0.038, 0.045);
((mouse_click || mouse_rclick) && hit_scf && edit_slider == 0 && edit_block == 0) ? ( slider3 = !(slider3|0); ui_changed = 1; );

hit_fader = 0;
inrect(mxn, myn, 0.1283, 0.9187, 0.076, 0.030) ? hit_fader = 1 :
inrect(mxn, myn, 0.8038, 0.9187, 0.079, 0.030) ? hit_fader = 2 : 0;

(mouse_click && hit_fader > 0 && edit_slider == 0 && edit_block == 0) ? ( active_fader = hit_fader; );

(active_fader > 0) ? (
  (mouse_cap & 1) ? (
    fw = ((active_fader == 1) ? 0.1519 : 0.1577) * gfx_w;
    fx0 = ((active_fader == 1) ? 0.1283 : 0.8038) * gfx_w - fw * 0.5;
    tt = (mouse_x - fx0) / fw;
    tt = max(0, min(1, tt));
    (active_fader == 1) ? ( slider20 = -12 + tt * 12; ) : ( slider24 = tt * 100; );
    ui_changed = 1;
  ) : ( active_fader = 0; );
);

// === FIX 5: reset del click_gr_frame si el click no es sobre el GR ===
(mouse_click && !gr_hit) ? ( click_gr_frame = -100; );

(mouse_rclick && hit_dd == 0 && hit_fader == 0 && !hit_scf && hit_knob == 0 && !gr_hit && edit_slider == 0 && edit_block == 0 && active_knob == 0) ? (
  slider22 = ((slider22|0) + 1) % 4;
  ui_changed = 1;
);

(ui_changed) ? (
  ui_pending = 1;
  sliderchange(-1);
);

hold_max_gr_display = hold_max_gr_display * 0.999;
(compressor.gr < hold_max_gr_display) ? ( hold_max_gr_display = compressor.gr; );

mouse_prev_cap = mouse_cap;
