desc:       Komplot AV Compresor con Saturacion
version:    6.4.4
author:     Adrian Vazquez
provides:   brian.png, adri.png, mayte.png, vicky.png, komplot_knobs_brian.png, komplot_knobs_adri.png, komplot_knobs_mayte.png, komplot_knobs_vicky.png, komplot_needle.png, komplot_dropdown.png, komplot_toggle.png, komplot_fader.png, komplot_fader_handle.png
tags:       compressor dynamics saturation

slider1:0<-12,12,0.1>-Input, dB
slider2:120<40,260,1>-SC Filter Freq, Hz
slider3:1<0,1,1{Off,On}>-SC Filter
slider4:-10<-40,0,0.1>-Threshold, dB
slider5:4.0<1.1,20,0.1>-Ratio, :1
slider6:1.0<0.0,1.0,0.01>-Knee
slider7:10<1,100,0.1>-Attack, ms
slider8:0<0,4,1{Alpha,Epsilon,Gamma,Dseta,Beta}>-Attack Mode
slider9:110<50,1000,0.1>-Release, ms
slider10:1<0,1,1{Off,On}>-Sat
slider11:6<-12,12,0.1>-Sat Drive, dB
slider12:0<-12,12,0.1>-Makeup, dB
slider13:0<0,100,0.1>-Dry Mix, %
slider14:5<0,5,1{Mono,Dual Mono,M,S,MS,Stereo}>-Mode
slider15:0<0,1,1{Off,On}>-Bypass
slider16:0<0,1,1{Int SC.,Ext SC.}>-Sidechain
slider17:0<0,3,1{Clean,Tape,Tube,Transistor}>-Sat Type
slider18:0<0,1,1{Off,On}>-Auto Makeup
slider19:0<0,1,1{Off,On}>-Limiter
slider20:-0.3<-12,0,0.1>-Limiter Ceiling, dB
slider21:0<0,1,1{Off,On}>-Delta
slider22:0<0,3,1{Brian,Adri,Mayte,Vicky}>-Skin
slider23:0<0,2,1{Off,2x,4x}>-Oversampling
slider24:50<0,100,1>-PD Release, %

in_pin:left input
in_pin:right input
in_pin:sidechain left input
in_pin:sidechain right input
out_pin:left output
out_pin:right output

filename:0,brian.png
filename:1,adri.png
filename:2,mayte.png
filename:3,vicky.png
filename:4,komplot_knobs_brian.png
filename:5,komplot_knobs_adri.png
filename:6,komplot_knobs_mayte.png
