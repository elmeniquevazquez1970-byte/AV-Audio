slider1 == 6 ? gfx_drawstr("06: 480L Large Church") :
slider1 == 7 ? gfx_drawstr("07: 480L Small Church") :
slider1 == 8 ? gfx_drawstr("08: 480L Jazz Hall") :
slider1 == 9 ? gfx_drawstr("09: 480L Auto Park") :
slider1 == 10? gfx_drawstr("10: Lexicon 300 Dance Hall") :
slider1 == 11? gfx_drawstr("11: Lexicon 300 Large Hall") :
slider1 == 12? gfx_drawstr("12: Lexicon 300 Lecture Hall") :
slider1 == 13? gfx_drawstr("13: Lexicon 300 Medium Hall") :
slider1 == 14? gfx_drawstr("14: Lexicon 300 Small Hall") :
slider1 == 15? gfx_drawstr("15: EM2450 Hall Huge") :
slider1 == 16? gfx_drawstr("16: EM2450 Hall Large") :
slider1 == 17? gfx_drawstr("17: EM2450 Hall Medium") :
slider1 == 18? gfx_drawstr("18: EM2450 Hall Small") :
slider1 == 19? gfx_drawstr("19: EM2460 Hall Large 1") :
slider1 == 20? gfx_drawstr("20: EM2460 Hall Large 2") :
slider1 == 21? gfx_drawstr("21: EM2460 Hall Large 3") :
slider1 == 22? gfx_drawstr("22: EM2460 Hall Large Damped") :
slider1 == 23? gfx_drawstr("23: EM2460 Hall Medium 1") :
slider1 == 24? gfx_drawstr("24: EM2460 Hall Medium 2") :
slider1 == 25? gfx_drawstr("25: 248 Hall Small") :
slider1 == 26? gfx_drawstr("26: 248 Hall Medium") :
slider1 == 27? gfx_drawstr("27: 248 Hall Large") :
slider1 == 28? gfx_drawstr("28: 248 Hall Huge") :
slider1 == 29? gfx_drawstr("29: 250 Concert Hall") :
slider1 == 30? gfx_drawstr("30: 250 Concert Hall Bright") :
slider1 == 31? gfx_drawstr("31: M7 Large Hall 01") :
slider1 == 32? gfx_drawstr("32: M7 Medium Hall 02") :
slider1 == 33? gfx_drawstr("33: M7 Small Hall 03") :
slider1 == 34? gfx_drawstr("34: M7 Large & Near 04") :
slider1 == 35? gfx_drawstr("35: M7 Cathedral") :
slider1 == 36? gfx_drawstr("36: M7 Vocal Hall") :
slider1 == 37? gfx_drawstr("37: M7 Bright Stage") :
slider1 == 38? gfx_drawstr("38: M7 Scoring Hall") :
slider1 == 39? gfx_drawstr("39: M7 Wood Hall") :
gfx_drawstr("40: Custom / Manual Controls");

// Navigation arrows
gfx_r = 0.8; gfx_g = 0.8; gfx_b = 0.8;
gfx_x = bx + bw + 10; gfx_y = by + 6; gfx_drawstr("<");
gfx_x = bx + bw + 25; gfx_y = by + 6; gfx_drawstr(">");

// Main Banner Box (Plates Style)
gfx_r = 0.18; gfx_g = 0.20; gfx_b = 0.24; gfx_rect(20, 48, gfx_w - 40, 36, 1);
gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95; 
gfx_setfont(1, "Courier New", 13, 'b');
#banner_txt = engine_mode == 0 ? "LEXICON 480L / 300 ALGORITHMIC HALL ENGINE" : "BRICASTI M7 / 248 / 250 HYBRID HALL MODELING";
gfx_measurestr(#banner_txt, bw_w, bw_h);
gfx_x = (gfx_w * 0.5) - (bw_w * 0.5); gfx_y = 59;
gfx_drawstr(#banner_txt);

// ----------------------------------------------------------------------------
// ROTARY KNOB FUNCTION (WITH LOCAL VARS & CORRECTED time_precise)
// ----------------------------------------------------------------------------
function draw_knob(kx, ky, kr, val, min_v, max_v, default_v, label_str, val_mode, knob_id) 
local(dy, range, norm, ang, lx, ly, lw, lh, vw, vh)
(
  // Mouse Interaction Logic
  mouse_x >= kx - kr && mouse_x <= kx + kr && mouse_y >= ky - kr && mouse_y <= ky + kr ? (
    (mouse_cap & 1) && drag_knob == -1 ? (
      drag_knob = knob_id;
      drag_start_y = mouse_y;
      drag_start_val = val;

      // Double click detection with time_precise()
      time_precise() - last_click_time < 0.25 ? (
        val = default_v;
        drag_knob = -1;
      );
      last_click_time = time_precise();
    );
  );

  drag_knob == knob_id ? (
    (mouse_cap & 1) ? (
      dy = drag_start_y - mouse_y;
      range = max_v - min_v;
      val = drag_start_val + (dy * (range / 150));
      val = max(min_v, min(max_v, val));
    ) : (
      drag_knob = -1;
    );
  );

  // Angle Calculation (-135 to +135 degrees)
  norm = (val - min_v) / (max_v - min_v);
  ang = -2.35619 + norm * 4.71239;

  // Outer Circle
  gfx_r = 0.22; gfx_g = 0.26; gfx_b = 0.32; gfx_a = 1.0;
  gfx_circle(kx, ky, kr, 0);

  // Indicator Line
  lx = kx + sin(ang) * (kr - 3);
  ly = ky - cos(ang) * (kr - 3);
  gfx_r = 0.65; gfx_g = 0.85; gfx_b = 0.80;
  gfx_line(kx, ky, lx, ly, 1);

  // Labels
  gfx_r = 0.85; gfx_g = 0.88; gfx_b = 0.92;
  gfx_setfont(1, "Courier New", 12, 'b');
  gfx_measurestr(label_str, lw, lh);
  gfx_x = kx - (lw * 0.5); gfx_y = ky + kr + 6;
  gfx_drawstr(label_str);

  // Formatted Value Output
  val_mode == 0 ? sprintf(#vstr, "%.2f s", val) :
  val_mode == 1 ? sprintf(#vstr, "%.0f %%", val) :
  val_mode == 2 ? sprintf(#vstr, "%d ms", val) :
  val_mode == 3 ? ( val >= 1000 ? sprintf(#vstr, "%.1f k", val/1000) : sprintf(#vstr, "%d Hz", val) ) :
  val_mode == 4 ? sprintf(#vstr, "%d %%", val) :
  val_mode == 5 ? sprintf(#vstr, "%.1f dB", val) :
  sprintf(#vstr, "%.2f", val);

  gfx_r = 0.65; gfx_g = 0.85; gfx_b = 0.80;
  gfx_setfont(1, "Courier New", 11);
  gfx_measurestr(#vstr, vw, vh);
  gfx_x = kx - (vw * 0.5); gfx_y = ky + kr + 19;
  gfx_drawstr(#vstr);

  val; // return updated value
);

// ----------------------------------------------------------------------------
// DRAW 12 KNOBS GRID (2 ROWS x 6 COLS)
// ----------------------------------------------------------------------------
row1_y = 135;
row2_y = 245;
col_w = 105;
start_x = 62;

// Row 1
slider2  = draw_knob(start_x + col_w * 0, row1_y, 22, slider2,  0.2, 8.0, 2.0, "Decay", 0, 2);
slider3  = draw_knob(start_x + col_w * 1, row1_y, 22, slider3,  0.5, 2.0, 1.0, "Size", 1, 3);
slider4  = draw_knob(start_x + col_w * 2, row1_y, 22, slider4,  0, 250, 25,   "Pre-delay", 2, 4);
slider5  = draw_knob(start_x + col_w * 3, row1_y, 22, slider5,  20, 500, 80,  "Low Cut", 3, 5);
slider6  = draw_knob(start_x + col_w * 4, row1_y, 22, slider6,  2000, 20000, 14000, "High Cut", 3, 6);
slider7  = draw_knob(start_x + col_w * 5, row1_y, 22, slider7,  800, 20000, 7500, "Hi Damping", 3, 7);

// Row 2
slider8  = draw_knob(start_x + col_w * 0, row2_y, 22, slider8,  0, 100, 75,  "Diffusion", 4, 8);
slider9  = draw_knob(start_x + col_w * 1, row2_y, 22, slider9,  0, 100, 35,  "Mod Depth", 4, 9);
slider10 = draw_knob(start_x + col_w * 2, row2_y, 22, slider10, 0, 100, 50,  "ER/Late", 4, 10);
slider11 = draw_knob(start_x + col_w * 3, row2_y, 22, slider11, 0, 200, 100, "Width", 4, 11);
slider12 = draw_knob(start_x + col_w * 4, row2_y, 22, slider12, -60, 12, 0,  "Gain", 5, 12);
slider13 = draw_knob(start_x + col_w * 5, row2_y, 22, slider13, -60, 12, -6, "Mix", 5, 13);

// Dropdown click handler
(mouse_cap & 1) && !(last_cap & 1) ? (
  mouse_x >= bx && mouse_x <= bx + bw && mouse_y >= by && mouse_y <= by + bh ? (
    sel = gfx_showmenu("00: 480L Large Hall|01: 480L Large Stage|02: 480L Medium Hall|03: 480L Medium Stage|04: 480L Small Hall|05: 480L Small Stage|06: 480L Large Church|07: 480L Small Church|08: 480L Jazz Hall|09: 480L Auto Park|10: Lexicon 300 Dance Hall|11: Lexicon 300 Large Hall|12: Lexicon 300 Lecture Hall|13: Lexicon 300 Medium Hall|14: Lexicon 300 Small Hall|15: EM2450 Hall Huge|16: EM2450 Hall Large|17: EM2450 Hall Medium|18: EM2450 Hall Small|19: EM2460 Hall Large 1|20: EM2460 Hall Large 2|21: EM2460 Hall Large 3|22: EM2460 Hall Large Damped|23: EM2460 Hall Medium 1|24: EM2460 Hall Medium 2|25: 248 Hall Small|26: 248 Hall Medium|27: 248 Hall Large|28: 248 Hall Huge|29: 250 Concert Hall|30: 250 Concert Hall Bright|31: M7 Large Hall 01|32: M7 Medium Hall 02|33: M7 Small Hall 03|34: M7 Large & Near 04|35: M7 Cathedral|36: M7 Vocal Hall|37: M7 Bright Stage|38: M7 Scoring Hall|39: M7 Wood Hall|40: Custom / Manual Controls");
    sel > 0 ? slider1 = sel - 1;
  );
  // Arrow clicks
  mouse_x >= bx + bw + 5 && mouse_x <= bx + bw + 18 && mouse_y >= by && mouse_y <= by + bh ? ( slider1 = max(0, slider1 - 1); );
  mouse_x >= bx + bw + 20 && mouse_x <= bx + bw + 35 && mouse_y >= by && mouse_y <= by + bh ? ( slider1 = min(40, slider1 + 1); );
);

last_cap = mouse_cap;
