desc:ReaDynEq
author:AV - Adrian Vazquez
options:gfx=1
in_pin:left input
in_pin:right input
in_pin:sc L
in_pin:sc R
out_pin:left output
out_pin:right output
slider1:0<0,0,1>--
slider2:0<0,0,1>--

@init

function draw_knob(kx, ky, kr, kangle) local(i, ang, perp_x, perp_y, bx1, by1, bx2, by2, tick_ang, tick_r1, tick_r2) (
  gfx_a = 1; gfx_r = 0.03; gfx_g = 0.03; gfx_b = 0.04;
  gfx_circle(kx, ky, kr + 4, 1);
  i = 0;
  while (i < 11) (
    tick_ang = -2.356 + (i / 10) * 4.712;
    tick_r1 = kr + 0.5;
    tick_r2 = (i % 5 == 0) ? kr + 4 : kr + 3;
    gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.7;
    gfx_x = kx + cos(tick_ang) * tick_r1 + 1;
    gfx_y = ky + sin(tick_ang) * tick_r1 + 1;
    gfx_lineto(kx + cos(tick_ang) * tick_r2 + 1, ky + sin(tick_ang) * tick_r2 + 1, 0);
    gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.95; gfx_a = 1;
    gfx_x = kx + cos(tick_ang) * tick_r1;
    gfx_y = ky + sin(tick_ang) * tick_r1;
    gfx_lineto(kx + cos(tick_ang) * tick_r2, ky + sin(tick_ang) * tick_r2, 0);
    i += 1;
  );
  i = 0;
  while (i < 20) (
    tick_ang = (i / 20) * 2 * $pi;
    gfx_r = 0.09; gfx_g = 0.09; gfx_b = 0.10; gfx_a = 1;
    gfx_circle(kx + cos(tick_ang) * (kr - 3), ky + sin(tick_ang) * (kr - 3), 3, 1);
    i += 1;
  );
  gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.06; gfx_a = 1;
  gfx_circle(kx, ky, kr - 3, 1);
  gfx_a = 1;
  gfx_r = 0.50; gfx_g = 0.50; gfx_b = 0.52; gfx_circle(kx, ky, kr - 7, 1);
  gfx_r = 0.44; gfx_g = 0.44; gfx_b = 0.46; gfx_circle(kx, ky, kr - 9, 1);
  gfx_r = 0.38; gfx_g = 0.38; gfx_b = 0.40; gfx_circle(kx, ky, kr - 11, 1);
  gfx_r = 0.32; gfx_g = 0.32; gfx_b = 0.34; gfx_circle(kx, ky, kr - 13, 1);
  gfx_r = 0.26; gfx_g = 0.26; gfx_b = 0.28; gfx_circle(kx, ky, kr - 15, 1);
  gfx_a = 0.25; gfx_r = 1; gfx_g = 1; gfx_b = 1;
  gfx_circle(kx - kr*0.20, ky - kr*0.20, kr - 13, 1);
  gfx_a = 0.4; gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.17;
  gfx_circle(kx, ky, 2.5, 1);
  ang = kangle;
  bx1 = kx + cos(ang) * (kr * 0.20);
  by1 = ky + sin(ang) * (kr * 0.20);
  bx2 = kx + cos(ang) * (kr * 0.70);
  by2 = ky + sin(ang) * (kr * 0.70);
  perp_x = -sin(ang) * 1.8;
  perp_y = cos(ang) * 1.8;
  gfx_a = 0.55; gfx_r = 0; gfx_g = 0; gfx_b = 0;
  gfx_x = bx1 + 1; gfx_y = by1 + 1; gfx_lineto(bx2 + 1, by2 + 1, 0);
  gfx_x = bx1 + 1 + perp_x; gfx_y = by1 + 1 + perp_y;
  gfx_lineto(bx2 + 1 + perp_x, by2 + 1 + perp_y, 0);
  gfx_x = bx1 + 1 - perp_x; gfx_y = by1 + 1 - perp_y;
  gfx_lineto(bx2 + 1 - perp_x, by2 + 1 - perp_y, 0);
  gfx_a = 1; gfx_r = 1; gfx_g = 1; gfx_b = 1;
  gfx_x = bx1; gfx_y = by1; gfx_lineto(bx2, by2, 0);
  gfx_x = bx1 + perp_x; gfx_y = by1 + perp_y; gfx_lineto(bx2 + perp_x, by2 + perp_y, 0);
  gfx_x = bx1 - perp_x; gfx_y = by1 - perp_y; gfx_lineto(bx2 - perp_x, by2 - perp_y, 0);
  gfx_circle(bx1, by1, 2.2, 1);
);

function freq_col(f) local(t, s) (
  t = (log(f) - 2.995732) / 6.907755;
  t = max(0, min(1, t));
  t < 0.30 ? ( s = t / 0.30; fc_r = 1.0; fc_g = s * 0.50; fc_b = 0.0; )
  : t < 0.55 ? ( s = (t - 0.30) / 0.25; fc_r = 1.0; fc_g = 0.50 + s * 0.50; fc_b = 0.0; )
  : t < 0.72 ? ( s = (t - 0.55) / 0.17; fc_r = 1.0 - s * 0.80; fc_g = 1.0; fc_b = 0.0; )
  : t < 0.87 ? ( s = (t - 0.72) / 0.15; fc_r = 0.20 - s * 0.20; fc_g = 1.0; fc_b = s * 1.0; )
  : ( s = (t - 0.87) / 0.13; fc_r = s * 0.55; fc_g = 1.0 - s * 0.80; fc_b = 1.0; );
);

init_done == 0 ? (
zoom_db = 6;
prev_cap = 0;
selected_band = 0;
drag_active = 0; drag_band_idx = 0; drag_which = 0;
q_drag_active = 0; q_drag_x0 = 0; q_drag_v0 = 0;
q_drag_active2 = 0; q_drag_x02 = 0; q_drag_v02 = 0;
off_drag_active = 0; off_drag_x0 = 0; off_drag_v0 = 0;
trim_drag = 0; trim_y0 = 0; trim_last_click_t = 0; trim_is_dbl = 0;
shift_down = 0; trim_speed = 0.006;
edit_mode = 0; edit_field = 0; edit_int = 0; edit_dec = 0;
edit_dec_places = 0; edit_neg = 0; edit_has_dot = 0;
q_pending = 0; q_click_t = 0; tgt_pending = 0; tgt_click_t = 0;
off_pending = 0; off_click_t = 0;
knob_lct = 25000;
knob_lct[0] = 0; knob_lct[1] = 0; knob_lct[2] = 0; knob_lct[3] = 0;
q_last_click_t = 0; tgt_last_click_t = 0; off_last_click_t = 0;
q_start_x_ = 0; tgt_start_x_ = 0; off_start_x_ = 0;
output_trim_db = 0; listen_band = -1; sc_listen_en = 0;
meter_in_peak_L = 0; meter_in_peak_R = 0;
meter_out_peak_L = 0; meter_out_peak_R = 0;
clip_in_flag = 0; clip_out_flag = 0;
clip_in_suppress = 0; clip_out_suppress = 0;
autogain_en = 0; autogain_sm = 0; ag_sm = 0;
ag_coef_slow = 0.9999; ag_coef_fast = 0.9999; ag_pred = 0; ag_i = 0;
state_cur = 0;
LOG_20 = log(20); LOG_20K = log(20000); LOG_RNG = LOG_20K - LOG_20;
LN10 = log(10); LN10_OVER_20 = LN10 / 20; INV_LN10 = 1 / LN10;
AG_EPS = 0.000000001;

// UI scale — 0=25%, 1=50%, 2=75%, 3=100%
ui_scale_int = 1.0;
ui_scale_idx = 3;

// Interaccion (se computan una sola vez por frame en @gfx)
mcap = 0; mdown = 0; mprev = 0; g_press = 0; g_release = 0;

band_freq = 100; band_gain = 110; band_q = 120; band_side = 130;
band_r = 140; band_g = 150; band_b = 160;
band_enabled = 170; band_type = 180; band_chan = 190;
band_target = 200; band_sc_en = 210; band_sc_type = 220;
band_sc_freq = 230; band_sc_q = 240; band_sc_ext = 250;
band_sc_chan = 260; band_detect = 270; band_trigger = 280;
band_thresh = 290; band_dyn = 300; band_attack = 310; band_release = 320;

band_freq[0]=100;   band_gain[0]=0; band_q[0]=70;   band_side[0]=0;
band_freq[1]=500;   band_gain[1]=0; band_q[1]=150;  band_side[1]=1;
band_freq[2]=2000;  band_gain[2]=0; band_q[2]=150;  band_side[2]=0;
band_freq[3]=6000;  band_gain[3]=0; band_q[3]=150;  band_side[3]=1;
band_freq[4]=12000; band_gain[4]=0; band_q[4]=70;   band_side[4]=0;

band_r[0]=0.35; band_g[0]=0.60; band_b[0]=1.00;
band_r[1]=0.30; band_g[1]=0.85; band_b[1]=0.40;
band_r[2]=0.95; band_g[2]=0.35; band_b[2]=0.35;
band_r[3]=1.00; band_g[3]=0.62; band_b[3]=0.20;
band_r[4]=0.90; band_g[4]=0.85; band_b[4]=0.30;

i = 0;
while (i < 5) (
  band_enabled[i] = 1; band_target[i] = 0; band_sc_en[i] = 0;
  band_sc_type[i] = 1; band_sc_freq[i] = band_freq[i]; band_sc_q[i] = 150;
  band_sc_ext[i] = 0; band_sc_chan[i] = 0; band_detect[i] = 0;
  band_trigger[i] = 0; band_thresh[i] = -48; band_dyn[i] = 100;
  band_attack[i] = 20; band_release[i] = 100;
  i = i + 1;
);

band_type[0] = 1; band_type[1] = 0; band_type[2] = 0;
band_type[3] = 0; band_type[4] = 2;
band_chan[0] = 0; band_chan[1] = 0; band_chan[2] = 0;
band_chan[3] = 0; band_chan[4] = 0;

GF = 500;
GF[0]=20; GF[1]=30; GF[2]=40; GF[3]=50; GF[4]=60; GF[5]=80;
GF[6]=100; GF[7]=200; GF[8]=300; GF[9]=400; GF[10]=500;
GF[11]=600; GF[12]=800; GF[13]=1000; GF[14]=2000;
GF[15]=3000; GF[16]=4000; GF[17]=5000; GF[18]=6000;
GF[19]=8000; GF[20]=10000; GF[21]=20000;
NGF = 22;
LBL = 550; LBL[0]=20; LBL[1]=200; LBL[2]=2000; LBL[3]=20000; NLBL = 4;

#strM = "M"; #strS = "S"; #strL = "L"; #strR = "R"; #strSt = "St";
#str_Stereo = "Stereo"; #str_Left = "Left"; #str_Right = "Right";
#str_Mid = "Mid"; #str_Side = "Side";
#str_Peak = "Peak"; #str_RMS = "RMS"; #str_Onsets = "Onsets";
#str_Above = "Above"; #str_Below = "Below";
#str_Detect = "Detect"; #str_Trigger = "Trigger";
#str_Threshold = "Threshold"; #str_Dynamics = "Dynamics";
#str_Attack = "Attack"; #str_Release = "Release";
#str_EQ = "EQ"; #str_SC = "SC"; #str_Ext = "Ext";
#str_Listen = "Listen"; #str_Trim = "Trim";
#str_A = "A"; #str_B = "B"; #str_SCL = "SC List";

knob_drag = 0; knob_y0 = 0;
EQ_Y = 422; EQ_H = 24;
SC_Y = 454; SC_H = 24;
SLIDER_Y = 494; SUB_Y = 518; SUB_H = 96;

dsp_state = 10000;
i = 0; while (i < 40) ( dsp_state[i] = 0; i = i + 1; );
dsp_env = 11000;
i = 0; while (i < 5) ( dsp_env[i] = 0; i = i + 1; );

dsp_g_v_arr = 15000; dsp_k_bell = 15100; dsp_a1_bell = 15200;
dsp_a2_bell = 15300; dsp_a1_shelf = 15400; dsp_a2_shelf = 15500;
i = 0;
while (i < 5) (
  dsp_g_v_arr[i] = 0.1; dsp_k_bell[i] = 1.0; dsp_a1_bell[i] = 0.9;
  dsp_a2_bell[i] = 0.1; dsp_a1_shelf[i] = 0.9; dsp_a2_shelf[i] = 0.1;
  i = i + 1;
);

dsp_sc_g = 16000; dsp_sc_k = 16100; dsp_sc_a1 = 16200; dsp_sc_a2 = 16300;
dsp_sc_is_bell = 16400; dsp_sc_is_low = 16500; dsp_sc_is_high = 16600;
i = 0;
while (i < 5) (
  dsp_sc_g[i] = 0.1; dsp_sc_k[i] = 1.0; dsp_sc_a1[i] = 0.9; dsp_sc_a2[i] = 0.1;
  dsp_sc_is_bell[i] = 1; dsp_sc_is_low[i] = 0; dsp_sc_is_high[i] = 0;
  i = i + 1;
);

dsp_env_fast = 17000; dsp_env_slow = 17100;
dsp_atc_fast = 17200; dsp_rtc_fast = 17300;
dsp_atc_slow = 17400; dsp_rtc_slow = 17500;
i = 0;
while (i < 5) (
  dsp_env_fast[i] = 0; dsp_env_slow[i] = 0;
  dsp_atc_fast[i] = 0.99; dsp_rtc_fast[i] = 0.999;
  dsp_atc_slow[i] = 0.999; dsp_rtc_slow[i] = 0.9999;
  i = i + 1;
);

dsp_env_sq = 17600;
i = 0; while (i < 5) ( dsp_env_sq[i] = 0; i = i + 1; );

dsp_atc = 12700; dsp_rtc = 12800;
i = 0;
while (i < 5) ( dsp_atc[i] = 0.99; dsp_rtc[i] = 0.999; i = i + 1; );

band_dyn_vis = 13000;
i = 0; while (i < 5) ( band_dyn_vis[i] = 0; i = i + 1; );

dsp_on_sm = 14000; dsp_A_db_sm = 14100;
i = 0;
while (i < 5) (
  dsp_on_sm[i] = 1; dsp_A_db_sm[i] = band_gain[i];
  i = i + 1;
);

// RBJ shelf state
dsp_shelf_z1_mid = 19000;
dsp_shelf_z2_mid = 19100;
dsp_shelf_z1_sid = 19200;
dsp_shelf_z2_sid = 19300;
dsp_cosw0_arr    = 19400;
dsp_sinw0_arr    = 19500;
i = 0;
while (i < 5) (
  dsp_shelf_z1_mid[i] = 0; dsp_shelf_z2_mid[i] = 0;
  dsp_shelf_z1_sid[i] = 0; dsp_shelf_z2_sid[i] = 0;
  dsp_cosw0_arr[i] = 1; dsp_sinw0_arr[i] = 0;
  i += 1;
);

dsp_coef_smooth_A = 0.99;
dsp_coef_smooth_on = 0.99;
state_A = 20000; state_B = 20100; state_cur = 20200;

undo_buf = 21000;
undo_head_ = 23000; undo_pos_ = 23001; undo_size_ = 23002;
undo_busy = 23003; undo_initialized = 23004;
last_saved = 23100; tmp_save = 23200;
undo_head_[0] = 0; undo_pos_[0] = 0; undo_size_[0] = 0;
undo_busy[0] = 0; undo_initialized[0] = 0;
i = 0;
while (i < 100) ( last_saved[i] = -99999; tmp_save[i] = 0; i += 1; );

// ===== SPECTRUM ANALYZER (dual: pre-EQ y post-EQ) =====
FFT_MAX = 8192;
fft_buf     = 400000;
fft_win     = 420000;
fft_ring    = 430000;
fft_ring_in = 440000;
fft_mag     = 450000;
fft_mag_in  = 455000;
fft_widx    = 460000;
fft_norm    = 460001;
fft_size_arr = 460010;
fft_size_arr[0]=1024; fft_size_arr[1]=2048;
fft_size_arr[2]=4096; fft_size_arr[3]=8192;
fft_size_count = 4;
fft_size_idx = 1;
fft_size_cur = 2048;
fft_size_last = 0;

an_overlay_main = 0;
an_last_click_t = 0;
an_range_lo_db = -100;
an_range_hi_db = 0;

fft_i = 0;
while (fft_i < FFT_MAX) (
  fft_ring[fft_i] = 0;
  fft_ring_in[fft_i] = 0;
  fft_i += 1;
);
fft_i = 0;
while (fft_i < FFT_MAX/2) (
  fft_mag[fft_i] = -120;
  fft_mag_in[fft_i] = -120;
  fft_i += 1;
);
fft_widx[0] = 0;

// ===== ANALIZADOR ReSpectrum-style (autocontenido) =====
rs_spec_mode = 1;
rs_display_mode = 1;
rs_ceiling_idx = 0;
rs_floor_idx = 0;
rs_tilt_idx = 0;
rs_window_type = 1;
rs_block_idx = 2;
rs_show_peaks = 0;

rs_ceiling = 0; rs_floor = -90; rs_tilt_db = 0;
rs_block_size = 8192; rs_block_size_prev = 0;
rs_win_gain_db = -8.9;

RS_MAX = 16384;
rs_ring_mid  = 500000;
rs_ring_side = 520000;
rs_fft_buf   = 540000;
rs_fft_win   = 580000;
rs_mag_mid   = 600000;
rs_mag_side  = 610000;
rs_peak_mid  = 620000;
rs_peak_side = 630000;
rs_widx      = 640000; rs_widx[0] = 0;

rs_ri = 0; while (rs_ri < RS_MAX) ( rs_ring_mid[rs_ri]=0; rs_ring_side[rs_ri]=0; rs_ri+=1; );
rs_ri = 0; while (rs_ri < 8192) (
  rs_mag_mid[rs_ri]=-200; rs_mag_side[rs_ri]=-200;
  rs_peak_mid[rs_ri]=-200; rs_peak_side[rs_ri]=-200;
  rs_ri+=1;
);

rs_listen_freq = 1000; rs_listen_q = 1;
rs_listen_ic1 = 0; rs_listen_ic2 = 0;
rs_lg = 0; rs_lk = 1; rs_la1 = 1; rs_la2 = 0; rs_la3 = 0;
rs_do_listen = 0; rs_listen_width = 0.10; rs_last_wheel = 0;

rs_expanded = 0;
rs_last_click_t = 0;
imgdim_ready = 0;

init_done = 1;
);

@serialize
_i = 0;
while (_i < 5) (
  file_var(_i*20 + 0, band_freq[_i]); file_var(_i*20 + 1, band_gain[_i]);
  file_var(_i*20 + 2, band_target[_i]); file_var(_i*20 + 3, band_q[_i]);
  file_var(_i*20 + 4, band_enabled[_i]); file_var(_i*20 + 5, band_type[_i]);
  file_var(_i*20 + 6, band_chan[_i]); file_var(_i*20 + 7, band_thresh[_i]);
  file_var(_i*20 + 8, band_dyn[_i]); file_var(_i*20 + 9, band_attack[_i]);
  file_var(_i*20 + 10, band_release[_i]); file_var(_i*20 + 11, band_detect[_i]);
  file_var(_i*20 + 12, band_trigger[_i]); file_var(_i*20 + 13, band_sc_en[_i]);
  file_var(_i*20 + 14, band_sc_type[_i]); file_var(_i*20 + 15, band_sc_freq[_i]);
  file_var(_i*20 + 16, band_sc_q[_i]); file_var(_i*20 + 17, band_sc_ext[_i]);
  file_var(_i*20 + 18, band_sc_chan[_i]);
  _i += 1;
);
file_var(200, selected_band); file_var(201, zoom_db);
file_var(202, output_trim_db); file_var(203, listen_band);
file_var(204, autogain_en);
file_var(205, fft_size_idx);
file_var(206, an_overlay_main);
file_var(207, rs_spec_mode);
file_var(208, rs_display_mode);
file_var(209, rs_ceiling_idx);
file_var(210, rs_floor_idx);
file_var(211, rs_tilt_idx);
file_var(212, rs_window_type);
file_var(213, rs_block_idx);
file_var(214, rs_show_peaks);
file_var(215, rs_expanded);
file_var(216, ui_scale_int);

@block
dsp_sr = srate; dsp_sr = max(8000, dsp_sr); dsp_nyq_safe = dsp_sr * 0.49;
dsp_coef_smooth_A = exp(-1 / (dsp_sr * 0.008));
dsp_coef_smooth_on = exp(-1 / (dsp_sr * 0.010));
dsp_smooth_coef = exp(-1 / (dsp_sr * 0.001));
meter_coef = exp(-1 / (dsp_sr * 0.350));
ag_coef_slow = exp(-1 / (dsp_sr * 0.08));
ag_coef_fast = exp(-1 / (dsp_sr * 0.04));

dsp_b = 0;
while (dsp_b < 5) (
  dsp_freq = band_freq[dsp_b]; dsp_Q = band_q[dsp_b] * 0.01;
  dsp_freq = max(20, min(20000, dsp_freq));
  dsp_freq = min(dsp_freq, dsp_nyq_safe);
  dsp_Q = max(0.3, min(16, dsp_Q));
  dsp_g_v = tan($pi * dsp_freq / dsp_sr);
  dsp_k_b = 1 / dsp_Q;
  dsp_den_b = 1 + dsp_g_v * (dsp_g_v + dsp_k_b);
  dsp_a1_b = 1 / dsp_den_b; dsp_a2_b = dsp_g_v * dsp_a1_b;
  dsp_g_v_arr[dsp_b] = dsp_g_v; dsp_k_bell[dsp_b] = dsp_k_b;
  dsp_a1_bell[dsp_b] = dsp_a1_b; dsp_a2_bell[dsp_b] = dsp_a2_b;

  // Precompute cos/sin for RBJ shelf
  dsp_w0_b = 2 * $pi * dsp_freq / dsp_sr;
  dsp_cosw0_arr[dsp_b] = cos(dsp_w0_b);
  dsp_sinw0_arr[dsp_b] = sin(dsp_w0_b);

  dsp_sc_f = band_sc_en[dsp_b]*band_sc_freq[dsp_b] + (1-band_sc_en[dsp_b])*band_freq[dsp_b];
  dsp_sc_q = band_sc_en[dsp_b]*band_sc_q[dsp_b]*0.01 + (1-band_sc_en[dsp_b])*band_q[dsp_b]*0.01;
  dsp_sc_t = band_sc_en[dsp_b]*band_sc_type[dsp_b] + (1-band_sc_en[dsp_b])*band_type[dsp_b];
  dsp_sc_f = max(20, min(20000, dsp_sc_f));
  dsp_sc_f = min(dsp_sc_f, dsp_nyq_safe);
  dsp_sc_q = max(0.3, min(16, dsp_sc_q));
  dsp_sc_gv = tan($pi * dsp_sc_f / dsp_sr);
  dsp_sc_kv = 1 / dsp_sc_q;
  dsp_sc_den = 1 + dsp_sc_gv * (dsp_sc_gv + dsp_sc_kv);
  dsp_sc_a1v = 1 / dsp_sc_den; dsp_sc_a2v = dsp_sc_gv * dsp_sc_a1v;
  dsp_sc_g[dsp_b] = dsp_sc_gv; dsp_sc_k[dsp_b] = dsp_sc_kv;
  dsp_sc_a1[dsp_b] = dsp_sc_a1v; dsp_sc_a2[dsp_b] = dsp_sc_a2v;
  dsp_sc_is_bell[dsp_b] = (dsp_sc_t == 0);
  dsp_sc_is_low[dsp_b] = (dsp_sc_t == 1);
  dsp_sc_is_high[dsp_b] = (dsp_sc_t == 2);

  dsp_att_s = band_attack[dsp_b] * 0.001;
  dsp_rel_s = band_release[dsp_b] * 0.001;
  dsp_att_s = max(0.0001, dsp_att_s); dsp_rel_s = max(0.0005, dsp_rel_s);
  dsp_atc[dsp_b] = exp(-1 / (dsp_sr * dsp_att_s));
  dsp_rtc[dsp_b] = exp(-1 / (dsp_sr * dsp_rel_s));
  dsp_atc_fast[dsp_b] = exp(-1 / (dsp_sr * 0.0010));
  dsp_rtc_fast[dsp_b] = exp(-1 / (dsp_sr * 0.0150));
  dsp_atc_slow[dsp_b] = exp(-1 / (dsp_sr * 0.0400));
  dsp_rtc_slow[dsp_b] = exp(-1 / (dsp_sr * 0.2500));
  dsp_b = dsp_b + 1;
);

rs_lg = tan($pi * rs_listen_freq / dsp_sr);
rs_lk = 1 / max(0.1, rs_listen_q);
rs_la1 = 1 / (1 + rs_lg*(rs_lg + rs_lk));
rs_la2 = rs_lg * rs_la1;
rs_la3 = rs_lg * rs_la2;

@sample
meter_in_L_raw = abs(spl0); meter_in_R_raw = abs(spl1);
ag_in_L = spl0; ag_in_R = spl1;

fft_ring_in[fft_widx[0]] = (spl0 + spl1) * 0.5;

dsp_mid = (spl0 + spl1) * 0.5;
dsp_sid = (spl0 - spl1) * 0.5;
dsp_scL_ext = spl2; dsp_scR_ext = spl3;
dsp_sc_mid_ext = (dsp_scL_ext + dsp_scR_ext) * 0.5;
dsp_sc_sid_ext = (dsp_scL_ext - dsp_scR_ext) * 0.5;
dsp_listen_mid = 0; dsp_listen_sid = 0; dsp_sclisten_out = 0;

dsp_b = 0;
while (dsp_b < 5) (
  dsp_on_tgt = band_enabled[dsp_b];
  dsp_on_sm[dsp_b] = dsp_on_tgt + (dsp_on_sm[dsp_b] - dsp_on_tgt) * dsp_coef_smooth_on;
  dsp_on_smooth = dsp_on_sm[dsp_b];

  dsp_chan = band_chan[dsp_b];
  is_side_det = (dsp_chan == 4);
  dsp_int_src = is_side_det * dsp_sid + (1 - is_side_det) * dsp_mid;

  sc_chan = band_sc_chan[dsp_b];
  dsp_ext_src = dsp_mid;
  sc_chan == 0 ? dsp_ext_src = max(abs(dsp_sc_mid_ext + dsp_sc_sid_ext), abs(dsp_sc_mid_ext - dsp_sc_sid_ext));
  sc_chan == 1 ? dsp_ext_src = dsp_scL_ext;
  sc_chan == 2 ? dsp_ext_src = dsp_scR_ext;
  sc_chan == 3 ? dsp_ext_src = dsp_sc_mid_ext;
  sc_chan == 4 ? dsp_ext_src = dsp_sc_sid_ext;

  is_ext = band_sc_ext[dsp_b];
  dsp_det_src = is_ext * dsp_ext_src + (1 - is_ext) * dsp_int_src;

  dsp_sc_gv = dsp_sc_g[dsp_b]; dsp_sc_kv = dsp_sc_k[dsp_b];
  dsp_sc_a1v = dsp_sc_a1[dsp_b]; dsp_sc_a2v = dsp_sc_a2[dsp_b];

  dsp_x = dsp_det_src;
  dsp_ic1 = dsp_state[dsp_b*8+2]; dsp_ic2 = dsp_state[dsp_b*8+3];
  dsp_v3 = dsp_x - dsp_ic2;
  dsp_v1 = dsp_sc_a1v * dsp_ic1 + dsp_sc_a2v * dsp_v3;
  dsp_v2 = dsp_ic2 + dsp_sc_gv * dsp_v1;
  dsp_state[dsp_b*8+2] = 2*dsp_v1 - dsp_ic1;
  dsp_state[dsp_b*8+3] = 2*dsp_v2 - dsp_ic2;
  dsp_LP = dsp_v2; dsp_BP = dsp_v1;
  dsp_HP = dsp_x - dsp_sc_kv * dsp_v1 - dsp_v2;

  dsp_det_filtered = dsp_sc_is_bell[dsp_b]*dsp_BP + dsp_sc_is_low[dsp_b]*dsp_LP + dsp_sc_is_high[dsp_b]*dsp_HP;

  is_sel_det = (dsp_b == selected_band);
  dsp_sclisten_out = dsp_sclisten_out + is_sel_det * dsp_det_filtered * dsp_on_smooth;

  dsp_abs = abs(dsp_det_filtered);
  dsp_smooth_state = dsp_state[dsp_b*8+6];
  dsp_smooth_state = dsp_abs + (dsp_smooth_state - dsp_abs) * dsp_smooth_coef;
  dsp_state[dsp_b*8+6] = dsp_smooth_state;
  dsp_abs = max(dsp_abs, dsp_smooth_state);

  dsp_env_s = dsp_env_slow[dsp_b];
  dsp_is_up_s = (dsp_abs > dsp_env_s);
  dsp_coef_es = dsp_atc_slow[dsp_b]*dsp_is_up_s + dsp_rtc_slow[dsp_b]*(1-dsp_is_up_s);
  dsp_env_s = dsp_abs + (dsp_env_s - dsp_abs) * dsp_coef_es;
  dsp_env_slow[dsp_b] = dsp_env_s;

  dsp_env_f = dsp_env_fast[dsp_b];
  dsp_is_up_f = (dsp_abs > dsp_env_f);
  dsp_coef_ef = dsp_atc_fast[dsp_b]*dsp_is_up_f + dsp_rtc_fast[dsp_b]*(1-dsp_is_up_f);
  dsp_env_f = dsp_abs + (dsp_env_f - dsp_abs) * dsp_coef_ef;
  dsp_env_fast[dsp_b] = dsp_env_f;

  dsp_env_v = dsp_env[dsp_b];
  dsp_is_up = (dsp_abs > dsp_env_v);
  dsp_coef_e = dsp_atc[dsp_b]*dsp_is_up + dsp_rtc[dsp_b]*(1-dsp_is_up);
  dsp_env_v = dsp_abs + (dsp_env_v - dsp_abs) * dsp_coef_e;
  dsp_env[dsp_b] = dsp_env_v;

  dsp_sq = dsp_det_filtered * dsp_det_filtered;
  dsp_env_sq_v = dsp_env_sq[dsp_b];
  dsp_is_up_sq = (dsp_sq > dsp_env_sq_v);
  dsp_coef_sq = dsp_atc[dsp_b]*dsp_is_up_sq + dsp_rtc[dsp_b]*(1-dsp_is_up_sq);
  dsp_env_sq_v = dsp_sq + (dsp_env_sq_v - dsp_sq) * dsp_coef_sq;
  dsp_env_sq[dsp_b] = dsp_env_sq_v;
  dsp_rms = sqrt(dsp_env_sq_v);

  dsp_rise = dsp_env_f - dsp_env_s;
  dsp_is_rising = (dsp_rise > 0.0003);
  dsp_onset = dsp_env_f * dsp_is_rising;

  det_mode = band_detect[dsp_b];
  is_peak_mode = (det_mode == 0);
  is_rms_mode = (det_mode == 1);
  is_onset_mode = (det_mode == 2);
  dsp_det_v = is_peak_mode*dsp_env_v + is_rms_mode*dsp_rms + is_onset_mode*dsp_onset;
  dsp_env_db = 20 * log(max(0.000001, dsp_det_v)) * INV_LN10;

  dsp_thr = band_thresh[dsp_b];
  dsp_thr_lo = dsp_thr - 5;
  dsp_dyn_raw = (dsp_env_db - dsp_thr_lo) * 0.1;
  dsp_dyn_raw = max(0, min(1, dsp_dyn_raw));
  dsp_trig = band_trigger[dsp_b];
  dsp_dyn_trig = dsp_dyn_raw*(1-dsp_trig) + (1-dsp_dyn_raw)*dsp_trig;
  dsp_dyn_amt = band_dyn[dsp_b] * 0.01;
  dsp_dyn_final = dsp_dyn_trig * dsp_dyn_amt;

  band_dyn_vis[dsp_b] = band_dyn_vis[dsp_b] + (dsp_dyn_final - band_dyn_vis[dsp_b]) * 0.005;

  dsp_gain_db = band_gain[dsp_b];
  dsp_gain_t_db = band_target[dsp_b];
  dsp_A_db_target = dsp_gain_db*(1-dsp_dyn_final) + dsp_gain_t_db*dsp_dyn_final;
  dsp_A_db_sm[dsp_b] = dsp_A_db_target + (dsp_A_db_sm[dsp_b] - dsp_A_db_target) * dsp_coef_smooth_A;
  dsp_A = exp(dsp_A_db_sm[dsp_b] * LN10_OVER_20);
  dsp_A = max(0.01, min(100, dsp_A));
  dsp_A_db_abs = abs(dsp_A_db_sm[dsp_b]);
  dsp_Q_prop_factor = 1 + dsp_A_db_abs * 0.020;
  dsp_Q_prop_factor = min(2.5, dsp_Q_prop_factor);

  dsp_type = band_type[dsp_b];
  is_bell = (dsp_type == 0); is_low = (dsp_type == 1);
  is_high = (dsp_type == 2); is_shelf = is_low + is_high;
  dsp_g_v = dsp_g_v_arr[dsp_b];
  dsp_A_m1 = dsp_A - 1;

  is_shelf ? (
    // ===== RBJ SHELF =====
    dsp_Arbj = sqrt(dsp_A);
    dsp_cosw0_v = dsp_cosw0_arr[dsp_b];
    dsp_sinw0_v = dsp_sinw0_arr[dsp_b];
    dsp_S = band_q[dsp_b] * 0.01;
    dsp_S = max(0.1, min(4.0, dsp_S));
    dsp_term = (dsp_Arbj + 1/dsp_Arbj) * (1/dsp_S - 1) + 2;
    dsp_term = max(0.001, dsp_term);
    dsp_alpha_rbj = dsp_sinw0_v * 0.5 * sqrt(dsp_term);
    dsp_sqArbj = sqrt(dsp_Arbj);
    dsp_2sqA_a = 2 * dsp_sqArbj * dsp_alpha_rbj;

    is_low ? (
      dsp_b0r =     dsp_Arbj*((dsp_Arbj+1) - (dsp_Arbj-1)*dsp_cosw0_v + dsp_2sqA_a);
      dsp_b1r = 2*  dsp_Arbj*((dsp_Arbj-1) - (dsp_Arbj+1)*dsp_cosw0_v                  );
      dsp_b2r =     dsp_Arbj*((dsp_Arbj+1) - (dsp_Arbj-1)*dsp_cosw0_v - dsp_2sqA_a);
      dsp_a0r =            (dsp_Arbj+1) + (dsp_Arbj-1)*dsp_cosw0_v + dsp_2sqA_a;
      dsp_a1r = -2*(      (dsp_Arbj-1) + (dsp_Arbj+1)*dsp_cosw0_v                  );
      dsp_a2r =            (dsp_Arbj+1) + (dsp_Arbj-1)*dsp_cosw0_v - dsp_2sqA_a;
    ) : (
      dsp_b0r =     dsp_Arbj*((dsp_Arbj+1) + (dsp_Arbj-1)*dsp_cosw0_v + dsp_2sqA_a);
      dsp_b1r = -2* dsp_Arbj*((dsp_Arbj-1) + (dsp_Arbj+1)*dsp_cosw0_v                  );
      dsp_b2r =     dsp_Arbj*((dsp_Arbj+1) + (dsp_Arbj-1)*dsp_cosw0_v - dsp_2sqA_a);
      dsp_a0r =            (dsp_Arbj+1) - (dsp_Arbj-1)*dsp_cosw0_v + dsp_2sqA_a;
      dsp_a1r =  2*(      (dsp_Arbj-1) - (dsp_Arbj+1)*dsp_cosw0_v                  );
      dsp_a2r =            (dsp_Arbj+1) - (dsp_Arbj-1)*dsp_cosw0_v - dsp_2sqA_a;
    );
    dsp_inv_a0 = 1 / dsp_a0r;
    dsp_bn0 = dsp_b0r * dsp_inv_a0;
    dsp_bn1 = dsp_b1r * dsp_inv_a0;
    dsp_bn2 = dsp_b2r * dsp_inv_a0;
    dsp_an1 = dsp_a1r * dsp_inv_a0;
    dsp_an2 = dsp_a2r * dsp_inv_a0;

    dsp_z1 = dsp_shelf_z1_mid[dsp_b];
    dsp_z2 = dsp_shelf_z2_mid[dsp_b];
    dsp_y_mid = dsp_bn0*dsp_mid + dsp_z1;
    dsp_z1n = dsp_bn1*dsp_mid - dsp_an1*dsp_y_mid + dsp_z2;
    dsp_z2n = dsp_bn2*dsp_mid - dsp_an2*dsp_y_mid;
    dsp_shelf_z1_mid[dsp_b] = dsp_z1n;
    dsp_shelf_z2_mid[dsp_b] = dsp_z2n;

    dsp_z1 = dsp_shelf_z1_sid[dsp_b];
    dsp_z2 = dsp_shelf_z2_sid[dsp_b];
    dsp_y_sid = dsp_bn0*dsp_sid + dsp_z1;
    dsp_z1n = dsp_bn1*dsp_sid - dsp_an1*dsp_y_sid + dsp_z2;
    dsp_z2n = dsp_bn2*dsp_sid - dsp_an2*dsp_y_sid;
    dsp_shelf_z1_sid[dsp_b] = dsp_z1n;
    dsp_shelf_z2_sid[dsp_b] = dsp_z2n;
  ) : (
    // ===== SVF BELL =====
    dsp_k_bell_eff = dsp_k_bell[dsp_b] / dsp_Q_prop_factor;
    dsp_den_b_eff = 1 + dsp_g_v * (dsp_g_v + dsp_k_bell_eff);
    dsp_a1_bell_eff = 1 / dsp_den_b_eff;
    dsp_a2_bell_eff = dsp_g_v * dsp_a1_bell_eff;
    dsp_k_v = dsp_k_bell_eff;

    dsp_x = dsp_mid;
    dsp_ic1 = dsp_state[dsp_b*8+0]; dsp_ic2 = dsp_state[dsp_b*8+1];
    dsp_v3 = dsp_x - dsp_ic2;
    dsp_v1 = dsp_a1_bell_eff*dsp_ic1 + dsp_a2_bell_eff*dsp_v3;
    dsp_v2 = dsp_ic2 + dsp_g_v*dsp_v1;
    dsp_state[dsp_b*8+0] = 2*dsp_v1 - dsp_ic1;
    dsp_state[dsp_b*8+1] = 2*dsp_v2 - dsp_ic2;
    dsp_BP = dsp_v1;
    dsp_y_mid = dsp_x + dsp_A_m1*(dsp_k_v*dsp_BP);

    dsp_x = dsp_sid;
    dsp_ic1 = dsp_state[dsp_b*8+4]; dsp_ic2 = dsp_state[dsp_b*8+5];
    dsp_v3 = dsp_x - dsp_ic2;
    dsp_v1 = dsp_a1_bell_eff*dsp_ic1 + dsp_a2_bell_eff*dsp_v3;
    dsp_v2 = dsp_ic2 + dsp_g_v*dsp_v1;
    dsp_state[dsp_b*8+4] = 2*dsp_v1 - dsp_ic1;
    dsp_state[dsp_b*8+5] = 2*dsp_v2 - dsp_ic2;
    dsp_BP = dsp_v1;
    dsp_y_sid = dsp_x + dsp_A_m1*(dsp_k_v*dsp_BP);
  );

  dsp_ym = dsp_y_mid; dsp_ys = dsp_y_sid;
  dM = dsp_ym - dsp_mid; dS = dsp_ys - dsp_sid;
  is_st = (dsp_chan == 0); is_l = (dsp_chan == 1); is_r = (dsp_chan == 2);
  is_m = (dsp_chan == 3); is_s = (dsp_chan == 4);
  dL = dM + dS; dR = dM - dS;
  add_M = is_st*dM + is_l*0.5*dL + is_r*0.5*dR + is_m*dM;
  add_S = is_st*dS + is_l*0.5*dL - is_r*0.5*dR + is_s*dS;

  is_listen = (listen_band == dsp_b);
  dsp_listen_mid = dsp_listen_mid + is_listen * dsp_on_smooth * add_M;
  dsp_listen_sid = dsp_listen_sid + is_listen * dsp_on_smooth * add_S;
  dsp_mid = dsp_mid + dsp_on_smooth * add_M;
  dsp_sid = dsp_sid + dsp_on_smooth * add_S;
  dsp_b = dsp_b + 1;
);

is_listen_mode = (listen_band >= 0);
dsp_out_mid = is_listen_mode*dsp_listen_mid + (1-is_listen_mode)*dsp_mid;
dsp_out_sid = is_listen_mode*dsp_listen_sid + (1-is_listen_mode)*dsp_sid;
dsp_out_L_pre = dsp_out_mid + dsp_out_sid;
dsp_out_R_pre = dsp_out_mid - dsp_out_sid;

is_sclisten = sc_listen_en;
dsp_out_L_pre = is_sclisten*dsp_sclisten_out + (1-is_sclisten)*dsp_out_L_pre;
dsp_out_R_pre = is_sclisten*dsp_sclisten_out + (1-is_sclisten)*dsp_out_R_pre;

ag_pred = 0; ag_i = 0;
while (ag_i < 5) (
  b_en = band_enabled[ag_i];
  b_gain_avg = (band_gain[ag_i] + band_target[ag_i]) * 0.5;
  ag_pred += -b_gain_avg * b_en;
  ag_i += 1;
);
ag_pred *= 0.5; ag_pred = max(-18, min(18, ag_pred));
ag_sm = ag_sm + (ag_pred - ag_sm) * ag_coef_slow;
autogain_sm = autogain_sm + (autogain_en - autogain_sm) * ag_coef_fast;
ag_apply_db = ag_sm * autogain_sm;
ag_apply_lin = exp(ag_apply_db * LN10_OVER_20);
dsp_trim_lin = exp(output_trim_db * LN10_OVER_20) * ag_apply_lin;
dsp_out_L = dsp_out_L_pre * dsp_trim_lin;
dsp_out_R = dsp_out_R_pre * dsp_trim_lin;

sc_absL = abs(dsp_out_L);
sc_absL > 1 ? (
  sc_signL = dsp_out_L / sc_absL;
  sc_overL = sc_absL - 1;
  dsp_out_L = sc_signL * (1 + sc_overL / (1 + sc_overL));
);
sc_absR = abs(dsp_out_R);
sc_absR > 1 ? (
  sc_signR = dsp_out_R / sc_absR;
  sc_overR = sc_absR - 1;
  dsp_out_R = sc_signR * (1 + sc_overR / (1 + sc_overR));
);

spl0 = dsp_out_L; spl1 = dsp_out_R;

rs_do_listen ? (
  rs_mono = 0.5 * (spl0 + spl1);
  rs_v3 = rs_mono - rs_listen_ic2;
  rs_v1 = rs_la1*rs_listen_ic1 + rs_la2*rs_v3;
  rs_v2 = rs_listen_ic2 + rs_la2*rs_listen_ic1 + rs_la3*rs_v3;
  rs_listen_ic1 = 2*rs_v1 - rs_listen_ic1;
  rs_listen_ic2 = 2*rs_v2 - rs_listen_ic2;
  rs_bp = rs_v1 * rs_lk * 2;
  spl0 = rs_bp; spl1 = rs_bp;
);

rs_sig0 = (rs_spec_mode==0)*(spl0+spl1)
        + (rs_spec_mode==1)*((spl0+spl1)*0.5)
        + (rs_spec_mode==2)*((spl0-spl1)*0.5)
        + (rs_spec_mode==3)*((spl0+spl1)*0.5)
        + (rs_spec_mode==4)*spl0
        + (rs_spec_mode==5)*spl1
        + (rs_spec_mode==6)*spl0;
rs_sig1 = (rs_spec_mode==3)*((spl0-spl1)*0.5)
        + (rs_spec_mode==6)*spl1;
rs_ring_mid[rs_widx[0]]  = rs_sig0;
rs_ring_side[rs_widx[0]] = rs_sig1;
rs_widx[0] = (rs_widx[0] + 1) % RS_MAX;

meter_in_L_raw > meter_in_peak_L ? meter_in_peak_L = meter_in_L_raw;
meter_in_peak_L = meter_in_peak_L * meter_coef;
meter_in_R_raw > meter_in_peak_R ? meter_in_peak_R = meter_in_R_raw;
meter_in_peak_R = meter_in_peak_R * meter_coef;
meter_out_L_raw = abs(spl0); meter_out_R_raw = abs(spl1);
meter_out_L_raw > meter_out_peak_L ? meter_out_peak_L = meter_out_L_raw;
meter_out_peak_L = meter_out_peak_L * meter_coef;
meter_out_R_raw > meter_out_peak_R ? meter_out_peak_R = meter_out_R_raw;
meter_out_peak_R = meter_out_peak_R * meter_coef;

clip_in_suppress > 0 ? (
  clip_in_suppress -= 1;
) : (
  clip_in_flag = clip_in_flag + (meter_in_L_raw > 0.999)*(1-clip_in_flag);
  clip_in_flag = clip_in_flag + (meter_in_R_raw > 0.999)*(1-clip_in_flag);
);
clip_out_suppress > 0 ? (
  clip_out_suppress -= 1;
) : (
  clip_out_flag = clip_out_flag + (meter_out_L_raw > 0.999)*(1-clip_out_flag);
  clip_out_flag = clip_out_flag + (meter_out_R_raw > 0.999)*(1-clip_out_flag);
);

fft_ring[fft_widx[0]] = (spl0 + spl1) * 0.5;
fft_widx[0] = (fft_widx[0] + 1) % FFT_MAX;
dsp_state[0] = dsp_state[0] + 0.000000000000001;

@gfx 1000 620

// ===== RENDER MODE: directo a pantalla si escala=100%, sino buffer =====
imgdim_ready == 0 ? ( gfx_setimgdim(0, 1000, 620); imgdim_ready = 1; );

// Input state — una sola vez por frame, antes de cualquier handler
mcap = mouse_cap;
mdown = (mcap & 1) > 0;
mprev = (prev_cap & 1) > 0;
g_press = mdown * (1 - mprev);
g_release = mprev * (1 - mdown);

// Auto-scale: NUNCA escalar hacia arriba. Si la ventana es mas grande
// que 1000x620, el contenido queda a 100% y solo se agrega margen.
gui_scale_auto = min(gfx_w / 1000, gfx_h / 620);
gui_scale_auto = min(gui_scale_auto, 1.0);
gui_scale_auto = max(gui_scale_auto, 0.1);

gui_scale = gui_scale_auto * ui_scale_int;
gui_scale = max(gui_scale, 0.1);

// Redondeo a enteros: evita desenfoque por sub-pixel
gui_scaled_w = floor(1000 * gui_scale + 0.5);
gui_scaled_h = floor(620 * gui_scale + 0.5);

// Modo nativo: el contenido se dibuja a 100% exacto -> directo a pantalla.
// Robusto frente a redimensionados del SO: si el tamaño final del contenido
// es 1000x620, no importa si la ventana es 1002, 1004 o 1010 px de ancho.
_native = (gui_scaled_w == 1000) * (gui_scaled_h == 620);

_native ? (
  // Modo nativo: sin offset, dibujo a coordenadas de pantalla reales
  gui_off_x = 0;
  gui_off_y = 0;
) : (
  // Modo buffer: contenido centrado en la ventana
  gui_off_x = floor((gfx_w - gui_scaled_w) * 0.5 + 0.5);
  gui_off_y = floor((gfx_h - gui_scaled_h) * 0.5 + 0.5);
);

gfx_dest = _native ? -1 : 0;

// Guardar coordenadas reales de ventana ANTES de transformar
_orig_mx = mouse_x;
_orig_my = mouse_y;

mouse_x = (mouse_x - gui_off_x) / gui_scale;
mouse_y = (mouse_y - gui_off_y) / gui_scale;

// AV logo — click CICLA UI scale en orden DECRECIENTE:
// 100% ? 75% ? 50% ? 25% ? 100% ...
// (idx 0 = 25%, 1 = 50%, 2 = 75%, 3 = 100%; sumar 3 equivale a restar 1)
in_av = (mouse_x >= 0) && (mouse_x <= 60) && (mouse_y >= 0) && (mouse_y <= 30);
_av_click = g_press * in_av;
_av_click ? (
  ui_scale_idx = (ui_scale_idx + 3) % 4;
  ui_scale_int = (ui_scale_idx + 1) * 0.25;
  g_press = 0;
);

// ===== 1. FFT DUAL (input + output) =====
fft_size_cur = fft_size_arr[fft_size_idx];
fft_size_cur != fft_size_last ? (
  fft_i = 0;
  while (fft_i < fft_size_cur) (
    w_a = 2 * $pi * fft_i / (fft_size_cur - 1);
    fft_win[fft_i] = 0.35875 - 0.48829*cos(w_a) + 0.14128*cos(2*w_a) - 0.01168*cos(3*w_a);
    fft_i += 1;
  );
  fft_size_last = fft_size_cur;
);
an_norm_val = 1.0 / (fft_size_cur * 0.5);
an_win_gain_db = 8.9;

fft_i = 0;
while (fft_i < fft_size_cur) (
  fft_idx = (fft_widx[0] - fft_size_cur + fft_i + FFT_MAX) % FFT_MAX;
  fft_buf[fft_i*2] = fft_ring_in[fft_idx] * fft_win[fft_i];
  fft_buf[fft_i*2+1] = 0;
  fft_i += 1;
);
fft(fft_buf, fft_size_cur);
fft_permute(fft_buf, fft_size_cur);
fft_i = 0;
while (fft_i < fft_size_cur/2) (
  fft_re = fft_buf[fft_i*2]; fft_im = fft_buf[fft_i*2+1];
  fft_m = sqrt(fft_re*fft_re + fft_im*fft_im) * an_norm_val;
  fft_db = 20 * log(max(0.000001, fft_m)) * INV_LN10 + an_win_gain_db;
  fft_mag_in[fft_i] = max(fft_db, fft_mag_in[fft_i] - 0.4);
  fft_i += 1;
);

fft_i = 0;
while (fft_i < fft_size_cur) (
  fft_idx = (fft_widx[0] - fft_size_cur + fft_i + FFT_MAX) % FFT_MAX;
  fft_buf[fft_i*2] = fft_ring[fft_idx] * fft_win[fft_i];
  fft_buf[fft_i*2+1] = 0;
  fft_i += 1;
);
fft(fft_buf, fft_size_cur);
fft_permute(fft_buf, fft_size_cur);
fft_i = 0;
while (fft_i < fft_size_cur/2) (
  fft_re = fft_buf[fft_i*2]; fft_im = fft_buf[fft_i*2+1];
  fft_m = sqrt(fft_re*fft_re + fft_im*fft_im) * an_norm_val;
  fft_db = 20 * log(max(0.000001, fft_m)) * INV_LN10 + an_win_gain_db;
  fft_mag[fft_i] = max(fft_db, fft_mag[fft_i] - 0.4);
  fft_i += 1;
);

// ===== 2. FONDO =====
gfx_r=0.15; gfx_g=0.17; gfx_b=0.21; gfx_a=1;
gfx_x=0; gfx_y=0; gfx_rectto(_native ? gfx_w : 1000, _native ? gfx_h : 620);
gfx_r=0.20; gfx_g=0.22; gfx_b=0.29; gfx_a=1;
gfx_x=0; gfx_y=0; gfx_rectto(1000, 30);
gfx_r=0.10; gfx_g=0.29; gfx_b=0.48; gfx_a=1;
gfx_x=0; gfx_y=0; gfx_rectto(60, 30);
gfx_setfont(1, "Arial", 18);
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
gfx_x=14; gfx_y=3; gfx_drawstr("AV");
gfx_setfont(1, "Arial", 9);
gfx_r=0.7; gfx_g=0.75; gfx_b=0.85; gfx_a=1;
gs = sprintf(#, "%d%%", floor(ui_scale_int * 100 + 0.5));
gfx_x=14; gfx_y=21; gfx_drawstr(gs);
gfx_setfont(1, "Arial", 17);
gfx_r=0.82; gfx_g=0.84; gfx_b=0.88; gfx_a=1;
gfx_x=400; gfx_y=4; gfx_drawstr("REA DYN EQ");

// ===== 3. REJILLA =====
gfx_r=0.17; gfx_g=0.18; gfx_b=0.23; gfx_a=1;
gfx_x=42; gfx_y=52; gfx_rectto(928, 402);
big_zoom = zoom_db >= 12;
gstep = 1 + big_zoom;
gdb = -zoom_db;
while (gdb <= zoom_db + 0.001) (
  gy = 52 + (zoom_db - gdb) / (2 * zoom_db) * 350;
  is_zero = abs(gdb) < 0.01;
  gfx_r = 0.21 + is_zero * 0.14;
  gfx_g = 0.23 + is_zero * 0.14;
  gfx_b = 0.28 + is_zero * 0.16;
  gfx_a = 1;
  gfx_x=42; gfx_y=gy; gfx_lineto(928, gy, 0);
  gdb = gdb + gstep;
);
gi = 0;
while (gi < NGF) (
  ff = GF[gi];
  gx = 42 + (log(ff) - LOG_20) / LOG_RNG * 886;
  is_maj = (ff == 100) + (ff == 1000) + (ff == 10000);
  gfx_r = 0.21 + is_maj * 0.05;
  gfx_g = 0.23 + is_maj * 0.05;
  gfx_b = 0.28 + is_maj * 0.06;
  gfx_a = 1;
  gfx_x=gx; gfx_y=52; gfx_lineto(gx, 402, 0);
  gi = gi + 1;
);
gfx_setfont(1, "Arial", 13);
gfx_r=0.60; gfx_g=0.64; gfx_b=0.72; gfx_a=1;
gdb = -zoom_db;
while (gdb <= zoom_db + 0.001) (
  gy = 52 + (zoom_db - gdb) / (2 * zoom_db) * 350;
  gs = sprintf(#, "%d", gdb);
  gfx_x=4; gfx_y=gy-8; gfx_drawstr(gs);
  gdb = gdb + gstep;
);
gi = 0;
while (gi < NLBL) (
  ff = LBL[gi];
  gx = 42 + (log(ff) - LOG_20) / LOG_RNG * 886;
  gs = sprintf(#, "%d", ff);
  gfx_x=gx-22; gfx_y=30; gfx_drawstr(gs);
  gi = gi + 1;
);
gi = 0;
while (gi < NLBL) (
  ff = LBL[gi];
  gx = 42 + (log(ff) - LOG_20) / LOG_RNG * 886;
  gs = sprintf(#, "%d", ff);
  gfx_x=gx-22; gfx_y=404; gfx_drawstr(gs);
  gi = gi + 1;
);

// ===== 4. ZONAS DE COLOR POR FRECUENCIA =====
i = 0;
while (i < 5) (
  bfc = band_freq[i]; bQ = band_q[i] * 0.01; bty = band_type[i];
  dv = band_dyn_vis[i]; dv = max(0, min(1, dv));
  is_sel_b = (i == selected_band);
  freq_col(bfc);
  bG_off = band_gain[i]; bG_tgt = band_target[i];
  bbw = 1.0 / max(0.3, bQ);
  xx = 42;
  while (xx <= 928) (
    ff = exp(LOG_20 + (xx - 42) / 886 * LOG_RNG);
    lnr = log(ff / bfc);
    r_off_b = bG_off * exp(-0.5 * pow(lnr / (bbw * 0.5), 2));
    r_tgt_b = bG_tgt * exp(-0.5 * pow(lnr / (bbw * 0.5), 2));
    r_off_ls = bG_off / (1 + pow(ff / bfc, 2*bQ));
    r_tgt_ls = bG_tgt / (1 + pow(ff / bfc, 2*bQ));
    r_off_hs = bG_off / (1 + pow(bfc / ff, 2*bQ));
    r_tgt_hs = bG_tgt / (1 + pow(bfc / ff, 2*bQ));
    is_b_ = (bty == 0); is_l_ = (bty == 1); is_h_ = (bty == 2);
    g_off = is_b_*r_off_b + is_l_*r_off_ls + is_h_*r_off_hs;
    g_tgt = is_b_*r_tgt_b + is_l_*r_tgt_ls + is_h_*r_tgt_hs;
    y_off = 52 + (zoom_db - g_off) / (2 * zoom_db) * 350;
    y_tgt = 52 + (zoom_db - g_tgt) / (2 * zoom_db) * 350;
    diff = abs(g_tgt - g_off);
    (diff > 0.08) ? (
      y_top = min(y_off, y_tgt); y_bot = max(y_off, y_tgt);
      y_top = max(52, min(402, y_top)); y_bot = max(52, min(402, y_bot));
      gfx_r = fc_r; gfx_g = fc_g; gfx_b = fc_b;
      gfx_a = 0.28 + is_sel_b * 0.10 + dv * 0.22;
      gfx_x = xx; gfx_y = y_top;
      gfx_rectto(xx + 1, y_bot);
    );
    xx += 1;
  );
  i += 1;
);

// ===== 5. OVERLAY DEL ANALIZADOR SOBRE LA GRAFICA (opcional) =====
an_overlay_main ? (
  an_nyq = dsp_sr * 0.5;
  an_bins = fft_size_cur / 2;

  gfx_r=0.95; gfx_g=0.85; gfx_b=0.25; gfx_a=0.55;
  fft_px = 42;
  while (fft_px <= 928) (
    fft_f = exp(LOG_20 + (fft_px - 42) / 886 * LOG_RNG);
    fft_bin = fft_f / an_nyq * an_bins;
    fft_bin = max(1, min(an_bins - 2, fft_bin));
    fft_b0 = floor(fft_bin); fft_b1 = fft_b0 + 1;
    fft_frac = fft_bin - fft_b0;
    fft_val = fft_mag[fft_b0]*(1-fft_frac) + fft_mag[fft_b1]*fft_frac;
    fft_val = max(an_range_lo_db, min(an_range_hi_db, fft_val));
    fft_yy = 402 - ((fft_val - an_range_lo_db)/(an_range_hi_db - an_range_lo_db)) * 350;
    fft_yy = max(52, min(402, fft_yy));
    gfx_x = fft_px; gfx_y = fft_yy;
    gfx_lineto(fft_px + 1, fft_yy, 0);
    fft_px += 2;
  );

  gfx_r=0.35; gfx_g=0.7; gfx_b=1.0; gfx_a=0.45;
  fft_px = 42;
  while (fft_px <= 928) (
    fft_f = exp(LOG_20 + (fft_px - 42) / 886 * LOG_RNG);
    fft_bin = fft_f / an_nyq * an_bins;
    fft_bin = max(1, min(an_bins - 2, fft_bin));
    fft_b0 = floor(fft_bin); fft_b1 = fft_b0 + 1;
    fft_frac = fft_bin - fft_b0;
    fft_val = fft_mag_in[fft_b0]*(1-fft_frac) + fft_mag_in[fft_b1]*fft_frac;
    fft_val = max(an_range_lo_db, min(an_range_hi_db, fft_val));
    fft_yy = 402 - ((fft_val - an_range_lo_db)/(an_range_hi_db - an_range_lo_db)) * 350;
    fft_yy = max(52, min(402, fft_yy));
    gfx_x = fft_px; gfx_y = fft_yy;
    gfx_lineto(fft_px + 1, fft_yy, 0);
    fft_px += 2;
  );

  gfx_setfont(1, "Arial", 10);
  gfx_r=0.95; gfx_g=0.95; gfx_b=0.4; gfx_a=0.9;
  gfx_x = 44; gfx_y = 54;
  gfx_drawstr("SPECTRUM OVERLAY");
);

// ===== 6. CURVAS DE BANDA (fondo) =====
bi = 0;
while (bi < 5) (
  gfx_r = band_r[bi]; gfx_g = band_g[bi]; gfx_b = band_b[bi]; gfx_a = 0.15;
  bfc = band_freq[bi]; bQ = band_q[bi]*0.01;
  bG = band_target[bi]; bty = band_type[bi]; bbw = 1.0 / bQ;
  xx = 42;
  while (xx <= 928) (
    ff = exp(LOG_20 + (xx - 42) / 886 * LOG_RNG);
    lnr = log(ff / bfc);
    resp = bG * exp(-0.5 * pow(lnr / (bbw * 0.5), 2));
    r_ls = bG / (1 + pow(ff / bfc, 2*bQ));
    r_hs = bG / (1 + pow(bfc / ff, 2*bQ));
    is_b_ = (bty == 0); is_l_ = (bty == 1); is_h_ = (bty == 2);
    resp = is_b_*resp + is_l_*r_ls + is_h_*r_hs;
    yr = 52 + (zoom_db - resp) / (2 * zoom_db) * 350;
    gfx_x=xx; gfx_y=yr; gfx_lineto(xx, 227, 0);
    xx = xx + 4;
  );
  bi = bi + 1;
);

// ===== 7. CURVA OFFSET TOTAL =====
gfx_r=0.7; gfx_g=0.75; gfx_b=0.85; gfx_a=0.4;
xx = 42; sum = 0; i = 0;
while (i < 5) (
  fc = band_freq[i]; Q = band_q[i]*0.01; G = band_gain[i]; ty = band_type[i];
  lnr = log(20 / fc); bw = 1.0 / Q;
  r1 = G * exp(-0.5 * pow(lnr / (bw * 0.5), 2));
  r2 = G / (1 + pow(20 / fc, 2*Q));
  r3 = G / (1 + pow(fc / 20, 2*Q));
  sum = sum + (ty==0)*r1 + (ty==1)*r2 + (ty==2)*r3;
  i = i + 1;
);
gfx_x=42; gfx_y=52 + (zoom_db - sum) / (2 * zoom_db) * 350;
xx = 43;
while (xx <= 928) (
  ff = exp(LOG_20 + (xx - 42) / 886 * LOG_RNG);
  sum = 0; i = 0;
  while (i < 5) (
    fc = band_freq[i]; Q = band_q[i]*0.01; G = band_gain[i]; ty = band_type[i];
    lnr = log(ff / fc); bw = 1.0 / Q;
    r1 = G * exp(-0.5 * pow(lnr / (bw * 0.5), 2));
    r2 = G / (1 + pow(ff / fc, 2*Q));
    r3 = G / (1 + pow(fc / ff, 2*Q));
    sum = sum + (ty==0)*r1 + (ty==1)*r2 + (ty==2)*r3;
    i = i + 1;
  );
  yy = 52 + (zoom_db - sum) / (2 * zoom_db) * 350;
  gfx_lineto(xx, yy, 0);
  xx = xx + 1;
);

// ===== 8. CURVA TARGET (3px) =====
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
xx = 42; sum = 0; i = 0;
while (i < 5) (
  fc = band_freq[i]; Q = band_q[i]*0.01; G = band_target[i]; ty = band_type[i];
  lnr = log(20 / fc); bw = 1.0 / Q;
  r1 = G * exp(-0.5 * pow(lnr / (bw * 0.5), 2));
  r2 = G / (1 + pow(20 / fc, 2*Q));
  r3 = G / (1 + pow(fc / 20, 2*Q));
  sum = sum + (ty==0)*r1 + (ty==1)*r2 + (ty==2)*r3;
  i = i + 1;
);
gfx_x=42; gfx_y=52 + (zoom_db - sum) / (2 * zoom_db) * 350;
xx = 43;
while (xx <= 928) (
  ff = exp(LOG_20 + (xx - 42) / 886 * LOG_RNG);
  sum = 0; i = 0;
  while (i < 5) (
    fc = band_freq[i]; Q = band_q[i]*0.01; G = band_target[i]; ty = band_type[i];
    lnr = log(ff / fc); bw = 1.0 / Q;
    r1 = G * exp(-0.5 * pow(lnr / (bw * 0.5), 2));
    r2 = G / (1 + pow(ff / fc, 2*Q));
    r3 = G / (1 + pow(fc / ff, 2*Q));
    sum = sum + (ty==0)*r1 + (ty==1)*r2 + (ty==2)*r3;
    i = i + 1;
  );
  yy = 52 + (zoom_db - sum) / (2 * zoom_db) * 350;
  gfx_x = xx; gfx_y = yy; gfx_lineto(xx, yy, 0);
  gfx_x = xx; gfx_y = yy - 1; gfx_lineto(xx, yy - 1, 0);
  gfx_x = xx; gfx_y = yy + 1; gfx_lineto(xx, yy + 1, 0);
  xx = xx + 1;
);

// ===== 9. CURVA DINAMICA (2px) =====
gfx_r=0.6; gfx_g=1.0; gfx_b=0.7; gfx_a=0.85;
xx = 42; sum = 0; i = 0;
while (i < 5) (
  dv = band_dyn_vis[i]; dv = max(0, min(1, dv));
  G = band_gain[i]*(1-dv) + band_target[i]*dv;
  fc = band_freq[i]; Q = band_q[i]*0.01; ty = band_type[i];
  lnr = log(20 / fc); bw = 1.0 / Q;
  r1 = G * exp(-0.5 * pow(lnr / (bw * 0.5), 2));
  r2 = G / (1 + pow(20 / fc, 2*Q));
  r3 = G / (1 + pow(fc / 20, 2*Q));
  sum = sum + (ty==0)*r1 + (ty==1)*r2 + (ty==2)*r3;
  i = i + 1;
);
gfx_x=42; gfx_y=52 + (zoom_db - sum) / (2 * zoom_db) * 350;
xx = 43;
while (xx <= 928) (
  ff = exp(LOG_20 + (xx - 42) / 886 * LOG_RNG);
  sum = 0; i = 0;
  while (i < 5) (
    dv = band_dyn_vis[i]; dv = max(0, min(1, dv));
    G = band_gain[i]*(1-dv) + band_target[i]*dv;
    fc = band_freq[i]; Q = band_q[i]*0.01; ty = band_type[i];
    lnr = log(ff / fc); bw = 1.0 / Q;
    r1 = G * exp(-0.5 * pow(lnr / (bw * 0.5), 2));
    r2 = G / (1 + pow(ff / fc, 2*Q));
    r3 = G / (1 + pow(fc / ff, 2*Q));
    sum = sum + (ty==0)*r1 + (ty==1)*r2 + (ty==2)*r3;
    i = i + 1;
  );
  yy = 52 + (zoom_db - sum) / (2 * zoom_db) * 350;
  gfx_x = xx; gfx_y = yy; gfx_lineto(xx, yy, 0);
  gfx_x = xx; gfx_y = yy + 1; gfx_lineto(xx, yy + 1, 0);
  xx = xx + 1;
);

// ===== 10. THRESHOLD LINE =====
thr_db = band_thresh[selected_band];
thr_y = 52 + (zoom_db - thr_db) / (2 * zoom_db) * 350;
gfx_r=1; gfx_g=0.4; gfx_b=0.4; gfx_a=0.55;
gfx_x=42; gfx_y=thr_y-1; gfx_lineto(928, thr_y-1, 0);
gfx_a=0.85;
gfx_x=42; gfx_y=thr_y; gfx_lineto(928, thr_y, 0);
gfx_a=0.55;
gfx_x=42; gfx_y=thr_y+1; gfx_lineto(928, thr_y+1, 0);
gfx_setfont(1, "Arial", 11);
gfx_r=1; gfx_g=0.5; gfx_b=0.5; gfx_a=1;
gs = sprintf(#, "Thr %.0f", thr_db);
gfx_x=44; gfx_y=thr_y-13; gfx_drawstr(gs);

// ===== 11. BORDES =====
gfx_r=0.10; gfx_g=0.11; gfx_b=0.15; gfx_a=1;
gfx_x=42; gfx_y=52; gfx_lineto(928, 52, 0);
gfx_x=42; gfx_y=53; gfx_lineto(928, 53, 0);
gfx_x=928; gfx_y=52; gfx_lineto(928, 402, 0);
gfx_x=927; gfx_y=52; gfx_lineto(927, 402, 0);
gfx_x=928; gfx_y=402; gfx_lineto(42, 402, 0);
gfx_x=928; gfx_y=401; gfx_lineto(42, 401, 0);
gfx_x=42; gfx_y=402; gfx_lineto(42, 52, 0);
gfx_x=43; gfx_y=402; gfx_lineto(43, 52, 0);

// ===== 12. TRIM BAR =====
gfx_r=0.17; gfx_g=0.18; gfx_b=0.23; gfx_a=1;
gfx_x=934; gfx_y=52; gfx_rectto(994, 402);
gfx_r=0.10; gfx_g=0.11; gfx_b=0.15; gfx_a=1;
gfx_x=934; gfx_y=52; gfx_lineto(994, 52, 0);
gfx_x=994; gfx_y=52; gfx_lineto(994, 402, 0);
gfx_x=994; gfx_y=402; gfx_lineto(934, 402, 0);
gfx_x=934; gfx_y=402; gfx_lineto(934, 52, 0);
gfx_setfont(1, "Arial", 11);
gfx_r=0.53; gfx_g=0.57; gfx_b=0.63; gfx_a=1;
gfx_x=996; gfx_y=46; gfx_drawstr("0");
gfx_x=996; gfx_y=93; gfx_drawstr("6");
gfx_x=996; gfx_y=137; gfx_drawstr("12");
gfx_x=996; gfx_y=225; gfx_drawstr("24");
gfx_x=996; gfx_y=396; gfx_drawstr("48");
trim_norm = (output_trim_db + 12) / 24;
trim_norm = max(0, min(1, trim_norm));
trim_y = 52 + (1 - trim_norm) * 350;
gfx_r=0.9; gfx_g=0.9; gfx_b=0.9; gfx_a=1;
gfx_x=932; gfx_y=trim_y; gfx_lineto(996, trim_y, 0);
gfx_setfont(1, "Arial", 12);
gfx_r=0.9; gfx_g=0.9; gfx_b=0.9;
gs = sprintf(#, "%.1f", output_trim_db);
gfx_x=956; gfx_y=trim_y-16; gfx_drawstr(gs);
gfx_r=0.5; gfx_g=0.55; gfx_b=0.6;
gfx_setfont(1, "Arial", 11);
gfx_x=956; gfx_y=trim_y+6; gfx_drawstr(#str_Trim);

// ===== 13. A/B BUTTONS =====
ab_x = 84; ab_y = 4; ab_w = 26; ab_h = 22;
gfx_setfont(1, "Arial", 14);
gfx_r=0.2+(state_cur==0)*0.3; gfx_g=0.25+(state_cur==0)*0.35; gfx_b=0.35+(state_cur==0)*0.4;
gfx_x=ab_x; gfx_y=ab_y; gfx_rectto(ab_x+ab_w, ab_y+ab_h);
gfx_r=0.65; gfx_g=0.70; gfx_b=0.75;
gfx_x=ab_x; gfx_y=ab_y; gfx_lineto(ab_x+ab_w, ab_y, 0);
gfx_x=ab_x; gfx_y=ab_y+1; gfx_lineto(ab_x+ab_w, ab_y+1, 0);
gfx_x=ab_x+ab_w; gfx_y=ab_y; gfx_lineto(ab_x+ab_w, ab_y+ab_h, 0);
gfx_x=ab_x+ab_w-1; gfx_y=ab_y; gfx_lineto(ab_x+ab_w-1, ab_y+ab_h, 0);
gfx_x=ab_x+ab_w; gfx_y=ab_y+ab_h; gfx_lineto(ab_x, ab_y+ab_h, 0);
gfx_x=ab_x+ab_w; gfx_y=ab_y+ab_h-1; gfx_lineto(ab_x, ab_y+ab_h-1, 0);
gfx_x=ab_x; gfx_y=ab_y+ab_h; gfx_lineto(ab_x, ab_y, 0);
gfx_x=ab_x+1; gfx_y=ab_y+ab_h; gfx_lineto(ab_x+1, ab_y, 0);
gfx_r=0.85+(state_cur==0)*0.15; gfx_g=0.87; gfx_b=0.9;
gfx_x=ab_x+7; gfx_y=ab_y+4; gfx_drawstr(#str_A);

gfx_r=0.2+(state_cur==1)*0.3; gfx_g=0.25+(state_cur==1)*0.35; gfx_b=0.35+(state_cur==1)*0.4;
gfx_x=ab_x+ab_w+4; gfx_y=ab_y; gfx_rectto(ab_x+2*ab_w+4, ab_y+ab_h);
gfx_r=0.65; gfx_g=0.70; gfx_b=0.75;
gfx_x=ab_x+ab_w+4; gfx_y=ab_y; gfx_lineto(ab_x+2*ab_w+4, ab_y, 0);
gfx_x=ab_x+ab_w+4; gfx_y=ab_y+1; gfx_lineto(ab_x+2*ab_w+4, ab_y+1, 0);
gfx_x=ab_x+2*ab_w+4; gfx_y=ab_y; gfx_lineto(ab_x+2*ab_w+4, ab_y+ab_h, 0);
gfx_x=ab_x+2*ab_w+3; gfx_y=ab_y; gfx_lineto(ab_x+2*ab_w+3, ab_y+ab_h, 0);
gfx_x=ab_x+2*ab_w+4; gfx_y=ab_y+ab_h; gfx_lineto(ab_x+ab_w+4, ab_y+ab_h, 0);
gfx_x=ab_x+2*ab_w+4; gfx_y=ab_y+ab_h-1; gfx_lineto(ab_x+ab_w+4, ab_y+ab_h-1, 0);
gfx_x=ab_x+ab_w+4; gfx_y=ab_y+ab_h; gfx_lineto(ab_x+ab_w+4, ab_y, 0);
gfx_x=ab_x+ab_w+5; gfx_y=ab_y+ab_h; gfx_lineto(ab_x+ab_w+5, ab_y, 0);
gfx_r=0.85+(state_cur==1)*0.15; gfx_g=0.87; gfx_b=0.9;
gfx_x=ab_x+ab_w+11; gfx_y=ab_y+4; gfx_drawstr(#str_B);

// ===== 14. UNDO/REDO/RESET/AUTOGAIN =====
undo_oldest = (undo_head_[0] - undo_size_[0] + 1 + 20) % 20;
can_undo_v = (undo_size_[0] > 1) * (undo_pos_[0] != undo_oldest);
can_redo_v = (undo_pos_[0] != undo_head_[0]) * (undo_size_[0] > 0);
un_x = 148; un_w = 20; un_y = 4; un_h = 22;
gfx_r=0.2+can_undo_v*0.15; gfx_g=0.25+can_undo_v*0.2; gfx_b=0.35+can_undo_v*0.25;
gfx_x=un_x; gfx_y=un_y; gfx_rectto(un_x+un_w, un_y+un_h);
gfx_r=0.65; gfx_g=0.70; gfx_b=0.75;
gfx_x=un_x; gfx_y=un_y; gfx_lineto(un_x+un_w, un_y, 0);
