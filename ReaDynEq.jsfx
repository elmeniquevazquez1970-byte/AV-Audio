gfx_x=347; gfx_y=SUB_Y+32; gfx_lineto(347, SUB_Y+8, 0);
gfx_r=0.90+is_onsets*0.10; gfx_g=0.92; gfx_b=0.95;
gfx_x=354; gfx_y=SUB_Y+14; gfx_drawstr(#str_Onsets);

gfx_setfont(1, "Arial", 12);
gfx_r=0.53; gfx_g=0.57; gfx_b=0.63;
gfx_x=305; gfx_y=SUB_Y+36; gfx_drawstr(#str_Detect);

is_above = band_trigger[sel] == 0;
is_below = 1 - is_above;

gfx_r=0.12+is_above*0.20; gfx_g=0.13+is_above*0.22; gfx_b=0.18+is_above*0.22;
gfx_a=1;
gfx_x=390; gfx_y=SUB_Y+8; gfx_rectto(470, SUB_Y+32);
gfx_r=0.45; gfx_g=0.48; gfx_b=0.55;
gfx_x=390; gfx_y=SUB_Y+8; gfx_lineto(470, SUB_Y+8, 0);
gfx_x=390; gfx_y=SUB_Y+9; gfx_lineto(470, SUB_Y+9, 0);
gfx_x=470; gfx_y=SUB_Y+8; gfx_lineto(470, SUB_Y+32, 0);
gfx_x=469; gfx_y=SUB_Y+8; gfx_lineto(469, SUB_Y+32, 0);
gfx_x=470; gfx_y=SUB_Y+32; gfx_lineto(390, SUB_Y+32, 0);
gfx_x=470; gfx_y=SUB_Y+31; gfx_lineto(390, SUB_Y+31, 0);
gfx_x=390; gfx_y=SUB_Y+32; gfx_lineto(390, SUB_Y+8, 0);
gfx_x=391; gfx_y=SUB_Y+32; gfx_lineto(391, SUB_Y+8, 0);
gfx_setfont(1, "Arial", 14);
gfx_r=0.90+is_above*0.10; gfx_g=0.92; gfx_b=0.95; gfx_a=1;
gfx_x=414; gfx_y=SUB_Y+12; gfx_drawstr(#str_Above);

gfx_r=0.12+is_below*0.20; gfx_g=0.13+is_below*0.22; gfx_b=0.18+is_below*0.22;
gfx_a=1;
gfx_x=390; gfx_y=SUB_Y+36; gfx_rectto(470, SUB_Y+60);
gfx_r=0.45; gfx_g=0.48; gfx_b=0.55;
gfx_x=390; gfx_y=SUB_Y+36; gfx_lineto(470, SUB_Y+36, 0);
gfx_x=390; gfx_y=SUB_Y+37; gfx_lineto(470, SUB_Y+37, 0);
gfx_x=470; gfx_y=SUB_Y+36; gfx_lineto(470, SUB_Y+60, 0);
gfx_x=469; gfx_y=SUB_Y+36; gfx_lineto(469, SUB_Y+60, 0);
gfx_x=470; gfx_y=SUB_Y+60; gfx_lineto(390, SUB_Y+60, 0);
gfx_x=470; gfx_y=SUB_Y+59; gfx_lineto(390, SUB_Y+59, 0);
gfx_x=390; gfx_y=SUB_Y+60; gfx_lineto(390, SUB_Y+36, 0);
gfx_x=391; gfx_y=SUB_Y+60; gfx_lineto(391, SUB_Y+36, 0);
gfx_r=0.90+is_below*0.10; gfx_g=0.92; gfx_b=0.95;
gfx_x=414; gfx_y=SUB_Y+40; gfx_drawstr(#str_Below);
gfx_setfont(1, "Arial", 13);
gfx_r=0.53; gfx_g=0.57; gfx_b=0.63;
gfx_x=414; gfx_y=SUB_Y+66; gfx_drawstr(#str_Trigger);

// ===== 22. KNOBS =====
kcx = 510; kcy = SUB_Y + 40; kr = 24;
tval = band_thresh[sel];
tnorm = (tval + 48) / 48;
tnorm = max(0, min(1, tnorm));
tangle = -2.30 + tnorm * 4.60;
draw_knob(kcx, kcy, kr, tangle);
gfx_setfont(1, "Arial", 12);
gs = sprintf(#, "%.1f", tval);
gfx_measurestr(gs, tw, th);
gfx_r=0; gfx_g=0; gfx_b=0; gfx_a=1;
gfx_x = kcx - tw/2 + 1; gfx_y = kcy + 3 + 1;
gfx_drawstr(gs);
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
gfx_x = kcx - tw/2; gfx_y = kcy + 3;
gfx_drawstr(gs);
gfx_r=0.53; gfx_g=0.57; gfx_b=0.63; gfx_a=1;
gfx_setfont(1, "Arial", 13);
gfx_measurestr(#str_Threshold, tw, th);
gfx_x = kcx - tw/2; gfx_y = SUB_Y + 72;
gfx_drawstr(#str_Threshold);

kcx = 580;
dval = band_dyn[sel];
dnorm = dval / 100;
dangle = -2.30 + dnorm * 4.60;
draw_knob(kcx, kcy, kr, dangle);
gfx_setfont(1, "Arial", 12);
gs = sprintf(#, "%d%%", dval);
gfx_measurestr(gs, tw, th);
gfx_r=0; gfx_g=0; gfx_b=0; gfx_a=1;
gfx_x = kcx - tw/2 + 1; gfx_y = kcy + 3 + 1;
gfx_drawstr(gs);
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
gfx_x = kcx - tw/2; gfx_y = kcy + 3;
gfx_drawstr(gs);
gfx_r=0.53; gfx_g=0.57; gfx_b=0.63;
gfx_setfont(1, "Arial", 13);
gfx_measurestr(#str_Dynamics, tw, th);
gfx_x = kcx - tw/2; gfx_y = SUB_Y + 72;
gfx_drawstr(#str_Dynamics);

kcx = 650;
aval = band_attack[sel];
anorm = aval / 100;
anorm = max(0, min(1, anorm));
aangle = -2.30 + anorm * 4.60;
draw_knob(kcx, kcy, kr, aangle);
gfx_setfont(1, "Arial", 12);
gs = sprintf(#, "%.0f", aval);
gfx_measurestr(gs, tw, th);
gfx_r=0; gfx_g=0; gfx_b=0; gfx_a=1;
gfx_x = kcx - tw/2 + 1; gfx_y = kcy + 3 + 1;
gfx_drawstr(gs);
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
gfx_x = kcx - tw/2; gfx_y = kcy + 3;
gfx_drawstr(gs);
gfx_r=0.53; gfx_g=0.57; gfx_b=0.63;
gfx_setfont(1, "Arial", 13);
gfx_measurestr(#str_Attack, tw, th);
gfx_x = kcx - tw/2; gfx_y = SUB_Y + 72;
gfx_drawstr(#str_Attack);

kcx = 720;
rval = band_release[sel];
rnorm = rval / 1000;
rnorm = max(0, min(1, rnorm));
rangle = -2.30 + rnorm * 4.60;
draw_knob(kcx, kcy, kr, rangle);
gfx_setfont(1, "Arial", 12);
gs = sprintf(#, "%.0f", rval);
gfx_measurestr(gs, tw, th);
gfx_r=0; gfx_g=0; gfx_b=0; gfx_a=1;
gfx_x = kcx - tw/2 + 1; gfx_y = kcy + 3 + 1;
gfx_drawstr(gs);
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
gfx_x = kcx - tw/2; gfx_y = kcy + 3;
gfx_drawstr(gs);
gfx_r=0.53; gfx_g=0.57; gfx_b=0.63;
gfx_setfont(1, "Arial", 13);
gfx_measurestr(#str_Release, tw, th);
gfx_x = kcx - tw/2; gfx_y = SUB_Y + 72;
gfx_drawstr(#str_Release);

// ===== 23. DYNAMIC TRANSFER FUNCTION (v2) =====
tc_x0 = 800; tc_x1 = 992;
tc_y0 = 506; tc_y1 = 616;
tc_w = tc_x1 - tc_x0;
tc_h = tc_y1 - tc_y0;
gfx_r=0.05; gfx_g=0.06; gfx_b=0.09; gfx_a=1;
gfx_x=tc_x0; gfx_y=tc_y0; gfx_rectto(tc_x1, tc_y1);

dyn_tgt = band_target[sel];
dyn_off = band_gain[sel];
dyn_trig = band_trigger[sel];
dyn_thr = band_thresh[sel];
dyn_amt = band_dyn[sel] * 0.01;
is_above = (dyn_trig == 0);
dyn_tgt_higher = (dyn_tgt > dyn_off);

is_down_comp = (is_above == 1) * (dyn_tgt_higher == 0);
is_up_exp    = (is_above == 1) * (dyn_tgt_higher == 1);
is_up_comp   = (is_above == 0) * (dyn_tgt_higher == 1);
is_down_exp  = (is_above == 0) * (dyn_tgt_higher == 0);

tc_px0 = tc_x0 + 6;
tc_px1 = tc_x1 - 6;
tc_py0 = tc_y0 + 18;
tc_py1 = tc_y1 - 18;
tc_pw = tc_px1 - tc_px0;
tc_ph = tc_py1 - tc_py0;

gfx_r=0.08; gfx_g=0.09; gfx_b=0.12; gfx_a=1;
gfx_x=tc_px0; gfx_y=tc_py0; gfx_rectto(tc_px1, tc_py1);

gfx_r=0.35; gfx_g=0.38; gfx_b=0.42; gfx_a=1;
gfx_x=tc_px0; gfx_y=tc_py1; gfx_lineto(tc_px1, tc_py1, 0);
gfx_x=tc_px0; gfx_y=tc_py0; gfx_lineto(tc_px0, tc_py1, 0);

gfx_r=0.4; gfx_g=0.42; gfx_b=0.48; gfx_a=1;
tc_i = 0;
while (tc_i < tc_pw) (
  tc_y1p = tc_py1 - (tc_i / tc_pw) * tc_ph;
  tc_y2p = tc_py1 - ((tc_i + 3) / tc_pw) * tc_ph;
  (tc_y1p >= tc_py0) ? (
    gfx_x = tc_px0 + tc_i; gfx_y = tc_y1p;
    gfx_lineto(tc_px0 + tc_i + 3, tc_y2p, 0);
  );
  tc_i += 7;
);

thr_norm = (dyn_thr + 60) / 60;
thr_norm = max(0, min(1, thr_norm));
thr_x = tc_px0 + thr_norm * tc_pw;
thr_y = tc_py1 - thr_norm * tc_ph;

gfx_r=1; gfx_g=0.4; gfx_b=0.4; gfx_a=0.6;
tc_i = tc_px0;
while (tc_i < tc_px1) (
  gfx_x = tc_i; gfx_y = thr_y;
  gfx_lineto(min(tc_i + 3, tc_px1), thr_y, 0);
  tc_i += 6;
);

gfx_r=0.5; gfx_g=0.5; gfx_b=0.55; gfx_a=0.5;
tc_i = thr_y;
while (tc_i < tc_py1) (
  gfx_x = thr_x; gfx_y = tc_i;
  gfx_lineto(thr_x, min(tc_i + 3, tc_py1), 0);
  tc_i += 6;
);

is_down_comp ? ( gfx_r=1.0; gfx_g=0.55; gfx_b=0.3; );
is_up_exp    ? ( gfx_r=0.4; gfx_g=1.0; gfx_b=0.5; );
is_up_comp   ? ( gfx_r=0.35; gfx_g=0.8; gfx_b=1.0; );
is_down_exp  ? ( gfx_r=0.9; gfx_g=0.4; gfx_b=0.9; );
gfx_a = 1;

tc_first = 1;
tc_i = 0;
while (tc_i <= tc_pw) (
  in_db = -60 + (tc_i / tc_pw) * 60;
  thr_lo = dyn_thr - 5;
  dyn_raw = (in_db - thr_lo) * 0.1;
  dyn_raw = max(0, min(1, dyn_raw));
  (is_above == 0) ? dyn_raw = 1 - dyn_raw;
  dyn_final = dyn_raw * dyn_amt;
  gain_now = dyn_off * (1 - dyn_final) + dyn_tgt * dyn_final;
  out_db = in_db + gain_now;
  out_db = max(-60, min(0, out_db));
  px = tc_px0 + tc_i;
  py = tc_py1 - ((out_db + 60) / 60) * tc_ph;
  py = max(tc_py0, min(tc_py1, py));
  tc_first ? ( gfx_x = px; gfx_y = py; tc_first = 0; ) : ( gfx_lineto(px, py, 0); );
  tc_i += 1;
);

gfx_r=0.3; gfx_g=0.33; gfx_b=0.38; gfx_a=1;
gfx_x=tc_x0; gfx_y=tc_y0; gfx_lineto(tc_x1, tc_y0, 0);
gfx_x=tc_x1; gfx_y=tc_y0; gfx_lineto(tc_x1, tc_y1, 0);
gfx_x=tc_x1; gfx_y=tc_y1; gfx_lineto(tc_x0, tc_y1, 0);
gfx_x=tc_x0; gfx_y=tc_y1; gfx_lineto(tc_x0, tc_y0, 0);

gfx_setfont(1, "Arial", 11);
gfx_r=0.85; gfx_g=0.88; gfx_b=0.92; gfx_a=1;
gfx_measurestr("DYNAMIC TRANSFER FUNCTION", tw, th);
gfx_x = tc_x0 + (tc_w - tw) * 0.5;
gfx_y = tc_y0 + 3;
gfx_drawstr("DYNAMIC TRANSFER FUNCTION");

gfx_setfont(1, "Arial", 12);
is_down_comp ? ( gfx_r=1.0; gfx_g=0.55; gfx_b=0.3; );
is_up_exp    ? ( gfx_r=0.4; gfx_g=1.0; gfx_b=0.5; );
is_up_comp   ? ( gfx_r=0.35; gfx_g=0.8; gfx_b=1.0; );
is_down_exp  ? ( gfx_r=0.9; gfx_g=0.4; gfx_b=0.9; );
gfx_a = 1;
is_down_comp ? gfx_measurestr("DOWNWARDS COMPRESSION", tw, th);
is_up_exp    ? gfx_measurestr("UPWARDS EXPANSION", tw, th);
is_up_comp   ? gfx_measurestr("UPWARDS COMPRESSION", tw, th);
is_down_exp  ? gfx_measurestr("DOWNWARDS EXPANSION", tw, th);
gfx_x = tc_x0 + (tc_w - tw) * 0.5;
gfx_y = tc_y1 - 15;
is_down_comp ? gfx_drawstr("DOWNWARDS COMPRESSION");
is_up_exp    ? gfx_drawstr("UPWARDS EXPANSION");
is_up_comp   ? gfx_drawstr("UPWARDS COMPRESSION");
is_down_exp  ? gfx_drawstr("DOWNWARDS EXPANSION");

// ===== 23b. ANALIZADOR ReSpectrum-style =====
_prev_m = (prev_cap & 1) > 0;
_now_m  = (mouse_cap & 1) > 0;
_rs_press = _now_m * (1 - _prev_m);

_rs_px0 = rs_expanded ? 42  : 2;
_rs_py0 = rs_expanded ? 52  : 500;
_rs_px1 = rs_expanded ? 928 : 246;
_rs_py1 = rs_expanded ? 402 : 616;

_rs_bw = rs_expanded ? 46 : 34;
_rs_pw = rs_expanded ? 34 : 24;
_rs_hd  = rs_expanded ? 20 : 13;
_rs_byo = rs_expanded ? 3 : 1;

_rs_setx = _rs_px1 - _rs_bw - 3;
_rs_pkx  = _rs_setx - _rs_pw - 2;
_rs_btny0 = _rs_py0 + 1;
_rs_btny1 = _rs_py0 + _rs_hd;

_rs_in_panel = (mouse_x>=_rs_px0)*(mouse_x<=_rs_px1)*(mouse_y>=_rs_py0)*(mouse_y<=_rs_py1);
_rs_on_btn = (mouse_x>=_rs_pkx)*(mouse_x<=_rs_setx+_rs_bw)
           * (mouse_y>=_rs_btny0)*(mouse_y<=_rs_btny1);
_rs_dbl = _rs_press * _rs_in_panel * (1 - _rs_on_btn);

_rs_dbl ? (
  _rs_t = time_precise();
  (_rs_t - rs_last_click_t) < 0.40 ? (
    rs_expanded = 1 - rs_expanded;
    rs_last_click_t = 0;
  ) : (
    rs_last_click_t = _rs_t;
  );
);

rs_expanded ? (
  an_x0 = 42; an_y0 = 52; an_x1 = 928; an_y1 = 402;
  rs_hdr_h = 20; rs_btn_h = 14; rs_btn_yo = 3;
  rs_set_w = 46; rs_pk_w = 34;
  rs_font_hdr = 11; rs_font_btn = 10;
  rs_font_info = 12; rs_info_w = 180; rs_info_h = 60;
) : (
  an_x0 = 2; an_y0 = 500; an_x1 = 246; an_y1 = 616;
  rs_hdr_h = 13; rs_btn_h = 11; rs_btn_yo = 1;
  rs_set_w = 34; rs_pk_w = 24;
  rs_font_hdr = 9; rs_font_btn = 9;
  rs_font_info = 9; rs_info_w = 96; rs_info_h = 38;
);
an_w = an_x1 - an_x0; an_h = an_y1 - an_y0;

gfx_r=0.08; gfx_g=0.09; gfx_b=0.12; gfx_a=1;
gfx_x=an_x0; gfx_y=an_y0; gfx_rectto(an_x1, an_y1);
gfx_r=0.20; gfx_g=0.22; gfx_b=0.26;
gfx_x=an_x0; gfx_y=an_y0; gfx_lineto(an_x1, an_y0, 0);
gfx_x=an_x1; gfx_y=an_y0; gfx_lineto(an_x1, an_y1, 0);
gfx_x=an_x1; gfx_y=an_y1; gfx_lineto(an_x0, an_y1, 0);
gfx_x=an_x0; gfx_y=an_y1; gfx_lineto(an_x0, an_y0, 0);

rs_hdr_y0 = an_y0 + 1; rs_hdr_y1 = an_y0 + rs_hdr_h;
gfx_setfont(1, "Arial", rs_font_hdr);
gfx_r=0.85; gfx_g=0.88; gfx_b=0.92; gfx_a=1;
gfx_x = an_x0 + 4;
gfx_y = rs_hdr_y0 + (rs_hdr_h - rs_font_hdr)*0.5 - 1;
gfx_drawstr(rs_expanded ? "SPECTRUM ANALYZER  [dbl-click to collapse]" : "SPECTRUM  [dbl-click]");

rs_btn_y = rs_hdr_y0 + rs_btn_yo;

rs_set_x = an_x1 - rs_set_w - 3;
gfx_r=0.30; gfx_g=0.55; gfx_b=0.85; gfx_a=0.75;
gfx_x=rs_set_x; gfx_y=rs_btn_y; gfx_rectto(rs_set_x+rs_set_w, rs_btn_y+rs_btn_h);
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
gfx_setfont(1, "Arial", rs_font_btn);
gfx_x=rs_set_x + 4; gfx_y = rs_btn_y + (rs_btn_h - rs_font_btn)*0.5 - 1;
gfx_drawstr("Set");

rs_pk_x = rs_set_x - rs_pk_w - 2;
gfx_r = rs_show_peaks ? 0.9 : 0.30;
gfx_g = rs_show_peaks ? 0.6 : 0.30;
gfx_b = rs_show_peaks ? 0.2 : 0.30;
gfx_x=rs_pk_x; gfx_y=rs_btn_y; gfx_rectto(rs_pk_x+rs_pk_w, rs_btn_y+rs_btn_h);
gfx_r=1; gfx_g=1; gfx_b=1;
gfx_x=rs_pk_x + 4; gfx_y = rs_btn_y + (rs_btn_h - rs_font_btn)*0.5 - 1;
gfx_drawstr("Pk");

rs_pl_x0 = an_x0 + 2; rs_pl_x1 = an_x1 - 2;
rs_pl_y0 = rs_hdr_y1 + 2;
rs_pl_y1 = an_y1 - 8;
rs_pl_w = rs_pl_x1 - rs_pl_x0;
rs_pl_h = rs_pl_y1 - rs_pl_y0;

gfx_r=0.02; gfx_g=0.03; gfx_b=0.05; gfx_a=1;
gfx_x=rs_pl_x0; gfx_y=rs_pl_y0; gfx_rectto(rs_pl_x1, rs_pl_y1);

rs_ceiling = rs_ceiling_idx==0 ? 0 : rs_ceiling_idx==1 ? 20 : 40;
rs_floor   = rs_floor_idx==0 ? -90 : rs_floor_idx==1 ? -140 : -200;
rs_tilt_db = rs_tilt_idx==0 ? 0 : rs_tilt_idx==1 ? 1.5 : rs_tilt_idx==2 ? 3 : rs_tilt_idx==3 ? 4.5 : 6;

rs_gdb = rs_ceiling;
while (rs_gdb >= rs_floor) (
  rs_gy = rs_pl_y0 + (rs_ceiling - rs_gdb)/(rs_ceiling - rs_floor) * rs_pl_h;
  gfx_r=0.12; gfx_g=0.14; gfx_b=0.17; gfx_a=1;
  gfx_x=rs_pl_x0; gfx_y=rs_gy; gfx_lineto(rs_pl_x1, rs_gy, 0);
  rs_gdb -= 20;
);

rs_gf = 100;
while (rs_gf <= 10000) (
  rs_gx = rs_pl_x0 + (log(rs_gf) - LOG_20)/LOG_RNG * rs_pl_w;
  (rs_gx >= rs_pl_x0) && (rs_gx <= rs_pl_x1) ? (
    gfx_r=0.12; gfx_g=0.14; gfx_b=0.17; gfx_a=1;
    gfx_x=rs_gx; gfx_y=rs_pl_y0; gfx_lineto(rs_gx, rs_pl_y1, 0);
  );
  rs_gf *= 10;
);

rs_block_size = 1024 * pow(2, rs_block_idx + 1);
rs_block_size != rs_block_size_prev ? (
  rs_i = 0;
  while (rs_i < rs_block_size) (
    rs_w1 = 2*$pi*rs_i/(rs_block_size-1);
    rs_window_type == 0 ? (
      rs_fft_win[rs_i] = 0.54 - 0.46*cos(rs_w1);
      rs_win_gain_db = 20*log(0.54)*INV_LN10;
    ) : rs_window_type == 1 ? (
      rs_fft_win[rs_i] = 0.35875 - 0.48829*cos(rs_w1)
                       + 0.14128*cos(2*rs_w1) - 0.01168*cos(3*rs_w1);
      rs_win_gain_db = 20*log(0.35875)*INV_LN10;
    ) : rs_window_type == 2 ? (
      rs_fft_win[rs_i] = 0.42 - 0.5*cos(rs_w1) + 0.08*cos(2*rs_w1);
      rs_win_gain_db = 20*log(0.42)*INV_LN10;
    ) : (
      rs_fft_win[rs_i] = 1;
      rs_win_gain_db = 0;
    );
    rs_i += 1;
  );
  rs_block_size_prev = rs_block_size;
);
rs_norm = 2.0 / rs_block_size;

rs_display_mode != 2 ? (
  rs_i = 0;
  while (rs_i < rs_block_size) (
    rs_idx = (rs_widx[0] - rs_block_size + rs_i + RS_MAX) % RS_MAX;
    rs_fft_buf[rs_i*2]     = rs_ring_mid[rs_idx] * rs_fft_win[rs_i];
    rs_fft_buf[rs_i*2 + 1] = 0;
    rs_i += 1;
  );
  fft(rs_fft_buf, rs_block_size);
  fft_permute(rs_fft_buf, rs_block_size);
  rs_i = 0;
  while (rs_i < rs_block_size/2) (
    rs_re = rs_fft_buf[rs_i*2];
    rs_im = rs_fft_buf[rs_i*2 + 1];
    rs_m = sqrt(rs_re*rs_re + rs_im*rs_im) * rs_norm;
    rs_db = 20 * log(max(0.000001, rs_m)) * INV_LN10 - rs_win_gain_db;
    rs_f = max(20, (rs_i + 0.5) * dsp_sr / rs_block_size);
    rs_db += rs_tilt_db * log(rs_f/1000) / log(2);
    rs_mag_mid[rs_i] = max(rs_db, rs_mag_mid[rs_i] - 1.0);
    rs_i += 1;
  );

  (rs_spec_mode == 3) || (rs_spec_mode == 6) ? (
    rs_i = 0;
    while (rs_i < rs_block_size) (
      rs_idx = (rs_widx[0] - rs_block_size + rs_i + RS_MAX) % RS_MAX;
      rs_fft_buf[rs_i*2]     = rs_ring_side[rs_idx] * rs_fft_win[rs_i];
      rs_fft_buf[rs_i*2 + 1] = 0;
      rs_i += 1;
    );
    fft(rs_fft_buf, rs_block_size);
    fft_permute(rs_fft_buf, rs_block_size);
    rs_i = 0;
    while (rs_i < rs_block_size/2) (
      rs_re = rs_fft_buf[rs_i*2];
      rs_im = rs_fft_buf[rs_i*2 + 1];
      rs_m = sqrt(rs_re*rs_re + rs_im*rs_im) * rs_norm;
      rs_db = 20 * log(max(0.000001, rs_m)) * INV_LN10 - rs_win_gain_db;
      rs_f = max(20, (rs_i + 0.5) * dsp_sr / rs_block_size);
      rs_db += rs_tilt_db * log(rs_f/1000) / log(2);
      rs_mag_side[rs_i] = max(rs_db, rs_mag_side[rs_i] - 1.0);
      rs_i += 1;
    );
  );

  rs_show_peaks ? (
    rs_i = 0;
    while (rs_i < rs_block_size/2) (
      rs_mag_mid[rs_i] > rs_peak_mid[rs_i] ? rs_peak_mid[rs_i] = rs_mag_mid[rs_i];
      rs_peak_mid[rs_i] -= 0.03;
      rs_i += 1;
    );
    (rs_spec_mode == 3) || (rs_spec_mode == 6) ? (
      rs_i = 0;
      while (rs_i < rs_block_size/2) (
        rs_mag_side[rs_i] > rs_peak_side[rs_i] ? rs_peak_side[rs_i] = rs_mag_side[rs_i];
        rs_peak_side[rs_i] -= 0.03;
        rs_i += 1;
      );
    );
  );

  rs_nyq = dsp_sr * 0.5;
  rs_bins = rs_block_size / 2;

  ((rs_spec_mode == 3) || (rs_spec_mode == 6)) ? (
    rs_prev_x = -1;
    rs_x = rs_pl_x0;
    while (rs_x <= rs_pl_x1) (
      rs_f = exp(LOG_20 + (rs_x - rs_pl_x0)/rs_pl_w * LOG_RNG);
      rs_bin = max(1, min(rs_bins-2, rs_f/rs_nyq*rs_bins));
      rs_b0 = floor(rs_bin); rs_b1 = rs_b0+1; rs_frac = rs_bin-rs_b0;
      rs_v = rs_mag_side[rs_b0]*(1-rs_frac) + rs_mag_side[rs_b1]*rs_frac;
      rs_v = max(rs_floor, min(rs_ceiling, rs_v));
      rs_y = rs_pl_y1 - ((rs_v - rs_floor)/(rs_ceiling - rs_floor)) * rs_pl_h;
      rs_y = max(rs_pl_y0, min(rs_pl_y1, rs_y));
      rs_prev_x >= 0 ? (
        gfx_r=0.5; gfx_g=0.85; gfx_b=0.3; gfx_a=0.6;
        gfx_x = rs_prev_x; gfx_y = rs_prev_y;
        gfx_lineto(rs_x, rs_y, 0);
      );
      rs_prev_x = rs_x; rs_prev_y = rs_y;
      rs_x += 2;
    );
  );

  rs_prev_x = -1;
  rs_x = rs_pl_x0;
  while (rs_x <= rs_pl_x1) (
    rs_f = exp(LOG_20 + (rs_x - rs_pl_x0)/rs_pl_w * LOG_RNG);
    rs_bin = max(1, min(rs_bins-2, rs_f/rs_nyq*rs_bins));
    rs_b0 = floor(rs_bin); rs_b1 = rs_b0+1; rs_frac = rs_bin-rs_b0;
    rs_v = rs_mag_mid[rs_b0]*(1-rs_frac) + rs_mag_mid[rs_b1]*rs_frac;
    rs_v = max(rs_floor, min(rs_ceiling, rs_v));
    rs_y = rs_pl_y1 - ((rs_v - rs_floor)/(rs_ceiling - rs_floor)) * rs_pl_h;
    rs_y = max(rs_pl_y0, min(rs_pl_y1, rs_y));

    rs_display_mode == 0 ? (
      gfx_r=0.38; gfx_g=0.84; gfx_b=1.0; gfx_a=0.45;
      gfx_x = rs_x; gfx_y = rs_y;
      gfx_rectto(rs_x + 1, rs_pl_y1);
    ) : rs_display_mode == 1 ? (
      gfx_r=0.45; gfx_g=0.84; gfx_b=0.99; gfx_a=1;
      rs_prev_x >= 0 ? (
        gfx_x = rs_prev_x; gfx_y = rs_prev_y;
        gfx_lineto(rs_x, rs_y, 0);
      );
    );
    rs_prev_x = rs_x; rs_prev_y = rs_y;
    rs_x += 1;
  );

  rs_show_peaks ? (
    rs_x = rs_pl_x0;
    while (rs_x <= rs_pl_x1) (
      rs_f = exp(LOG_20 + (rs_x - rs_pl_x0)/rs_pl_w * LOG_RNG);
      rs_bin = max(1, min(rs_bins-2, rs_f/rs_nyq*rs_bins));
      rs_b0 = floor(rs_bin); rs_b1 = rs_b0+1; rs_frac = rs_bin-rs_b0;
      rs_v = rs_peak_mid[rs_b0]*(1-rs_frac) + rs_peak_mid[rs_b1]*rs_frac;
      rs_v = max(rs_floor, min(rs_ceiling, rs_v));
      rs_y = rs_pl_y1 - ((rs_v - rs_floor)/(rs_ceiling - rs_floor)) * rs_pl_h;
      rs_y = max(rs_pl_y0, min(rs_pl_y1, rs_y));
      gfx_r=1; gfx_g=0.7; gfx_b=0.2; gfx_a=0.9;
      gfx_x=rs_x; gfx_y=rs_y; gfx_lineto(rs_x+1, rs_y, 0);
      rs_x += 2;
    );
  );
);

gfx_r=0.30; gfx_g=0.33; gfx_b=0.38; gfx_a=1;
gfx_x=rs_pl_x0; gfx_y=rs_pl_y0; gfx_lineto(rs_pl_x1, rs_pl_y0, 0);
gfx_x=rs_pl_x1; gfx_y=rs_pl_y0; gfx_lineto(rs_pl_x1, rs_pl_y1, 0);
gfx_x=rs_pl_x1; gfx_y=rs_pl_y1; gfx_lineto(rs_pl_x0, rs_pl_y1, 0);
gfx_x=rs_pl_x0; gfx_y=rs_pl_y1; gfx_lineto(rs_pl_x0, rs_pl_y0, 0);

rs_in_plot = (mouse_x >= rs_pl_x0) && (mouse_x <= rs_pl_x1)
           && (mouse_y >= rs_pl_y0) && (mouse_y <= rs_pl_y1);
rs_in_plot ? (
  rs_mf = exp(LOG_20 + (mouse_x - rs_pl_x0)/rs_pl_w * LOG_RNG);
  rs_mf = max(20, min(20000, rs_mf));
  rs_mdb = rs_ceiling - (mouse_y - rs_pl_y0)/rs_pl_h * (rs_ceiling - rs_floor);

  rs_C0 = 440 * pow(2, -4.75);
  rs_semi = floor(12 * log(rs_mf/rs_C0)/log(2) + 0.5);
  rs_note = (rs_semi % 12 + 12) % 12;
  rs_oct = floor((rs_semi)/12);
  rs_nf = rs_C0 * pow(2, rs_semi/12);
  rs_cent = floor(1200 * log(rs_mf/rs_nf)/log(2) + 0.5);

  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.25;
  gfx_x=rs_pl_x0; gfx_y=mouse_y; gfx_lineto(rs_pl_x1, mouse_y, 0);
  gfx_x=mouse_x; gfx_y=rs_pl_y0; gfx_lineto(mouse_x, rs_pl_y1, 0);

  rs_info_x0 = rs_pl_x1 - rs_info_w;
  rs_info_y0 = rs_pl_y0 + 2;
  gfx_r=0.05; gfx_g=0.05; gfx_b=0.08; gfx_a=0.85;
  gfx_x=rs_info_x0; gfx_y=rs_info_y0;
  gfx_rectto(rs_pl_x1-2, rs_info_y0+rs_info_h);
  gfx_setfont(1, "Arial", rs_font_info);

  gfx_r=0.45; gfx_g=0.85; gfx_b=1; gfx_a=1;
  rs_mf < 1000 ? gs = sprintf(#, "%.1f Hz", rs_mf)
               : gs = sprintf(#, "%.2f kHz", rs_mf/1000);
  gfx_x=rs_info_x0+3; gfx_y=rs_info_y0+2; gfx_drawstr(gs);

  rs_nn = "?";
  rs_note == 0  ? rs_nn = "C";
  rs_note == 1  ? rs_nn = "C#";
  rs_note == 2  ? rs_nn = "D";
  rs_note == 3  ? rs_nn = "D#";
  rs_note == 4  ? rs_nn = "E";
  rs_note == 5  ? rs_nn = "F";
  rs_note == 6  ? rs_nn = "F#";
  rs_note == 7  ? rs_nn = "G";
  rs_note == 8  ? rs_nn = "G#";
  rs_note == 9  ? rs_nn = "A";
  rs_note == 10 ? rs_nn = "A#";
  rs_note == 11 ? rs_nn = "B";
  strcat(rs_nn, sprintf(#, "%d", rs_oct));
  gfx_r=0.85; gfx_g=0.9; gfx_b=0.95;
  gfx_x=rs_info_x0+3; gfx_y=rs_info_y0 + (rs_font_info+2);
  gfx_drawstr(rs_nn);

  gs = sprintf(#, "%+d ct", rs_cent);
  gfx_x=rs_info_x0 + rs_info_w*0.45; gfx_y=rs_info_y0 + (rs_font_info+2);
  gfx_drawstr(gs);

  gs = sprintf(#, "%.1f dB", rs_mdb);
  gfx_x=rs_info_x0+3; gfx_y=rs_info_y0 + (rs_font_info+2)*2;
  gfx_drawstr(gs);
);

(mouse_cap & 8) && rs_in_plot ? (
  rs_do_listen = 1;
  rs_listen_freq = rs_mf;
  rs_lf = exp(LOG_20 + ((mouse_x - rs_pl_x0)/rs_pl_w - rs_listen_width) * LOG_RNG);
  rs_hf = exp(LOG_20 + ((mouse_x - rs_pl_x0)/rs_pl_w + rs_listen_width) * LOG_RNG);
  rs_lx = rs_pl_x0 + (log(rs_lf) - LOG_20)/LOG_RNG * rs_pl_w;
  rs_hx = rs_pl_x0 + (log(rs_hf) - LOG_20)/LOG_RNG * rs_pl_w;
  gfx_r=0.45; gfx_g=0.85; gfx_b=1; gfx_a=1;
  gfx_x=rs_lx; gfx_y=rs_pl_y0; gfx_lineto(rs_lx, rs_pl_y1, 0);
  gfx_x=rs_hx; gfx_y=rs_pl_y0; gfx_lineto(rs_hx, rs_pl_y1, 0);
  rs_octw = log(rs_hf/rs_lf)/log(2);
  rs_e1 = exp(0.5 * log(2) * rs_octw);
  rs_e2 = 1 / rs_e1;
  rs_den = max(0.01, rs_e1 - rs_e2);
  rs_listen_q = 1 / rs_den;
) : rs_do_listen = 0;

// ===== 24. EDIT MODE OVERLAY =====
edit_mode ? (
  gfx_r=0.05; gfx_g=0.05; gfx_b=0.10; gfx_a=0.94;
  gfx_x=350; gfx_y=250; gfx_rectto(650, 370);
  gfx_r=0.4; gfx_g=0.6; gfx_b=0.9; gfx_a=1;
  gfx_x=350; gfx_y=250; gfx_lineto(650, 250, 0);
  gfx_x=650; gfx_y=250; gfx_lineto(650, 370, 0);
  gfx_x=650; gfx_y=370; gfx_lineto(350, 370, 0);
  gfx_x=350; gfx_y=370; gfx_lineto(350, 250, 0);
  gfx_setfont(1, "Arial", 14);
  gfx_r=0.9; gfx_g=0.9; gfx_b=0.95; gfx_a=1;
  gfx_x=360; gfx_y=265;
  edit_field == 0 ? gfx_drawstr("Edit Q (0.30-8.00):");
  edit_field == 1 ? gfx_drawstr("Edit Target (dB):");
  edit_field == 2 ? gfx_drawstr("Edit Offset (dB):");
  edit_field == 3 ? gfx_drawstr("Edit Frequency (Hz):");
  gfx_setfont(1, "Courier New", 32);
  (edit_neg == 1) ? (
    edit_has_dot ? (
      edit_dec_places > 0 ? gs = sprintf(#, "-%d.%d", edit_int, edit_dec)
                          : gs = sprintf(#, "-%d.", edit_int);
    ) : gs = sprintf(#, "-%d", edit_int);
  ) : (
    edit_has_dot ? (
      edit_dec_places > 0 ? gs = sprintf(#, "%d.%d", edit_int, edit_dec)
                          : gs = sprintf(#, "%d.", edit_int);
    ) : gs = sprintf(#, "%d", edit_int);
  );
  gfx_x=360; gfx_y=300; gfx_drawstr(gs);
  gfx_setfont(1, "Arial", 11);
  gfx_r=0.6; gfx_g=0.6; gfx_b=0.65;
  gfx_x=360; gfx_y=345;
  gfx_drawstr("ENTER=OK   ESC=cancel   BKSP=del");
  gfx_setfont(1, "Arial", 14);
);

// ===== 25. INTERACCION =====
// mcap/mdown/mprev/g_press/g_release ya se computan al inicio de @gfx

// ===== 25b. ANALYZER INTERACTION =====
in_rs_set = (mouse_x>=rs_set_x)*(mouse_x<=rs_set_x+rs_set_w)
          * (mouse_y>=rs_btn_y)*(mouse_y<=rs_btn_y+rs_btn_h);
rs_set_click = g_press * in_rs_set;
rs_set_click ? (
  #rs_menu = ">Spectrum Mode|";
  rs_spec_mode==0 ? #rs_menu += "!Full|" : #rs_menu += "Full|";
  rs_spec_mode==1 ? #rs_menu += "!Mid|"  : #rs_menu += "Mid|";
  rs_spec_mode==2 ? #rs_menu += "!Side|" : #rs_menu += "Side|";
  rs_spec_mode==3 ? #rs_menu += "!Mid + Side|" : #rs_menu += "Mid + Side|";
  rs_spec_mode==4 ? #rs_menu += "!Left|" : #rs_menu += "Left|";
  rs_spec_mode==5 ? #rs_menu += "!Right|" : #rs_menu += "Right|";
  rs_spec_mode==6 ? #rs_menu += "!Left + Right|" : #rs_menu += "Left + Right|";

  #rs_menu += ">Display|";
  rs_display_mode==0 ? #rs_menu += "!Fill|" : #rs_menu += "Fill|";
  rs_display_mode==1 ? #rs_menu += "!Line|" : #rs_menu += "Line|";
  rs_display_mode==2 ? #rs_menu += "!None|" : #rs_menu += "None|";

  #rs_menu += ">Range|";
  rs_ceiling_idx==0 ? #rs_menu += "!Ceiling 0dB|" : #rs_menu += "Ceiling 0dB|";
  rs_ceiling_idx==1 ? #rs_menu += "!Ceiling 20dB|" : #rs_menu += "Ceiling 20dB|";
  rs_ceiling_idx==2 ? #rs_menu += "!Ceiling 40dB|" : #rs_menu += "Ceiling 40dB|";
  rs_floor_idx==0 ? #rs_menu += "!Floor -90dB|" : #rs_menu += "Floor -90dB|";
  rs_floor_idx==1 ? #rs_menu += "!Floor -140dB|" : #rs_menu += "Floor -140dB|";
  rs_floor_idx==2 ? #rs_menu += "!Floor -200dB|" : #rs_menu += "Floor -200dB|";

  #rs_menu += ">Tilt|";
  rs_tilt_idx==0 ? #rs_menu += "!0 dB/oct|" : #rs_menu += "0 dB/oct|";
  rs_tilt_idx==1 ? #rs_menu += "!1.5 dB/oct|" : #rs_menu += "1.5 dB/oct|";
  rs_tilt_idx==2 ? #rs_menu += "!3 dB/oct|" : #rs_menu += "3 dB/oct|";
  rs_tilt_idx==3 ? #rs_menu += "!4.5 dB/oct|" : #rs_menu += "4.5 dB/oct|";
  rs_tilt_idx==4 ? #rs_menu += "!6 dB/oct|" : #rs_menu += "6 dB/oct|";

  #rs_menu += ">Window|";
  rs_window_type==0 ? #rs_menu += "!Hamming|" : #rs_menu += "Hamming|";
  rs_window_type==1 ? #rs_menu += "!Blackman-Harris|" : #rs_menu += "Blackman-Harris|";
  rs_window_type==2 ? #rs_menu += "!Blackman|" : #rs_menu += "Blackman|";
  rs_window_type==3 ? #rs_menu += "!Rectangular|" : #rs_menu += "Rectangular|";

  #rs_menu += ">FFT Size|";
  rs_block_idx==0 ? #rs_menu += "!2048|" : #rs_menu += "2048|";
  rs_block_idx==1 ? #rs_menu += "!4096|" : #rs_menu += "4096|";
  rs_block_idx==2 ? #rs_menu += "!8192|" : #rs_menu += "8192|";
  rs_block_idx==3 ? #rs_menu += "!16384|" : #rs_menu += "16384|";

  // FIX: coordenadas reales de ventana para gfx_showmenu (evita congelamiento)
  gfx_x = _orig_mx;
  gfx_y = _orig_my;
  rs_sel = gfx_showmenu(#rs_menu) - 1;
  rs_sel >= 0 && rs_sel <= 6  ? rs_spec_mode   = rs_sel;
  rs_sel >= 7 && rs_sel <= 9  ? rs_display_mode = rs_sel - 7;
  rs_sel >= 10 && rs_sel <= 12 ? rs_ceiling_idx = rs_sel - 10;
  rs_sel >= 13 && rs_sel <= 15 ? rs_floor_idx   = rs_sel - 13;
  rs_sel >= 16 && rs_sel <= 20 ? rs_tilt_idx    = rs_sel - 16;
  rs_sel >= 21 && rs_sel <= 24 ? rs_window_type = rs_sel - 21;
  rs_sel >= 25 && rs_sel <= 28 ? rs_block_idx   = rs_sel - 25;
);

in_rs_pk = (mouse_x>=rs_pk_x)*(mouse_x<=rs_pk_x+rs_pk_w)
         * (mouse_y>=rs_btn_y)*(mouse_y<=rs_btn_y+rs_btn_h);
rs_show_peaks = rs_show_peaks + (g_press*in_rs_pk)*(1-2*rs_show_peaks);

(mouse_cap & 8) && rs_in_plot ? (
  rs_mw = mouse_wheel;
  rs_md = -(rs_mw - rs_last_wheel) / 120;
  rs_last_wheel = rs_mw;
  rs_listen_width = rs_listen_width + rs_md / 200;
  rs_listen_width = max(0.01, min(0.30, rs_listen_width));
) : rs_last_wheel = mouse_wheel;

// ===== 26. A/B =====
in_ab_A = (mouse_x>=84)*(mouse_x<=110)*(mouse_y>=4)*(mouse_y<=26);
in_ab_B = (mouse_x>=114)*(mouse_x<=140)*(mouse_y>=4)*(mouse_y<=26);
ab_click_A = g_press * in_ab_A;
ab_click_B = g_press * in_ab_B;
should_swap_A = ab_click_A * (state_cur != 0);
should_swap_B = ab_click_B * (state_cur != 1);
need_swap = should_swap_A + should_swap_B;

need_swap ? (
  _dst = state_cur == 0 ? state_A : state_B;
  _i = 0;
  while (_i < 5) (
    _dst[_i*20+0] = band_freq[_i]; _dst[_i*20+1] = band_gain[_i];
    _dst[_i*20+2] = band_target[_i]; _dst[_i*20+3] = band_q[_i];
    _dst[_i*20+4] = band_enabled[_i]; _dst[_i*20+5] = band_type[_i];
    _dst[_i*20+6] = band_chan[_i]; _dst[_i*20+7] = band_thresh[_i];
    _dst[_i*20+8] = band_dyn[_i]; _dst[_i*20+9] = band_attack[_i];
    _dst[_i*20+10] = band_release[_i]; _dst[_i*20+11] = band_detect[_i];
    _dst[_i*20+12] = band_trigger[_i]; _dst[_i*20+13] = band_sc_en[_i];
    _dst[_i*20+14] = band_sc_type[_i]; _dst[_i*20+15] = band_sc_freq[_i];
    _dst[_i*20+16] = band_sc_q[_i]; _dst[_i*20+17] = band_sc_ext[_i];
    _dst[_i*20+18] = band_sc_chan[_i];
    _i += 1;
  );
  _dst[90] = selected_band; _dst[91] = output_trim_db;
  _dst[92] = listen_band; _dst[93] = zoom_db;
  state_cur = should_swap_A*0 + should_swap_B*1 + (1-need_swap)*state_cur;
  _src = state_cur == 0 ? state_A : state_B;
  _i = 0;
  while (_i < 5) (
    band_freq[_i] = _src[_i*20+0]; band_gain[_i] = _src[_i*20+1];
    band_target[_i] = _src[_i*20+2]; band_q[_i] = _src[_i*20+3];
    band_enabled[_i] = _src[_i*20+4]; band_type[_i] = _src[_i*20+5];
    band_chan[_i] = _src[_i*20+6]; band_thresh[_i] = _src[_i*20+7];
    band_dyn[_i] = _src[_i*20+8]; band_attack[_i] = _src[_i*20+9];
    band_release[_i] = _src[_i*20+10]; band_detect[_i] = _src[_i*20+11];
    band_trigger[_i] = _src[_i*20+12]; band_sc_en[_i] = _src[_i*20+13];
    band_sc_type[_i] = _src[_i*20+14]; band_sc_freq[_i] = _src[_i*20+15];
    band_sc_q[_i] = _src[_i*20+16]; band_sc_ext[_i] = _src[_i*20+17];
    band_sc_chan[_i] = _src[_i*20+18];
    _i += 1;
  );
  selected_band = _src[90]; output_trim_db = _src[91];
  listen_band = _src[92]; zoom_db = _src[93];
);

// ===== 27. UNDO/REDO/RESET/AUTOGAIN =====
in_undo = (mouse_x>=148)*(mouse_x<=168)*(mouse_y>=4)*(mouse_y<=26);
undo_click = g_press * in_undo;
in_redo = (mouse_x>=172)*(mouse_x<=192)*(mouse_y>=4)*(mouse_y<=26);
redo_click = g_press * in_redo;
in_rst_band = (mouse_x>=198)*(mouse_x<=240)*(mouse_y>=4)*(mouse_y<=26);
rst_band_click = g_press * in_rst_band;
in_rst_all = (mouse_x>=244)*(mouse_x<=290)*(mouse_y>=4)*(mouse_y<=26);
rst_all_click = g_press * in_rst_all;
in_autogain = (mouse_x>=294)*(mouse_x<=352)*(mouse_y>=4)*(mouse_y<=26);
autogain_click = g_press * in_autogain;
autogain_en = autogain_en + autogain_click*(1-2*autogain_en);

undo_oldest = (undo_head_[0] - undo_size_[0] + 1 + 20) % 20;
can_undo_act = (undo_size_[0] > 1) * (undo_pos_[0] != undo_oldest);
do_undo = undo_click * can_undo_act;
do_undo ? (
  undo_pos_[0] = (undo_pos_[0] - 1 + 20) % 20;
  undo_busy[0] = 1;
  _base = undo_buf + undo_pos_[0]*100;
  selected_band = _base[0]; output_trim_db = _base[1];
  listen_band = _base[2]; zoom_db = _base[3]; autogain_en = _base[4];
  i = 0;
  while (i < 5) (
    band_freq[i]=_base[5+i*19+0]; band_gain[i]=_base[5+i*19+1];
    band_target[i]=_base[5+i*19+2]; band_q[i]=_base[5+i*19+3];
    band_enabled[i]=_base[5+i*19+4]; band_type[i]=_base[5+i*19+5];
    band_chan[i]=_base[5+i*19+6]; band_thresh[i]=_base[5+i*19+7];
    band_dyn[i]=_base[5+i*19+8]; band_attack[i]=_base[5+i*19+9];
    band_release[i]=_base[5+i*19+10]; band_detect[i]=_base[5+i*19+11];
    band_trigger[i]=_base[5+i*19+12]; band_sc_en[i]=_base[5+i*19+13];
    band_sc_type[i]=_base[5+i*19+14]; band_sc_freq[i]=_base[5+i*19+15];
    band_sc_q[i]=_base[5+i*19+16]; band_sc_ext[i]=_base[5+i*19+17];
    band_sc_chan[i]=_base[5+i*19+18];
    i += 1;
  );
  memcpy(last_saved, _base, 100);
);

can_redo_act = (undo_pos_[0] != undo_head_[0]) * (undo_size_[0] > 0);
do_redo = redo_click * can_redo_act;
do_redo ? (
  undo_pos_[0] = (undo_pos_[0] + 1) % 20;
  undo_busy[0] = 1;
  _base = undo_buf + undo_pos_[0]*100;
  selected_band = _base[0]; output_trim_db = _base[1];
  listen_band = _base[2]; zoom_db = _base[3]; autogain_en = _base[4];
  i = 0;
  while (i < 5) (
    band_freq[i]=_base[5+i*19+0]; band_gain[i]=_base[5+i*19+1];
    band_target[i]=_base[5+i*19+2]; band_q[i]=_base[5+i*19+3];
    band_enabled[i]=_base[5+i*19+4]; band_type[i]=_base[5+i*19+5];
    band_chan[i]=_base[5+i*19+6]; band_thresh[i]=_base[5+i*19+7];
    band_dyn[i]=_base[5+i*19+8]; band_attack[i]=_base[5+i*19+9];
    band_release[i]=_base[5+i*19+10]; band_detect[i]=_base[5+i*19+11];
    band_trigger[i]=_base[5+i*19+12]; band_sc_en[i]=_base[5+i*19+13];
    band_sc_type[i]=_base[5+i*19+14]; band_sc_freq[i]=_base[5+i*19+15];
    band_sc_q[i]=_base[5+i*19+16]; band_sc_ext[i]=_base[5+i*19+17];
    band_sc_chan[i]=_base[5+i*19+18];
    i += 1;
  );
  memcpy(last_saved, _base, 100);
);

rst_band_click ? (
  band_gain[sel]=0; band_target[sel]=0;
  band_thresh[sel]=-48; band_dyn[sel]=100;
  band_attack[sel]=20; band_release[sel]=100;
  band_detect[sel]=0; band_trigger[sel]=0;
  band_sc_en[sel]=0; band_sc_ext[sel]=0;
  band_enabled[sel]=1;
);

rst_all_click ? (
  i = 0;
  while (i < 5) (
    band_gain[i]=0; band_target[i]=0;
    band_thresh[i]=-48; band_dyn[i]=100;
    band_attack[i]=20; band_release[i]=100;
    band_detect[i]=0; band_trigger[i]=0;
    band_sc_en[i]=0; band_sc_ext[i]=0;
    band_enabled[i]=1; band_chan[i]=0;
    i += 1;
  );
  output_trim_db = 0;
);

// ===== 28. GRAPH NODES DRAG =====
in_graph = (mouse_x>=42)*(mouse_x<=928)*(mouse_y>=52)*(mouse_y<=402)*(1-rs_expanded);
best_d2 = 999999; best_i = 0; best_which = 0;
i = 0;
while (i < 5) (
  nx = 42 + (log(band_freq[i]) - LOG_20)/LOG_RNG*886;
  ny_tgt = 52 + (zoom_db - band_target[i])/(2*zoom_db)*350;
  ny_off = 52 + (zoom_db - band_gain[i])/(2*zoom_db)*350;
  dx_t = mouse_x - nx; dy_t = mouse_y - ny_tgt;
  d2_t = dx_t*dx_t + dy_t*dy_t;
  dx_o = mouse_x - nx; dy_o = mouse_y - ny_off;
  d2_o = dx_o*dx_o + dy_o*dy_o;
  is_better_t = d2_t < best_d2;
  best_d2 = best_d2 + is_better_t*(d2_t - best_d2);
  best_i = best_i + is_better_t*(i - best_i);
  best_which = best_which + is_better_t*(1 - best_which);
  is_better_o = d2_o < best_d2;
  best_d2 = best_d2 + is_better_o*(d2_o - best_d2);
  best_i = best_i + is_better_o*(i - best_i);
  best_which = best_which + is_better_o*(2 - best_which);
  i = i + 1;
);
hit_node = (best_d2 < 900)*in_graph*(1-edit_mode);
start_drag = g_press * hit_node;
drag_active = (1-g_release)*(drag_active + start_drag*(1-drag_active));
selected_band = selected_band + start_drag*(best_i - selected_band);
drag_band_idx = drag_band_idx + start_drag*(best_i - drag_band_idx);
drag_which = drag_which + start_drag*(best_which - drag_which);
new_freq = exp(LOG_20 + (mouse_x-42)/886*LOG_RNG);
new_freq = max(20, min(20000, new_freq));
new_gain = zoom_db - (mouse_y-52)/350*2*zoom_db;
new_gain = max(-zoom_db, min(zoom_db, new_gain));
apply = drag_active * mdown;
is_drag_tgt = (drag_which == 1);
is_drag_off = (drag_which == 2);
band_freq[drag_band_idx] = band_freq[drag_band_idx] + apply*(new_freq - band_freq[drag_band_idx]);
band_target[drag_band_idx] = band_target[drag_band_idx] + apply*is_drag_tgt*(new_gain - band_target[drag_band_idx]);
band_gain[drag_band_idx] = band_gain[drag_band_idx] + apply*is_drag_off*(new_gain - band_gain[drag_band_idx]);

wz = mouse_wheel;
over_node_wheel = (best_d2 < 900)*in_graph;
q_band = best_i;
q_delta = over_node_wheel * wz * 5;
q_new = band_q[q_band] + q_delta;
q_new = max(30, min(800, q_new));
band_q[q_band] = band_q[q_band] + over_node_wheel*(q_new - band_q[q_band]);

zoom_amt = wz * (1 - over_node_wheel);
zoom_db = zoom_db + zoom_amt * in_graph;
under = zoom_db < 4; over = zoom_db > 20;
zoom_db = zoom_db + under*(4 - zoom_db);
zoom_db = zoom_db + over*(20 - zoom_db);

// ===== 29. WHEEL EN CAMPOS =====
in_freq_field = (mouse_x>=312)*(mouse_x<=456)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
in_q_field_w  = (mouse_x>=464)*(mouse_x<=586)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
in_tgt_field_w= (mouse_x>=594)*(mouse_x<=776)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
in_off_field_w= (mouse_x>=784)*(mouse_x<=976)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);

wz_f = mouse_wheel;
(wz_f != 0) && in_freq_field && (over_node_wheel == 0) && (in_graph == 0) ? (
  band_freq[sel] = band_freq[sel] * pow(1.05, wz_f);
  band_freq[sel] = max(20, min(20000, band_freq[sel]));
  mouse_wheel = 0;
);
(wz_f != 0) && in_q_field_w && (over_node_wheel == 0) && (in_graph == 0) ? (
  band_q[sel] = band_q[sel] + wz_f * 5;
  band_q[sel] = max(30, min(800, band_q[sel]));
  mouse_wheel = 0;
);
(wz_f != 0) && in_tgt_field_w && (over_node_wheel == 0) && (in_graph == 0) ? (
  band_target[sel] = band_target[sel] + wz_f * 0.5;
  band_target[sel] = max(-24, min(24, band_target[sel]));
  mouse_wheel = 0;
);
(wz_f != 0) && in_off_field_w && (over_node_wheel == 0) && (in_graph == 0) ? (
  band_gain[sel] = band_gain[sel] + wz_f * 0.5;
  band_gain[sel] = max(-24, min(24, band_gain[sel]));
  mouse_wheel = 0;
);
mouse_wheel = 0;

// ===== 30. BAND SLIDER =====
in_slider = (mouse_y>=SLIDER_Y-6)*(mouse_y<=SLIDER_Y+12)*(mouse_x>=20)*(mouse_x<=980);
best_sd2 = 999999; best_si = 0;
i = 0;
while (i < 5) (
  sx = 20 + (log(band_freq[i]) - LOG_20)/LOG_RNG*960;
  d = mouse_x - sx; d2 = d*d;
  is_better = d2 < best_sd2;
  best_sd2 = best_sd2 + is_better*(d2 - best_sd2);
  best_si = best_si + is_better*(i - best_si);
  i = i + 1;
);
slider_click = g_press * in_slider * (best_sd2 < 400);
selected_band = selected_band + slider_click*(best_si - selected_band);

// ===== 31. EQ ON/OFF, LISTEN, TYPE, CHANNEL =====
in_eq_led = (mouse_x>=22)*(mouse_x<=55)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
eq_led_click = g_press * in_eq_led;
band_enabled[sel] = band_enabled[sel] + eq_led_click*(1-2*band_enabled[sel]);

in_listen = (mouse_x>=68)*(mouse_x<=135)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
listen_click = g_press * in_listen;
is_cur_lst = (listen_band == sel);
new_lst = is_cur_lst*(-1) + (1-is_cur_lst)*sel;
listen_band = listen_band + listen_click*(new_lst - listen_band);

in_eq_icon = (mouse_x>=276)*(mouse_x<=300)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
eq_icon_click = g_press * in_eq_icon;
band_type[sel] = band_type[sel] + eq_icon_click;
band_type[sel] = band_type[sel] - 3*(band_type[sel] >= 3);

in_eq_chan = (mouse_x>=168)*(mouse_x<=263)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
eq_chan_click = g_press * in_eq_chan;
band_chan[sel] = band_chan[sel] + eq_chan_click;
band_chan[sel] = band_chan[sel] - 5*(band_chan[sel] >= 5);

// ===== 32. Q FIELD =====
in_q_field = (mouse_x>=464)*(mouse_x<=586)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
q_press = g_press * in_q_field * (1-edit_mode);
q_rel = g_release * q_drag_active;
q_press ? (
  q_drag_active = 1;
  q_drag_x0 = mouse_x;
  q_drag_v0 = band_q[sel];
  q_start_x_ = mouse_x;
);
q_drag_active ? (
  q_dx = mouse_x - q_drag_x0;
  q_v = q_drag_v0 + q_dx * 0.5;
  q_v = max(30, min(800, q_v));
  band_q[sel] = band_q[sel] + mdown*(q_v - band_q[sel]);
);
q_rel ? (
  was_drag = abs(mouse_x - q_start_x_) > 3;
  was_drag == 0 ? (
    dt_q = time_precise() - q_click_t;
    dt_q < 0.35 ? (
      band_q[sel] = 150;
      q_pending = 0; q_click_t = 0;
    ) : (
      q_pending = 1;
      q_click_t = time_precise();
    );
  );
  q_drag_active = 0;
);

// ===== 33. TARGET FIELD =====
in_tgt_field = (mouse_x>=594)*(mouse_x<=776)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
tgt_press = g_press * in_tgt_field * (1-edit_mode);
tgt_rel = g_release * q_drag_active2;
tgt_press ? (
  q_drag_active2 = 1;
  q_drag_x02 = mouse_x;
  q_drag_v02 = band_target[sel];
  tgt_start_x_ = mouse_x;
);
q_drag_active2 ? (
  q_dx2 = mouse_x - q_drag_x02;
  q_v2 = q_drag_v02 + q_dx2 * 0.04;
  q_v2 = max(-24, min(24, q_v2));
  band_target[sel] = band_target[sel] + mdown*(q_v2 - band_target[sel]);
);
tgt_rel ? (
  was_drag = abs(mouse_x - tgt_start_x_) > 3;
  was_drag == 0 ? (
    dt_t = time_precise() - tgt_click_t;
    dt_t < 0.35 ? (
      band_target[sel] = 0;
      tgt_pending = 0; tgt_click_t = 0;
    ) : (
      tgt_pending = 1;
      tgt_click_t = time_precise();
    );
  );
  q_drag_active2 = 0;
);

// ===== 34. OFFSET FIELD =====
in_off_field = (mouse_x>=784)*(mouse_x<=976)*(mouse_y>=EQ_Y)*(mouse_y<=EQ_Y+EQ_H);
off_press = g_press * in_off_field * (1-edit_mode);
off_rel = g_release * off_drag_active;
off_press ? (
  off_drag_active = 1;
  off_drag_x0 = mouse_x;
  off_drag_v0 = band_gain[sel];
  off_start_x_ = mouse_x;
);
off_drag_active ? (
  o_dx = mouse_x - off_drag_x0;
  o_v = off_drag_v0 + o_dx * 0.04;
  o_v = max(-24, min(24, o_v));
  band_gain[sel] = band_gain[sel] + mdown*(o_v - band_gain[sel]);
);
off_rel ? (
  was_drag = abs(mouse_x - off_start_x_) > 3;
  was_drag == 0 ? (
    dt_o = time_precise() - off_click_t;
    dt_o < 0.35 ? (
      band_gain[sel] = 0;
      off_pending = 0; off_click_t = 0;
    ) : (
      off_pending = 1;
      off_click_t = time_precise();
    );
  );
  off_drag_active = 0;
);

// ===== 35. PENDING =====
(q_pending == 1) && ((time_precise() - q_click_t) > 0.35) ? (
  edit_mode = 1; edit_field = 0;
  edit_int = floor(band_q[sel]/100);
  edit_dec = floor(band_q[sel]%100);
  edit_dec_places = 2; edit_has_dot = 1; edit_neg = 0;
  q_pending = 0; q_click_t = 0;
);
(tgt_pending == 1) && ((time_precise() - tgt_click_t) > 0.35) ? (
  edit_mode = 1; edit_field = 1;
  edit_int = floor(abs(band_target[sel]));
  edit_dec = floor(abs(band_target[sel])*100)%100;
  edit_dec_places = 2; edit_has_dot = 1;
  edit_neg = band_target[sel] < 0;
  tgt_pending = 0; tgt_click_t = 0;
);
(off_pending == 1) && ((time_precise() - off_click_t) > 0.35) ? (
  edit_mode = 1; edit_field = 2;
  edit_int = floor(abs(band_gain[sel]));
  edit_dec = floor(abs(band_gain[sel])*100)%100;
  edit_dec_places = 2; edit_has_dot = 1;
  edit_neg = band_gain[sel] < 0;
  off_pending = 0; off_click_t = 0;
);

// ===== 36. ZOOM =====
in_zoom_bar = (mouse_y>=4)*(mouse_y<=26);
zbt = floor((mouse_x-500)/34);
zbt_valid = (mouse_x>=500)*(mouse_x<=500+4*34)*in_zoom_bar;
zbt = max(0, min(3, zbt));
zbt_v = 4*(zbt==0)+6*(zbt==1)+12*(zbt==2)+20*(zbt==3);
zoom_set = g_press * zbt_valid;
zoom_db = zoom_db + zoom_set*(zbt_v - zoom_db);

// ===== 37. TRIM =====
in_trim = (mouse_x>=930)*(mouse_x<=998)*(mouse_y>=52)*(mouse_y<=402);
shift_down = (mouse_cap & 8) > 0;
trim_speed = shift_down ? 0.002 : 0.006;
trim_is_dbl = 0;
trim_press = g_press * in_trim;
trim_press ? (
  cur_t = time_precise();
  (cur_t - trim_last_click_t) < 0.35 ? (
    trim_is_dbl = 1;
    output_trim_db = 0;
    trim_drag = 0;
    trim_last_click_t = 0;
  ) : (
    trim_last_click_t = cur_t;
  );
);
in_trim_drag = in_trim * (1-trim_is_dbl);
trim_start = g_press * in_trim_drag;
trim_drag = trim_drag + trim_start*(1-trim_drag);
trim_drag = trim_drag * (1-g_release);
trim_y0 = trim_y0 + trim_start*(mouse_y - trim_y0);
trim_dy = trim_y0 - mouse_y;
trim_v = output_trim_db + trim_dy * trim_speed;
trim_v = max(-12, min(12, trim_v));
output_trim_db = output_trim_db + trim_drag*mdown*(trim_v - output_trim_db);

// ===== 38. SIDECHAIN =====
in_sc_lbl = (mouse_x>=18)*(mouse_x<=50)*(mouse_y>=SC_Y)*(mouse_y<=SC_Y+SC_H);
sc_en_click = g_press * in_sc_lbl;
sc_was_off = 1 - band_sc_en[sel];
sc_turning_on = sc_en_click * sc_was_off;
sc_turning_on ? (
  band_sc_freq[sel] = band_freq[sel];
  band_sc_q[sel] = band_q[sel];
  band_sc_type[sel] = band_type[sel];
  band_sc_chan[sel] = band_chan[sel];
);
band_sc_en[sel] = band_sc_en[sel] + sc_en_click*(1-2*band_sc_en[sel]);

in_sc_listen = (mouse_x>=580)*(mouse_x<=680)*(mouse_y>=SC_Y)*(mouse_y<=SC_Y+SC_H);
scl_click = g_press * in_sc_listen;
sc_listen_en = sc_listen_en + scl_click*(1-2*sc_listen_en);

in_sc_ext = (mouse_x>=90)*(mouse_x<=148)*(mouse_y>=SC_Y)*(mouse_y<=SC_Y+SC_H);
sc_ext_click = g_press * in_sc_ext;
band_sc_ext[sel] = band_sc_ext[sel] + sc_ext_click*(1-2*band_sc_ext[sel]);

in_sc_chan = (mouse_x>=158)*(mouse_x<=250)*(mouse_y>=SC_Y)*(mouse_y<=SC_Y+SC_H);
sc_chan_click = g_press * in_sc_chan;
band_sc_chan[sel] = band_sc_chan[sel] + sc_chan_click;
band_sc_chan[sel] = band_sc_chan[sel] - 5*(band_sc_chan[sel] >= 5);

in_sc_icon = (mouse_x>=255)*(mouse_x<=277)*(mouse_y>=SC_Y)*(mouse_y<=SC_Y+SC_H);
sc_icon_click = g_press * in_sc_icon;
band_sc_type[sel] = band_sc_type[sel] + sc_icon_click;
band_sc_type[sel] = band_sc_type[sel] - 3*(band_sc_type[sel] >= 3);

// ===== 39. DETECT / TRIGGER =====
in_peak = (mouse_x>=258)*(mouse_x<=298)*(mouse_y>=SUB_Y+8)*(mouse_y<=SUB_Y+32);
in_rms = (mouse_x>=302)*(mouse_x<=342)*(mouse_y>=SUB_Y+8)*(mouse_y<=SUB_Y+32);
in_onsets = (mouse_x>=346)*(mouse_x<=396)*(mouse_y>=SUB_Y+8)*(mouse_y<=SUB_Y+32);
peak_click = g_press * in_peak;
rms_click = g_press * in_rms;
onsets_click = g_press * in_onsets;
band_detect[sel] = band_detect[sel] + peak_click*(0 - band_detect[sel]);
band_detect[sel] = band_detect[sel] + rms_click*(1 - band_detect[sel]);
band_detect[sel] = band_detect[sel] + onsets_click*(2 - band_detect[sel]);

in_above = (mouse_x>=390)*(mouse_x<=470)*(mouse_y>=SUB_Y+8)*(mouse_y<=SUB_Y+32);
above_click = g_press * in_above;
band_trigger[sel] = band_trigger[sel] + above_click*(0 - band_trigger[sel]);
in_below = (mouse_x>=390)*(mouse_x<=470)*(mouse_y>=SUB_Y+36)*(mouse_y<=SUB_Y+60);
below_click = g_press * in_below;
band_trigger[sel] = band_trigger[sel] + below_click*(1 - band_trigger[sel]);

// ===== 40. KNOBS INTERACTION =====
in_thresh_k = (mouse_x>=486)*(mouse_x<=534)*(mouse_y>=SUB_Y+16)*(mouse_y<=SUB_Y+64);
in_dyn_k = (mouse_x>=556)*(mouse_x<=604)*(mouse_y>=SUB_Y+16)*(mouse_y<=SUB_Y+64);
in_att_k = (mouse_x>=626)*(mouse_x<=674)*(mouse_y>=SUB_Y+16)*(mouse_y<=SUB_Y+64);
in_rel_k = (mouse_x>=696)*(mouse_x<=744)*(mouse_y>=SUB_Y+16)*(mouse_y<=SUB_Y+64);

knob_press_which = g_press * (in_thresh_k*1 + in_dyn_k*2 + in_att_k*3 + in_rel_k*4);

(knob_press_which > 0) && (edit_mode == 0) ? (
  kn_idx = knob_press_which - 1;
  cur_t = time_precise();
  (cur_t - knob_lct[kn_idx]) < 0.35 ? (
    knob_drag = 0;
    knob_lct[kn_idx] = 0;
    knob_press_which == 1 ? band_thresh[sel] = -48;
    knob_press_which == 2 ? band_dyn[sel] = 100;
    knob_press_which == 3 ? band_attack[sel] = 20;
    knob_press_which == 4 ? band_release[sel] = 100;
  ) : (
    knob_drag = knob_press_which;
    knob_y0 = mouse_y;
    knob_lct[kn_idx] = cur_t;
  );
);

(knob_drag > 0) ? (
  dy = knob_y0 - mouse_y;
  k_apply = mdown;
  knob_drag == 1 ? (
    val_t = band_thresh[sel] + dy * 0.025;
    val_t = max(-48, min(0, val_t));
    band_thresh[sel] = band_thresh[sel] + k_apply*(val_t - band_thresh[sel]);
  );
  knob_drag == 2 ? (
    val_d = band_dyn[sel] + dy * 0.04;
    val_d = max(0, min(100, val_d));
    band_dyn[sel] = band_dyn[sel] + k_apply*(val_d - band_dyn[sel]);
  );
  knob_drag == 3 ? (
    val_a = band_attack[sel] + dy * 0.04;
    val_a = max(0, min(100, val_a));
    band_attack[sel] = band_attack[sel] + k_apply*(val_a - band_attack[sel]);
  );
  knob_drag == 4 ? (
    val_r = band_release[sel] + dy * 0.08;
    val_r = max(0, min(1000, val_r));
    band_release[sel] = band_release[sel] + k_apply*(val_r - band_release[sel]);
  );
);
g_release ? knob_drag = 0;

// ===== 41. CLIP LEDs =====
in_clip_in = (mouse_x>=780)*(mouse_x<=796)*(mouse_y>=4)*(mouse_y<=26);
in_clip_out = (mouse_x>=920)*(mouse_x<=936)*(mouse_y>=4)*(mouse_y<=26);
clip_in_click = g_press * in_clip_in;
clip_out_click = g_press * in_clip_out;
clip_in_click ? (
  clip_in_flag = 0;
  clip_in_suppress = srate * 0.5;
);
clip_out_click ? (
  clip_out_flag = 0;
  clip_out_suppress = srate * 0.5;
);

// ===== 42. BADGE M/S =====
i = 0;
while (i < 5) (
  nbx = 42 + (log(band_freq[i]) - LOG_20)/LOG_RNG*886;
  nby = 52 + (zoom_db - band_target[i])/(2*zoom_db)*350;
  in_badge = (mouse_x>=nbx-30)*(mouse_x<=nbx-13)*(mouse_y>=nby-9)*(mouse_y<=nby+9);
  badge_click = g_press * in_badge;
  bchan_cur = band_chan[i];
  is_mid_now = (bchan_cur == 3);
  new_chan = 3 + is_mid_now;
  band_chan[i] = band_chan[i] + badge_click*(new_chan - band_chan[i]);
  i = i + 1;
);

// ===== 43. KEYBOARD =====
k = gfx_getchar();
while (k > 0) (
  edit_mode ? (
    (k >= 48) && (k <= 57) ? (
      dgt = k - 48;
      edit_has_dot == 1 ? (
        edit_dec = edit_dec * 10 + dgt;
        edit_dec_places += 1;
      ) : (
        edit_int = edit_int * 10 + dgt;
      );
    ) : (
      (k == 46) && (edit_has_dot == 0) ? (
        edit_has_dot = 1; edit_dec = 0; edit_dec_places = 0;
      ) : (
        (k == 45) ? ( edit_neg = 1 - edit_neg; ) : (
          (k == 8) ? (
            edit_has_dot == 1 ? (
              edit_dec_places > 0 ? (
                edit_dec = floor(edit_dec/10);
                edit_dec_places -= 1;
              ) : (
                edit_has_dot = 0; edit_dec = 0;
              );
            ) : ( edit_int = floor(edit_int/10); );
          ) : (
            (k == 13) ? (
              edit_has_dot == 1 ? (
                edit_dec_places > 0 ? (
                  ed_val = edit_int + edit_dec/pow(10, edit_dec_places);
                ) : ( ed_val = edit_int; );
              ) : ( ed_val = edit_int; );
              (edit_neg == 1) ? ed_val = -ed_val;
              edit_field == 0 ? (
                (ed_val > 8) ? ed_val = 8;
                (ed_val < 0.3) ? ed_val = 0.3;
                band_q[sel] = ed_val * 100;
              ) : (
                edit_field == 1 ? (
                  (ed_val > 24) ? ed_val = 24;
                  (ed_val < -24) ? ed_val = -24;
                  band_target[sel] = ed_val;
                ) : (
                  edit_field == 2 ? (
                    (ed_val > 24) ? ed_val = 24;
                    (ed_val < -24) ? ed_val = -24;
                    band_gain[sel] = ed_val;
                  ) : (
                    (ed_val > 20000) ? ed_val = 20000;
                    (ed_val < 20) ? ed_val = 20;
                    band_freq[sel] = ed_val;
                  );
                );
              );
              edit_mode = 0;
            ) : (
              (k == 27) ? edit_mode = 0;
            );
          );
        );
      );
    );
  );
  k = gfx_getchar();
);

// ===== 44. AUTOSAVE =====
src_a = tmp_save;
src_a[0] = selected_band; src_a[1] = output_trim_db;
src_a[2] = listen_band; src_a[3] = zoom_db; src_a[4] = autogain_en;
i = 0;
while (i < 5) (
  src_a[5+i*19+0]=band_freq[i]; src_a[5+i*19+1]=band_gain[i];
  src_a[5+i*19+2]=band_target[i]; src_a[5+i*19+3]=band_q[i];
  src_a[5+i*19+4]=band_enabled[i]; src_a[5+i*19+5]=band_type[i];
  src_a[5+i*19+6]=band_chan[i]; src_a[5+i*19+7]=band_thresh[i];
  src_a[5+i*19+8]=band_dyn[i]; src_a[5+i*19+9]=band_attack[i];
  src_a[5+i*19+10]=band_release[i]; src_a[5+i*19+11]=band_detect[i];
  src_a[5+i*19+12]=band_trigger[i]; src_a[5+i*19+13]=band_sc_en[i];
  src_a[5+i*19+14]=band_sc_type[i]; src_a[5+i*19+15]=band_sc_freq[i];
  src_a[5+i*19+16]=band_sc_q[i]; src_a[5+i*19+17]=band_sc_ext[i];
  src_a[5+i*19+18]=band_sc_chan[i];
  i += 1;
);
diff_count = 0; i = 0;
while (i < 100) (
  diff_count = diff_count + (abs(src_a[i] - last_saved[i]) > 0.0001);
  i += 1;
);
do_push = (diff_count > 0)*(1-mdown)*(1-undo_busy[0]);
undo_initialized[0] == 0 ? (
  memcpy(last_saved, src_a, 100);
  undo_head_[0] = 0; undo_pos_[0] = 0; undo_size_[0] = 1;
  memcpy(undo_buf, src_a, 100);
  undo_initialized[0] = 1;
  do_push = 0;
);
do_push ? (
  undo_head_[0] = (undo_head_[0] + 1) % 20;
  memcpy(undo_buf + undo_head_[0]*100, src_a, 100);
  undo_pos_[0] = undo_head_[0];
  undo_size_[0] = min(undo_size_[0] + 1, 20);
  memcpy(last_saved, src_a, 100);
);
undo_busy[0] = 0;

prev_cap = mcap;

// ===== BLIT A PANTALLA (solo si estamos usando el buffer) =====
_native == 0 ? (
  gfx_dest = -1;
  gfx_blit(0, 1, 0, 0, 0, 1000, 620, gui_off_x, gui_off_y, gui_scaled_w, gui_scaled_h);
);