gfx_x=346; gfx_y=SUB_Y+9; gfx_lineto(396, SUB_Y+9, 0);
gfx_x=396; gfx_y=SUB_Y+8; gfx_lineto(396, SUB_Y+32, 0);
gfx_x=395; gfx_y=SUB_Y+8; gfx_lineto(395, SUB_Y+32, 0);
gfx_x=396; gfx_y=SUB_Y+32; gfx_lineto(346, SUB_Y+32, 0);
gfx_x=396; gfx_y=SUB_Y+31; gfx_lineto(346, SUB_Y+31, 0);
