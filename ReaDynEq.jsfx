gfx_x=re_x; gfx_y=un_y; gfx_lineto(re_x+un_w, un_y, 0);
gfx_x=re_x; gfx_y=un_y+1; gfx_lineto(re_x+un_w, un_y+1, 0);
gfx_x=re_x+un_w; gfx_y=un_y; gfx_lineto(re_x+un_w, un_y+un_h, 0);
gfx_x=re_x+un_w-1; gfx_y=un_y; gfx_lineto(re_x+un_w-1, un_y+un_h, 0);
gfx_x=re_x+un_w; gfx_y=un_y+un_h; gfx_lineto(re_x, un_y+un_h, 0);
gfx_x=re_x+un_w; gfx_y=un_y+un_h-1; gfx_lineto(re_x, un_y+un_h-1, 0);
gfx_x=re_x; gfx_y=un_y+un_h; gfx_lineto(re_x, un_y, 0);
gfx_x=re_x+1; gfx_y=un_y+un_h; gfx_lineto(re_x+1, un_y, 0);
gfx_r=0.5+can_redo_v*0.4; gfx_g=0.55+can_redo_v*0.4; gfx_b=0.6+can_redo_v*0.3;
gfx_x=re_x+7; gfx_y=un_y+11; gfx_lineto(re_x+12, un_y+11, 0);
gfx_x=re_x+12; gfx_y=un_y+11; gfx_lineto(re_x+9, un_y+8, 0);
gfx_x=re_x+12; gfx_y=un_y+11; gfx_lineto(re_x+9, un_y+14, 0);

rb_x = re_x + un_w + 6; rb_w = 42;
gfx_r=0.2; gfx_g=0.25; gfx_b=0.35;
gfx_x=rb_x; gfx_y=un_y; gfx_rectto(rb_x+rb_w, un_y+un_h);
gfx_r=0.65; gfx_g=0.70; gfx_b=0.75;
gfx_x=rb_x; gfx_y=un_y; gfx_lineto(rb_x+rb_w, un_y, 0);
gfx_x=rb_x; gfx_y=un_y+1; gfx_lineto(rb_x+rb_w, un_y+1, 0);
gfx_x=rb_x+rb_w; gfx_y=un_y; gfx_lineto(rb_x+rb_w, un_y+un_h, 0);
gfx_x=rb_x+rb_w-1; gfx_y=un_y; gfx_lineto(rb_x+rb_w-1, un_y+un_h, 0);
gfx_x=rb_x+rb_w; gfx_y=un_y+un_h; gfx_lineto(rb_x, un_y+un_h, 0);
gfx_x=rb_x+rb_w; gfx_y=un_y+un_h-1; gfx_lineto(rb_x, un_y+un_h-1, 0);
gfx_x=rb_x; gfx_y=un_y+un_h; gfx_lineto(rb_x, un_y, 0);
gfx_x=rb_x+1; gfx_y=un_y+un_h; gfx_lineto(rb_x+1, un_y, 0);
gfx_setfont(1, "Arial", 11);
gfx_r=0.85; gfx_g=0.87; gfx_b=0.9;
gfx_x=rb_x+4; gfx_y=un_y+6; gfx_drawstr("Rst B");

ra_x = rb_x + rb_w + 4; ra_w = 46;
gfx_r=0.2; gfx_g=0.25; gfx_b=0.35;
gfx_x=ra_x; gfx_y=un_y; gfx_rectto(ra_x+ra_w, un_y+un_h);
gfx_r=0.65; gfx_g=0.70; gfx_b=0.75;
gfx_x=ra_x; gfx_y=un_y; gfx_lineto(ra_x+ra_w, un_y, 0);
gfx_x=ra_x; gfx_y=un_y+1; gfx_lineto(ra_x+ra_w, un_y+1, 0);
gfx_x=ra_x+ra_w; gfx_y=un_y; gfx_lineto(ra_x+ra_w, un_y+un_h, 0);
gfx_x=ra_x+ra_w-1; gfx_y=un_y; gfx_lineto(ra_x+ra_w-1, un_y+un_h, 0);
gfx_x=ra_x+ra_w; gfx_y=un_y+un_h; gfx_lineto(ra_x, un_y+un_h, 0);
gfx_x=ra_x+ra_w; gfx_y=un_y+un_h-1; gfx_lineto(ra_x, un_y+un_h-1, 0);
gfx_x=ra_x; gfx_y=un_y+un_h; gfx_lineto(ra_x, un_y, 0);
gfx_x=ra_x+1; gfx_y=un_y+un_h; gfx_lineto(ra_x+1, un_y, 0);
gfx_r=0.85; gfx_g=0.87; gfx_b=0.9;
gfx_x=ra_x+4; gfx_y=un_y+6; gfx_drawstr("Rst All");

ag_x = ra_x + ra_w + 4; ag_w = 58;
ag_is_on = autogain_en;
gfx_r = 0.2 + ag_is_on*0.25; gfx_g = 0.25 + ag_is_on*0.45; gfx_b = 0.35 + ag_is_on*0.1;
gfx_x=ag_x; gfx_y=un_y; gfx_rectto(ag_x+ag_w, un_y+un_h);
gfx_r=0.65; gfx_g=0.70; gfx_b=0.75;
gfx_x=ag_x; gfx_y=un_y; gfx_lineto(ag_x+ag_w, un_y, 0);
gfx_x=ag_x; gfx_y=un_y+1; gfx_lineto(ag_x+ag_w, un_y+1, 0);
gfx_x=ag_x+ag_w; gfx_y=un_y; gfx_lineto(ag_x+ag_w, un_y+un_h, 0);
gfx_x=ag_x+ag_w-1; gfx_y=un_y; gfx_lineto(ag_x+ag_w-1, un_y+un_h, 0);
gfx_x=ag_x+ag_w; gfx_y=un_y+un_h; gfx_lineto(ag_x, un_y+un_h, 0);
gfx_x=ag_x+ag_w; gfx_y=un_y+un_h-1; gfx_lineto(ag_x, un_y+un_h-1, 0);
gfx_x=ag_x; gfx_y=un_y+un_h; gfx_lineto(ag_x, un_y, 0);
gfx_x=ag_x+1; gfx_y=un_y+un_h; gfx_lineto(ag_x+1, un_y, 0);
gfx_r=0.85+ag_is_on*0.15; gfx_g=0.87; gfx_b=0.9;
gfx_x=ag_x+4; gfx_y=un_y+6; gfx_drawstr("AutoGn");
gs = sprintf(#, "%.1f", ag_sm * autogain_sm);
gfx_setfont(1, "Arial", 9);
gfx_r=0.7; gfx_g=0.9; gfx_b=0.7;
gfx_x=ag_x+4; gfx_y=un_y+14; gfx_drawstr(gs);

// ===== 15. ZOOM =====
zx_b = 500; zy_b = 4; zb_w = 30; zb_h = 22;
zoi = 0;
while (zoi < 4) (
  zval = 4*(zoi==0)+6*(zoi==1)+12*(zoi==2)+20*(zoi==3);
  is_cur = abs(zoom_db - zval) < 0.5;
  bx0 = zx_b + zoi * (zb_w + 4); bx1 = bx0 + zb_w;
  gfx_r = 0.2 + is_cur * 0.15;
  gfx_g = 0.25 + is_cur * 0.2;
  gfx_b = 0.35 + is_cur * 0.25;
  gfx_x=bx0; gfx_y=zy_b; gfx_rectto(bx1, zy_b+zb_h);
  gfx_r=0.65; gfx_g=0.70; gfx_b=0.75;
  gfx_x=bx0; gfx_y=zy_b; gfx_lineto(bx1, zy_b, 0);
  gfx_x=bx0; gfx_y=zy_b+1; gfx_lineto(bx1, zy_b+1, 0);
  gfx_x=bx1; gfx_y=zy_b; gfx_lineto(bx1, zy_b+zb_h, 0);
  gfx_x=bx1-1; gfx_y=zy_b; gfx_lineto(bx1-1, zy_b+zb_h, 0);
  gfx_x=bx1; gfx_y=zy_b+zb_h; gfx_lineto(bx0, zy_b+zb_h, 0);
  gfx_x=bx1; gfx_y=zy_b+zb_h-1; gfx_lineto(bx0, zy_b+zb_h-1, 0);
  gfx_x=bx0; gfx_y=zy_b+zb_h; gfx_lineto(bx0, zy_b, 0);
  gfx_x=bx0+1; gfx_y=zy_b+zb_h; gfx_lineto(bx0+1, zy_b, 0);
  gfx_setfont(1, "Arial", 11);
  gfx_r=0.85; gfx_g=0.87; gfx_b=0.9;
  gs = sprintf(#, "%d", zval);
  gfx_x=bx0+6; gfx_y=zy_b+5; gfx_drawstr(gs);
  zoi = zoi + 1;
);

// ===== 16. METERS =====
mt_in_x0 = 660; mt_in_x1 = 780;
mt_out_x0 = 800; mt_out_x1 = 920;
mt_y_top = 4; mt_bar_h = 9; mt_gap = 1;
gfx_r=0.08; gfx_g=0.09; gfx_b=0.11; gfx_a=1;
gfx_x=mt_in_x0; gfx_y=mt_y_top; gfx_rectto(mt_in_x1, mt_y_top+mt_bar_h*2+mt_gap);
gfx_x=mt_out_x0; gfx_y=mt_y_top; gfx_rectto(mt_out_x1, mt_y_top+mt_bar_h*2+mt_gap);

meter_in_peak_L > 0 ? (
  w_L = min(mt_in_x1-mt_in_x0-2, meter_in_peak_L*(mt_in_x1-mt_in_x0-2));
  gfx_r = meter_in_peak_L>0.9?1:0.3; gfx_g = meter_in_peak_L>0.9?0.3:0.85; gfx_b = meter_in_peak_L>0.9?0.3:0.4;
  gfx_x=mt_in_x0+1; gfx_y=mt_y_top+1; gfx_rectto(mt_in_x0+1+w_L, mt_y_top+1+mt_bar_h-1);
);
meter_in_peak_R > 0 ? (
  w_R = min(mt_in_x1-mt_in_x0-2, meter_in_peak_R*(mt_in_x1-mt_in_x0-2));
  gfx_r = meter_in_peak_R>0.9?1:0.3; gfx_g = meter_in_peak_R>0.9?0.3:0.85; gfx_b = meter_in_peak_R>0.9?0.3:0.4;
  gfx_x=mt_in_x0+1; gfx_y=mt_y_top+mt_bar_h+mt_gap+1; gfx_rectto(mt_in_x0+1+w_R, mt_y_top+mt_bar_h+mt_gap+1+mt_bar_h-1);
);
meter_out_peak_L > 0 ? (
  w_L = min(mt_out_x1-mt_out_x0-2, meter_out_peak_L*(mt_out_x1-mt_out_x0-2));
  gfx_r = meter_out_peak_L>0.9?1:0.3; gfx_g = meter_out_peak_L>0.9?0.3:0.85; gfx_b = meter_out_peak_L>0.9?0.3:0.4;
  gfx_x=mt_out_x0+1; gfx_y=mt_y_top+1; gfx_rectto(mt_out_x0+1+w_L, mt_y_top+1+mt_bar_h-1);
);
meter_out_peak_R > 0 ? (
  w_R = min(mt_out_x1-mt_out_x0-2, meter_out_peak_R*(mt_out_x1-mt_out_x0-2));
  gfx_r = meter_out_peak_R>0.9?1:0.3; gfx_g = meter_out_peak_R>0.9?0.3:0.85; gfx_b = meter_out_peak_R>0.9?0.3:0.4;
  gfx_x=mt_out_x0+1; gfx_y=mt_y_top+mt_bar_h+mt_gap+1; gfx_rectto(mt_out_x0+1+w_R, mt_y_top+mt_bar_h+mt_gap+1+mt_bar_h-1);
);
gfx_setfont(1, "Arial", 8);
gfx_r=0.75; gfx_g=0.8; gfx_b=0.85; gfx_a=1;
gfx_measurestr("IN", tw, th);
gfx_x = (mt_in_x0 + mt_in_x1)*0.5 - tw*0.5;
gfx_y = mt_y_top + mt_bar_h*2 + mt_gap + 2;
gfx_drawstr("IN");
gfx_measurestr("OUT", tw, th);
gfx_x = (mt_out_x0 + mt_out_x1)*0.5 - tw*0.5;
gfx_y = mt_y_top + mt_bar_h*2 + mt_gap + 2;
gfx_drawstr("OUT");

gfx_r = clip_in_flag ? 1 : 0.2;
gfx_g = clip_in_flag ? 0.2 : 0.2;
gfx_b = clip_in_flag ? 0.2 : 0.2;
gfx_circle(mt_in_x1 + 8, mt_y_top + mt_bar_h, 4, 1);
gfx_r = clip_out_flag ? 1 : 0.2;
gfx_g = clip_out_flag ? 0.2 : 0.2;
gfx_b = clip_out_flag ? 0.2 : 0.2;
gfx_circle(mt_out_x1 + 8, mt_y_top + mt_bar_h, 4, 1);

// ===== 17. NODOS DE BANDA =====
i = 0;
while (i < 5) (
  nx = 42 + (log(band_freq[i]) - LOG_20) / LOG_RNG * 886;
  ny_off = 52 + (zoom_db - band_gain[i]) / (2 * zoom_db) * 350;
  ny_tgt = 52 + (zoom_db - band_target[i]) / (2 * zoom_db) * 350;
  dyn_v = band_dyn_vis[i]; dyn_v = max(0, min(1, dyn_v));
  ny_now = ny_off*(1-dyn_v) + ny_tgt*dyn_v;
  is_sel = i == selected_band;
  node_r = 10 + is_sel * 2;
  rng = abs(ny_tgt - ny_off); has_rng = rng > 2;
  gfx_r=band_r[i]; gfx_g=band_g[i]; gfx_b=band_b[i]; gfx_a=has_rng*0.5;
  gfx_x = nx; gfx_y = ny_off; gfx_lineto(nx, ny_tgt, 0);
  gfx_r=band_r[i]; gfx_g=band_g[i]; gfx_b=band_b[i]; gfx_a=has_rng*0.6;
  gfx_circle(nx, ny_off, 5, 0);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=dyn_v*0.9;
  gfx_circle(nx, ny_now, 3, 1);
  is_active = dyn_v > 0.05;
  gfx_r=band_r[i]; gfx_g=band_g[i]; gfx_b=band_b[i]; gfx_a=is_active*0.4;
  gfx_circle(nx, ny_now, 20, 0);
  gfx_r=band_r[i]; gfx_g=band_g[i]; gfx_b=band_b[i]; gfx_a=is_sel*0.35;
  gfx_circle(nx, ny_tgt, 16, 1);
  gfx_a=1; gfx_circle(nx, ny_tgt, node_r, 1);
  gfx_r=0; gfx_g=0; gfx_b=0; gfx_a=1;
  gfx_circle(nx, ny_tgt, node_r+1, 0);
  gfx_setfont(1, "Arial", 13);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
  ns = sprintf(#, "%d", i + 1);
  gfx_x=nx-4; gfx_y=ny_tgt-8; gfx_drawstr(ns);
  gfx_r=0.08; gfx_g=0.08; gfx_b=0.08; gfx_a=1;
  gfx_x=nx-30; gfx_y=ny_tgt-9; gfx_rectto(nx-13, ny_tgt+9);
  gfx_setfont(1, "Arial", 13);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
  bchan = band_chan[i];
  is_M = (bchan==3); is_S = (bchan==4);
  is_L = (bchan==1); is_R = (bchan==2); is_St = (bchan==0);
  gfx_x = nx-27-(1-is_M)*2000; gfx_y = ny_tgt-8; gfx_drawstr(#strM);
  gfx_x = nx-27-(1-is_S)*2000; gfx_y = ny_tgt-8; gfx_drawstr(#strS);
  gfx_x = nx-27-(1-is_L)*2000; gfx_y = ny_tgt-8; gfx_drawstr(#strL);
  gfx_x = nx-27-(1-is_R)*2000; gfx_y = ny_tgt-8; gfx_drawstr(#strR);
  gfx_x = nx-27-(1-is_St)*2000; gfx_y = ny_tgt-8; gfx_drawstr(#strSt);
  i = i + 1;
);

// ===== 18. PANEL INFERIOR =====
gfx_r=0.12; gfx_g=0.13; gfx_b=0.17; gfx_a=1;
gfx_x=0; gfx_y=410; gfx_rectto(1000, 620);

sel = selected_band;
is_eq_on = band_enabled[sel];
gfx_r = 0.5 + is_eq_on*0.4;
gfx_g = 0.1 + is_eq_on*0.1;
gfx_b = 0.1 + is_eq_on*0.1;
gfx_circle(30, EQ_Y + EQ_H*0.5, 6, 1);
