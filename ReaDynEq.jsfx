  gfx_r=0; gfx_g=0; gfx_b=0; gfx_a=1;
  gfx_circle(sx, SLIDER_Y+2, sr_rad+1, 0);
  dv = band_dyn_vis[i]; dv = max(0, min(1, dv));
  bar_h = dv * 18; bar_y = SLIDER_Y - 5 - bar_h;
  gfx_r=band_r[i]; gfx_g=band_g[i]; gfx_b=band_b[i]; gfx_a=0.85;
  gfx_x = sx - 1; gfx_y = bar_y; gfx_rectto(sx + 1, SLIDER_Y - 5);
  i = i + 1;
);

