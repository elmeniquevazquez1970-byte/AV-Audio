gfx_x=un_x+un_w-1; gfx_y=un_y; gfx_lineto(un_x+un_w-1, un_y+un_h, 0);
gfx_x=un_x+un_w; gfx_y=un_y+un_h; gfx_lineto(un_x, un_y+un_h, 0);
gfx_x=un_x+un_w; gfx_y=un_y+un_h-1; gfx_lineto(un_x, un_y+un_h-1, 0);
gfx_x=un_x; gfx_y=un_y+un_h; gfx_lineto(un_x, un_y, 0);
gfx_x=un_x+1; gfx_y=un_y+un_h; gfx_lineto(un_x+1, un_y, 0);
gfx_r=0.5+can_undo_v*0.4; gfx_g=0.55+can_undo_v*0.4; gfx_b=0.6+can_undo_v*0.3;
gfx_x=un_x+13; gfx_y=un_y+11; gfx_lineto(un_x+8, un_y+11, 0);
gfx_x=un_x+8; gfx_y=un_y+11; gfx_lineto(un_x+11, un_y+8, 0);
gfx_x=un_x+8; gfx_y=un_y+11; gfx_lineto(un_x+11, un_y+14, 0);

re_x = un_x + un_w + 4;
gfx_r=0.2+can_redo_v*0.15; gfx_g=0.25+can_redo_v*0.2; gfx_b=0.35+can_redo_v*0.25;
gfx_x=re_x; gfx_y=un_y; gfx_rectto(re_x+un_w, un_y+un_h);
