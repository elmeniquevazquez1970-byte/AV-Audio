gfx_r=0.12+is_rms_m*0.20; gfx_g=0.13+is_rms_m*0.22; gfx_b=0.18+is_rms_m*0.22;
gfx_a=1;
gfx_x=302; gfx_y=SUB_Y+8; gfx_rectto(342, SUB_Y+32);
gfx_r=0.45; gfx_g=0.48; gfx_b=0.55;
