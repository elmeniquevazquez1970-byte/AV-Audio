fstate[73] = fstate[72]; fstate[72] = pb_l2; fstate[75] = fstate[74]; fstate[74] = o19;
pb_l3 = o19;
o20 = ph2_b0 * pb_r2 + ph2_b1 * fstate[76] + ph2_b2 * fstate[77] - ph2_a1 * fstate[78] - ph2_a2 * fstate[79];
fstate[77] = fstate[76]; fstate[76] = pb_r2; fstate[79] = fstate[78]; fstate[78] = o20;
pb_r3 = o20;

o13 = ha_b0 * pb_l3 + ha_b1 * fstate[48] + ha_b2 * fstate[49] - ha_a1 * fstate[50] - ha_a2 * fstate[51];
fstate[49] = fstate[48]; fstate[48] = pb_l3; fstate[51] = fstate[50]; fstate[50] = o13;
ha_l = o13;
o14 = ha_b0 * pb_r3 + ha_b1 * fstate[52] + ha_b2 * fstate[53] - ha_a1 * fstate[54] - ha_a2 * fstate[55];
fstate[53] = fstate[52]; fstate[52] = pb_r3; fstate[55] = fstate[54]; fstate[54] = o14;
ha_r = o14;

o17 = mpx_b0 * ha_l + mpx_b1 * fstate[64] + mpx_b2 * fstate[65] - mpx_a1 * fstate[66] - mpx_a2 * fstate[67];
fstate[65] = fstate[64]; fstate[64] = ha_l; fstate[67] = fstate[66]; fstate[66] = o17;
mpx_l = o17;
o18 = mpx_b0 * ha_r + mpx_b1 * fstate[68] + mpx_b2 * fstate[69] - mpx_a1 * fstate[70] - mpx_a2 * fstate[71];
fstate[69] = fstate[68]; fstate[68] = ha_r; fstate[71] = fstate[70]; fstate[70] = o18;
mpx_r = o18;

pt_buf[pt_pos] = mpx_l;
pt_buf[PT_SIZE + pt_pos] = mpx_r;
rp_pt = pt_pos - pt_delay;
rp_pt < 0 ? rp_pt += PT_SIZE;
pt_ri = floor(rp_pt); pt_fr = rp_pt - pt_ri;
pt_rn = pt_ri + 1; pt_rn >= PT_SIZE ? pt_rn -= PT_SIZE;
pt_out_l = pt_buf[pt_ri] * (1 - pt_fr) + pt_buf[pt_rn] * pt_fr;
pt_out_r = pt_buf[PT_SIZE + pt_ri] * (1 - pt_fr) + pt_buf[PT_SIZE + pt_rn] * pt_fr;
pt_pos += 1; pt_pos >= PT_SIZE ? pt_pos = 0;

print_l = mpx_l + pt_out_l * pt_level;
print_r = mpx_r + pt_out_r * pt_level;

azim_out_l = print_l - azim_amt * print_r;
azim_out_r = print_r - azim_amt * print_l;

wow_phase += 2 * $pi * wow_rate / srate;
wow_phase >= 2 * $pi ? wow_phase -= 2 * $pi;
wow2_phase += 2 * $pi * wow2_rate / srate;
wow2_phase >= 2 * $pi ? wow2_phase -= 2 * $pi;
flut_phase += 2 * $pi * flut_rate / srate;
flut_phase >= 2 * $pi ? flut_phase -= 2 * $pi;
scrape_phase += 2 * $pi * scrape_rate / srate;
scrape_phase >= 2 * $pi ? scrape_phase -= 2 * $pi;

mod_s = (sin(wow_phase) * 0.7 + sin(wow2_phase) * 0.3) * wow_depth_s + sin(flut_phase) * flut_depth_s;
mod_s += sin(scrape_phase) * scrape_depth_s;

delay_samples = 20 + mod_s * srate;
delay_samples < 2 ? delay_samples = 2;
delay_samples > WOW_SIZE - 2 ? delay_samples = WOW_SIZE - 2;

wow_buf[wow_pos] = azim_out_l;
wow_buf[WOW_SIZE + wow_pos] = azim_out_r;

rp = wow_pos - delay_samples;
rp < 0 ? rp += WOW_SIZE;
ri = floor(rp); fr = rp - ri;
rn = ri + 1; rn >= WOW_SIZE ? rn -= WOW_SIZE;

wow_out_l = wow_buf[ri] * (1 - fr) + wow_buf[rn] * fr;
wow_out_r = wow_buf[WOW_SIZE + ri] * (1 - fr) + wow_buf[WOW_SIZE + rn] * fr;

wow_pos += 1; wow_pos >= WOW_SIZE ? wow_pos = 0;

wn_l = rand(2) - 1; wn_r = rand(2) - 1;
pink_l = pink_l * 0.98 + wn_l * 0.02;
pink_r = pink_r * 0.98 + wn_r * 0.02;
hiss_l = pink_l * 15.0 * hiss_level;
hiss_r = pink_r * 15.0 * hiss_level;

abs_max = abs(wow_out_l);
abs(wow_out_r) > abs_max ? abs_max = abs(wow_out_r);
abs_max > sag_env ? ( sag_env += (abs_max - sag_env) * sag_atk; ) : ( sag_env += (abs_max - sag_env) * sag_rel; );
sag_g = 1 - sag_env * sag_amt;
sag_g < 0.4 ? sag_g = 0.4;
sag_l = (wow_out_l + hiss_l) * sag_g;
sag_r = (wow_out_r + hiss_r) * sag_g;

(play_state == 1 || play_state == 5) ? (
    rn = rand(2) - 1;
    fstate[96] += (rn - fstate[96]) * rumble_coef;
    fstate[97] += (rn - fstate[97]) * rumble_coef * 1.07;
    sag_l += fstate[96] * rumble_amt;
    sag_r += fstate[97] * rumble_amt;
);

(dolby_on > 0.5) ? (
    fstate[84] += (sag_l - fstate[84]) * dolby_lp_coef;
    fstate[86] += (sag_r - fstate[86]) * dolby_lp_coef;
    hp_dl = sag_l - fstate[84];
    hp_dr = sag_r - fstate[86];
    aL = abs(hp_dl); aR = abs(hp_dr);
    fstate[85] += (aL - fstate[85]) * (aL > fstate[85] ? dolby_atk : dolby_rel);
    fstate[87] += (aR - fstate[87]) * (aR > fstate[87] ? dolby_atk : dolby_rel);
    rL = fstate[85] / dolby_thresh; rL > 1 ? rL = 1;
    rR = fstate[87] / dolby_thresh; rR > 1 ? rR = 1;
    gL = 1 + (dolby_max_g - 1) * (1 - rL);
    gR = 1 + (dolby_max_g - 1) * (1 - rR);
    sag_l -= hp_dl * (gL - 1) / gL;
    sag_r -= hp_dr * (gR - 1) / gR;
);

o15 = dc_b0 * sag_l + dc_b1 * fstate[56] + dc_b2 * fstate[57] - dc_a1 * fstate[58] - dc_a2 * fstate[59];
