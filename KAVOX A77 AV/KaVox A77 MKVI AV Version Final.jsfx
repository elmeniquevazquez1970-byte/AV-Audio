slider15 == 12 ? gfx_drawstr("Piano");
slider15 == 13 ? gfx_drawstr("Keys");
slider15 == 14 ? gfx_drawstr("Room");
slider15 == 15 ? gfx_drawstr("Lo-Fi");
slider15 == 16 ? gfx_drawstr("Mastering");

mouse_click = (mouse_cap & 1) && !(mouse_prev & 1);
(!(mouse_cap & 1) && active_knob > 0) ? ( active_knob = 0; );

power_zone = (mouse_x > W * 0.078) && (mouse_x < W * 0.132) &&
             (mouse_y > H * 0.755) && (mouse_y < H * 0.812);
(mouse_click && power_zone) ? ( power_on = 1 - power_on; );

(mouse_click && hov1) ? ( slider16 = (slider16 > 0.5) ? 0 : 1; ui_pending = 1; );
(mouse_click && hov2) ? ( slider17 = (slider17 > 0.5) ? 0 : 1; ui_pending = 1; );
(mouse_click && hov3) ? ( slider18 = (slider18 > 0.5) ? 0 : 1; ui_pending = 1; );

(mouse_click && hov4) ? ( az_drag_active = 1; );
(!(mouse_cap & 1)) ? ( az_drag_active = 0; );
(az_drag_active > 0) ? (
    rel_x = (mouse_x - tg_x4) / tg_w;
    rel_x < 0 ? rel_x = 0;
    rel_x > 1 ? rel_x = 1;
    slider19 = rel_x;
    ui_pending = 1;
);

hit_knob = 0;
hit_r = kr * 1.15;

(!power_zone) ? (
    (abs(mouse_x - kx1_1) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 1;
    (abs(mouse_x - kx1_2) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 2;
    (abs(mouse_x - kx1_3) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 3;
    (abs(mouse_x - kx1_4) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 4;
    (abs(mouse_x - kx1_5) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 5;
    (abs(mouse_x - kx1_6) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 6;
    (abs(mouse_x - kx1_7) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 7;
    (abs(mouse_x - kx1_8) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 8;
    (abs(mouse_x - kx1_9) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 9;
    (abs(mouse_x - kx1_10) < hit_r && abs(mouse_y - ky1) < hit_r) ? hit_knob = 10;
    (abs(mouse_x - kx2_1) < hit_r && abs(mouse_y - ky2c) < hit_r) ? hit_knob = 11;
    (abs(mouse_x - kx2_2) < hit_r && abs(mouse_y - ky2c) < hit_r) ? hit_knob = 12;
    (abs(mouse_x - kx2_3) < hit_r && abs(mouse_y - ky2c) < hit_r) ? hit_knob = 13;
    (abs(mouse_x - kx2_4) < hit_r && abs(mouse_y - ky2c) < hit_r) ? hit_knob = 14;
);

is_double = 0;
(mouse_click && hit_knob > 0 && hit_knob == last_click_knob && (frame_count - last_click_frame) < 30) ? is_double = 1;
(mouse_click && hit_knob > 0) ? ( last_click_knob = hit_knob; last_click_frame = frame_count; );

(mouse_click && hit_knob > 0) ? (
    (is_double) ? (
        (hit_knob == 1) ? slider1 = 0;
        (hit_knob == 2) ? slider2 = 0;
        (hit_knob == 3) ? slider3 = 0;
        (hit_knob == 4) ? slider4 = 0;
        (hit_knob == 5) ? slider9 = 50;
        (hit_knob == 6) ? slider10 = 0;
        (hit_knob == 7) ? slider11 = 0;
        (hit_knob == 8) ? slider12 = 50;
        (hit_knob == 9) ? slider13 = 50;
        (hit_knob == 10) ? slider14 = 0;
        (hit_knob == 11) ? slider7 = 0;
