// ============================================================
// TOOLTIPS v11.10 — texto con outline, sin fondo, mas completo
// ============================================================
tooltip_text = "";
tooltip_active = 0;

(abs(mouse_x - kx1_1) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "INPUT GAIN: Ajusta el nivel que entra al plugin antes de todo el procesamiento. Rango -24 a +24 dB. Subilo para empujar mas la cinta; bajalo para evitar clipping de entrada."; tooltip_active = 1; );
(abs(mouse_x - kx1_2) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "DRIVE: Cantidad de cinta activa. A 0 el plugin casi no colorea (senal limpia). A 10 emula saturacion magnetica, compresion y calidez del A77. Valores 2-4 suenan sutiles; 6-8 agresivos."; tooltip_active = 1; );
(abs(mouse_x - kx1_3) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "OUTPUT GAIN: Nivel de salida final. Solo ajusta volumen global, no afecta el caracter de la cinta. Subilo si Drive bajo el nivel percibido; bajalo si saturas el bus del DAW."; tooltip_active = 1; );
(abs(mouse_x - kx1_4) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "HF ADJUST: Realce o corte de agudos centrado en 8 kHz. Rango +/-6 dB. Util para compensar cintas con poca respuesta aguda o para oscurecer una toma muy brillante."; tooltip_active = 1; );
(abs(mouse_x - kx1_5) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "BIAS: Corriente de polarizacion de alta frecuencia. Afecta el balance entre agudos y distorsion. Bias bajo = mas agudos pero mas distorsion. Bias alto = menos agudos pero mas limpio. Valor optimo por cinta es 50."; tooltip_active = 1; );
(abs(mouse_x - kx1_6) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "WOW: Profundidad de las fluctuaciones lentas de velocidad del motor capstan. Simula el efecto de un motor desgastado o una cinta vieja. A 0 es digital perfecto; a 30-50 es audible; a 100 es dramatico."; tooltip_active = 1; );
(abs(mouse_x - kx1_7) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "HISS: Nivel del ruido de cinta. Con 0 no hay ruido. Valores bajos (5-15) suenan a cinta bien conservada. Valores altos (30+) suenan a cinta vieja o mal calibrada."; tooltip_active = 1; );
(abs(mouse_x - kx1_8) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "BUMP: Resalte de graves fisico del cabezal, centrado en 55 Hz (7.5 ips) o 45 Hz (3.75 ips). Da cuerpo al kick y al bajo. 0 = sin resalte; 50 = sutil; 100 = muy marcado."; tooltip_active = 1; );
(abs(mouse_x - kx1_9) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "HF LOSS: Perdida de agudos por desgaste del cabezal o cinta mal conservada. 0 = cabezal nuevo; 50 = cinta con uso normal; 100 = cinta con años de uso. Reduce el cutoff del filtro de agudos."; tooltip_active = 1; );
(abs(mouse_x - kx1_10) < hit_r && abs(mouse_y - ky1) < hit_r) ? ( tooltip_text = "SAG: Compresion dinamica por caida de tension de la fuente. Simula la compresion sutil en pasajes fuertes. 0 = fuente perfecta; 50 = rizado moderado; 100 = fuente muy debil."; tooltip_active = 1; );
(abs(mouse_x - kx2_1) < hit_r && abs(mouse_y - ky2c) < hit_r) ? ( tooltip_text = "TAPE TYPE: Elegis la marca y modelo de cinta. Cada una tiene su bias optimo y respuesta de frecuencia. Revox 601/621 son las originales del A77; Ampex 456 es la mas usada en estudios."; tooltip_active = 1; );
(abs(mouse_x - kx2_2) < hit_r && abs(mouse_y - ky2c) < hit_r) ? ( tooltip_text = "EQ STANDARD: NAB es el estandar americano (time constants 50 us a 7.5 ips, 90 us a 3.75). IEC/CCIR es el europeo (70 us a 7.5, 90 us a 3.75). Una cinta grabada con uno suena mal con el otro."; tooltip_active = 1; );
(abs(mouse_x - kx2_3) < hit_r && abs(mouse_y - ky2c) < hit_r) ? ( tooltip_text = "MONITOR: Tape procesa la senal por todo el path de cinta. Input salta el path y pasa la senal directa (bypass), util para comparar A/B y verificar cuanto color agrega el plugin."; tooltip_active = 1; );
(abs(mouse_x - kx2_4) < hit_r && abs(mouse_y - ky2c) < hit_r) ? ( tooltip_text = "PRESET: Configuraciones predefinidas para fuentes comunes (voz, bateria, mezcla, mastering). Cada preset ajusta Drive, Bias, HF Loss, Bump, Hiss y otros parametros de una sola vez."; tooltip_active = 1; );

hov1 ? ( tooltip_text = "MPX FILTER: Filtro a 14.5 kHz. Elimina la subportadora estereo de 19 kHz que emiten las radios FM y que puede batir con el bias. Activalo solo si estas grabando de una radio FM estereo."; tooltip_active = 1; );
hov2 ? ( tooltip_text = "PRE-EMPHASIS: Clean = respuesta plana, sin realce de agudos ni shelves de graves. Ideal mastering. Tape = curvas de grabacion/reproduccion NAB o IEC originales del A77. Mas caracter, mas color."; tooltip_active = 1; );
hov3 ? ( tooltip_text = "DOLBY B: Reductor de ruido Dolby B (aprox 10 dB de reduccion). Realza agudos en senales debiles al grabar y los atenua al reproducir. Activalo solo con cintas grabadas en Dolby B."; tooltip_active = 1; );
hov4 ? ( tooltip_text = "AZIMUTH: Desalineacion angular del cabezal de reproduccion (0 a 100%). A 0 el cabezal esta perfecto. Valores altos producen perdida de agudos y sangrado entre canales. Arrastra horizontalmente para ajustar."; tooltip_active = 1; );

// Tooltip con OUTLINE (sin fondo) para no tapar la imagen de la cinta
(tooltip_active == 1) ? (
