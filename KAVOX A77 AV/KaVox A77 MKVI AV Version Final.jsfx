    y1 = reel_cy + sin(ang) * reel_rad * 0.13;
    x2 = reel_rx + cos(ang) * reel_rad * 0.28 * spoke_mod_r;
    y2 = reel_cy + sin(ang) * reel_rad * 0.28 * spoke_mod_r;
    gfx_line(x1, y1, x2, y2);
    idx += 1;
);

tg_y = H * 0.318;
tg_h = H * 0.042;
tg_w = W * 0.155;
tg_gap = W * 0.018;
tg_x1 = W * 0.130;
tg_x2 = tg_x1 + tg_w + tg_gap;
tg_x3 = tg_x2 + tg_w + tg_gap;
tg_x4 = tg_x3 + tg_w + tg_gap;

hov1 = (mouse_x > tg_x1 && mouse_x < tg_x1 + tg_w && mouse_y > tg_y && mouse_y < tg_y + tg_h);
hov2 = (mouse_x > tg_x2 && mouse_x < tg_x2 + tg_w && mouse_y > tg_y && mouse_y < tg_y + tg_h);
hov3 = (mouse_x > tg_x3 && mouse_x < tg_x3 + tg_w && mouse_y > tg_y && mouse_y < tg_y + tg_h);
hov4 = (mouse_x > tg_x4 && mouse_x < tg_x4 + tg_w && mouse_y > tg_y && mouse_y < tg_y + tg_h);

