signal_energy = (abs(sat_l) + abs(sat_r)) * 0.5;
thermal_activity += (signal_energy - thermal_activity) * thermal_activity_coef;
thermal_target = 25 + thermal_activity * 30;
thermal_state += (thermal_target - thermal_state) * thermal_coef;

mon_l = sat_l; mon_r = sat_r;

crosstalk_l = (mon_r - mon_l) * crosstalk_coef;
crosstalk_r = (mon_l - mon_r) * crosstalk_coef;
mon_l += crosstalk_l;
mon_r += crosstalk_r;

o5 = hb_b0 * mon_l + hb_b1 * fstate[16] + hb_b2 * fstate[17] - hb_a1 * fstate[18] - hb_a2 * fstate[19];
fstate[17] = fstate[16]; fstate[16] = mon_l; fstate[19] = fstate[18]; fstate[18] = o5;
