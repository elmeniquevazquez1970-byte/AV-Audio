        (active_knob == 3) ? ( drag_v0 = slider3; drag_min = -24; drag_max = 24; );
        (active_knob == 4) ? ( drag_v0 = slider4; drag_min = -6; drag_max = 6; );
        (active_knob == 5) ? ( drag_v0 = slider9; drag_min = 0; drag_max = 100; );
        (active_knob == 6) ? ( drag_v0 = slider10; drag_min = 0; drag_max = 100; );
