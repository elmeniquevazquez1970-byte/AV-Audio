);

gfx_setfont(1, "Arial", 11, 'b');
gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15;
gfx_x = W * 0.455; gfx_y = H * 0.815;
slider15 == 0 ? gfx_drawstr("Init");
slider15 == 1 ? gfx_drawstr("Warm Vocal");
slider15 == 2 ? gfx_drawstr("Lead Vocal");
slider15 == 3 ? gfx_drawstr("Backing Vox");
slider15 == 4 ? gfx_drawstr("Bass");
