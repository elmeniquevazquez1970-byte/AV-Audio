        (active_knob == 9) ? ( drag_v0 = slider13; drag_min = 0; drag_max = 100; );
        (active_knob == 10) ? ( drag_v0 = slider14; drag_min = 0; drag_max = 100; );
        (active_knob == 11) ? ( drag_v0 = slider7; drag_min = 0; drag_max = 20; );
        (active_knob == 12) ? ( drag_v0 = slider6; drag_min = 0; drag_max = 1; );
        (active_knob == 13) ? ( drag_v0 = slider8; drag_min = 0; drag_max = 1; );
