        slider15 == 12 ? ( slider1 = -1.0; slider2 = 2.0; slider3 = 0; slider4 = 0; slider5 = 0; slider6 = 0; slider7 = 10; slider8 = 0; slider9 = 60; slider10 = 15; slider11 = 8; slider12 = 45; slider13 = 70; slider14 = 25; );
        slider15 == 13 ? ( slider1 = -0.5; slider2 = 3.0; slider3 = -0.5; slider4 = 0; slider5 = 0; slider6 = 0; slider7 = 9; slider8 = 0; slider9 = 55; slider10 = 10; slider11 = 8; slider12 = 55; slider13 = 75; slider14 = 30; );
