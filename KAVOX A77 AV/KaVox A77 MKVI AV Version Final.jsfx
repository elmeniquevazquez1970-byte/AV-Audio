    vu_rms_l_disp = sqrt(vu_ms_l);
    vu_db_l = (vu_rms_l_disp > 0.00001) ? (20 * log10(vu_rms_l_disp)) : -60;
    vu_vu_l = vu_db_l + 19;
    vu_vu_l < -20 ? vu_vu_l = -20;
    vu_vu_l > 3 ? vu_vu_l = 3;
    n_l = (vu_vu_l + 20) / 23;
    ang_l = -1.15 + n_l * 1.90;
    pvx_l = vu_x_l + vu_w * 0.5;
    pvy_l = vu_y + vu_h * 0.95;
    nlen_l = vu_h * 0.82;
    nx_l = pvx_l + sin(ang_l) * nlen_l;
    ny_l = pvy_l - cos(ang_l) * nlen_l;
    
    perp_x = cos(ang_l) * 1.8;
    perp_y = sin(ang_l) * 1.8;
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
    gfx_line(nx_l - perp_x, ny_l - perp_y, pvx_l - perp_x, pvy_l - perp_y);
    gfx_line(nx_l, ny_l, pvx_l, pvy_l);
    gfx_line(nx_l + perp_x, ny_l + perp_y, pvx_l + perp_x, pvy_l + perp_y);
    gfx_circle(pvx_l, pvy_l, 3.5, 1);
    
    vu_peak_db_l = (vu_peak_l > 0.00001) ? (20 * log10(vu_peak_l) + 19) : -60;
    vu_peak_db_l < -20 ? vu_peak_db_l = -20;
    vu_peak_db_l > 3 ? vu_peak_db_l = 3;
    n_pk_l = (vu_peak_db_l + 20) / 23;
    ang_pk_l = -1.15 + n_pk_l * 1.90;
    pk_x_l = pvx_l + sin(ang_pk_l) * nlen_l;
    pk_y_l = pvy_l - cos(ang_pk_l) * nlen_l;
    gfx_r = 1.0; gfx_g = 0.2; gfx_b = 0.1;
    gfx_circle(pk_x_l, pk_y_l, 2, 1);
    
    vu_rms_r_disp = sqrt(vu_ms_r);
    vu_db_r = (vu_rms_r_disp > 0.00001) ? (20 * log10(vu_rms_r_disp)) : -60;
    vu_vu_r = vu_db_r + 19;
    vu_vu_r < -20 ? vu_vu_r = -20;
    vu_vu_r > 3 ? vu_vu_r = 3;
    n_r = (vu_vu_r + 20) / 23;
    ang_r = -1.15 + n_r * 1.90;
    pvx_r = vu_x_r + vu_w * 0.5;
    pvy_r = vu_y + vu_h * 0.95;
    nlen_r = vu_h * 0.82;
    nx_r = pvx_r + sin(ang_r) * nlen_r;
    ny_r = pvy_r - cos(ang_r) * nlen_r;
    
    perp_x = cos(ang_r) * 1.8;
    perp_y = sin(ang_r) * 1.8;
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
    gfx_line(nx_r - perp_x, ny_r - perp_y, pvx_r - perp_x, pvy_r - perp_y);
    gfx_line(nx_r, ny_r, pvx_r, pvy_r);
    gfx_line(nx_r + perp_x, ny_r + perp_y, pvx_r + perp_x, pvy_r + perp_y);
    gfx_circle(pvx_r, pvy_r, 3.5, 1);
    
    vu_peak_db_r = (vu_peak_r > 0.00001) ? (20 * log10(vu_peak_r) + 19) : -60;
    vu_peak_db_r < -20 ? vu_peak_db_r = -20;
    vu_peak_db_r > 3 ? vu_peak_db_r = 3;
    n_pk_r = (vu_peak_db_r + 20) / 23;
    ang_pk_r = -1.15 + n_pk_r * 1.90;
    pk_x_r = pvx_r + sin(ang_pk_r) * nlen_r;
    pk_y_r = pvy_r - cos(ang_pk_r) * nlen_r;
    gfx_r = 1.0; gfx_g = 0.2; gfx_b = 0.1;
    gfx_circle(pk_x_r, pk_y_r, 2, 1);
);

power_on == 1 ? (
    gfx_r = 0.10; gfx_g = 1.00; gfx_b = 0.15;
    gfx_circle(W * 0.105, H * 0.784, W * 0.004, 1);
    gfx_r = 0.30; gfx_g = 1.00; gfx_b = 0.30;
