vu_ms_r += (spl1 * spl1 - vu_ms_r) * vu_rms_coef;

abs(spl0) > vu_peak_l ? ( vu_peak_l = abs(spl0); vu_hold_l = vu_hold_samples; ) : ( vu_hold_l > 0 ? vu_hold_l -= 1 : vu_peak_l *= 0.9995; );
abs(spl1) > vu_peak_r ? ( vu_peak_r = abs(spl1); vu_hold_r = vu_hold_samples; ) : ( vu_hold_r > 0 ? vu_hold_r -= 1 : vu_peak_r *= 0.9995; );

@gfx 1419 1109

W = gfx_w;
H = gfx_h;
frame_count += 1;

gfx_getimgdim(0, bg_w, bg_h);
gfx_getimgdim(1, kb_w, kb_h);
gfx_getimgdim(2, rl_w, rl_h);
gfx_getimgdim(3, vu_face_w, vu_face_h);
