    gfx_x = tx - 1; gfx_y = ty;     gfx_drawstr(tooltip_text);
    gfx_x = tx + 1; gfx_y = ty;     gfx_drawstr(tooltip_text);
    gfx_x = tx;     gfx_y = ty - 1; gfx_drawstr(tooltip_text);
    gfx_x = tx;     gfx_y = ty + 1; gfx_drawstr(tooltip_text);
    // Texto blanco encima
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    gfx_x = tx; gfx_y = ty;
    gfx_drawstr(tooltip_text);
);

(vu_face_w > 0) ? (
    vu_w = W * 0.155;
    vu_h = vu_w * vu_face_h / vu_face_w;
    (vu_h > H * 0.155) ? (
        vu_h = H * 0.155;
        vu_w = vu_h * vu_face_w / vu_face_h;
    );
    
    vu_y = H * 0.740;
    vu_gap = W * 0.010;
    vu_total_w = vu_w * 2 + vu_gap;
    vu_center = W * 0.695;
    vu_x_l = vu_center - vu_total_w * 0.5;
    vu_x_r = vu_x_l + vu_w + vu_gap;
    
    blit_c[0] = 0; blit_c[1] = 0;
    blit_c[2] = vu_face_w; blit_c[3] = vu_face_h;
    blit_c[4] = vu_x_l; blit_c[5] = vu_y;
    blit_c[6] = vu_w; blit_c[7] = vu_h;
