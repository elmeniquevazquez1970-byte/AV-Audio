gfx_r = hov1 ? 0.85 : 0.95; gfx_g = hov1 ? 0.85 : 0.95; gfx_b = hov1 ? 0.85 : 0.95;
gfx_x = tg_x1; gfx_y = tg_y + tg_h*0.5 - 8;
gfx_drawstr((slider16 > 0.5) ? "MPX ON" : "MPX OFF");
gfx_r = (slider16 > 0.5) ? 0.10 : 0.35;
