);

gfx_setfont(1, "Arial", 14, 'b');

tape_name = "---";
slider7 == 0  ? tape_name = "Revox 601";
slider7 == 1  ? tape_name = "Revox 621";
slider7 == 2  ? tape_name = "Revox 631";
slider7 == 3  ? tape_name = "Scotch 206";
slider7 == 4  ? tape_name = "Scotch 207";
slider7 == 5  ? tape_name = "Scotch 250";
