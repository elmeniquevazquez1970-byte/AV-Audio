desc:Kavox A77 MKIV v1.0
author:AV Audio- Adrian Vazquez
version:1.0
provides:   bg.png, knob.png, reel.png, vu_face.png, vu_needle.png

slider1:0<-24,24,0.1>-Input Gain (dB)
slider2:0<0,10,0.01>-Drive
slider3:0<-24,24,0.1>-Output Gain (dB)
slider4:0<-6,6,0.1>-HF Adjust (dB)
slider5:0<0,1,1{7.5 ips,3.75 ips}>-Tape Speed
slider6:0<0,1,1{NAB,IEC}>-EQ Standard
slider7:0<0,20,1{Revox 601,Revox 621,Revox 631,Scotch 206,Scotch 207,Scotch 250,Scotch 256,Ampex 406,Ampex 407,Ampex 456,Agfa 468,BASF LPR,Agfa PEM 368,Agfa PER 525,Agfa PER 528,BASF SPR 50LH,BASF LGP 30P,BASF LGR 50,Maxell UD-XL,Tok Audua,EMI 816/817}>-Tape Type
slider8:0<0,1,1{Tape,Input}>-Monitor
slider9:0<0,100,0.1>-Bias
slider10:0<0,100,0.1>-Wow
slider11:0<0,100,0.1>-Hiss
slider12:0<0,100,0.1>-Bump
slider13:0<0,100,0.1>-HF Loss
slider14:0<0,100,0.1>-Sag
slider15:0<0,16,1{Init,Warm Vocal,Lead Vocal,Backing Vox,Bass,Kick,Snare,Drum Bus,Mix Bus,Elec Guitar,Acous Guitar,Spanish Guitar,Piano,Keys,Room,Lo-Fi,Mastering}>-Preset
slider16:0<0,1,1{Off,On}>-MPX Filter
slider17:0<0,1,1{Clean,Tape}>-Pre-Emphasis
slider18:0<0,1,1{Off,On}>-Dolby B
slider19:0<0,1,0.01>-Azimuth

filename:0,bg.png
filename:1,knob.png
filename:2,reel.png
filename:3,vu_face.png
filename:4,vu_needle.png
resource:0,1,2,3,4

@init

FSTATE_BYTES = 1024;
fstate = freembuf(FSTATE_BYTES);
memset(fstate, 0, FSTATE_BYTES);

WOW_SIZE = 16384;
WOW_BYTES = WOW_SIZE * 2 * 8;
wow_buf = freembuf(WOW_BYTES);
memset(wow_buf, 0, WOW_BYTES);
wow_pos = 0;

BLIT_BYTES = 8192;
blit_c = freembuf(BLIT_BYTES);

PT_SIZE = ceil(srate * 0.20);
PT_BYTES = PT_SIZE * 2 * 8;
pt_buf = freembuf(PT_BYTES);
memset(pt_buf, 0, PT_BYTES);
pt_pos = 0;
pt_delay = floor(srate * 0.125);
pt_level = 0.006;

azim_state_l = 0; azim_state_r = 0;
azim_l_prev = 0; azim_r_prev = 0;
azim_amt = 0.22;

mag_l = 0; mag_r = 0;
sag_env = 0;
wow_phase = 0; flut_phase = 0;
wow2_phase = 0;
scrape_phase = 0;
pink_l = 0; pink_r = 0;
last_speed = -1; last_eq = -1; last_tape = -1;
last_drive = -1; last_bias = -1;

preset_initialized = 0;
last_preset = -1;

power_on = 1;
power_zone = 0;

raw_in_l = 0;
raw_in_r = 0;

reel_angle = 0;
reel_angle_r = 0;

bg_w = 0; bg_h = 0;
kb_w = 0; kb_h = 0;
rl_w = 0; rl_h = 0;
vu_face_w = 0; vu_face_h = 0;
vu_needle_w = 0; vu_needle_h = 0;

active_knob = 0;
drag_y0 = 0; drag_v0 = 0;
drag_min = 0; drag_max = 0;
drag_px = 200;
mouse_prev = 0;
last_click_knob = 0;
last_click_frame = -100;
frame_count = 0;
ui_pending = 0;

vu_ms_l = 0;
vu_ms_r = 0;
vu_rms_coef = 1 - exp(-1 / (0.065 * srate));

vu_peak_l = 0;
vu_peak_r = 0;
vu_hold_l = 0;
vu_hold_r = 0;
vu_hold_samples = 2.0 * srate;

comp_env_l = 0;
comp_env_r = 0;
comp_env_coef = 1 - exp(-1 / (0.010 * srate));
comp_thresh = 0.8;
comp_slope = 0.10;

crosstalk_coef = 0.001;

mpx_b0 = 0; mpx_b1 = 0; mpx_b2 = 0; mpx_a1 = 0; mpx_a2 = 0;
ph2_b0 = 0; ph2_b1 = 0; ph2_b2 = 0; ph2_a1 = 0; ph2_a2 = 0;

scrape_rate = 65;
scrape_depth_s = 0.000002;

thermal_state = 25;
thermal_target = 25;
thermal_coef = 1 - exp(-1 / (30.0 * srate));
thermal_activity = 0;
thermal_activity_coef = 1 - exp(-1 / (2.0 * srate));

gm_l = 1; gm_r = 1;

in_gain = 1; out_gain = 1;
speed = 0; eq = 0; tape = 0;
thd = 2.0; snr = 62;
wow_pct = 0.08; flut_pct = 0.1;
hf_base = 22000; bump_freq = 55; bump_gain_base = 2.5;
hf_tc_us = 50.0; bias_dv = 4.0; hf_cut = 20000;
drive_gain = 1; drive_comp = 1;
sat_asym = 0.05; sat3_asym = 0.06; sat4_asym = 0.01;
hyst_atk = 0.2; hyst_rel = 0.1;
bias_op_shift = 0;
wow_rate = 0.7; flut_rate = 7.5;
wow2_rate = 0.31;
wow_depth_s = 0; flut_depth_s = 0;
hiss_level = 0; sag_amt = 0;
sag_atk = 0.01; sag_rel = 0.001;

mpx_on = 0;
preemp_on = 1;
dolby_on = 0;
dolby_lp_coef = 0.15;
dolby_atk = 0.001; dolby_rel = 0.01;
dolby_thresh = 0.00775; dolby_max_g = 3.162;
rumble_coef = 0; rumble_amt = 0.0006;

az_drag_active = 0;

rl_b0 = 1; rl_b1 = 0; rl_b2 = 0; rl_a1 = 0; rl_a2 = 0;
rh_b0 = 1; rh_b1 = 0; rh_b2 = 0; rh_a1 = 0; rh_a2 = 0;
pl_b0 = 1; pl_b1 = 0; pl_b2 = 0; pl_a1 = 0; pl_a2 = 0;
ph_b0 = 1; ph_b1 = 0; ph_b2 = 0; ph_a1 = 0; ph_a2 = 0;
hb_b0 = 1; hb_b1 = 0; hb_b2 = 0; hb_a1 = 0; hb_a2 = 0;
hfl_b0 = 1; hfl_b1 = 0; hfl_b2 = 0; hfl_a1 = 0; hfl_a2 = 0;
ha_b0 = 1; ha_b1 = 0; ha_b2 = 0; ha_a1 = 0; ha_a2 = 0;
dc_b0 = 1; dc_b1 = 0; dc_b2 = 0; dc_a1 = 0; dc_a2 = 0;

function update_params() (
    in_gain = 10 ^ (slider1 * 0.05);
    out_gain = 10 ^ (slider3 * 0.05);
    speed = slider5;
    eq = slider6;
    tape = slider7;
    
    thd = 2.0; snr = 62;
    wow_pct = 0.08; flut_pct = 0.1;
    hf_base = 22000; bump_gain_base = 2.5; hf_tc_us = 50.0;
    bump_freq = 55;
    pt_level = 0.006;
    
    speed == 1 ? (
        thd = 3.0; snr = 59;
        wow_pct = 0.1; flut_pct = 0.15;
        hf_base = 14000; bump_freq = 45; bump_gain_base = 4.0; hf_tc_us = 90.0;
        pt_level = 0.010;
    );
    eq == 1 ? ( hf_tc_us = 70.0; speed == 1 ? hf_tc_us = 90.0; );
    
    bias_75 = 4.0;
    tape == 0  ? bias_75 = 4.0;
    tape == 1  ? bias_75 = 4.0;
    tape == 2  ? bias_75 = 6.0;
    tape == 3  ? bias_75 = 5.0;
    tape == 4  ? bias_75 = 4.0;
    tape == 5  ? bias_75 = 6.0;
    tape == 6  ? bias_75 = 6.0;
    tape == 7  ? bias_75 = 5.0;
    tape == 8  ? bias_75 = 5.5;
    tape == 9  ? bias_75 = 6.0;
    tape == 10 ? bias_75 = 6.0;
    tape == 11 ? bias_75 = 5.0;
    tape == 12 ? bias_75 = 5.0;
    tape == 13 ? bias_75 = 5.0;
    tape == 14 ? bias_75 = 6.0;
    tape == 15 ? bias_75 = 5.0;
    tape == 16 ? bias_75 = 5.0;
    tape == 17 ? bias_75 = 6.0;
    tape == 18 ? bias_75 = 5.0;
    tape == 19 ? bias_75 = 5.0;
    tape == 20 ? bias_75 = 6.0;
    
    bias_375 = 5.0;
    tape == 0  ? bias_375 = 5.0;
    tape == 1  ? bias_375 = 4.5;
    tape == 2  ? bias_375 = 6.0;
    tape == 3  ? bias_375 = 5.0;
    tape == 4  ? bias_375 = 5.0;
    tape == 5  ? bias_375 = 5.0;
    tape == 6  ? bias_375 = 6.0;
    tape == 7  ? bias_375 = 6.0;
    tape == 8  ? bias_375 = 6.0;
    tape == 9  ? bias_375 = 5.0;
    tape == 10 ? bias_375 = 6.0;
    tape == 11 ? bias_375 = 6.0;
    tape == 12 ? bias_375 = 5.0;
    tape == 13 ? bias_375 = 6.0;
    tape == 14 ? bias_375 = 6.0;
    tape == 15 ? bias_375 = 6.0;
    tape == 16 ? bias_375 = 6.0;
    tape == 17 ? bias_375 = 6.0;
    tape == 18 ? bias_375 = 6.0;
    tape == 19 ? bias_375 = 6.0;
    tape == 20 ? bias_375 = 6.0;
    
    bias_dv = bias_75;
    speed == 1 ? bias_dv = bias_375;
    
    thermal_bias_mod = 1 + (thermal_state - 25.0) * 0.0004;
    bias_dv = bias_dv * thermal_bias_mod;
    
    bias_track = (slider9 - 50) * 0.0001;
    
    hf_cut = hf_base * (1.0 - (bias_dv - 4.0) * 0.04 - (slider9 * 0.0005) - bias_track);
    
    hf_loss_amt = slider13 * 0.01;
    hf_cut = hf_cut * (1.0 - hf_loss_amt * 0.75);
    hf_cut < 6000 ? hf_cut = 6000;
    
    drive_gain = 1 + (slider2 * 0.5) + (slider2 * slider2 * 0.08);
    drive_comp = 1 / (1 + slider2 * 0.30);
    
    gm_l = 1 / (1 + slider2 * 0.05);
    gm_r = 1 / (1 + slider2 * 0.05);
    
    drive_amount = slider2 * 0.1;
    drive_amount < 0 ? drive_amount = 0;
    drive_amount > 1 ? drive_amount = 1;
    
    sat_asym = (0.02 + thd * 0.020) * drive_amount;
    sat3_asym = 0.008 * thd * (1 + slider2 * 0.15) * drive_amount;
    sat4_asym = 0.002 * thd * (1 + slider2 * 0.10) * drive_amount;
    hyst_atk = 0.15 + thd * 0.04;
    hyst_rel = 0.08 + thd * 0.02;
    
    bias_amt = slider9 * 0.01;
    bias_op_shift = bias_amt * 0.25;
    
    wow_var_fraction = (wow_pct / 100.0) * (slider10 * 0.010);
    flut_var_fraction = (flut_pct / 100.0) * (slider10 * 0.010);
    wow_thermal_mod = 1 + (thermal_state - 25.0) * 0.00004;
    wow_depth_s = (wow_var_fraction / (2 * $pi * wow_rate)) * wow_thermal_mod;
    flut_depth_s = (flut_var_fraction / (2 * $pi * flut_rate)) * wow_thermal_mod;
    wow_depth_s > 0.005 ? wow_depth_s = 0.005;
    flut_depth_s > 0.005 ? flut_depth_s = 0.005;
    
    hiss_level = (10 ^ (-snr * 0.05)) * (slider11 * 0.01);
    sag_amt = slider14 * 0.01 * 0.6;
    sag_atk = 1 - exp(-1 / (0.005 * srate));
    sag_rel = 1 - exp(-1 / (0.100 * srate));
    
    preemp_on = slider17;
    
    rl_gain = preemp_on ? 3.0 : 0.0;
    A = 10 ^ (rl_gain / 40); w0 = 2 * $pi * 50 / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / 2 * sqrt((A + 1/A) * (1/0.707 - 1) + 2);
    tsa = 2 * sqrt(A) * alpha;
    b0 = A * ((A+1) + (A-1)*cw + tsa);
    b1 = -2 * A * ((A-1) + (A+1)*cw);
    b2 = A * ((A+1) + (A-1)*cw - tsa);
    a0 = (A+1) - (A-1)*cw + tsa;
    a1 = 2 * ((A-1) - (A+1)*cw);
    a2 = (A+1) - (A-1)*cw - tsa;
    rl_b0 = b0/a0; rl_b1 = b1/a0; rl_b2 = b2/a0; rl_a1 = a1/a0; rl_a2 = a2/a0;
    
    rec_hf_freq = 1000000 / (2 * $pi * hf_tc_us);
    rec_hg = preemp_on ? 4 : 0;
    eq == 1 ? (preemp_on ? rec_hg = 3 : rec_hg = 0);
    A = 10 ^ (rec_hg / 40); w0 = 2 * $pi * rec_hf_freq / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / 2 * sqrt((A + 1/A) * (1/0.707 - 1) + 2);
    tsa = 2 * sqrt(A) * alpha;
    b0 = A * ((A+1) + (A-1)*cw + tsa);
    b1 = -2 * A * ((A-1) + (A+1)*cw);
    b2 = A * ((A+1) + (A-1)*cw - tsa);
    a0 = (A+1) - (A-1)*cw + tsa;
    a1 = 2 * ((A-1) - (A+1)*cw);
    a2 = (A+1) - (A-1)*cw - tsa;
    rh_b0 = b0/a0; rh_b1 = b1/a0; rh_b2 = b2/a0; rh_a1 = a1/a0; rh_a2 = a2/a0;
    
    pl_gain = preemp_on ? -3.0 : 0.0;
    A = 10 ^ (pl_gain / 40); w0 = 2 * $pi * 50 / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / 2 * sqrt((A + 1/A) * (1/0.707 - 1) + 2);
    tsa = 2 * sqrt(A) * alpha;
    b0 = A * ((A+1) + (A-1)*cw + tsa);
    b1 = -2 * A * ((A-1) + (A+1)*cw);
    b2 = A * ((A+1) + (A-1)*cw - tsa);
    a0 = (A+1) - (A-1)*cw + tsa;
    a1 = 2 * ((A-1) - (A+1)*cw);
    a2 = (A+1) - (A-1)*cw - tsa;
    pl_b0 = b0/a0; pl_b1 = b1/a0; pl_b2 = b2/a0; pl_a1 = a1/a0; pl_a2 = a2/a0;
    
    pb_hg = preemp_on ? -4 : 0;
    eq == 1 ? (preemp_on ? pb_hg = -3 : pb_hg = 0);
    A = 10 ^ (pb_hg / 40); w0 = 2 * $pi * rec_hf_freq / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / 2 * sqrt((A + 1/A) * (1/0.707 - 1) + 2);
    tsa = 2 * sqrt(A) * alpha;
    b0 = A * ((A+1) + (A-1)*cw + tsa);
    b1 = -2 * A * ((A-1) + (A+1)*cw);
    b2 = A * ((A+1) + (A-1)*cw - tsa);
    a0 = (A+1) - (A-1)*cw + tsa;
    a1 = 2 * ((A-1) - (A+1)*cw);
    a2 = (A+1) - (A-1)*cw - tsa;
    ph_b0 = b0/a0; ph_b1 = b1/a0; ph_b2 = b2/a0; ph_a1 = a1/a0; ph_a2 = a2/a0;
    
    ph2_b0 = 1; ph2_b1 = 0; ph2_b2 = 0;
    ph2_a1 = 0; ph2_a2 = 0;
    
    hb_gain = bump_gain_base * (slider12 * 0.01);
    A = 10 ^ (hb_gain / 40); w0 = 2 * $pi * bump_freq / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / (2 * 0.9);
    b0 = 1 + alpha*A; b1 = -2 * cw; b2 = 1 - alpha*A;
    a0 = 1 + alpha/A; a1 = -2 * cw; a2 = 1 - alpha/A;
    hb_b0 = b0/a0; hb_b1 = b1/a0; hb_b2 = b2/a0; hb_a1 = a1/a0; hb_a2 = a2/a0;
    
    hf_cut_use = hf_cut;
    hf_cut_use > srate * 0.45 ? hf_cut_use = srate * 0.45;
    w0 = 2 * $pi * hf_cut_use / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / (2 * 0.55);
    b0 = (1-cw)/2; b1 = 1-cw; b2 = (1-cw)/2;
    a0 = 1+alpha; a1 = -2*cw; a2 = 1-alpha;
    hfl_b0 = b0/a0; hfl_b1 = b1/a0; hfl_b2 = b2/a0; hfl_a1 = a1/a0; hfl_a2 = a2/a0;
    
    ha_freq = 8000;
    ha_freq > srate * 0.45 ? ha_freq = srate * 0.40;
    A = 10 ^ (slider4 / 40); w0 = 2 * $pi * ha_freq / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / 2 * sqrt((A + 1/A) * (1/0.707 - 1) + 2);
    tsa = 2 * sqrt(A) * alpha;
    b0 = A * ((A+1) + (A-1)*cw + tsa);
    b1 = -2 * A * ((A-1) + (A+1)*cw);
    b2 = A * ((A+1) + (A-1)*cw - tsa);
    a0 = (A+1) - (A-1)*cw + tsa;
    a1 = 2 * ((A-1) - (A+1)*cw);
    a2 = (A+1) - (A-1)*cw - tsa;
    ha_b0 = b0/a0; ha_b1 = b1/a0; ha_b2 = b2/a0; ha_a1 = a1/a0; ha_a2 = a2/a0;
    
    w0 = 2 * $pi * 20 / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / (2 * 0.7071);
    b0 = (1+cw)/2; b1 = -(1+cw); b2 = (1+cw)/2;
    a0 = 1+alpha; a1 = -2*cw; a2 = 1-alpha;
    dc_b0 = b0/a0; dc_b1 = b1/a0; dc_b2 = b2/a0; dc_a1 = a1/a0; dc_a2 = a2/a0;
    
    mpx_on = slider16;
    (mpx_on > 0.5) ? (
        mpx_freq = 14500;
        mpx_freq > srate * 0.45 ? mpx_freq = srate * 0.40;
        w0 = 2 * $pi * mpx_freq / srate;
        cw = cos(w0); sw = sin(w0);
        alpha = sw / (2 * 0.707);
        b0 = (1-cw)/2; b1 = 1-cw; b2 = (1-cw)/2;
        a0 = 1+alpha; a1 = -2*cw; a2 = 1-alpha;
        mpx_b0 = b0/a0; mpx_b1 = b1/a0; mpx_b2 = b2/a0;
        mpx_a1 = a1/a0; mpx_a2 = a2/a0;
    ) : (
        mpx_b0 = 1; mpx_b1 = 0; mpx_b2 = 0;
        mpx_a1 = 0; mpx_a2 = 0;
    );
    
    dolby_on = slider18;
    dolby_lp_coef = 1 - exp(-2 * $pi * 1000 / srate);
    dolby_atk = 1 - exp(-1 / (0.0015 * srate));
    dolby_rel = 1 - exp(-1 / (0.100  * srate));
    dolby_thresh = 0.00775;
    dolby_max_g = 10 ^ (10.0 / 20.0);

    rumble_coef = 1 - exp(-2 * $pi * 80 / srate);
    azim_amt = slider19 * 0.5;
    
    (last_drive < 0) ? ( last_drive = slider2; last_bias = slider9; );
    
    (speed != last_speed) || (eq != last_eq) || (tape != last_tape) || 
    (abs(slider2 - last_drive) > 0.5) || (abs(slider9 - last_bias) > 5) ? (
        memset(fstate, 0, FSTATE_BYTES);
        mag_l = 0; mag_r = 0; sag_env = 0;
        pink_l = 0; pink_r = 0;
        comp_env_l = 0; comp_env_r = 0;
        last_speed = speed; last_eq = eq; last_tape = tape;
        last_drive = slider2; last_bias = slider9;
    );
);

@slider
update_params();

@block

preset_initialized == 0 ? (
    preset_initialized = 1;
    last_preset = slider15;
) : (
    slider15 != last_preset ? (
        last_preset = slider15;
        slider15 == 0 ? ( slider1 = 0; slider2 = 0; slider3 = 0; slider4 = 0; slider5 = 0; slider6 = 0; slider7 = 0; slider8 = 0; slider9 = 50; slider10 = 0; slider11 = 0; slider12 = 50; slider13 = 50; slider14 = 0; slider16 = 0; slider17 = 1; slider18 = 0; slider19 = 0; );
        slider15 == 1 ? ( slider1 = -1.5; slider2 = 2.5; slider3 = 0.5; slider4 = 1.0; slider5 = 0; slider6 = 0; slider7 = 0; slider8 = 0; slider9 = 50; slider10 = 15; slider11 = 10; slider12 = 60; slider13 = 70; slider14 = 25; );
        slider15 == 2 ? ( slider1 = -0.5; slider2 = 3.5; slider3 = -0.5; slider4 = 1.5; slider5 = 0; slider6 = 0; slider7 = 9; slider8 = 0; slider9 = 55; slider10 = 10; slider11 = 8; slider12 = 65; slider13 = 75; slider14 = 35; );
        slider15 == 3 ? ( slider1 = 0; slider2 = 2.5; slider3 = -0.5; slider4 = 0; slider5 = 0; slider6 = 0; slider7 = 5; slider8 = 0; slider9 = 60; slider10 = 20; slider11 = 12; slider12 = 70; slider13 = 60; slider14 = 30; );
        slider15 == 4 ? ( slider1 = 0; slider2 = 3.0; slider3 = -1.0; slider4 = -1.0; slider5 = 0; slider6 = 0; slider7 = 7; slider8 = 0; slider9 = 50; slider10 = 10; slider11 = 10; slider12 = 70; slider13 = 80; slider14 = 40; );
        slider15 == 5 ? ( slider1 = 0; slider2 = 4.0; slider3 = -1.5; slider4 = -2.0; slider5 = 0; slider6 = 0; slider7 = 5; slider8 = 0; slider9 = 45; slider10 = 8; slider11 = 10; slider12 = 75; slider13 = 70; slider14 = 45; );
        slider15 == 6 ? ( slider1 = 0; slider2 = 5.0; slider3 = -1.5; slider4 = 0.5; slider5 = 0; slider6 = 0; slider7 = 9; slider8 = 0; slider9 = 50; slider10 = 10; slider11 = 12; slider12 = 55; slider13 = 60; slider14 = 50; );
        slider15 == 7 ? ( slider1 = -1.0; slider2 = 5.5; slider3 = -1.0; slider4 = -0.5; slider5 = 0; slider6 = 0; slider7 = 5; slider8 = 0; slider9 = 45; slider10 = 12; slider11 = 10; slider12 = 75; slider13 = 65; slider14 = 55; );
        slider15 == 8 ? ( slider1 = -1.0; slider2 = 2.5; slider3 = 0; slider4 = 0.5; slider5 = 0; slider6 = 0; slider7 = 9; slider8 = 0; slider9 = 55; slider10 = 15; slider11 = 10; slider12 = 60; slider13 = 65; slider14 = 30; );
        slider15 == 9 ? ( slider1 = -0.5; slider2 = 3.5; slider3 = -0.5; slider4 = 0; slider5 = 0; slider6 = 0; slider7 = 1; slider8 = 0; slider9 = 50; slider10 = 15; slider11 = 15; slider12 = 65; slider13 = 65; slider14 = 30; );
