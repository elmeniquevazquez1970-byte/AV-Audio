desc: SaturnoDeltaEQ  - Autor: Adrian Vazquez
author: Adrian Vazquez 

slider1:42.00<20,20000,0.01>-B1 Freq
slider2:0.00<0,18,0.01>-B1 Gain
slider3:0.71<0.1,10,0.01>-B1 Q
slider4:1<0,1,1>-B1 On
slider24:0<0,10,1>-B1 Sat
slider29:0<0,4,1>-B1 Ch

slider5:164.00<20,20000,0.01>-B2 Freq
slider6:0.00<0,18,0.01>-B2 Gain
slider7:0.71<0.1,10,0.01>-B2 Q
slider8:1<0,1,1>-B2 On
slider25:0<0,10,1>-B2 Sat
slider30:0<0,4,1>-B2 Ch

slider9:632.00<20,20000,0.01>-B3 Freq
slider10:0.00<0,18,0.01>-B3 Gain
slider11:0.71<0.1,10,0.01>-B3 Q
slider12:1<0,1,1>-B3 On
slider26:0<0,10,1>-B3 Sat
slider31:0<0,4,1>-B3 Ch

slider13:2460.00<20,20000,0.01>-B4 Freq
slider14:0.00<0,18,0.01>-B4 Gain
slider15:0.71<0.1,10,0.01>-B4 Q
slider16:1<0,1,1>-B4 On
slider27:0<0,10,1>-B4 Sat
slider32:0<0,4,1>-B4 Ch

slider17:9600.00<20,20000,0.01>-B5 Freq
slider18:0.00<0,18,0.01>-B5 Gain
slider19:0.71<0.1,10,0.01>-B5 Q
slider20:1<0,1,1>-B5 On
slider28:0<0,10,1>-B5 Sat
slider33:0<0,4,1>-B5 Ch

slider21:0<-24,24,0.01>-Input
slider22:0<-24,24,0.01>-Output
slider23:50<0,100,0.1>-Mix

slider37:1<0,2,1>-Mode
slider38:0<0,1,1>-DeEmphasis

@init
gfx_clear = 1;

b0_arr = mem; mem += 5;
b1_arr = mem; mem += 5;
b2_arr = mem; mem += 5;
a1_arr = mem; mem += 5;
a2_arr = mem; mem += 5;

z1L = mem; mem += 5;
z2L = mem; mem += 5;
z1R = mem; mem += 5;
z2R = mem; mem += 5;

i = 0;
loop(5,
  b0_arr[i] = 1; b1_arr[i] = 0; b2_arr[i] = 0;
  a1_arr[i] = 0; a2_arr[i] = 0;
  z1L[i] = 0; z2L[i] = 0;
  z1R[i] = 0; z2R[i] = 0;
  i += 1;
);

cb_b0 = 1; cb_b1 = 0; cb_b2 = 0; cb_a1 = 0; cb_a2 = 0;

coeff_ready = 0;

function tanh_x(x) local(x2, e2, r) (
  x = max(-8, min(8, x));
  x2 = x * 2;
  (x2 > 0) ? (
    e2 = exp(-x2);
    r = (1 - e2) / (1 + e2);
  ) : (
    e2 = exp(x2);
    r = (e2 - 1) / (e2 + 1);
  );
  r;
);

function compute_band(freq, Q, gain_db, type) local(A, w0, cw, sw, alpha, a0, sqA) (
  freq = max(20, min(20000, freq));
  Q = max(0.1, Q);
  A = 10^(gain_db / 40);
  w0 = 2 * $pi * freq / srate;
  cw = cos(w0);
  sw = sin(w0);

  type == 0 ? (
    sqA = sqrt(A);
    alpha = sw * 0.70710678;
    cb_b0 = A * ((A+1) - (A-1)*cw + 2*sqA*alpha);
    cb_b1 = 2 * A * ((A-1) - (A+1)*cw);
    cb_b2 = A * ((A+1) - (A-1)*cw - 2*sqA*alpha);
    a0 = (A+1) + (A-1)*cw + 2*sqA*alpha;
    cb_a1 = -2 * ((A-1) + (A+1)*cw);
    cb_a2 = (A+1) + (A-1)*cw - 2*sqA*alpha;
  )
  : type == 2 ? (
    sqA = sqrt(A);
    alpha = sw * 0.70710678;
    cb_b0 = A * ((A+1) + (A-1)*cw + 2*sqA*alpha);
    cb_b1 = -2 * A * ((A-1) + (A+1)*cw);
    cb_b2 = A * ((A+1) + (A-1)*cw - 2*sqA*alpha);
    a0 = (A+1) - (A-1)*cw + 2*sqA*alpha;
    cb_a1 = 2 * ((A-1) - (A+1)*cw);
    cb_a2 = (A+1) - (A-1)*cw - 2*sqA*alpha;
  )
  : (
    alpha = sw / (2*Q);
    cb_b0 = 1 + alpha*A;
    cb_b1 = -2 * cw;
    cb_b2 = 1 - alpha*A;
    a0 = 1 + alpha/A;
    cb_a1 = -2 * cw;
    cb_a2 = 1 - alpha/A;
  );

  cb_b0 /= a0; cb_b1 /= a0; cb_b2 /= a0;
  cb_a1 /= a0; cb_a2 /= a0;
);

function saturate(xin, stype, drive) local(x, y, ax) (
  drive = max(0.01, drive);
  x = xin * drive;
  ax = abs(x);

  stype == 0 ? ( y = x / (1 + ax); )
  : stype == 1 ? ( y = tanh_x(x * 0.6); )
  : stype == 2 ? ( y = x > 0 ? x/(1+x) : x/(1-x*1.5); )
  : stype == 3 ? ( y = tanh_x(x * 0.9) * 0.9; )
  : stype == 4 ? ( y = ax > 0.08 ? x - sign(x)*0.08 : 0; )
  : stype == 5 ? ( y = x / (1 + ax*1.4); )
  : stype == 6 ? ( y = max(-1, min(1, x)); )
  : stype == 7 ? ( y = floor(x * 16) / 16; )
  : stype == 8 ? ( y = ax; )
  : stype == 9 ? ( y = max(0, x); )
  : ( y = x; );

  stype == 10 ? ( y = xin; ) : ( y = y / drive; );
  y;
);

drag_band = -1;
last_click_frame = -100;
last_click_band = -1;
last_click_row = -1;
knob_drag = -1;
knob_y0 = 0;
knob_val0 = 0;
link_io = 0;
frame_count = 0;

last_knob_click_frame = -100;
last_knob_click_idx = -1;

panel_drag_band = -1;
panel_drag_row = -1;
panel_drag_y0 = 0;
panel_drag_val0 = 0;

dropdown_open = -1;
dropdown_band = -1;

edit_active = 0;
edit_band = -1;
edit_field = -1;
edit_cooldown = 0;
#edit_buf = "";

prev_mouse_wheel = 0;
wheel_cooldown = 0;

@slider

@block
(srate > 100) ? (
  compute_band(slider1, slider3, slider2, 0);
  b0_arr[0] = cb_b0; b1_arr[0] = cb_b1; b2_arr[0] = cb_b2;
  a1_arr[0] = cb_a1; a2_arr[0] = cb_a2;

  compute_band(slider5, slider7, slider6, 1);
  b0_arr[1] = cb_b0; b1_arr[1] = cb_b1; b2_arr[1] = cb_b2;
  a1_arr[1] = cb_a1; a2_arr[1] = cb_a2;

  compute_band(slider9, slider11, slider10, 1);
  b0_arr[2] = cb_b0; b1_arr[2] = cb_b1; b2_arr[2] = cb_b2;
  a1_arr[2] = cb_a1; a2_arr[2] = cb_a2;

  compute_band(slider13, slider15, slider14, 1);
  b0_arr[3] = cb_b0; b1_arr[3] = cb_b1; b2_arr[3] = cb_b2;
  a1_arr[3] = cb_a1; a2_arr[3] = cb_a2;

  compute_band(slider17, slider19, slider18, 2);
  b0_arr[4] = cb_b0; b1_arr[4] = cb_b1; b2_arr[4] = cb_b2;
  a1_arr[4] = cb_a1; a2_arr[4] = cb_a2;

  coeff_ready = 1;
);

@sample
(coeff_ready == 1) ? (
  in_gain = 10^(slider21/20);
  out_gain = 10^(slider22/20);
  in_gain = max(0.05, min(20, in_gain));
  out_gain = max(0.05, min(20, out_gain));
  mix_amt = max(0, min(1, slider23 * 0.01));

  mode_drive = slider37 == 0 ? 0.5 : (slider37 == 1 ? 1.5 : 3.0);

  dryL = spl0 * in_gain;
  dryR = spl1 * in_gain;

  wetL = 0;
  wetR = 0;
  unsatL = 0;
  unsatR = 0;

  bd = 0;
  loop(5,
    on_b = (bd==0) ? slider4 : (bd==1) ? slider8 : (bd==2) ? slider12 : (bd==3) ? slider16 : slider20;
    st_b = (bd==0) ? slider24 : (bd==1) ? slider25 : (bd==2) ? slider26 : (bd==3) ? slider27 : slider28;
    cm_b = (bd==0) ? slider29 : (bd==1) ? slider30 : (bd==2) ? slider31 : (bd==3) ? slider32 : slider33;

    on_b == 1 ? (
      yL = b0_arr[bd]*dryL + z1L[bd];
      z1L[bd] = b1_arr[bd]*dryL - a1_arr[bd]*yL + z2L[bd];
      z2L[bd] = b2_arr[bd]*dryL - a2_arr[bd]*yL;

      yR = b0_arr[bd]*dryR + z1R[bd];
      z1R[bd] = b1_arr[bd]*dryR - a1_arr[bd]*yR + z2R[bd];
      z2R[bd] = b2_arr[bd]*dryR - a2_arr[bd]*yR;

      dL = yL - dryL;
      dR = yR - dryR;

      satL = saturate(dL, st_b, mode_drive);
      satR = saturate(dR, st_b, mode_drive);

      cm_b == 0 ? ( wetL += satL; wetR += satR; )
      : cm_b == 1 ? ( wetL += satL; )
      : cm_b == 2 ? ( wetR += satR; )
      : cm_b == 3 ? ( m_id = (satL + satR) * 0.5; wetL += m_id; wetR += m_id; )
      : ( s_id = (satL - satR) * 0.5; wetL += s_id; wetR -= s_id; );

      cm_b == 0 ? ( unsatL += dL; unsatR += dR; )
      : cm_b == 1 ? ( unsatL += dL; )
      : cm_b == 2 ? ( unsatR += dR; )
      : cm_b == 3 ? ( u_m = (dL + dR) * 0.5; unsatL += u_m; unsatR += u_m; )
      : ( u_s = (dL - dR) * 0.5; unsatL += u_s; unsatR -= u_s; );
    );
    bd += 1;
  );

  slider38 == 1 ? (
    wetL -= unsatL;
    wetR -= unsatR;
  );

  outL = (dryL + wetL * mix_amt) * out_gain;
  outR = (dryR + wetR * mix_amt) * out_gain;

  (outL != outL) ? ( outL = 0; );
  (outR != outR) ? ( outR = 0; );
  (outL > 4) ? ( outL = 0; );
  (outL < -4) ? ( outL = 0; );
  (outR > 4) ? ( outR = 0; );
  (outR < -4) ? ( outR = 0; );

  spl0 = outL;
  spl1 = outR;

) : (
  spl0 = spl0;
  spl1 = spl1;
);

// ============================================================
//  GFX
// ============================================================
@gfx 780 600

frame_count += 1;

(edit_cooldown > 0) ? ( edit_cooldown -= 1; );

wheel_raw = mouse_wheel;
wheel_diff = wheel_raw - prev_mouse_wheel;
prev_mouse_wheel = wheel_raw;

(wheel_cooldown > 0) ? (
  wheel_cooldown -= 1;
  wheel = 0;
) : (
  (abs(wheel_diff) > 0.5) ? (
    wheel = wheel_diff;
    wheel_cooldown = 2;
  ) : (
    wheel = 0;
  );
);

br=0.051; bg=0.043; bb=0.180;
gr=0.031; gg=0.024; gb=0.129;
lr=0.118; lg=0.106; lb=0.294;

c0r=0.95; c0g=0.20; c0b=0.20;
c1r=1.00; c1g=0.55; c1b=0.10;
c2r=0.60; c2g=0.90; c2b=0.20;
c3r=0.20; c3g=0.85; c3b=0.95;
c4r=0.65; c4g=0.30; c4b=1.00;

tx1r=0.655; tx1g=0.545; tx1b=0.980;
tx2r=0.576; tx2g=0.773; tx2b=0.992;
pr=0.082; pg=0.071; pb=0.220;
per=0.180; peg=0.160; peb=0.360;

header_h = 50;
footer_h = 46;
graph_top = header_h;
graph_bot = gfx_h - footer_h - 200;
panel_y = graph_bot + 14;
panel_h = 112;
knob_y = panel_y + panel_h + 34;
foot_y = gfx_h - footer_h;
row_h = panel_h / 5;
col_w = (gfx_w - 56) / 5;

gfx_set(1,1,1,1);
gfx_rect(0,0,gfx_w,header_h);
gfx_set(br,bg,bb,1);
gfx_rect(0,header_h,gfx_w,gfx_h-header_h);
gfx_set(gr,gg,gb,1);
gfx_rect(0,graph_top,gfx_w,graph_bot-graph_top);

gfx_set(0.65, 0.30, 1, 1);
gfx_setfont(1, "Arial", 22);
gfx_x = 15; gfx_y = 14;
gfx_drawstr("AV");

gfx_setfont(1, "Arial", 17);
gfx_x = gfx_w/2 - 85; gfx_y = 17;
gfx_set(0.65, 0.30, 1, 1);
gfx_drawstr("SATURNO");
gfx_x = gfx_w/2 - 85 + 72;
gfx_set(0.35, 0.55, 1, 1);
gfx_drawstr("DELTAEQ");

gfx_set(0.15,0.15,0.30,1);
gfx_rect(gfx_w-40,18,22,3);
gfx_rect(gfx_w-40,25,22,3);
gfx_rect(gfx_w-40,32,22,3);

log_min = log(20);
log_max = log(20000);

function sx(f) ( (log(f)-log_min)/(log_max-log_min) * gfx_w );

x30=sx(30); x100=sx(100); x300=sx(300);
x1k=sx(1000); x3k=sx(3000); x10k=sx(10000);

gfx_set(lr,lg,lb,1);
gfx_line(x30,graph_top,x30,graph_bot);
gfx_line(x100,graph_top,x100,graph_bot);
gfx_line(x300,graph_top,x300,graph_bot);
gfx_line(x1k,graph_top,x1k,graph_bot);
gfx_line(x3k,graph_top,x3k,graph_bot);
gfx_line(x10k,graph_top,x10k,graph_bot);

yy6 = graph_top + (graph_bot - graph_top) * 0.666;
yy12 = graph_top + (graph_bot - graph_top) * 0.333;
yy18 = graph_top;
gfx_line(0, yy6, gfx_w, yy6);
gfx_line(0, yy12, gfx_w, yy12);
gfx_line(0, yy18, gfx_w, yy18);

gfx_set(tx1r,tx1g,tx1b,0.5);
gfx_setfont(1,"Arial",9);
gfx_x = 3; gfx_y = yy6-5; gfx_drawstr("6");
gfx_x = 3; gfx_y = yy12-5; gfx_drawstr("12");
gfx_x = 3; gfx_y = yy18-5; gfx_drawstr("18");

gfx_set(tx1r,tx1g,tx1b,1);
gfx_setfont(1,"Arial",12);
gfx_x=x30-8; gfx_y=graph_bot+4; gfx_drawstr("30");
gfx_x=x100-12; gfx_y=graph_bot+4; gfx_drawstr("100");
gfx_x=x300-12; gfx_y=graph_bot+4; gfx_drawstr("300");
gfx_x=x1k-8; gfx_y=graph_bot+4; gfx_drawstr("1k");
gfx_x=x3k-8; gfx_y=graph_bot+4; gfx_drawstr("3k");
gfx_x=x10k-12; gfx_y=graph_bot+4; gfx_drawstr("10k");

dbmin = 0; dbmax = 18;

function band_y(g) ( graph_bot - (g - dbmin) / (dbmax - dbmin) * (graph_bot - graph_top) );
function y_to_gain(y) ( dbmin + (graph_bot - y) / (graph_bot - graph_top) * (dbmax - dbmin) );
function x_to_freq(x) ( exp(log_min + (x / gfx_w) * (log_max - log_min)) );

px0=sx(slider1); px1=sx(slider5); px2=sx(slider9);
px3=sx(slider13); px4=sx(slider17);

py0=band_y(slider2); py1=band_y(slider6); py2=band_y(slider10);
py3=band_y(slider14); py4=band_y(slider18);

mdown = mouse_cap & 1;
interact_ok = (edit_cooldown == 0) ? 1 : 0;

hit_band = -1;
hr = 22;
dx = mouse_x - px0; dy = mouse_y - py0; (dx*dx + dy*dy < hr*hr) ? hit_band = 0;
dx = mouse_x - px1; dy = mouse_y - py1; (dx*dx + dy*dy < hr*hr) ? hit_band = 1;
dx = mouse_x - px2; dy = mouse_y - py2; (dx*dx + dy*dy < hr*hr) ? hit_band = 2;
dx = mouse_x - px3; dy = mouse_y - py3; (dx*dx + dy*dy < hr*hr) ? hit_band = 3;
dx = mouse_x - px4; dy = mouse_y - py4; (dx*dx + dy*dy < hr*hr) ? hit_band = 4;

hit_icon = -1;
icon_y = graph_top + 22;
(mouse_y < graph_top + 42) ? (
  dx = mouse_x - px0; dy = mouse_y - icon_y; (dx*dx + dy*dy < 16*16) ? hit_icon = 0;
  dx = mouse_x - px1; dy = mouse_y - icon_y; (dx*dx + dy*dy < 16*16) ? hit_icon = 1;
  dx = mouse_x - px2; dy = mouse_y - icon_y; (dx*dx + dy*dy < 16*16) ? hit_icon = 2;
  dx = mouse_x - px3; dy = mouse_y - icon_y; (dx*dx + dy*dy < 16*16) ? hit_icon = 3;
  dx = mouse_x - px4; dy = mouse_y - icon_y; (dx*dx + dy*dy < 16*16) ? hit_icon = 4;
);

hit_knob = -1;
kx = gfx_w*0.25; ky = knob_y;
dx = mouse_x - kx; dy = mouse_y - ky; (dx*dx + dy*dy < 24*24) ? hit_knob = 0;
kx = gfx_w*0.50;
dx = mouse_x - kx; dy = mouse_y - ky; (dx*dx + dy*dy < 24*24) ? hit_knob = 1;
kx = gfx_w*0.75;
dx = mouse_x - kx; dy = mouse_y - ky; (dx*dx + dy*dy < 24*24) ? hit_knob = 2;

hit_link = 0;
link_x = (gfx_w*0.25 + gfx_w*0.50) / 2;
dx = mouse_x - link_x; dy = mouse_y - knob_y;
(dx*dx + dy*dy < 14*14) ? hit_link = 1;

in_panel = 0;
panel_hover_band = -1;
panel_hover_row = -1;
(mouse_y > panel_y && mouse_y < panel_y + panel_h && mouse_x > 28 && mouse_x < gfx_w - 28) ? (
  in_panel = 1;
  panel_hover_band = max(0, min(4, floor((mouse_x - 28) / col_w)));
  panel_hover_row = max(0, min(4, floor((mouse_y - panel_y) / row_h)));
);

// FOOTER: 2 columnas (Mode y De-Emphasis)
footer_hover = -1;
(mouse_y > foot_y && mouse_y < gfx_h) ? (
  footer_hover = max(0, min(1, floor(mouse_x / (gfx_w/2))));
);

drop_x = 0; drop_y = 0; drop_w = 0; drop_h = 0;
drop_items = 0;
(dropdown_open >= 0) ? (
  (dropdown_open == 3 || dropdown_open == 4) ? (
    drop_x = 28 + dropdown_band * col_w;
    drop_w = col_w - 4;
    drop_items = (dropdown_open == 3) ? 11 : 5;
    item_h = 14;
    drop_h = drop_items * item_h;
    drop_y = panel_y + row_h * (dropdown_open + 1);
    (drop_y + drop_h > foot_y - 2) ? (
      drop_y = panel_y + row_h * dropdown_open - drop_h;
    );
    drop_y = max(4, drop_y);
  ) : (
    // Footer: 8 = Mode, 9 = De-Emphasis
    fdi = dropdown_open - 8;
    drop_x = gfx_w * fdi / 2;
    drop_w = gfx_w / 2 - 4;
    drop_items = (fdi == 0) ? 3 : 2;
    item_h = 16;
    drop_h = drop_items * item_h;
    drop_y = foot_y - drop_h - 2;
  );
);

dropdown_click = -1;
drop_in_area = 0;
(dropdown_open >= 0) ? (
  (mouse_x > drop_x && mouse_x < drop_x + drop_w && mouse_y > drop_y && mouse_y < drop_y + drop_h) ? (
    drop_in_area = 1;
    idx = floor((mouse_y - drop_y) / item_h);
    (idx >= 0 && idx < drop_items) ? ( dropdown_click = idx; );
  );
);

(dropdown_open >= 0 && mdown == 1 && dropdown_click >= 0 && interact_ok == 1) ? (
  dropdown_open == 3 ? (
    dropdown_band == 0 ? ( slider24 = dropdown_click; );
    dropdown_band == 1 ? ( slider25 = dropdown_click; );
    dropdown_band == 2 ? ( slider26 = dropdown_click; );
    dropdown_band == 3 ? ( slider27 = dropdown_click; );
    dropdown_band == 4 ? ( slider28 = dropdown_click; );
  ) : (dropdown_open == 4) ? (
    dropdown_band == 0 ? ( slider29 = dropdown_click; );
    dropdown_band == 1 ? ( slider30 = dropdown_click; );
    dropdown_band == 2 ? ( slider31 = dropdown_click; );
    dropdown_band == 3 ? ( slider32 = dropdown_click; );
    dropdown_band == 4 ? ( slider33 = dropdown_click; );
  ) : (dropdown_open == 8) ? ( slider37 = dropdown_click; )
  : (dropdown_open == 9) ? ( slider38 = dropdown_click; );
  dropdown_open = -1;
  dropdown_band = -1;
  edit_cooldown = 5;
);

(dropdown_open >= 0 && mdown == 1 && dropdown_click < 0 && drop_in_area == 0) ? (
  (!in_panel && footer_hover < 0) ? (
    dropdown_open = -1;
    dropdown_band = -1;
    edit_cooldown = 3;
  );
);

// Footer click: mapea las 2 columnas a dropdown 8 (Mode) y 9 (De-Emphasis)
(mdown == 1 && footer_hover >= 0 && dropdown_open < 0 && edit_active == 0 && interact_ok == 1) ? (
  footer_hover == 0 ? ( dropdown_open = 8; ) : ( dropdown_open = 9; );
  dropdown_band = -1;
  last_click_frame = frame_count;
);

(mdown == 1 && hit_icon >= 0 && drag_band == -1 && dropdown_open < 0 && edit_active == 0 && interact_ok == 1) ? (
  hit_icon == 0 ? ( slider4 = 1 - slider4; );
  hit_icon == 1 ? ( slider8 = 1 - slider8; );
  hit_icon == 2 ? ( slider12 = 1 - slider12; );
  hit_icon == 3 ? ( slider16 = 1 - slider16; );
  hit_icon == 4 ? ( slider20 = 1 - slider20; );
);

(mdown == 1 && hit_band >= 0 && drag_band == -1 && dropdown_open < 0 && edit_active == 0 && interact_ok == 1) ? (
  (frame_count - last_click_frame < 20 && last_click_band == hit_band && last_click_row == -1) ? (
    hit_band == 0 ? ( slider4 = 1 - slider4; );
    hit_band == 1 ? ( slider8 = 1 - slider8; );
    hit_band == 2 ? ( slider12 = 1 - slider12; );
    hit_band == 3 ? ( slider16 = 1 - slider16; );
    hit_band == 4 ? ( slider20 = 1 - slider20; );
