gfx_circle(px0,py0,6,1); gfx_circle(px1,py1,6,1); gfx_circle(px2,py2,6,1);
gfx_circle(px3,py3,6,1); gfx_circle(px4,py4,6,1);

slider4 == 0 ? ( gfx_set(c0r,c0g,c0b,0.6); gfx_circle(px0,py0,6,0); );
slider8 == 0 ? ( gfx_set(c1r,c1g,c1b,0.6); gfx_circle(px1,py1,6,0); );
slider12 == 0 ? ( gfx_set(c2r,c2g,c2b,0.6); gfx_circle(px2,py2,6,0); );
slider16 == 0 ? ( gfx_set(c3r,c3g,c3b,0.6); gfx_circle(px3,py3,6,0); );
slider20 == 0 ? ( gfx_set(c4r,c4g,c4b,0.6); gfx_circle(px4,py4,6,0); );

drag_band == 0 ? ( gfx_set(c0r,c0g,c0b,0.9); gfx_circle(px0,py0,12,0); );
drag_band == 1 ? ( gfx_set(c1r,c1g,c1b,0.9); gfx_circle(px1,py1,12,0); );
drag_band == 2 ? ( gfx_set(c2r,c2g,c2b,0.9); gfx_circle(px2,py2,12,0); );
drag_band == 3 ? ( gfx_set(c3r,c3g,c3b,0.9); gfx_circle(px3,py3,12,0); );
drag_band == 4 ? ( gfx_set(c4r,c4g,c4b,0.9); gfx_circle(px4,py4,12,0); );

// PANEL
gfx_set(pr,pg,pb,1);
gfx_rect(28, panel_y, gfx_w - 56, panel_h);
gfx_set(per,peg,peb,0.8);
gfx_rect(28, panel_y, gfx_w - 56, 1);

(in_panel == 1 && dropdown_open < 0) ? (
  hx = 28 + panel_hover_band * col_w;
  hy = panel_y + panel_hover_row * row_h;
  gfx_set(1, 1, 1, 0.06);
  gfx_rect(hx, hy, col_w, row_h);
);

i = 0;
loop(5,
  cx = 28 + col_w * i + col_w / 2;

  i == 0 ? ( freq=slider1; gain=slider2; qv=slider3; on=slider4; sv=slider24; mv=slider29; bc_r=c0r; bc_g=c0g; bc_b=c0b; );
  i == 1 ? ( freq=slider5; gain=slider6; qv=slider7; on=slider8; sv=slider25; mv=slider30; bc_r=c1r; bc_g=c1g; bc_b=c1b; );
  i == 2 ? ( freq=slider9; gain=slider10; qv=slider11; on=slider12; sv=slider26; mv=slider31; bc_r=c2r; bc_g=c2g; bc_b=c2b; );
  i == 3 ? ( freq=slider13; gain=slider14; qv=slider15; on=slider16; sv=slider27; mv=slider32; bc_r=c3r; bc_g=c3g; bc_b=c3b; );
  i == 4 ? ( freq=slider17; gain=slider18; qv=slider19; on=slider20; sv=slider28; mv=slider33; bc_r=c4r; bc_g=c4g; bc_b=c4b; );

  al = (on == 1) ? 1 : 0.4;
  gfx_setfont(1, "Arial", 12);

  gfx_set(bc_r, bc_g, bc_b, al);
  (freq < 1000) ? ( gfx_x = cx-40; gfx_y = panel_y+8; gfx_drawstr(sprintf(#,"%.2f Hz",freq)); )
                : ( gfx_x = cx-40; gfx_y = panel_y+8; gfx_drawstr(sprintf(#,"%.2f kHz",freq/1000)); );

  gfx_set(bc_r*0.8+0.2, bc_g*0.8+0.2, bc_b*0.8+0.2, al);
  gfx_x = cx-40; gfx_y = panel_y+row_h+8;
  gfx_drawstr(sprintf(#,"%.2f dB",gain));

  gfx_set(bc_r, bc_g, bc_b, al);
  gfx_x = cx-40; gfx_y = panel_y+row_h*2+8;
  gfx_drawstr(sprintf(#,"%.2f",qv));

  gfx_set(bc_r*0.8+0.2, bc_g*0.8+0.2, bc_b*0.8+0.2, al);
  gfx_x = cx-40; gfx_y = panel_y+row_h*3+8;
  sv == 0 ? ( gfx_drawstr("Tube v"); )
  : sv == 1 ? ( gfx_drawstr("WarmTube v"); )
  : sv == 2 ? ( gfx_drawstr("Solid v"); )
  : sv == 3 ? ( gfx_drawstr("Tape v"); )
  : sv == 4 ? ( gfx_drawstr("ClassB v"); )
  : sv == 5 ? ( gfx_drawstr("Diode v"); )
  : sv == 6 ? ( gfx_drawstr("Digital v"); )
  : sv == 7 ? ( gfx_drawstr("Bit v"); )
  : sv == 8 ? ( gfx_drawstr("Rectify v"); )
  : sv == 9 ? ( gfx_drawstr("HalfRect v"); )
  : ( gfx_drawstr("Clean v"); );

  gfx_set(bc_r, bc_g, bc_b, al);
  gfx_x = cx-40; gfx_y = panel_y+row_h*4+8;
  mv == 0 ? ( gfx_drawstr("Stereo v"); )
  : mv == 1 ? ( gfx_drawstr("Left v"); )
  : mv == 2 ? ( gfx_drawstr("Right v"); )
  : mv == 3 ? ( gfx_drawstr("Mid v"); )
  : ( gfx_drawstr("Side v"); );

  i += 1;
);

// KNOBS
gfx_set(0.18,0.16,0.32,1);
gfx_arc(gfx_w*0.25, knob_y, 18, 18, 0, 360, 1);
gfx_set(c0r,c0g,c0b,1);
gfx_arc(gfx_w*0.25, knob_y, 18, 18, -135, -135+(slider21+24)/48*270, 1);
gfx_set(0.85,0.85,1,1);
gfx_setfont(1,"Arial",12);
gfx_x=gfx_w*0.25-25; gfx_y=knob_y+26; gfx_drawstr("Input");

gfx_set(0.18,0.16,0.32,1);
gfx_arc(gfx_w*0.50, knob_y, 18, 18, 0, 360, 1);
gfx_set(c2r,c2g,c2b,1);
gfx_arc(gfx_w*0.50, knob_y, 18, 18, -135, -135+(slider22+24)/48*270, 1);
gfx_set(0.85,0.85,1,1);
gfx_x=gfx_w*0.50-30; gfx_y=knob_y+26; gfx_drawstr("Output");

gfx_set(0.18,0.16,0.32,1);
gfx_arc(gfx_w*0.75, knob_y, 18, 18, 0, 360, 1);
gfx_set(c4r,c4g,c4b,1);
gfx_arc(gfx_w*0.75, knob_y, 18, 18, -135, -135+slider23/100*270, 1);
gfx_set(0.85,0.85,1,1);
gfx_x=gfx_w*0.75-15; gfx_y=knob_y+26; gfx_drawstr("Mix");

link_x = (gfx_w*0.25 + gfx_w*0.50)/2;
gfx_set(0.35,0.35,0.55,1);
lx = gfx_w*0.25 + 26;
lcount = max(0, floor((gfx_w*0.50 - gfx_w*0.25 - 52)/6));
loop(lcount, gfx_line(lx, knob_y, lx+3, knob_y); lx += 6; );
link_io ? ( gfx_set(1.0,0.8,0.2,1); ) : ( gfx_set(0.35,0.35,0.55,1); );
gfx_circle(link_x, knob_y, 7, 1);
gfx_set(0.10,0.10,0.25,1);
gfx_circle(link_x, knob_y, 4, 1);

gfx_set(tx2r,tx2g,tx2b,1);
gfx_setfont(1,"Arial",10);
gfx_x=gfx_w*0.25-20; gfx_y=knob_y-28; gfx_drawstr(sprintf(#,"%.1f",slider21));
gfx_x=gfx_w*0.50-20; gfx_y=knob_y-28; gfx_drawstr(sprintf(#,"%.1f",slider22));
gfx_x=gfx_w*0.75-15; gfx_y=knob_y-28; gfx_drawstr(sprintf(#,"%.0f",slider23));

(edit_active == 1) ? (
  ex = 28 + edit_band * col_w;
  ey = panel_y + edit_field * row_h;
  gfx_set(0.05, 0.04, 0.15, 0.98);
  gfx_rect(ex, ey, col_w, row_h);
  gfx_set(0.85, 0.55, 1, 1);
  gfx_rect(ex, ey, col_w, 1);
  gfx_rect(ex, ey + row_h - 1, col_w, 1);
  gfx_rect(ex, ey, 1, row_h);
  gfx_rect(ex + col_w - 1, ey, 1, row_h);
  gfx_setfont(1, "Arial", 13);
  gfx_set(1, 1, 1, 1);
  gfx_x = ex + 6; gfx_y = ey + 6;
  gfx_drawstr(#edit_buf);
  gfx_drawstr("_");
);

// FOOTER con solo 2 items: Mode y De-Emphasis
gfx_set(1,1,1,1);
gfx_rect(0, foot_y, gfx_w, footer_h);

gfx_setfont(1, "Arial", 11);
i = 0;
loop(2,
  cx = gfx_w * (i + 0.5) / 2;
  gfx_set(0.15, 0.15, 0.35, 1);
  gfx_x = cx - 40; gfx_y = foot_y + 6;
  i == 0 ? ( gfx_drawstr("Mode v"); )
  : ( gfx_drawstr("De-Emphasis v"); );

  gfx_set(0.45, 0.45, 1, 1);
  gfx_x = cx - 40; gfx_y = foot_y + 24;
  i == 0 ? ( slider37 == 0 ? ( gfx_drawstr("Subtle"); ) : slider37 == 1 ? ( gfx_drawstr("Medium"); ) : ( gfx_drawstr("Aggressive"); ) )
  : ( slider38 == 0 ? ( gfx_drawstr("Disabled"); ) : ( gfx_drawstr("Enabled"); ) );

  i += 1;
);

(footer_hover >= 0) ? (
  gfx_set(0,0,0,0.08);
  gfx_rect(gfx_w*footer_hover/2, foot_y, gfx_w/2, footer_h);
);

// DROPDOWN
(dropdown_open >= 0) ? (
  gfx_set(0.08, 0.06, 0.20, 1);
  gfx_rect(drop_x, drop_y, drop_w, drop_h);
  gfx_set(0.30, 0.25, 0.50, 1);
  gfx_rect(drop_x, drop_y, drop_w, 1);
  gfx_rect(drop_x, drop_y + drop_h - 1, drop_w, 1);
  gfx_rect(drop_x, drop_y, 1, drop_h);
  gfx_rect(drop_x + drop_w - 1, drop_y, 1, drop_h);

  cur_val = (dropdown_open == 3) ? (
    dropdown_band == 0 ? slider24 : dropdown_band == 1 ? slider25 : dropdown_band == 2 ? slider26 : dropdown_band == 3 ? slider27 : slider28
  ) : (dropdown_open == 4) ? (
    dropdown_band == 0 ? slider29 : dropdown_band == 1 ? slider30 : dropdown_band == 2 ? slider31 : dropdown_band == 3 ? slider32 : slider33
  ) : (dropdown_open == 8) ? slider37
  : slider38;

  k = 0;
  loop(drop_items,
    iy = drop_y + k * item_h;
    hover = (mouse_x > drop_x && mouse_x < drop_x + drop_w && mouse_y > iy && mouse_y < iy + item_h) ? 1 : 0;
    (k == cur_val) ? ( gfx_set(0.35, 0.25, 0.65, 1); gfx_rect(drop_x+2, iy+1, drop_w-4, item_h-2); );
    (hover == 1 && k != cur_val) ? ( gfx_set(0.20, 0.16, 0.38, 1); gfx_rect(drop_x+2, iy+1, drop_w-4, item_h-2); );
    gfx_set(k == cur_val ? 1 : 0.85, k == cur_val ? 1 : 0.85, 1, 1);
    gfx_setfont(1, "Arial", 11);
    gfx_x = drop_x + 8; gfx_y = iy + 1;
    (dropdown_open == 3) ? (
      k == 0 ? ( gfx_drawstr("Tube"); )
      : k == 1 ? ( gfx_drawstr("WarmTube"); )
      : k == 2 ? ( gfx_drawstr("Solid"); )
      : k == 3 ? ( gfx_drawstr("Tape"); )
      : k == 4 ? ( gfx_drawstr("ClassB"); )
      : k == 5 ? ( gfx_drawstr("Diode"); )
      : k == 6 ? ( gfx_drawstr("Digital"); )
      : k == 7 ? ( gfx_drawstr("Bit"); )
      : k == 8 ? ( gfx_drawstr("Rectify"); )
      : k == 9 ? ( gfx_drawstr("HalfRect"); )
      : ( gfx_drawstr("Clean"); );
    ) : (dropdown_open == 4) ? (
      k == 0 ? ( gfx_drawstr("Stereo"); )
      : k == 1 ? ( gfx_drawstr("Left"); )
      : k == 2 ? ( gfx_drawstr("Right"); )
      : k == 3 ? ( gfx_drawstr("Mid"); )
      : ( gfx_drawstr("Side"); );
    ) : (dropdown_open == 8) ? (
      k == 0 ? ( gfx_drawstr("Subtle"); )
      : k == 1 ? ( gfx_drawstr("Medium"); )
      : ( gfx_drawstr("Aggressive"); );
    ) : (
      k == 0 ? ( gfx_drawstr("Disabled"); )
      : ( gfx_drawstr("Enabled"); );
    );
    k += 1;
  );
);
